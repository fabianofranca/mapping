{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "swipe-to-dismiss",
  "name": "Swipe to dismiss",
  "description": "Item que se dispensa deslizando: o fundo revelado (primaryContainer ao arrastar para o fim, errorContainer ao arrastar para o início) leva o ícone no lado de onde o item saiu; em repouso só o item aparece.",
  "size": {
    "width": 360,
    "height": 72
  },
  "sizing": {
    "width": "fill",
    "height": 72
  },
  "preview": {
    "title": "Reunião de equipe",
    "supportingText": "Hoje, 14:00",
    "direction": "EndToStart",
    "enableDismissFromStartToEnd": "true",
    "enableDismissFromEndToStart": "true",
    "icon": "Delete",
    "width": "fill",
    "height": "wrap",
    "weight": null
  },
  "template": {
    "type": "frame",
    "name": "swipe to dismiss",
    "layout": {
      "type": "none"
    },
    "clip": true,
    "fill": {
      "$if": {
        "$and": [
          {
            "$eq": ["direction", "StartToEnd"]
          },
          {
            "$not": {
              "$eq": ["enableDismissFromStartToEnd", "false"]
            }
          }
        ]
      },
      "then": {
        "$token": "primary-container"
      },
      "else": {
        "$if": {
          "$and": [
            {
              "$eq": ["direction", "EndToStart"]
            },
            {
              "$not": {
                "$eq": ["enableDismissFromEndToStart", "false"]
              }
            }
          ]
        },
        "then": {
          "$token": "error-container"
        },
        "else": {
          "$token": "surface"
        }
      }
    },
