{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "alert-dialog",
  "name": "Alert dialog",
  "description": "Diálogo em surface container high com a forma extra-large (28) e margem de 24: ícone (24, em secondary, centralizado) opcional, título em headline small, texto em body medium e os botões de texto à direita; 280 a 560 de largura.",
  "size": {
    "width": 312,
    "height": 248
  },
  "sizing": {
    "width": 312,
    "height": "hug"
  },
  "preview": {
    "style": "standard",
    "title": "Descartar rascunho?",
    "text": "O rascunho será apagado e não poderá ser recuperado.",
    "confirmButton": "Descartar",
    "dismissButton": "Cancelar",
    "icon": "Delete",
    "contentDescription": ""
  },
  "template": {
    "type": "frame",
    "name": "diálogo",
    "fill": {
      "$token": "surface-container-high"
    },
    "cornerRadius": {
      "$token": "corner-extra-large"
    },
    "minWidth": 280,
    "maxWidth": 560,
    "layout": {
      "type": "column",
      "padding": 24
    },
    "children": [
      {
        "type": "frame",
        "name": "ícone",
        "width": "fill",
        "height": "hug",
        "visible": {
          "$has": "icon"
        },
        "layout": {
          "type": "row",
          "padding": [0, 0, 16, 0],
          "justify": "center"
        },
        "children": [
          {
            "type": "icon",
            "name": {
              "$switch": "icon",
              "cases": {
                "Home": "home",
                "Search": "search",
                "Person": "person",
                "Menu": "menu",
                "MoreVert": "more_vert",
                "Add": "add",
                "Check": "check",
                "Close": "close",
                "ArrowBack": "arrow_back",
                "Favorite": "favorite",
                "Edit": "edit",
                "Delete": "delete",
                "Share": "share",
                "Notifications": "notifications",
                "Settings": "settings",
                "Info": "info",
                "Star": "star",
                "Email": "email",
                "Phone": "phone",
                "Place": "place",
                "DateRange": "date_range",
                "ShoppingCart": "shopping_cart",
                "AccountCircle": "account_circle",
                "KeyboardArrowRight": "keyboard_arrow_right",
                "KeyboardArrowDown": "keyboard_arrow_down",
                "Refresh": "refresh",
                "Clear": "clear",
                "Done": "done",
                "Lock": "lock",
                "List": "list",
                "AccountBox": "account_box",
                "AddCircle": "add_circle",
                "ArrowDropDown": "arrow_drop_down",
                "ArrowDropUp": "arrow_drop_up",
                "ArrowForward": "arrow_forward",
                "ArrowUpward": "arrow_upward",
                "ArrowDownward": "arrow_downward",
                "Build": "build",
                "Call": "call",
                "CheckCircle": "check_circle",
                "Create": "create",
                "Face": "face",
                "FavoriteBorder": "favorite_border",
                "ExitToApp": "exit_to_app",
                "KeyboardArrowLeft": "keyboard_arrow_left",
                "KeyboardArrowUp": "keyboard_arrow_up",
                "LocationOn": "location_on",
                "MailOutline": "mail_outline",
                "PlayArrow": "play_arrow",
                "Send": "send",
                "ThumbUp": "thumb_up",
                "Warning": "warning",
                "Cancel": "cancel",
                "ExpandMore": "expand_more",
                "ExpandLess": "expand_less",
                "ChevronLeft": "chevron_left",
                "ChevronRight": "chevron_right",
                "FirstPage": "first_page",
                "LastPage": "last_page",
                "MoreHoriz": "more_horiz",
                "Apps": "apps",
                "Dashboard": "dashboard",
                "Folder": "folder",
                "FolderOpen": "folder_open",
                "InsertDriveFile": "insert_drive_file",
                "Description": "description",
                "Image": "image",
                "Mic": "mic",
                "Videocam": "videocam",
                "Chat": "chat",
                "Comment": "comment",
                "Forum": "forum",
                "NotificationsNone": "notifications_none",
                "Visibility": "visibility",
                "VisibilityOff": "visibility_off",
                "Language": "language",
                "Public": "public",
                "Link": "link",
                "Attachment": "attachment",
                "ContentCopy": "content_copy",
                "ContentPaste": "content_paste",
                "ContentCut": "content_cut",
                "Save": "save",
                "Download": "download",
                "Upload": "upload",
                "CloudUpload": "cloud_upload",
                "CloudDownload": "cloud_download",
                "Cloud": "cloud",
                "Sync": "sync",
                "Schedule": "schedule",
                "AccessTime": "access_time",
                "CalendarToday": "calendar_today",
                "Event": "event",
                "Today": "today",
                "Timer": "timer",
                "Alarm": "alarm",
                "History": "history",
                "Bookmark": "bookmark",
                "BookmarkBorder": "bookmark_border",
                "Label": "label",
                "Flag": "flag",
                "Help": "help",
                "HelpOutline": "help_outline",
                "Error": "error",
                "ErrorOutline": "error_outline",
                "Report": "report",
                "Block": "block",
                "Tune": "tune",
                "FilterList": "filter_list",
                "Sort": "sort",
                "Fullscreen": "fullscreen",
                "Wifi": "wifi",
                "Bluetooth": "bluetooth",
                "LightMode": "light_mode",
                "DarkMode": "dark_mode",
                "Palette": "palette",
                "ShoppingBag": "shopping_bag",
                "Store": "store",
                "Payment": "payment",
                "CreditCard": "credit_card",
                "AttachMoney": "attach_money",
                "Receipt": "receipt",
                "Map": "map",
                "Navigation": "navigation",
                "DirectionsCar": "directions_car",
                "Flight": "flight",
                "MenuOpen": "menu_open",
                "Logout": "logout",
                "Login": "login",
                "People": "people",
                "Group": "group",
                "PersonAdd": "person_add",
                "LockOpen": "lock_open",
                "Security": "security",
                "VerifiedUser": "verified_user",
                "Key": "key",
                "Pause": "pause",
                "Stop": "stop",
                "SkipNext": "skip_next",
                "SkipPrevious": "skip_previous",
                "VolumeUp": "volume_up",
                "VolumeOff": "volume_off",
                "ThumbDown": "thumb_down",
                "Reply": "reply",
                "Inbox": "inbox",
                "Archive": "archive",
                "Undo": "undo",
                "Redo": "redo",
                "ZoomIn": "zoom_in",
                "ZoomOut": "zoom_out",
                "Keyboard": "keyboard",
                "CheckBox": "check_box",
                "CheckBoxOutlineBlank": "check_box_outline_blank",
                "RadioButtonChecked": "radio_button_checked",
                "RadioButtonUnchecked": "radio_button_unchecked",
                "ToggleOn": "toggle_on",
                "ToggleOff": "toggle_off",
                "StarBorder": "star_border",
                "StarHalf": "star_half",
                "Lightbulb": "lightbulb",
                "Code": "code",
                "Terminal": "terminal",
                "Bolt": "bolt",
                "EditCalendar": "edit_calendar"
              },
              "default": {
                "$field": "icon"
              }
            },
            "color": {
              "$token": "secondary"
            },
            "width": 24,
            "height": 24
          }
        ]
      },
      {
        "type": "frame",
        "name": "título",
        "width": "fill",
        "height": "hug",
        "visible": {
          "$has": "title"
        },
        "layout": {
          "type": "column",
          "padding": [0, 0, 16, 0]
        },
        "children": [
          {
            "type": "text",
            "name": "título",
            "text": {
              "$field": "title"
            },
            "width": "fill",
            "font": {
              "size": {
                "$token": "headline-small-size"
              },
              "weight": {
                "$token": "headline-small-weight"
              },
              "lineHeight": {
                "$token": "headline-small-line-height"
              },
              "letterSpacing": {
                "$token": "headline-small-tracking"
              },
              "align": {
                "$if": {
                  "$has": "icon"
                },
                "then": "center",
                "else": "left"
              }
            },
            "color": {
              "$token": "on-surface"
            }
          }
        ]
      },
      {
        "type": "frame",
        "name": "texto",
        "width": "fill",
        "height": "hug",
        "visible": {
          "$has": "text"
        },
        "layout": {
          "type": "column",
          "padding": [0, 0, 24, 0]
        },
        "children": [
          {
            "type": "text",
            "name": "texto",
            "text": {
              "$field": "text"
            },
            "width": "fill",
            "font": {
              "size": {
                "$token": "body-medium-size"
              },
              "weight": {
                "$token": "body-medium-weight"
              },
              "lineHeight": {
                "$token": "body-medium-line-height"
              },
              "letterSpacing": {
                "$token": "body-medium-tracking"
              }
            },
            "color": {
              "$token": "on-surface-variant"
            }
          }
        ]
      },
      {
        "type": "frame",
        "name": "botões",
        "width": "fill",
        "height": "hug",
        "layout": {
          "type": "row",
          "gap": 8,
          "justify": "end",
          "align": "center"
        },
        "children": [
          {
            "type": "frame",
            "name": "dispensar",
            "width": "hug",
            "height": "hug",
            "minWidth": 58,
            "layout": {
              "type": "row",
              "padding": [8, 12],
              "align": "center",
              "justify": "center"
            },
            "visible": {
              "$has": "dismissButton"
            },
            "children": [
              {
                "type": "frame",
                "name": "conteúdo do rótulo",
                "width": "hug",
                "height": "hug",
                "layout": {
                  "type": "column"
                },
                "children": [
                  {
                    "type": "text",
                    "name": "rótulo",
                    "text": {
                      "$field": "dismissButton"
                    },
                    "font": {
                      "size": {
                        "$token": "label-large-size"
                      },
                      "weight": {
                        "$token": "label-large-weight"
                      },
                      "lineHeight": {
                        "$token": "label-large-line-height"
                      },
                      "letterSpacing": {
                        "$token": "label-large-tracking"
                      },
                      "verticalAlign": "cap-middle"
                    },
                    "color": {
                      "$token": "primary"
                    },
                    "width": "fill"
                  }
                ]
              }
            ],
            "minHeight": 40
          },
          {
            "type": "frame",
            "name": "confirmar",
            "width": "hug",
            "height": "hug",
            "minWidth": 58,
            "layout": {
              "type": "row",
              "padding": [8, 12],
              "align": "center",
              "justify": "center"
            },
            "visible": {
              "$has": "confirmButton"
            },
            "children": [
              {
                "type": "frame",
                "name": "conteúdo do rótulo",
                "width": "hug",
                "height": "hug",
                "layout": {
                  "type": "column"
                },
                "children": [
                  {
                    "type": "text",
                    "name": "rótulo",
                    "text": {
                      "$field": "confirmButton"
                    },
                    "font": {
                      "size": {
                        "$token": "label-large-size"
                      },
                      "weight": {
                        "$token": "label-large-weight"
                      },
                      "lineHeight": {
                        "$token": "label-large-line-height"
                      },
                      "letterSpacing": {
                        "$token": "label-large-tracking"
                      },
                      "verticalAlign": "cap-middle"
                    },
                    "color": {
                      "$token": "primary"
                    },
                    "width": "fill"
                  }
                ]
              }
            ],
            "minHeight": 40
          }
        ],
        "minHeight": 48
      }
    ]
  }
}
