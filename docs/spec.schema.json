{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapping.local/spec.schema.json",
  "title": "Mapping — especialização (formatVersion 1, 2 e 3)",
  "description": "Valida a estrutura. Regras entre elementos (ids únicos, allowedChildren em outra camada, requiresOwner, labelField, rowLabel, default compatível, rowLabel/tags, plataformas declaradas em platforms, chaves de params e values, platforms/code/codeRef a partir do formatVersion 2, sources só no formatVersion 3, values de sources só em campos enum e com destinos nas options) só são verificadas pelo validador da app; veja SPEC-FORMAT.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "id", "name", "version", "layers"],
  "properties": {
    "format": {
      "enum": ["mapping-spec", "mapeador-spec"]
    },
    "formatVersion": {
      "enum": [1, 2, 3]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_]*$"
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color", "annotationTypes"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "annotationTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotationType"
          }
        }
      }
    },
    "annotationType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "fields"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "labelField": {
          "type": ["string", "null"]
        },
        "requiresOwner": {
          "type": "boolean"
        },
        "allowedChildren": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "code": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/platformId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/codeEntry"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeSource"
          }
        }
      }
    },
    "field": {
      "oneOf": [
        {
          "$ref": "#/$defs/simpleField"
        },
        {
          "$ref": "#/$defs/tableField"
        },
        {
          "$ref": "#/$defs/refField"
        },
        {
          "$ref": "#/$defs/codeRefField"
        }
      ]
    },
    "simpleField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type"],
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tag"
              }
            },
            "type": {
              "enum": ["string", "number", "date"]
            },
            "default": {
              "type": ["string", "number"]
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fieldSource"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type", "options"],
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tag"
              }
            },
            "type": {
              "const": "enum"
            },
            "default": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fieldSource"
              }
            }
          }
        }
      ]
    },
    "column": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type"],
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "type": {
              "enum": ["string", "number", "date"]
            },
            "default": {
              "type": ["string", "number"]
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fieldSource"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type", "options"],
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "type": {
              "const": "enum"
            },
            "default": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fieldSource"
              }
            }
          }
        }
      ]
    },
    "tableField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "columns"],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "const": "table"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "rowLabel": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldSource"
          }
        }
      }
    },
    "refField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "accepts"],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "const": "ref"
        },
        "accepts": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["tags"],
              "properties": {
                "tags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/tag"
                  },
                  "minItems": 1
                },
                "free": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["free"],
              "properties": {
                "tags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/tag"
                  }
                },
                "free": {
                  "const": true
                }
              }
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldSource"
          }
        }
      }
    },
    "platformId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/platformId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "codeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol"],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "codeRefField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "const": "codeRef"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/platformId"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldSource"
          }
        }
      }
    },
    "typeSource": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "id"],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "name"],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "fieldSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "name"],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
