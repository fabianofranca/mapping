{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "tab",
  "name": "Aba",
  "description": "Uma aba: o rótulo (color-text-muted; selecionada em color-text, peso 600, com o sublinhado de 2 px em color-accent) e o contador opcional.",
  "size": {
    "width": 100,
    "height": 28
  },
  "minSize": {
    "width": 8,
    "height": 12
  },
  "sizing": {
    "width": 100,
    "height": 28
  },
  "preview": {
    "rotulo": "Avisos",
    "selecionada": "não",
    "selo": "",
    "tamanho": "md"
  },
  "template": {
    "type": "frame",
    "name": "aba",
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "frame",
        "name": "conteúdo",
        "width": "hug",
        "height": "hug",
        "anchors": {
          "centerX": true,
          "centerY": true
        },
        "layout": {
          "type": "row",
          "gap": 6,
          "align": "center"
        },
        "children": [
          {
            "type": "icon",
            "width": 16,
            "height": 16,
            "visible": {
              "$has": "icone"
            },
            "name": {
              "$switch": "icone",
              "cases": {
                "undo": "undo",
                "redo": "redo",
                "edit": "edit",
                "copy": "copy",
                "trash": "trash",
                "plus": "plus",
                "minus": "minus",
                "check": "check",
                "close": "close",
                "refresh": "refresh",
                "pan": "pan",
                "pointer": "pointer",
                "draw": "draw",
                "marking": "marking",
                "arrow": "arrow",
                "crop": "crop",
                "text": "text",
                "fit": "fit",
                "zoomIn": "zoom-in",
                "zoomOut": "zoom-out",
                "search": "search",
                "locate": "locate",
                "filter": "filter",
                "menu": "menu",
                "chevronUp": "chevron-up",
                "chevronDown": "chevron-down",
                "chevronLeft": "chevron-left",
                "chevronRight": "chevron-right",
                "arrowUp": "arrow-up",
                "arrowDown": "arrow-down",
                "arrowLeft": "arrow-left",
                "arrowRight": "arrow-right",
                "collapseAll": "collapse-all",
                "expandAll": "expand-all",
                "maximize": "maximize",
                "minimize": "minimize",
                "externalLink": "external-link",
                "home": "home",
                "panelLeft": "panel-left",
                "panelRight": "panel-right",
                "panelBottom": "panel-bottom",
                "minimap": "minimap",
                "tree": "tree",
                "perspective": "perspective",
                "layers": "layers",
                "list": "list",
                "table": "table",
                "checklist": "checklist",
                "diagnostics": "diagnostics",
                "specialization": "specialization",
                "library": "library",
                "container": "container",
                "containerMark": "container-mark",
                "arrange": "arrange",
                "more": "grip",
                "moreVertical": "grip",
                "grip": "grip",
                "addImage": "add-image",
                "image": "image",
                "folder": "folder",
                "file": "file",
                "save": "save",
                "export": "export",
                "upload": "upload",
                "tag": "tag",
                "link": "link",
                "share": "share",
                "eye": "eye",
                "eyeOff": "eye-off",
                "lock": "lock",
                "unlock": "unlock",
                "info": "info",
                "warning": "warning",
                "error": "error",
                "help": "help",
                "settings": "settings",
                "keyboard": "keyboard",
                "sun": "sun",
                "moon": "moon",
                "proposal": "proposal",
                "chat": "chat",
                "chatAdd": "chat-add",
                "moved": "moved",
                "changed": "changed",
                "replaced": "replaced",
                "compare": "compare",
                "note": "note",
                "blocked": "blocked",
                "globe": "globe"
              }
            },
            "color": {
              "$if": {
                "$eq": [
                  "selecionada",
                  "sim"
                ]
              },
              "then": {
                "$token": "color-text"
              },
              "else": {
                "$token": "color-text-muted"
              }
            }
          },
          {
            "type": "text",
            "name": "rótulo",
            "text": {
              "$field": "rotulo",
              "default": "Aba"
            },
            "color": {
              "$if": {
                "$eq": [
                  "selecionada",
                  "sim"
                ]
              },
              "then": {
                "$token": "color-text"
              },
              "else": {
                "$token": "color-text-muted"
              }
            },
            "font": {
              "size": {
                "$if": {
                  "$eq": [
                    "tamanho",
                    "sm"
                  ]
                },
                "then": 12,
                "else": 13
              },
              "weight": {
                "$if": {
                  "$eq": [
                    "selecionada",
                    "sim"
                  ]
                },
                "then": 600,
                "else": 400
              },
              "lineHeight": {
                "$if": {
                  "$eq": [
                    "tamanho",
                    "sm"
                  ]
                },
                "then": 16,
                "else": 20
              }
            },
            "visible": {
              "$not": {
                "$has": "icone"
              }
            }
          },
          {
            "type": "frame",
            "name": "selo",
            "width": "hug",
            "height": 16,
            "cornerRadius": 999,
            "fill": {
              "$token": "color-selection-muted"
            },
            "visible": {
              "$has": "selo"
            },
            "layout": {
              "type": "row",
              "padding": [
                0,
                6
              ],
              "align": "center"
            },
            "children": [
              {
                "type": "text",
                "name": "contador",
                "text": {
                  "$field": "selo"
                },
                "color": {
                  "$token": "color-text-muted"
                },
                "font": {
                  "size": 12,
                  "weight": 400,
                  "lineHeight": 16
                }
              }
            ]
          }
        ]
      },
      {
        "type": "rect",
        "name": "sublinhado",
        "height": 2,
        "anchors": {
          "left": 0,
          "right": 0,
          "bottom": 0
        },
        "fill": {
          "$token": "color-accent"
        },
        "visible": {
          "$eq": [
            "selecionada",
            "sim"
          ]
        }
      }
    ]
  }
}
