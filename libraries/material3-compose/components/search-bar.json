{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "search-bar",
  "name": "Search bar",
  "description": "Barra de busca de 56 com forma full: ícone inicial, consulta ou dica e ícone final. Expandida, o container cresce e ganha o divisor dos resultados (bar ocupa a tela, docked abre embaixo do campo).",
  "size": {
    "width": 360,
    "height": 56
  },
  "minSize": {
    "width": 360,
    "height": 56
  },
  "sizing": {
    "width": "fill",
    "height": 56
  },
  "preview": {
    "query": "",
    "placeholder": "Pesquisar",
    "leadingIcon": "Search",
    "trailingIcon": "",
    "expanded": "false",
    "style": "bar"
  },
  "template": {
    "type": "frame",
    "name": "search bar",
    "clip": false,
    "layout": {
      "type": "none"
    },
    "cornerRadius": {
      "$if": {
        "$and": [
          {
            "$eq": ["expanded", "true"]
          },
          {
            "$eq": ["style", "bar"]
          }
        ]
      },
      "then": {
        "$token": "corner-none"
      },
      "else": {
        "$if": {
          "$eq": ["style", "bar"]
        },
        "then": {
          "$token": "corner-full"
        },
        "else": {
          "$token": "corner-extra-large"
        }
      }
    },
    "fill": {
      "$token": "surface-container-high"
    },
    "children": [
      {
        "type": "rect",
        "name": "estado",
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0
        },
        "height": 56,
        "cornerRadius": {
          "$if": {
            "$and": [
              {
                "$eq": ["expanded", "true"]
              },
              {
                "$eq": ["style", "bar"]
              }
            ]
          },
          "then": {
            "$token": "corner-none"
          },
          "else": {
            "$if": {
              "$eq": ["style", "bar"]
            },
            "then": {
              "$token": "corner-full"
            },
            "else": {
              "$token": "corner-extra-large"
            }
          }
        },
        "fill": {
          "$token": "on-surface"
        },
        "opacity": {
          "$switch": "interaction",
          "cases": {
            "hovered": {
              "$token": "state-hover"
            },
            "focused": {
              "$token": "state-focus"
            },
            "pressed": {
              "$token": "state-pressed"
            }
          },
          "default": 0
        },
        "visible": {
          "$not": {
            "$eq": ["interaction", "none"]
          }
        }
      },
      {
        "type": "rect",
        "name": "anel de foco",
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0
        },
        "height": 56,
        "cornerRadius": {
          "$if": {
            "$and": [
              {
                "$eq": ["expanded", "true"]
              },
              {
                "$eq": ["style", "bar"]
              }
            ]
          },
          "then": {
            "$token": "corner-none"
          },
          "else": {
            "$if": {
              "$eq": ["style", "bar"]
            },
            "then": {
              "$token": "corner-full"
            },
            "else": {
              "$token": "corner-extra-large"
            }
          }
        },
        "fill": "none",
        "stroke": {
          "color": {
            "$token": "secondary"
          },
          "width": 3,
          "align": "outside",
          "offset": 2
        },
        "visible": {
          "$eq": ["interaction", "focused"]
        }
      },
      {
        "type": "frame",
        "name": "campo de entrada",
        "clip": false,
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0
        },
        "height": "hug",
        "layout": {
          "type": "column",
          "padding": {
            "$if": {
              "$and": [
                {
                  "$eq": ["expanded", "true"]
                },
                {
                  "$eq": ["style", "bar"]
                }
              ]
            },
            "then": [8, 0, 0, 0],
            "else": 0
          }
        },
        "children": [
          {
            "type": "frame",
            "name": "linha",
            "clip": false,
            "width": "fill",
            "height": "hug",
            "minHeight": 56,
            "layout": {
              "type": "row",
              "gap": 12,
              "padding": [0, 16],
              "align": "center"
            },
            "children": [
              {
                "type": "icon",
                "name": {
                  "$switch": "leadingIcon",
                  "cases": {
                    "Home": "home",
                    "Search": "search",
                    "Person": "person",
                    "Menu": "menu",
                    "MoreVert": "more_vert",
                    "Add": "add",
                    "Check": "check",
                    "Close": "close",
                    "ArrowBack": "arrow_back",
                    "Favorite": "favorite",
