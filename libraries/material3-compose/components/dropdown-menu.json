                          "RadioButtonUnchecked": "radio_button_unchecked",
                          "ToggleOn": "toggle_on",
                          "ToggleOff": "toggle_off",
                          "StarBorder": "star_border",
                          "StarHalf": "star_half",
                          "Lightbulb": "lightbulb",
                          "Code": "code",
                          "Terminal": "terminal",
                          "Bolt": "bolt",
                          "EditCalendar": "edit_calendar"
                        },
                        "default": {
                          "$field": "leadingIcon"
                        }
                      },
                      "width": 24,
                      "height": 24,
                      "color": {
                        "$if": {
                          "$eq": ["enabled", "false"]
                        },
                        "then": {
                          "$token": "on-surface"
                        },
                        "else": {
                          "$if": {
                            "$eq": ["selected", "true"]
                          },
                          "then": {
                            "$token": "on-secondary-container"
                          },
                          "else": {
                            "$token": "on-surface-variant"
                          }
                        }
                      },
                      "opacity": {
                        "$if": {
                          "$eq": ["enabled", "false"]
                        },
                        "then": {
                          "$token": "state-disabled-content"
                        },
                        "else": 1
                      },
                      "visible": {
                        "$has": "leadingIcon"
                      },
                      "anchors": {
                        "left": {
                          "$if": {
                            "$eq": ["style", "exposed"]
                          },
                          "then": 16,
                          "else": 12
                        },
                        "centerY": true
                      }
                    },
                    {
                      "type": "text",
                      "name": "texto",
                      "text": {
                        "$field": "text"
                      },
                      "width": "fill",
                      "font": {
                        "size": {
                          "$token": "label-large-size"
                        },
                        "weight": {
                          "$token": "label-large-weight"
                        },
                        "lineHeight": {
                          "$token": "label-large-line-height"
                        },
                        "letterSpacing": {
                          "$token": "label-large-tracking"
                        },
                        "verticalAlign": "cap-middle"
                      },
                      "color": {
                        "$if": {
                          "$eq": ["selected", "true"]
                        },
                        "then": {
                          "$token": "on-secondary-container"
                        },
                        "else": {
                          "$token": "on-surface"
                        }
                      },
                      "opacity": {
                        "$if": {
                          "$eq": ["enabled", "false"]
                        },
                        "then": {
                          "$token": "state-disabled-content"
                        },
                        "else": 1
                      },
                      "anchors": {
                        "left": {
                          "$if": {
                            "$has": "leadingIcon"
                          },
                          "then": {
                            "$if": {
                              "$eq": ["style", "exposed"]
                            },
                            "then": 52,
                            "else": 48
                          },
                          "else": {
                            "$if": {
                              "$eq": ["style", "exposed"]
                            },
                            "then": 16,
                            "else": 12
                          }
                        },
                        "right": {
                          "$if": {
                            "$has": "trailingIcon"
                          },
                          "then": {
                            "$if": {
                              "$eq": ["style", "exposed"]
                            },
                            "then": 52,
                            "else": 48
                          },
                          "else": {
                            "$if": {
                              "$eq": ["style", "exposed"]
                            },
                            "then": 16,
                            "else": 12
                          }
                        },
                        "centerY": true
                      },
                      "height": "hug"
                    },
