{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "switch",
  "name": "Switch",
  "description": "Switch: trilho 52 × 32, alça de 24 (ligado, ou com ícone) ou 16 (desligado) e rótulo opcional ao lado.",
  "size": {
    "width": 200,
    "height": 32
  },
  "sizing": {
    "width": "fill",
    "height": 32
  },
  "preview": {
    "label": "Notificações",
    "checked": "true",
    "enabled": "true",
    "thumbIcon": "false"
  },
  "template": {
    "type": "frame",
    "name": "switch",
    "layout": {
      "type": "row",
      "gap": 16,
      "align": "center"
    },
    "children": [
      {
        "type": "text",
        "name": "rótulo",
        "text": {
          "$field": "label"
        },
        "font": {
          "size": {
            "$token": "body-large-size"
          },
          "weight": {
            "$token": "body-large-weight"
          },
          "lineHeight": {
            "$token": "body-large-line-height"
          },
          "letterSpacing": {
            "$token": "body-large-tracking"
          }
        },
        "color": {
          "$token": "on-surface"
        },
        "opacity": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": {
            "$token": "state-disabled-content"
          },
          "else": 1
        },
        "width": "fill",
        "visible": {
          "$has": "label"
        }
      },
      {
        "type": "frame",
        "name": "chave",
        "width": 52,
        "height": 32,
        "layout": {
          "type": "none"
        },
        "children": [
          {
            "type": "rect",
            "name": "trilho",
            "cornerRadius": {
              "$token": "corner-full"
            },
            "fill": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$if": {
                  "$field": "checked"
                },
                "then": {
                  "$token": "on-surface",
                  "alpha": {
                    "$token": "state-disabled-container"
                  },
                  "over": "surface"
                },
                "else": {
                  "$token": "surface-container-highest",
                  "alpha": {
                    "$token": "state-disabled-container"
                  },
                  "over": "surface"
                }
              },
              "else": {
                "$if": {
                  "$field": "checked"
                },
                "then": {
                  "$token": "primary"
                },
                "else": {
                  "$token": "surface-container-highest"
                }
              }
            }
          },
          {
            "type": "rect",
            "name": "contorno",
            "cornerRadius": {
              "$token": "corner-full"
            },
            "visible": {
              "$not": {
                "$field": "checked"
              }
            },
            "fill": "none",
            "stroke": {
              "color": {
                "$if": {
                  "$eq": ["enabled", "false"]
                },
                "then": {
                  "$token": "on-surface",
                  "alpha": {
                    "$token": "state-disabled-container"
                  },
                  "over": "surface"
                },
                "else": {
                  "$token": "outline"
                }
              },
              "width": 2,
              "align": "inside"
            }
          },
          {
            "type": "rect",
            "name": "anel de foco",
            "cornerRadius": {
              "$token": "corner-full"
            },
            "fill": "none",
            "stroke": {
              "color": {
                "$token": "secondary"
              },
              "width": 3,
              "align": "outside",
              "offset": 2
            },
            "visible": {
              "$and": [
                {
                  "$eq": ["interaction", "focused"]
                },
                {
                  "$not": {
                    "$eq": ["enabled", "false"]
                  }
                }
              ]
            }
          },
          {
            "type": "ellipse",
            "name": "estado",
            "width": 32,
            "height": 32,
            "fill": {
              "$if": {
                "$field": "checked"
              },
              "then": {
                "$token": "primary"
              },
              "else": {
                "$token": "on-surface"
              }
            },
            "opacity": {
              "$switch": "interaction",
              "cases": {
                "hovered": {
                  "$token": "state-hover"
                },
                "focused": {
                  "$token": "state-focus"
                },
                "pressed": {
                  "$token": "state-pressed"
                }
              },
              "default": 0
            },
            "visible": {
              "$and": [
                {
                  "$not": {
                    "$eq": ["enabled", "false"]
                  }
                },
                {
                  "$not": {
                    "$eq": ["interaction", "none"]
                  }
                }
              ]
            },
            "anchors": {
              "left": {
                "$if": {
                  "$field": "checked"
                },
                "then": 20,
                "else": 0
              },
              "top": 0
            }
          },
          {
            "type": "frame",
            "name": "curso",
            "layout": {
              "type": "row",
              "padding": {
                "$if": {
                  "$and": [
                    {
                      "$not": {
                        "$eq": ["enabled", "false"]
                      }
                    },
                    {
                      "$eq": ["interaction", "pressed"]
                    }
                  ]
                },
                "then": [0, 2],
                "else": [0, 4]
              },
              "align": "center",
              "justify": {
                "$if": {
                  "$field": "checked"
                },
                "then": "end",
                "else": "start"
              }
            },
            "children": [
              {
                "type": "frame",
                "name": "área da alça",
                "width": {
                  "$if": {
                    "$and": [
                      {
                        "$not": {
                          "$eq": ["enabled", "false"]
                        }
                      },
                      {
                        "$eq": ["interaction", "pressed"]
                      }
                    ]
                  },
                  "then": 28,
                  "else": 24
                },
                "height": {
                  "$if": {
                    "$and": [
                      {
                        "$not": {
                          "$eq": ["enabled", "false"]
                        }
                      },
                      {
                        "$eq": ["interaction", "pressed"]
                      }
                    ]
                  },
                  "then": 28,
                  "else": 24
                },
                "layout": {
                  "type": "none"
                },
                "children": [
                  {
                    "type": "ellipse",
                    "name": "alça",
                    "width": {
                      "$if": {
                        "$and": [
                          {
                            "$not": {
                              "$eq": ["enabled", "false"]
                            }
                          },
                          {
                            "$eq": ["interaction", "pressed"]
                          }
                        ]
                      },
                      "then": 28,
                      "else": {
                        "$if": {
                          "$or": [
                            {
                              "$field": "checked"
                            },
                            {
                              "$eq": ["thumbIcon", "true"]
                            }
                          ]
                        },
                        "then": 24,
                        "else": 16
                      }
                    },
                    "height": {
                      "$if": {
                        "$and": [
                          {
                            "$not": {
                              "$eq": ["enabled", "false"]
                            }
                          },
                          {
                            "$eq": ["interaction", "pressed"]
                          }
                        ]
                      },
                      "then": 28,
                      "else": {
                        "$if": {
                          "$or": [
                            {
                              "$field": "checked"
                            },
                            {
                              "$eq": ["thumbIcon", "true"]
                            }
                          ]
                        },
                        "then": 24,
                        "else": 16
                      }
                    },
                    "fill": {
                      "$if": {
                        "$eq": ["enabled", "false"]
                      },
                      "then": {
                        "$if": {
                          "$field": "checked"
                        },
                        "then": {
                          "$token": "surface"
                        },
                        "else": {
                          "$token": "on-surface",
                          "alpha": {
                            "$token": "state-disabled-content"
                          },
                          "over": "surface"
                        }
                      },
                      "else": {
                        "$if": {
                          "$field": "checked"
                        },
                        "then": {
                          "$if": {
                            "$or": [
                              {
                                "$eq": ["interaction", "hovered"]
                              },
                              {
                                "$eq": ["interaction", "focused"]
                              },
                              {
                                "$eq": ["interaction", "pressed"]
                              }
                            ]
                          },
                          "then": {
                            "$token": "primary-container"
                          },
                          "else": {
                            "$token": "on-primary"
                          }
                        },
                        "else": {
                          "$if": {
                            "$or": [
                              {
                                "$eq": ["interaction", "hovered"]
                              },
                              {
                                "$eq": ["interaction", "focused"]
                              },
                              {
                                "$eq": ["interaction", "pressed"]
                              }
                            ]
                          },
                          "then": {
                            "$token": "on-surface-variant"
                          },
                          "else": {
                            "$token": "outline"
                          }
                        }
                      }
                    },
                    "anchors": {
                      "centerX": true,
                      "centerY": true
                    }
                  },
                  {
                    "type": "icon",
                    "name": "check",
                    "width": 16,
                    "height": 16,
                    "color": {
                      "$if": {
                        "$eq": ["enabled", "false"]
                      },
                      "then": {
                        "$token": "on-surface"
                      },
                      "else": {
                        "$token": "on-primary-container"
                      }
                    },
                    "opacity": {
                      "$if": {
                        "$eq": ["enabled", "false"]
                      },
                      "then": {
                        "$token": "state-disabled-content"
                      },
                      "else": 1
                    },
                    "visible": {
                      "$and": [
                        {
                          "$eq": ["thumbIcon", "true"]
                        },
                        {
                          "$field": "checked"
                        }
                      ]
                    },
                    "anchors": {
                      "centerX": true,
                      "centerY": true
                    }
                  },
                  {
                    "type": "icon",
                    "name": "close",
                    "width": 16,
                    "height": 16,
                    "color": {
                      "$if": {
                        "$eq": ["enabled", "false"]
                      },
                      "then": {
                        "$token": "surface"
                      },
                      "else": {
                        "$token": "surface-container-highest"
                      }
                    },
                    "opacity": 1,
                    "visible": {
                      "$and": [
                        {
                          "$eq": ["thumbIcon", "true"]
                        },
                        {
                          "$not": {
                            "$field": "checked"
                          }
                        }
                      ]
                    },
                    "anchors": {
                      "centerX": true,
                      "centerY": true
                    }
                  },
                  {
                    "type": "icon",
                    "name": "close",
                    "width": 16,
                    "height": 16,
                    "color": {
                      "$token": "surface-container-highest"
                    },
                    "opacity": {
                      "$token": "state-disabled-content"
                    },
                    "visible": {
                      "$and": [
                        {
                          "$eq": ["thumbIcon", "true"]
                        },
                        {
                          "$not": {
                            "$field": "checked"
                          }
                        },
                        {
                          "$eq": ["enabled", "false"]
                        }
                      ]
                    },
                    "anchors": {
                      "centerX": true,
                      "centerY": true
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
