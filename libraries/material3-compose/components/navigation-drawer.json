{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "navigation-drawer",
  "name": "Navigation drawer",
  "description": "Folha de navegação de 360 de largura com cabeçalho opcional e um destino por linha de Itens (item de 56 com forma full, ícone, rótulo e selo). A modal usa surface container low e cantos finais de 16; a dismissible e a permanent usam surface sem cantos. O scrim é do composable.",
  "size": {
    "width": 360,
    "height": 400
  },
  "sizing": {
    "width": "fill",
    "height": 400
  },
  "preview": {
    "headline": "Mapping",
    "style": "modal",
    "items": [
      {
        "label": "Caixa de entrada",
        "icon": "Email",
        "selected": "true",
        "badge": "24"
      },
      {
        "label": "Favoritos",
        "icon": "Favorite",
        "selected": "false"
      },
      {
        "label": "Configurações",
        "icon": "Settings",
        "selected": "false"
      }
    ]
  },
  "template": {
    "type": "frame",
    "name": "navigation drawer",
    "fill": {
      "$if": {
        "$eq": ["style", "modal"]
      },
      "then": {
        "$token": "surface-container-low"
      },
      "else": {
        "$token": "surface"
      }
    },
    "cornerRadius": {
      "$if": {
        "$eq": ["style", "modal"]
      },
      "then": [0, 16, 16, 0],
      "else": 0
    },
    "layout": {
      "type": "column",
      "padding": [12, 12]
    },
    "children": [
      {
        "type": "frame",
        "name": "cabeçalho",
        "width": "fill",
        "height": 56,
        "visible": {
          "$has": "headline"
        },
        "layout": {
          "type": "row",
          "padding": [0, 16],
          "align": "center"
        },
        "children": [
          {
            "type": "text",
            "name": "título",
            "text": {
              "$field": "headline"
            },
            "font": {
              "size": {
                "$token": "title-small-size"
              },
              "weight": {
                "$token": "title-small-weight"
              },
              "lineHeight": {
                "$token": "title-small-line-height"
              },
              "letterSpacing": {
                "$token": "title-small-tracking"
              }
            },
            "color": {
              "$token": "on-surface-variant"
            },
            "width": "fill"
          }
        ]
      },
      {
        "type": "repeat",
        "name": "destinos",
        "field": "items",
        "direction": "column",
        "width": "fill",
        "template": {
          "type": "frame",
          "name": "item",
          "width": "fill",
          "height": "hug",
          "layout": {
            "type": "none"
          },
          "children": [
            {
              "type": "frame",
              "name": "destino",
              "width": "fill",
              "height": "hug",
              "minHeight": 56,
              "cornerRadius": {
                "$token": "corner-full"
              },
              "fill": {
                "$if": {
                  "$field": "selected"
                },
                "then": {
                  "$token": "secondary-container"
                },
                "else": "none"
              },
              "layout": {
                "type": "row",
                "gap": 12,
                "padding": [0, 24, 0, 16],
                "align": "center"
              },
              "children": [
                {
                  "type": "icon",
                  "name": {
                    "$switch": "icon",
                    "cases": {
                      "Home": "home",
                      "Search": "search",
                      "Person": "person",
                      "Menu": "menu",
                      "MoreVert": "more_vert",
                      "Add": "add",
                      "Check": "check",
                      "Close": "close",
                      "ArrowBack": "arrow_back",
                      "Favorite": "favorite",
                      "Edit": "edit",
                      "Delete": "delete",
                      "Share": "share",
                      "Notifications": "notifications",
                      "Settings": "settings",
                      "Info": "info",
                      "Star": "star",
                      "Email": "email",
                      "Phone": "phone",
                      "Place": "place",
                      "DateRange": "date_range",
                      "ShoppingCart": "shopping_cart",
                      "AccountCircle": "account_circle",
                      "KeyboardArrowRight": "keyboard_arrow_right",
                      "KeyboardArrowDown": "keyboard_arrow_down",
                      "Refresh": "refresh",
                      "Clear": "clear",
                      "Done": "done",
                      "Lock": "lock",
                      "List": "list",
                      "AccountBox": "account_box",
                      "AddCircle": "add_circle",
                      "ArrowDropDown": "arrow_drop_down",
                      "ArrowDropUp": "arrow_drop_up",
                      "ArrowForward": "arrow_forward",
                      "ArrowUpward": "arrow_upward",
                      "ArrowDownward": "arrow_downward",
                      "Build": "build",
                      "Call": "call",
                      "CheckCircle": "check_circle",
                      "Create": "create",
                      "Face": "face",
                      "FavoriteBorder": "favorite_border",
                      "ExitToApp": "exit_to_app",
                      "KeyboardArrowLeft": "keyboard_arrow_left",
                      "KeyboardArrowUp": "keyboard_arrow_up",
                      "LocationOn": "location_on",
                      "MailOutline": "mail_outline",
                      "PlayArrow": "play_arrow",
                      "Send": "send",
                      "ThumbUp": "thumb_up",
                      "Warning": "warning",
                      "Cancel": "cancel",
                      "ExpandMore": "expand_more",
                      "ExpandLess": "expand_less",
                      "ChevronLeft": "chevron_left",
                      "ChevronRight": "chevron_right",
                      "FirstPage": "first_page",
                      "LastPage": "last_page",
                      "MoreHoriz": "more_horiz",
                      "Apps": "apps",
                      "Dashboard": "dashboard",
                      "Folder": "folder",
                      "FolderOpen": "folder_open",
                      "InsertDriveFile": "insert_drive_file",
                      "Description": "description",
                      "Image": "image",
                      "Mic": "mic",
                      "Videocam": "videocam",
                      "Chat": "chat",
                      "Comment": "comment",
                      "Forum": "forum",
                      "NotificationsNone": "notifications_none",
                      "Visibility": "visibility",
                      "VisibilityOff": "visibility_off",
                      "Language": "language",
                      "Public": "public",
                      "Link": "link",
                      "Attachment": "attachment",
                      "ContentCopy": "content_copy",
                      "ContentPaste": "content_paste",
                      "ContentCut": "content_cut",
                      "Save": "save",
                      "Download": "download",
                      "Upload": "upload",
                      "CloudUpload": "cloud_upload",
                      "CloudDownload": "cloud_download",
                      "Cloud": "cloud",
                      "Sync": "sync",
                      "Schedule": "schedule",
                      "AccessTime": "access_time",
                      "CalendarToday": "calendar_today",
                      "Event": "event",
                      "Today": "today",
                      "Timer": "timer",
                      "Alarm": "alarm",
                      "History": "history",
                      "Bookmark": "bookmark",
                      "BookmarkBorder": "bookmark_border",
                      "Label": "label",
                      "Flag": "flag",
                      "Help": "help",
                      "HelpOutline": "help_outline",
                      "Error": "error",
                      "ErrorOutline": "error_outline",
                      "Report": "report",
                      "Block": "block",
                      "Tune": "tune",
                      "FilterList": "filter_list",
                      "Sort": "sort",
                      "Fullscreen": "fullscreen",
                      "Wifi": "wifi",
                      "Bluetooth": "bluetooth",
                      "LightMode": "light_mode",
                      "DarkMode": "dark_mode",
                      "Palette": "palette",
                      "ShoppingBag": "shopping_bag",
                      "Store": "store",
                      "Payment": "payment",
                      "CreditCard": "credit_card",
                      "AttachMoney": "attach_money",
                      "Receipt": "receipt",
                      "Map": "map",
                      "Navigation": "navigation",
                      "DirectionsCar": "directions_car",
                      "Flight": "flight",
                      "MenuOpen": "menu_open",
                      "Logout": "logout",
                      "Login": "login",
                      "People": "people",
                      "Group": "group",
                      "PersonAdd": "person_add",
                      "LockOpen": "lock_open",
                      "Security": "security",
                      "VerifiedUser": "verified_user",
                      "Key": "key",
                      "Pause": "pause",
                      "Stop": "stop",
                      "SkipNext": "skip_next",
                      "SkipPrevious": "skip_previous",
                      "VolumeUp": "volume_up",
                      "VolumeOff": "volume_off",
                      "ThumbDown": "thumb_down",
                      "Reply": "reply",
                      "Inbox": "inbox",
                      "Archive": "archive",
                      "Undo": "undo",
                      "Redo": "redo",
                      "ZoomIn": "zoom_in",
                      "ZoomOut": "zoom_out",
                      "Keyboard": "keyboard",
                      "CheckBox": "check_box",
                      "CheckBoxOutlineBlank": "check_box_outline_blank",
                      "RadioButtonChecked": "radio_button_checked",
                      "RadioButtonUnchecked": "radio_button_unchecked",
                      "ToggleOn": "toggle_on",
                      "ToggleOff": "toggle_off",
                      "StarBorder": "star_border",
                      "StarHalf": "star_half",
                      "Lightbulb": "lightbulb",
                      "Code": "code",
                      "Terminal": "terminal",
                      "Bolt": "bolt",
                      "EditCalendar": "edit_calendar"
                    },
                    "default": {
                      "$field": "icon"
                    }
                  },
                  "color": {
                    "$if": {
                      "$field": "selected"
                    },
                    "then": {
                      "$token": "on-secondary-container"
                    },
                    "else": {
                      "$token": "on-surface-variant"
                    }
                  },
                  "width": 24,
                  "height": 24,
                  "visible": {
                    "$has": "icon"
                  }
                },
                {
                  "type": "text",
                  "name": "rótulo",
                  "text": {
                    "$field": "label"
                  },
                  "font": {
                    "size": {
                      "$token": "label-large-size"
                    },
                    "weight": {
                      "$token": "label-large-weight"
                    },
                    "lineHeight": {
                      "$token": "label-large-line-height"
                    },
                    "letterSpacing": {
                      "$token": "label-large-tracking"
                    }
                  },
                  "color": {
                    "$if": {
                      "$field": "selected"
                    },
                    "then": {
                      "$token": "on-secondary-container"
                    },
                    "else": {
                      "$token": "on-surface-variant"
                    }
                  },
                  "visible": {
                    "$has": "label"
                  },
                  "width": "fill"
                },
                {
                  "type": "text",
                  "name": "selo",
                  "text": {
                    "$field": "badge"
                  },
                  "font": {
                    "size": {
                      "$token": "label-large-size"
                    },
                    "weight": {
                      "$token": "label-large-weight"
                    },
                    "lineHeight": {
                      "$token": "label-large-line-height"
                    },
                    "letterSpacing": {
                      "$token": "label-large-tracking"
                    }
                  },
                  "color": {
                    "$if": {
                      "$field": "selected"
                    },
                    "then": {
                      "$token": "on-secondary-container"
                    },
                    "else": {
                      "$token": "on-surface-variant"
                    }
                  },
                  "visible": {
                    "$has": "badge"
                  }
                }
              ]
            },
            {
              "type": "rect",
              "name": "estado",
              "anchors": {
                "left": 0,
                "right": 0,
                "top": 0,
                "bottom": 0
              },
              "cornerRadius": {
                "$token": "corner-full"
              },
              "fill": {
                "$token": "on-secondary-container"
              },
              "opacity": {
                "$switch": "interaction",
                "cases": {
                  "hovered": {
                    "$token": "state-hover"
                  },
                  "focused": {
                    "$token": "state-focus"
                  },
                  "pressed": {
                    "$token": "state-pressed"
                  }
                },
                "default": 0
              },
              "visible": {
                "$and": [
                  {
                    "$field": "selected"
                  },
                  {
                    "$not": {
                      "$eq": ["interaction", "none"]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
