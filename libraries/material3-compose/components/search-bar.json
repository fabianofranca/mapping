      {
        "type": "rect",
        "name": "divisor",
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 56
        },
        "height": 1,
        "fill": {
          "$token": "outline"
        },
        "visible": {
          "$and": [
            {
              "$eq": ["expanded", "true"]
            },
            {
              "$not": {
                "$eq": ["style", "bar"]
              }
            }
          ]
        }
      },
      {
        "type": "rect",
        "name": "divisor (bar)",
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 72
        },
        "height": 1,
        "fill": {
          "$token": "outline"
        },
        "visible": {
          "$and": [
            {
              "$eq": ["expanded", "true"]
            },
            {
              "$eq": ["style", "bar"]
            }
          ]
        }
      }
