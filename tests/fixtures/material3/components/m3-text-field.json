{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "m3-text-field",
  "name": "Text field",
  "description": "Outlined text field: caixa de 56 dp, forma extra-small (4), rótulo flutuante e texto de apoio.",
  "size": {
    "width": 280,
    "height": 80
  },
  "minSize": {
    "width": 120,
    "height": 56
  },
  "sizing": {
    "width": "fill",
    "height": 56
  },
  "preview": {
    "label": "Label",
    "value": "Input text",
    "placeholder": "",
    "supporting": "Supporting text",
    "state": "enabled",
    "trailing": ""
  },
  "template": {
    "type": "frame",
    "name": "text field",
    "clip": false,
    "layout": {
      "type": "column",
      "gap": 4
    },
    "children": [
      {
        "type": "frame",
        "name": "contêiner",
        "width": "fill",
        "height": 56,
        "clip": false,
        "layout": {
          "type": "none"
        },
        "children": [
          {
            "type": "rect",
            "name": "outline",
            "anchors": {
              "left": 0,
              "right": 0,
              "top": 8,
              "bottom": 0
            },
            "cornerRadius": 4,
            "fill": "rgba(0, 0, 0, 0)",
            "stroke": {
              "color": {
                "$switch": "state",
                "cases": {
                  "focused": "#6750A4",
                  "error": "#B3261E",
                  "disabled": "rgba(29, 27, 32, 0.12)"
                },
                "default": "#79747E"
              },
              "width": {
                "$if": {
                  "$eq": ["state", "focused"]
                },
                "then": 2,
                "else": 1
              },
              "align": "inside"
            }
          },
          {
            "type": "frame",
            "name": "rótulo",
            "anchors": {
              "left": 12,
              "top": 0
            },
            "width": "hug",
            "height": "hug",
            "layout": {
              "type": "row",
              "padding": [0, 4]
            },
            "fill": "#FEF7FF",
            "visible": {
              "$has": "label"
            },
            "children": [
              {
                "type": "text",
                "name": "rótulo",
                "text": {
                  "$field": "label"
                },
                "font": {
                  "family": "Roboto",
                  "size": 12,
                  "weight": 400,
                  "lineHeight": 16
                },
                "color": {
                  "$switch": "state",
                  "cases": {
                    "focused": "#6750A4",
                    "error": "#B3261E",
                    "disabled": "rgba(29, 27, 32, 0.38)"
                  },
                  "default": "#49454F"
                }
              }
            ]
          },
          {
            "type": "frame",
            "name": "conteúdo",
            "anchors": {
              "left": 16,
              "right": 12,
              "top": 8,
              "bottom": 0
            },
            "layout": {
              "type": "row",
              "gap": 12,
              "align": "center"
            },
            "children": [
              {
                "type": "text",
                "name": "texto",
                "text": {
                  "$if": {
                    "$has": "value"
                  },
                  "then": {
                    "$field": "value"
                  },
                  "else": {
                    "$field": "placeholder",
                    "default": ""
                  }
                },
                "font": {
                  "family": "Roboto",
                  "size": 16,
                  "weight": 400,
                  "lineHeight": 24
                },
                "color": {
                  "$if": {
                    "$eq": ["state", "disabled"]
                  },
                  "then": "rgba(29, 27, 32, 0.38)",
                  "else": {
                    "$if": {
                      "$has": "value"
                    },
                    "then": "#1D1B20",
                    "else": "#49454F"
                  }
                },
                "width": "fill"
              },
              {
                "type": "path",
                "name": "ícone",
                "width": 24,
                "height": 24,
                "viewBox": [24, 24],
                "d": {
                  "$switch": "trailing",
                  "cases": {
                    "home": "M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z",
                    "search": "M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z",
                    "person": "M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z",
                    "menu": "M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z",
                    "more": "M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z",
                    "add": "M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z",
                    "check": "M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z",
                    "back": "M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z",
                    "favorite": "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z",
                    "edit": "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z",
                    "notifications": "M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z",
                    "chevron": "M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z",
                    "settings": "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                  },
                  "default": "M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                },
                "fill": "#49454F",
                "visible": {
                  "$has": "trailing"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "name": "apoio",
        "text": {
          "$field": "supporting"
        },
        "font": {
          "family": "Roboto",
          "size": 12,
          "weight": 400,
          "lineHeight": 16
        },
        "color": {
          "$if": {
            "$eq": ["state", "error"]
          },
          "then": "#B3261E",
          "else": "#49454F"
        },
        "visible": {
          "$has": "supporting"
        },
        "width": "fill"
      }
    ]
  }
}
