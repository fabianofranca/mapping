{
  "format": "mapping-spec",
  "formatVersion": 21,
  "id": "sdui-backend",
  "name": "Backend SDUI",
  "version": 4,
  "description": "Example of the executable origin: a fictional external system (an SDUI backend) describes screens in JSON and the origins declaration translates them into components. It shows sources, slot, anchors, scrim, examples of the external system and the version contract.",
  "containers": [
    {
      "id": "phone",
      "name": "Phone",
      "width": 412,
      "height": 917,
      "background": "#FEF7FF",
      "classes": {
        "platform": "android"
      }
    },
    {
      "id": "web-desktop",
      "name": "Web desktop",
      "width": 1440,
      "height": 900,
      "classes": {
        "platform": "web"
      }
    }
  ],
  "containerClasses": [
    {
      "id": "platform",
      "name": "Platform",
      "classes": [
        {
          "id": "android",
          "name": "Android"
        },
        {
          "id": "ios",
          "name": "iOS"
        },
        {
          "id": "web",
          "name": "Web"
        }
      ]
    },
    {
      "id": "window",
      "name": "Window",
      "by": "width",
      "classes": [
        {
          "id": "compact",
          "name": "Compact",
          "below": 600
        },
        {
          "id": "medium",
          "name": "Medium",
          "below": 840
        },
        {
          "id": "expanded",
          "name": "Expanded"
        }
      ]
    }
  ],
  "fileFormats": [
    {
      "id": "sdui",
      "name": "SDUI screen",
      "extension": "json",
      "plugin": "plugins/sdui.js",
      "contract": 1,
      "scope": "container",
      "description": "The JSON screen of the SDUI backend: a container is one screen, its components are the nodes, and the JSON creates the screen back (the modal and its scrim are left out).",
      "examples": [
        {
          "name": "Home",
          "file": "examples/home.sdui.json"
        }
      ]
    }
  ],
  "origins": [
    {
      "system": "sdui",
      "name": "Backend SDUI",
      "node": {
        "type": "type",
        "props": "props",
        "children": "children"
      },
      "screen": {
        "id": {
          "path": "screen.id"
        },
        "name": {
          "path": "screen.title",
          "default": "Screen"
        },
        "width": {
          "path": "screen.device.width"
        },
        "height": {
          "path": "screen.device.height"
        },
        "background": {
          "path": "screen.background",
          "values": {
            "surface": "#FEF7FF"
          },
          "default": "#FFFFFF"
        },
        "roots": [
          {
            "path": "content"
          },
          {
            "path": "floating[*]",
            "anchor": {
              "path": "anchor"
            },
            "margin": {
              "path": "margin"
            }
          },
          {
            "path": "modal",
            "anchor": "bottom",
            "scrim": "sdui-scrim"
          }
        ]
      },
      "booleans": {
        "true": "yes",
        "false": "no"
      },
      "examples": [
        {
          "name": "Settings",
          "file": "examples/settings.sdui.json"
        }
      ]
    }
  ],
  "migrations": [
    {
      "from": 1,
      "to": 2,
      "steps": [
        {
          "op": "rename-type",
          "from": "sdui-action",
          "to": "sdui-endpoint"
        },
        {
          "op": "rename-field",
          "type": "sdui-button",
          "from": "text",
          "to": "label"
        },
        {
          "op": "map-values",
          "type": "sdui-button",
          "field": "variant",
          "values": {
            "primary": "filled"
          }
        },
        {
          "op": "fill-field",
          "type": "sdui-fab",
          "field": "color",
          "default": "primary"
        },
        {
          "op": "remove-field",
          "type": "sdui-sheet",
          "field": "legacy"
        },
        {
          "op": "remove-type",
          "type": "sdui-badge",
          "mode": "convert"
        },
        {
          "op": "remove-type",
          "type": "sdui-toast",
          "mode": "delete"
        }
      ]
    },
    {
      "from": 2,
      "to": 3,
      "steps": [
        {
          "op": "map-values",
          "type": "sdui-button",
          "field": "disabled",
          "values": {
            "sim": "yes",
            "não": "no"
          }
        }
      ]
    }
  ],
  "layers": [
    {
      "id": "ui",
      "name": "Interface",
      "color": "#6750A4",
      "annotationTypes": [
        {
          "id": "sdui-column",
          "name": "Column",
          "component": "components/sdui-column.json",
          "doc": "docs/sdui-column.md",
          "sources": [
            {
              "system": "sdui",
              "name": "Column",
              "slot": "content"
            }
          ],
          "fields": [
            {
              "key": "spacing",
              "label": "Spacing",
              "type": "number",
              "default": 8,
              "sources": [
                {
                  "system": "sdui",
                  "path": "spacing"
                }
              ]
            },
            {
              "key": "padding",
              "label": "Padding",
              "type": "number",
              "sources": [
                {
                  "system": "sdui",
                  "path": "padding"
                }
              ]
            }
          ],
          "examples": [
            {
              "name": "Default",
              "values": {
                "spacing": 8,
                "padding": 0
              }
            },
            {
              "name": "Spaced",
              "values": {
                "spacing": 16,
                "padding": 16
              }
            }
          ]
        },
        {
          "id": "sdui-button",
          "name": "Button",
          "labelField": "label",
          "component": "components/sdui-button.json",
          "accessibility": {
            "role": "button",
            "label": { "fields": ["label"] },
            "variants": {
              "field": "mode",
              "cases": {
                "link": {
                  "role": "link",
                  "label": { "fields": ["label"], "required": true }
                }
              }
            }
          },
          "doc": "docs/sdui-button.md",
          "sources": [
            {
              "system": "sdui",
              "name": "Button",
              "ignore": ["contentDescription"]
            },
            {
              "system": "figma",
              "id": "3f2a9c",
              "name": "DS/Button"
            }
          ],
          "fields": [
            {
              "key": "label",
              "label": "Label",
              "type": "string",
              "required": true,
              "sources": [
                {
                  "system": "sdui",
                  "path": "text"
                }
              ]
            },
            {
              "key": "variant",
              "label": "Variant",
              "type": "enum",
              "options": ["filled", "tonal", "outlined", "text"],
              "default": "filled",
              "sources": [
                {
                  "system": "sdui",
                  "path": "style"
                },
                {
                  "system": "figma",
                  "name": "Style",
                  "values": {
                    "Primary": "filled",
                    "Secondary": "tonal",
                    "Ghost": "text"
                  }
                }
              ]
            },
            {
              "key": "mode",
              "label": "Mode",
              "type": "enum",
              "options": ["normal", "link", "deprecated"],
              "default": "normal",
              "sources": [
                {
                  "system": "sdui",
                  "path": "mode"
                }
              ]
            },
            {
              "key": "disabled",
              "label": "Disabled",
              "type": "enum",
              "options": ["yes", "no"],
              "default": "no",
              "sources": [
                {
                  "system": "sdui",
                  "path": "disabled"
                }
              ]
            }
          ],
          "examples": [
            {
              "name": "Default",
              "values": {
                "label": "Label",
                "variant": "filled",
                "mode": "normal",
                "disabled": "no"
              }
            },
            {
              "name": "Link",
              "values": {
                "label": "Label",
                "variant": "text",
                "mode": "link",
                "disabled": "no"
              }
            },
            {
              "name": "From the external system",
              "system": "sdui",
              "file": "examples/button.sdui.json"
            }
          ]
        },
        {
          "id": "sdui-fab",
          "name": "FAB",
          "component": "components/sdui-fab.json",
          "doc": "docs/sdui-fab.md",
          "sources": [
            {
              "system": "sdui",
              "name": "FAB"
            }
          ],
          "fields": [
            {
              "key": "icon",
              "label": "Icon",
              "type": "enum",
              "options": ["add", "ring"],
              "default": "add",
              "sources": [
                {
                  "system": "sdui",
                  "path": "icon"
                }
              ]
            },
            {
              "key": "color",
              "label": "Color",
              "type": "enum",
              "options": ["primary", "secondary"],
              "required": true,
              "default": "primary",
              "sources": [
                {
                  "system": "sdui",
                  "path": "color"
                }
              ]
            }
          ],
          "examples": [
            {
              "name": "Plus",
              "values": {
                "icon": "add",
                "color": "primary"
              }
            },
            {
              "name": "Ring",
              "values": {
                "icon": "ring",
                "color": "secondary"
              }
            }
          ],
          "appliesIn": {
            "window": ["compact", "medium"]
          }
        },
        {
          "id": "sdui-sheet",
          "name": "Bottom sheet",
          "labelField": "title",
          "component": "components/sdui-sheet.json",
          "doc": "docs/sdui-sheet.md",
          "sources": [
            {
              "system": "sdui",
              "name": "BottomSheet"
            }
          ],
          "fields": [
            {
              "key": "title",
              "label": "Title",
              "type": "string",
              "required": true,
              "sources": [
                {
                  "system": "sdui",
                  "path": "title"
                }
              ]
            },
            {
              "key": "subtitle",
              "label": "Subtitle",
              "type": "string",
              "sources": [
                {
                  "system": "sdui",
                  "path": "subtitle"
                }
              ]
            },
            {
              "key": "footer",
              "label": "Footer",
              "type": "string",
              "sources": [
                {
                  "system": "sdui",
                  "path": "footer"
                }
              ]
            }
          ],
          "examples": [
            {
              "name": "Sort",
              "values": {
                "title": "Sort by",
                "subtitle": "Choose the list order",
                "footer": "Cancel"
              }
            }
          ],
          "appliesIn": {
            "platform": ["android", "ios"]
          }
        },
        {
          "id": "sdui-scrim",
          "name": "Scrim",
          "component": "components/sdui-scrim.json",
          "doc": "docs/sdui-scrim.md",
          "fields": [],
          "examples": [
            {
              "name": "Default",
              "values": {}
            }
          ]
        }
      ]
    },
    {
      "id": "api",
      "name": "API",
      "color": "#006A6A",
      "annotationTypes": [
        {
          "id": "sdui-endpoint",
          "name": "Endpoint",
          "description": "The endpoint that delivers a screen or a block. It applies only to markings (not to arrows): it describes what the area shows.",
          "labelField": "url",
          "appliesTo": ["marking"],
          "doc": "docs/sdui-endpoint.md",
          "fields": [
            {
              "key": "url",
              "label": "URL",
              "type": "string",
              "required": true,
              "description": "The endpoint path (/v1/screens/settings)."
            },
            {
              "key": "typeName",
              "label": "Response type",
              "type": "string",
              "linkedRef": "typeRef",
              "description": "The name of the response type; choosing a mapped declaration saves the text and the link together."
            },
            {
              "key": "typeRef",
              "label": "Declaration",
              "type": "ref",
              "accepts": {
                "free": true
              }
            },
            {
              "key": "params",
              "label": "Parameters",
              "type": "table",
              "columns": [
                {
                  "key": "name",
                  "label": "Name",
                  "type": "string",
                  "required": true
                },
                {
                  "key": "kind",
                  "label": "Where",
                  "type": "enum",
                  "options": ["query", "header", "body"],
                  "default": "query",
                  "sources": [
                    {
                      "system": "sdui",
                      "name": "kind",
                      "path": "params.kind",
                      "values": {
                        "q": "query",
                        "h": "header"
                      }
                    }
                  ]
                },
                {
                  "key": "timeoutMs",
                  "label": "Timeout (ms)",
                  "type": "number"
                },
                {
                  "key": "since",
                  "label": "Since",
                  "type": "date"
                },
                {
                  "key": "target",
                  "label": "Target",
                  "type": "ref",
                  "accepts": {
                    "free": true
                  }
                }
              ]
            }
          ],
          "examples": [
            {
              "name": "Settings screen",
              "values": {
                "url": "/v1/screens/settings"
              }
            }
          ]
        }
      ]
    }
  ]
}
