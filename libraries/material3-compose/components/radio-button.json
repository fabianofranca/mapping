{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "radio-button",
  "name": "Radio button",
  "description": "Radio button de 20 numa área de 24 (RadioButtonPadding 2 de cada lado), com rótulo ao lado: anel de 2 e, selecionado, ponto de 10 na mesma cor.",
  "size": {
    "width": 200,
    "height": 40
  },
  "sizing": {
    "width": "fill",
    "height": 40
  },
  "preview": {
    "label": "Cartão de crédito",
    "selected": "true",
    "enabled": "true"
  },
  "template": {
    "type": "frame",
    "name": "radio button",
    "layout": {
      "type": "row",
      "align": "center"
    },
    "children": [
      {
        "type": "frame",
        "name": "área",
        "width": 24,
        "height": 40,
        "layout": {
          "type": "none"
        },
        "children": [
          {
            "type": "ellipse",
            "name": "estado",
            "width": 40,
            "height": 40,
            "fill": {
              "$if": {
                "$field": "selected"
              },
              "then": {
                "$token": "primary"
              },
              "else": {
                "$token": "on-surface"
              }
            },
            "opacity": {
              "$switch": "interaction",
              "cases": {
                "hovered": {
                  "$token": "state-hover"
                },
                "focused": {
                  "$token": "state-focus"
                },
                "pressed": {
                  "$token": "state-pressed"
                }
              },
              "default": 0
            },
            "visible": {
              "$and": [
                {
                  "$not": {
                    "$eq": ["enabled", "false"]
                  }
                },
                {
                  "$not": {
                    "$eq": ["interaction", "none"]
                  }
                }
              ]
            },
            "anchors": {
              "centerX": true,
              "centerY": true
            }
          },
          {
            "type": "ellipse",
            "name": "anel",
            "width": 20,
            "height": 20,
            "fill": "none",
            "stroke": {
              "color": {
                "$if": {
                  "$eq": ["enabled", "false"]
                },
                "then": {
                  "$token": "on-surface"
                },
                "else": {
                  "$if": {
                    "$field": "selected"
                  },
                  "then": {
                    "$token": "primary"
                  },
                  "else": {
                    "$if": {
                      "$or": [
                        {
                          "$eq": ["interaction", "hovered"]
                        },
                        {
                          "$eq": ["interaction", "focused"]
                        },
                        {
                          "$eq": ["interaction", "pressed"]
                        }
                      ]
                    },
                    "then": {
                      "$token": "on-surface"
                    },
                    "else": {
                      "$token": "on-surface-variant"
                    }
                  }
                }
              },
              "width": 2,
              "align": "inside"
            },
            "opacity": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$token": "state-disabled-content"
              },
              "else": 1
            },
            "anchors": {
              "centerX": true,
              "centerY": true
            }
          },
          {
            "type": "ellipse",
            "name": "ponto",
            "width": 10,
            "height": 10,
            "fill": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$token": "on-surface"
              },
              "else": {
                "$if": {
                  "$field": "selected"
                },
                "then": {
                  "$token": "primary"
                },
                "else": {
                  "$token": "on-surface-variant"
                }
              }
            },
            "visible": {
              "$field": "selected"
            },
            "opacity": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$token": "state-disabled-content"
              },
              "else": 1
            },
            "anchors": {
              "centerX": true,
              "centerY": true
            }
          }
        ]
      },
      {
        "type": "text",
        "name": "rótulo",
        "text": {
          "$field": "label"
        },
        "font": {
          "size": {
            "$token": "body-large-size"
          },
          "weight": {
            "$token": "body-large-weight"
          },
          "lineHeight": {
            "$token": "body-large-line-height"
          },
          "letterSpacing": {
            "$token": "body-large-tracking"
          }
        },
        "color": {
          "$token": "on-surface"
        },
        "opacity": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": {
            "$token": "state-disabled-content"
          },
          "else": 1
        },
        "width": "fill",
        "visible": {
          "$has": "label"
        }
      }
    ]
  }
}
