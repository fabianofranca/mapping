{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "list-item",
  "name": "List item",
  "description": "Item de lista de uma a três linhas (56, 72 e 88): ícone ou avatar à esquerda, sobretítulo, título, apoio e conteúdo à direita.",
  "size": {
    "width": 412,
    "height": 88
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "headlineContent": "Ana Souza",
    "overlineContent": "",
    "supportingContent": "Vamos almoçar?",
    "leadingIcon": "Person",
    "leadingImage": "",
    "trailingContent": "12:30",
    "trailingIcon": ""
  },
  "template": {
    "type": "frame",
    "name": "list item",
    "fill": {
      "$token": "surface"
    },
    "children": [
      {
        "type": "frame",
        "name": "corpo",
        "width": "fill",
        "height": "hug",
        "minHeight": {
          "$if": {
            "$and": [
              {
                "$has": "overlineContent"
              },
              {
                "$has": "supportingContent"
              }
            ]
          },
          "then": 88,
          "else": {
            "$if": {
              "$or": [
                {
                  "$has": "overlineContent"
                },
                {
                  "$has": "supportingContent"
                }
              ]
            },
            "then": 72,
            "else": 56
          }
        },
        "layout": {
          "type": "row",
          "gap": 16,
          "padding": {
            "$if": {
              "$and": [
                {
                  "$has": "overlineContent"
                },
                {
                  "$has": "supportingContent"
                }
              ]
            },
            "then": [12, 16],
            "else": [8, 16]
          },
          "align": {
            "$if": {
              "$and": [
                {
                  "$has": "overlineContent"
                },
                {
                  "$has": "supportingContent"
                }
              ]
            },
            "then": "start",
            "else": "center"
          }
        },
        "children": [
          {
            "type": "image",
            "name": "avatar",
            "src": {
              "$field": "leadingImage"
            },
            "fit": "cover",
            "width": 40,
            "height": 40,
            "cornerRadius": {
              "$token": "corner-full"
            },
            "fill": {
              "$token": "primary-container"
            },
            "visible": {
              "$has": "leadingImage"
            }
          },
          {
            "type": "icon",
            "name": {
              "$switch": "leadingIcon",
              "cases": {
                "Home": "home",
                "Search": "search",
                "Person": "person",
                "Menu": "menu",
                "MoreVert": "more_vert",
                "Add": "add",
                "Check": "check",
                "Close": "close",
                "ArrowBack": "arrow_back",
                "Favorite": "favorite",
                "Edit": "edit",
                "Delete": "delete",
                "Share": "share",
                "Notifications": "notifications",
                "Settings": "settings",
                "Info": "info",
                "Star": "star",
                "Email": "email",
                "Phone": "phone",
                "Place": "place",
                "DateRange": "date_range",
                "ShoppingCart": "shopping_cart",
                "AccountCircle": "account_circle",
                "KeyboardArrowRight": "keyboard_arrow_right",
                "KeyboardArrowDown": "keyboard_arrow_down",
                "Refresh": "refresh",
                "Clear": "clear",
                "Done": "done",
                "Lock": "lock",
                "List": "list",
                "AccountBox": "account_box",
                "AddCircle": "add_circle",
                "ArrowDropDown": "arrow_drop_down",
