{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "navigation-bar",
  "name": "Navigation bar",
  "description": "Barra de navegação de 80 em surface container, com um destino de largura igual por linha de Itens (8 entre eles); o selecionado leva o indicador de 56 × 32 em secondary container.",
  "size": {
    "width": 412,
    "height": 80
  },
  "sizing": {
    "width": "fill",
    "height": 80
  },
  "preview": {
    "items": [
      {
        "label": "Início",
        "icon": "Home",
        "selected": "true"
      },
      {
        "label": "Buscar",
        "icon": "Search",
        "selected": "false"
      },
      {
        "label": "Perfil",
        "icon": "Person",
        "selected": "false"
      }
    ],
    "alwaysShowLabel": "true"
  },
  "template": {
    "type": "frame",
    "name": "navigation bar",
    "fill": {
      "$token": "surface-container"
    },
    "layout": {
      "type": "row"
    },
    "children": [
      {
        "type": "repeat",
        "name": "destinos",
        "field": "items",
        "direction": "row",
        "gap": 8,
        "distribute": "fill",
        "width": "fill",
        "height": "fill",
        "template": {
          "type": "frame",
          "name": "destino",
          "width": "fill",
          "height": "fill",
          "layout": {
            "type": "column",
            "gap": 4,
            "align": "center",
            "justify": {
              "$if": {
                "$and": [
                  {
                    "$has": "label"
                  },
                  {
                    "$or": [
                      {
                        "$not": {
                          "$eq": ["alwaysShowLabel", "false"]
                        }
                      },
                      {
                        "$field": "selected"
                      }
                    ]
                  }
                ]
              },
              "then": "start",
              "else": "center"
            },
            "padding": {
              "$if": {
                "$and": [
                  {
                    "$has": "label"
                  },
                  {
                    "$or": [
                      {
                        "$not": {
                          "$eq": ["alwaysShowLabel", "false"]
                        }
                      },
                      {
                        "$field": "selected"
                      }
                    ]
                  }
                ]
              },
              "then": [12, 0, 0, 0],
              "else": 0
            }
          },
          "children": [
            {
              "type": "frame",
              "name": "indicador",
              "width": 56,
              "height": 32,
              "cornerRadius": {
                "$token": "corner-full"
              },
              "fill": {
                "$if": {
                  "$field": "selected"
                },
                "then": {
                  "$token": "secondary-container"
                },
                "else": "none"
              },
              "layout": {
                "type": "none"
              },
              "children": [
                {
                  "type": "rect",
                  "name": "estado",
                  "anchors": {
                    "left": 0,
                    "right": 0,
                    "top": 0,
                    "bottom": 0
                  },
                  "cornerRadius": {
                    "$token": "corner-full"
                  },
                  "fill": {
                    "$token": "on-surface"
                  },
                  "opacity": {
                    "$switch": "interaction",
                    "cases": {
                      "hovered": {
                        "$token": "state-hover"
                      },
                      "focused": {
                        "$token": "state-focus"
                      },
                      "pressed": {
                        "$token": "state-pressed"
                      }
                    },
                    "default": 0
                  },
                  "visible": {
                    "$and": [
                      {
                        "$field": "selected"
                      },
                      {
                        "$not": {
                          "$eq": ["interaction", "none"]
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "frame",
                  "name": "conteúdo",
                  "width": "fill",
                  "height": "fill",
                  "layout": {
                    "type": "row",
                    "align": "center",
                    "justify": "center"
                  },
                  "children": [
                    {
                      "type": "icon",
                      "name": {
                        "$switch": "icon",
                        "cases": {
                          "Home": "home",
                          "Search": "search",
                          "Person": "person",
                          "Menu": "menu",
                          "MoreVert": "more_vert",
                          "Add": "add",
                          "Check": "check",
                          "Close": "close",
                          "ArrowBack": "arrow_back",
                          "Favorite": "favorite",
                          "Edit": "edit",
                          "Delete": "delete",
                          "Share": "share",
                          "Notifications": "notifications",
                          "Settings": "settings",
                          "Info": "info",
                          "Star": "star",
                          "Email": "email",
                          "Phone": "phone",
                          "Place": "place",
                          "DateRange": "date_range",
                          "ShoppingCart": "shopping_cart",
                          "AccountCircle": "account_circle",
                          "KeyboardArrowRight": "keyboard_arrow_right",
                          "KeyboardArrowDown": "keyboard_arrow_down",
                          "Refresh": "refresh",
                          "Clear": "clear",
                          "Done": "done",
                          "Lock": "lock",
                          "List": "list",
                          "AccountBox": "account_box",
                          "AddCircle": "add_circle",
                          "ArrowDropDown": "arrow_drop_down",
                          "ArrowDropUp": "arrow_drop_up",
                          "ArrowForward": "arrow_forward",
                          "ArrowUpward": "arrow_upward",
                          "ArrowDownward": "arrow_downward",
                          "Build": "build",
                          "Call": "call",
                          "CheckCircle": "check_circle",
                          "Create": "create",
                          "Face": "face",
                          "FavoriteBorder": "favorite_border",
                          "ExitToApp": "exit_to_app",
                          "KeyboardArrowLeft": "keyboard_arrow_left",
                          "KeyboardArrowUp": "keyboard_arrow_up",
                          "LocationOn": "location_on",
                          "MailOutline": "mail_outline",
                          "PlayArrow": "play_arrow",
                          "Send": "send",
                          "ThumbUp": "thumb_up",
                          "Warning": "warning",
                          "Cancel": "cancel",
                          "ExpandMore": "expand_more",
                          "ExpandLess": "expand_less",
                          "ChevronLeft": "chevron_left",
                          "ChevronRight": "chevron_right",
                          "FirstPage": "first_page",
                          "LastPage": "last_page",
                          "MoreHoriz": "more_horiz",
                          "Apps": "apps",
                          "Dashboard": "dashboard",
                          "Folder": "folder",
                          "FolderOpen": "folder_open",
                          "InsertDriveFile": "insert_drive_file",
                          "Description": "description",
                          "Image": "image",
                          "Mic": "mic",
                          "Videocam": "videocam",
                          "Chat": "chat",
                          "Comment": "comment",
                          "Forum": "forum",
                          "NotificationsNone": "notifications_none",
                          "Visibility": "visibility",
                          "VisibilityOff": "visibility_off",
                          "Language": "language",
                          "Public": "public",
                          "Link": "link",
                          "Attachment": "attachment",
                          "ContentCopy": "content_copy",
                          "ContentPaste": "content_paste",
                          "ContentCut": "content_cut",
                          "Save": "save",
                          "Download": "download",
                          "Upload": "upload",
                          "CloudUpload": "cloud_upload",
                          "CloudDownload": "cloud_download",
                          "Cloud": "cloud",
                          "Sync": "sync",
                          "Schedule": "schedule",
                          "AccessTime": "access_time",
                          "CalendarToday": "calendar_today",
                          "Event": "event",
                          "Today": "today",
                          "Timer": "timer",
                          "Alarm": "alarm",
                          "History": "history",
                          "Bookmark": "bookmark",
                          "BookmarkBorder": "bookmark_border",
                          "Label": "label",
                          "Flag": "flag",
                          "Help": "help",
                          "HelpOutline": "help_outline",
                          "Error": "error",
                          "ErrorOutline": "error_outline",
                          "Report": "report",
                          "Block": "block",
                          "Tune": "tune",
                          "FilterList": "filter_list",
                          "Sort": "sort",
                          "Fullscreen": "fullscreen",
                          "Wifi": "wifi",
                          "Bluetooth": "bluetooth",
                          "LightMode": "light_mode",
                          "DarkMode": "dark_mode",
                          "Palette": "palette",
                          "ShoppingBag": "shopping_bag",
                          "Store": "store",
                          "Payment": "payment",
                          "CreditCard": "credit_card",
                          "AttachMoney": "attach_money",
                          "Receipt": "receipt",
                          "Map": "map",
                          "Navigation": "navigation",
                          "DirectionsCar": "directions_car",
                          "Flight": "flight",
                          "MenuOpen": "menu_open",
                          "Logout": "logout",
                          "Login": "login",
                          "People": "people",
                          "Group": "group",
                          "PersonAdd": "person_add",
                          "LockOpen": "lock_open",
                          "Security": "security",
                          "VerifiedUser": "verified_user",
                          "Key": "key",
                          "Pause": "pause",
                          "Stop": "stop",
                          "SkipNext": "skip_next",
                          "SkipPrevious": "skip_previous",
                          "VolumeUp": "volume_up",
                          "VolumeOff": "volume_off",
                          "ThumbDown": "thumb_down",
                          "Reply": "reply",
                          "Inbox": "inbox",
                          "Archive": "archive",
                          "Undo": "undo",
                          "Redo": "redo",
                          "ZoomIn": "zoom_in",
                          "ZoomOut": "zoom_out",
                          "Keyboard": "keyboard",
                          "CheckBox": "check_box",
                          "CheckBoxOutlineBlank": "check_box_outline_blank",
                          "RadioButtonChecked": "radio_button_checked",
                          "RadioButtonUnchecked": "radio_button_unchecked",
                          "ToggleOn": "toggle_on",
                          "ToggleOff": "toggle_off",
                          "StarBorder": "star_border",
                          "StarHalf": "star_half",
                          "Lightbulb": "lightbulb",
                          "Code": "code",
                          "Terminal": "terminal",
                          "Bolt": "bolt",
                          "EditCalendar": "edit_calendar"
                        },
                        "default": {
                          "$field": "icon"
                        }
                      },
                      "color": {
                        "$if": {
                          "$field": "selected"
                        },
                        "then": {
                          "$token": "on-secondary-container"
                        },
                        "else": {
                          "$token": "on-surface-variant"
                        }
                      },
                      "width": 24,
                      "height": 24,
                      "visible": {
                        "$has": "icon"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "name": "rótulo",
              "text": {
                "$field": "label"
              },
              "font": {
                "size": {
                  "$token": "label-medium-size"
                },
                "weight": {
                  "$token": "label-medium-weight"
                },
                "lineHeight": {
                  "$token": "label-medium-line-height"
                },
                "letterSpacing": {
                  "$token": "label-medium-tracking"
                },
                "verticalAlign": "cap-middle"
              },
              "color": {
                "$if": {
                  "$field": "selected"
                },
                "then": {
                  "$token": "secondary"
                },
                "else": {
                  "$token": "on-surface-variant"
                }
              },
              "visible": {
                "$and": [
                  {
                    "$has": "label"
                  },
                  {
                    "$or": [
                      {
                        "$not": {
                          "$eq": ["alwaysShowLabel", "false"]
                        }
                      },
                      {
                        "$field": "selected"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
