{
  "format": "mapping-component",
  "formatVersion": 2,
  "id": "comments-window",
  "name": "CommentsWindow",
  "description": "Tabela da janela Comentários: resumo, cabeçalho (Por, Âncora, Última mensagem, Msgs, Status, Quando) e uma linha por conversa; não lida em negrito, resolvida riscada e cinza, órfã em color-warning.",
  "size": {
    "width": 812,
    "height": 164
  },
  "minSize": {
    "width": 400,
    "height": 80
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "resumo": "2 abertas · 1 aguardando agente · 3 resolvidas",
    "conversas": [
      {
        "iniciais": "MA",
        "nome": "Marina Alves",
        "ancora": "Button › variant",
        "ultima": "É outlined, por isso filled",
        "msgs": "3",
        "status": "Aguardando agente",
        "badge": "agente",
        "quando": "há 5 min",
        "estado": "normal"
      },
      {
        "iniciais": "AG",
        "nome": "Claude Code",
        "ancora": "Campo Texto",
        "ultima": "A spec não diz qual variante",
        "msgs": "1",
        "status": "Aguardando humano",
        "badge": "humano",
        "quando": "ontem",
        "estado": "naoLida"
      },
      {
        "iniciais": "MA",
        "nome": "Marina Alves",
        "ancora": "Seção Identidade",
        "ultima": "Resolvido.",
        "msgs": "4",
        "status": "Resolvida",
        "badge": "resolvida",
        "quando": "05/11",
        "estado": "resolvida"
      }
    ]
  },
  "template": {
    "type": "frame",
    "name": "janela",
    "layout": {
      "type": "column"
    },
    "fill": "#ffffff",
    "children": [
      {
        "type": "frame",
        "name": "resumo",
        "width": "fill",
        "height": "hug",
        "visible": {
          "$has": "resumo"
        },
        "layout": {
          "type": "row",
          "padding": [
            4,
            12
          ]
        },
        "children": [
          {
            "type": "text",
            "name": "resumo",
            "text": {
              "$field": "resumo"
            },
            "color": "#1b1f24",
            "font": {
              "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
              "size": 12,
              "weight": 400,
              "lineHeight": 16
            },
            "width": "fill"
          }
        ]
      },
      {
        "type": "frame",
        "name": "cabeçalho",
        "width": "fill",
        "height": 28,
        "layout": {
          "type": "none"
        },
        "children": [
          {
            "type": "frame",
            "name": "colunas",
            "layout": {
              "type": "row",
              "padding": [
                0,
                12
              ],
              "align": "center"
            },
            "children": [
              {
                "type": "text",
                "name": "Por",
                "text": "Por",
                "color": "#5b6470",
                "font": {
                  "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                  "size": 12,
                  "weight": 400,
                  "lineHeight": 16
                },
                "width": "16%"
              },
              {
                "type": "text",
                "name": "Âncora",
                "text": "Âncora",
                "color": "#5b6470",
                "font": {
                  "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                  "size": 12,
                  "weight": 400,
                  "lineHeight": 16
                },
                "width": "21%"
              },
              {
                "type": "text",
                "name": "Última mensagem",
                "text": "Última mensagem",
                "color": "#5b6470",
                "font": {
                  "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                  "size": 12,
                  "weight": 400,
                  "lineHeight": 16
                },
                "width": "fill"
              },
              {
                "type": "text",
                "name": "Msgs",
                "text": "Msgs",
                "color": "#5b6470",
                "font": {
                  "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                  "size": 12,
                  "weight": 400,
                  "lineHeight": 16,
                  "align": "right"
                },
                "width": "6%"
              },
              {
                "type": "text",
                "name": "Status",
                "text": "Status",
                "color": "#5b6470",
                "font": {
                  "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                  "size": 12,
                  "weight": 400,
                  "lineHeight": 16
                },
                "width": "18%"
              },
              {
                "type": "text",
                "name": "Quando",
                "text": "Quando",
                "color": "#5b6470",
                "font": {
                  "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                  "size": 12,
                  "weight": 400,
                  "lineHeight": 16
                },
                "width": "9%"
              },
              {
                "type": "rect",
                "name": "menu",
                "width": 24,
                "height": 1,
                "fill": "rgba(0, 0, 0, 0)"
              }
            ]
          },
          {
            "type": "rect",
            "name": "divisória",
            "height": 1,
            "anchors": {
              "left": 0,
              "right": 0,
              "bottom": 0
            },
            "fill": "#dfe3e8"
          }
        ]
      },
      {
        "type": "repeat",
        "name": "conversas",
        "field": "conversas",
        "direction": "column",
        "gap": 0,
        "width": "fill",
        "template": {
          "type": "frame",
          "name": "linha",
          "width": "fill",
          "height": 28,
          "layout": {
            "type": "none"
          },
          "children": [
            {
              "type": "frame",
              "name": "células",
              "layout": {
                "type": "row",
                "padding": [
                  0,
                  12
                ],
                "align": "center"
              },
              "children": [
                {
                  "type": "frame",
                  "name": "por",
                  "width": "16%",
                  "height": "hug",
                  "layout": {
                    "type": "row",
                    "gap": 4,
                    "align": "center"
                  },
                  "children": [
                    {
                      "type": "frame",
                      "name": "avatar",
                      "width": 16,
                      "height": 16,
                      "cornerRadius": 8,
                      "fill": "#eceff3",
                      "layout": {
                        "type": "row",
                        "align": "center",
                        "justify": "center"
                      },
                      "children": [
                        {
                          "type": "text",
                          "name": "iniciais",
                          "text": {
                            "$field": "iniciais"
                          },
                          "color": "#1b1f24",
                          "font": {
                            "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                            "size": 11,
                            "weight": 600,
                            "lineHeight": 16
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "name": "nome",
                      "text": {
                        "$field": "nome"
                      },
                      "color": {
                        "$if": {
                          "$eq": [
                            "estado",
                            "resolvida"
                          ]
                        },
                        "then": "#5b6470",
                        "else": "#1b1f24"
                      },
                      "font": {
                        "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                        "size": 13,
                        "weight": {
                          "$if": {
                            "$eq": [
                              "estado",
                              "naoLida"
                            ]
                          },
                          "then": 600,
                          "else": 400
                        },
                        "lineHeight": 20
                      },
                      "width": "fill"
                    }
                  ]
                },
                {
                  "type": "text",
                  "name": "âncora",
                  "text": {
                    "$field": "ancora"
                  },
                  "color": {
                    "$switch": "estado",
                    "cases": {
                      "orfa": "#8a5a00",
                      "resolvida": "#5b6470"
                    },
                    "default": "#1b1f24"
                  },
                  "font": {
                    "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                    "size": 13,
                    "weight": {
                      "$if": {
                        "$eq": [
                          "estado",
                          "naoLida"
                        ]
                      },
                      "then": 600,
                      "else": 400
                    },
                    "lineHeight": 20,
                    "decoration": {
                      "$if": {
                        "$eq": [
                          "estado",
                          "resolvida"
                        ]
                      },
                      "then": "line-through",
                      "else": "none"
                    }
                  },
                  "width": "21%"
                },
                {
                  "type": "text",
                  "name": "última",
                  "text": {
                    "$field": "ultima"
                  },
                  "color": {
                    "$if": {
                      "$eq": [
                        "estado",
                        "resolvida"
                      ]
                    },
                    "then": "#5b6470",
                    "else": "#1b1f24"
                  },
                  "font": {
                    "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                    "size": 13,
                    "weight": {
                      "$if": {
                        "$eq": [
                          "estado",
                          "naoLida"
                        ]
                      },
                      "then": 600,
                      "else": 400
                    },
                    "lineHeight": 20
                  },
                  "width": "fill"
                },
                {
                  "type": "text",
                  "name": "msgs",
                  "text": {
                    "$field": "msgs"
                  },
                  "color": {
                    "$if": {
                      "$eq": [
                        "estado",
                        "resolvida"
                      ]
                    },
                    "then": "#5b6470",
                    "else": "#1b1f24"
                  },
                  "font": {
                    "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                    "size": 13,
                    "weight": 400,
                    "lineHeight": 20,
                    "align": "right"
                  },
                  "width": "6%"
                },
                {
                  "type": "frame",
                  "name": "status",
                  "width": "18%",
                  "height": "hug",
                  "layout": {
                    "type": "row",
                    "align": "center"
                  },
                  "children": [
                    {
                      "type": "frame",
                      "name": "selo",
                      "width": "hug",
                      "height": 16,
                      "cornerRadius": 999,
                      "fill": {
                        "$switch": "badge",
                        "cases": {
                          "agente": "#fff4d6"
                        },
                        "default": "#eceff3"
                      },
                      "layout": {
                        "type": "row",
                        "padding": [
                          0,
                          8
                        ],
                        "align": "center"
                      },
                      "children": [
                        {
                          "type": "text",
                          "name": "status",
                          "text": {
                            "$field": "status"
                          },
                          "color": {
                            "$switch": "badge",
                            "cases": {
                              "agente": "#8a5a00",
                              "resolvida": "#1e7a46"
                            },
                            "default": "#5b6470"
                          },
                          "font": {
                            "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                            "size": 11,
                            "weight": 600,
                            "lineHeight": 16
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "text",
                  "name": "quando",
                  "text": {
                    "$field": "quando"
                  },
                  "color": "#5b6470",
                  "font": {
                    "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
                    "size": 13,
                    "weight": 400,
                    "lineHeight": 20
                  },
                  "width": "9%"
                },
                {
                  "type": "path",
                  "name": "ações",
                  "width": 16,
                  "height": 16,
                  "viewBox": [
                    16,
                    16
                  ],
                  "d": "M2.9 8a0.6 0.6 0 1 0 1.2 0a0.6 0.6 0 1 0 -1.2 0ZM7.4 8a0.6 0.6 0 1 0 1.2 0a0.6 0.6 0 1 0 -1.2 0ZM11.9 8a0.6 0.6 0 1 0 1.2 0a0.6 0.6 0 1 0 -1.2 0Z",
                  "fill": "none",
                  "stroke": {
                    "color": "#5b6470",
                    "width": 1.25
                  }
                }
              ]
            },
            {
              "type": "rect",
              "name": "divisória",
              "height": 1,
              "anchors": {
                "left": 0,
                "right": 0,
                "bottom": 0
              },
              "fill": "#dfe3e8"
            }
          ]
        }
      }
    ]
  }
}
