{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "avatar",
  "name": "Iniciais",
  "description": "As iniciais de quem escreveu, num círculo em color-selection-muted (24 px na conversa, 16 px na tabela).",
  "size": {
    "width": 24,
    "height": 24
  },
  "minSize": {
    "width": 8,
    "height": 8
  },
  "sizing": {
    "width": 24,
    "height": 24
  },
  "preview": {
    "iniciais": "MA",
    "estilo": "conversa"
  },
  "template": {
    "type": "frame",
    "name": "iniciais",
    "layout": {
      "type": "none"
    },
    "cornerRadius": 999,
    "fill": "#eceff3",
    "children": [
      {
        "type": "text",
        "name": "iniciais",
        "text": {
          "$field": "iniciais",
          "default": "?"
        },
        "color": {
          "$switch": "estilo",
          "cases": {
            "tabela": "#5b6470"
          },
          "default": "#1b1f24"
        },
        "font": {
          "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
          "size": 11,
          "weight": 600,
          "lineHeight": 16,
          "align": "center",
          "verticalAlign": "middle"
        },
        "width": "fill",
        "height": "fill"
      }
    ]
  }
}
