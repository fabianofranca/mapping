{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "m3-box",
  "name": "Box",
  "description": "Container livre do Compose: os filhos ficam onde o retângulo deles diz.",
  "size": {
    "width": 200,
    "height": 120
  },
  "minSize": {
    "width": 24,
    "height": 24
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "background": "none",
    "shape": "none",
    "padding": 0
  },
  "template": {
    "type": "frame",
    "name": "m3-box",
    "clip": false,
    "layout": {
      "type": "none"
    },
    "fill": {
      "$switch": "background",
      "cases": {
        "surface": "#FEF7FF",
        "surface-container": "#F3EDF7",
        "primary-container": "#EADDFF",
        "secondary-container": "#E8DEF8"
      },
      "default": "rgba(0, 0, 0, 0)"
    },
    "cornerRadius": {
      "$switch": "shape",
      "cases": {
        "small": 8,
        "medium": 12,
        "large": 16,
        "extra-large": 28
      },
      "default": 0
    },
    "children": [
      {
        "type": "slot",
        "name": "content",
        "label": "Box",
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "layout": {
          "type": "none"
        }
      }
    ]
  }
}
