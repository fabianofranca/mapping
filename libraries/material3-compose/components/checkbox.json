{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "checkbox",
  "name": "Checkbox",
  "description": "Checkbox de 20 (CheckboxSize) na área de 48 do toque mínimo, com rótulo: marcado (check), desmarcado (contorno) ou indeterminado (traço).",
  "size": {
    "width": 200,
    "height": 40
  },
  "sizing": {
    "width": "fill",
    "height": 40
  },
  "preview": {
    "label": "Lembrar de mim",
    "state": "checked",
    "enabled": "true"
  },
  "template": {
    "type": "frame",
    "name": "checkbox",
    "layout": {
      "type": "row",
      "align": "center"
    },
    "children": [
      {
        "type": "frame",
        "name": "área",
        "width": 48,
        "height": 40,
        "layout": {
          "type": "none"
        },
        "children": [
          {
            "type": "ellipse",
            "name": "estado",
            "width": 40,
            "height": 40,
            "fill": {
              "$if": {
                "$or": [
                  {
                    "$eq": ["state", "checked"]
                  },
                  {
                    "$eq": ["state", "indeterminate"]
                  }
                ]
              },
              "then": {
                "$token": "primary"
              },
              "else": {
                "$token": "on-surface"
              }
            },
            "opacity": {
              "$switch": "interaction",
              "cases": {
                "hovered": {
                  "$token": "state-hover"
                },
                "focused": {
                  "$token": "state-focus"
                },
                "pressed": {
                  "$token": "state-pressed"
                }
              },
              "default": 0
            },
            "visible": {
              "$and": [
                {
                  "$not": {
                    "$eq": ["enabled", "false"]
                  }
                },
                {
                  "$not": {
                    "$eq": ["interaction", "none"]
                  }
                }
              ]
            },
            "anchors": {
              "centerX": true,
              "centerY": true
            }
          },
          {
            "type": "frame",
            "name": "marca",
            "width": 20,
            "height": 20,
            "layout": {
              "type": "none"
            },
            "children": [
              {
                "type": "rect",
                "name": "caixa",
                "width": 20,
                "height": 20,
                "cornerRadius": {
                  "$token": "corner-checkbox"
                },
                "fill": {
                  "$if": {
                    "$or": [
                      {
                        "$eq": ["state", "checked"]
                      },
                      {
                        "$eq": ["state", "indeterminate"]
                      }
                    ]
                  },
                  "then": {
                    "$if": {
                      "$eq": ["enabled", "false"]
                    },
                    "then": {
                      "$token": "on-surface"
                    },
                    "else": {
                      "$token": "primary"
                    }
                  },
                  "else": "none"
                },
                "stroke": {
                  "color": {
                    "$if": {
                      "$or": [
                        {
                          "$eq": ["state", "checked"]
                        },
                        {
                          "$eq": ["state", "indeterminate"]
                        }
                      ]
                    },
                    "then": "none",
                    "else": {
                      "$if": {
                        "$eq": ["enabled", "false"]
                      },
                      "then": {
                        "$token": "on-surface"
                      },
                      "else": {
                        "$if": {
                          "$or": [
                            {
                              "$eq": ["interaction", "hovered"]
                            },
                            {
                              "$eq": ["interaction", "focused"]
                            },
                            {
                              "$eq": ["interaction", "pressed"]
                            }
                          ]
                        },
                        "then": {
                          "$token": "on-surface"
                        },
                        "else": {
                          "$token": "on-surface-variant"
                        }
                      }
                    }
                  },
                  "width": 2,
                  "align": "inside"
                },
                "opacity": {
                  "$if": {
                    "$eq": ["enabled", "false"]
                  },
                  "then": {
                    "$token": "state-disabled-content"
                  },
                  "else": 1
                }
              },
              {
                "type": "path",
                "name": "check",
                "visible": {
                  "$eq": ["state", "checked"]
                },
                "width": 20,
                "height": 20,
                "viewBox": [20, 20],
                "d": "M4 10L8 14L16 6",
                "fill": "none",
                "stroke": {
                  "color": {
                    "$token": "on-primary"
                  },
                  "width": 2,
                  "align": "center",
                  "cap": "square",
                  "join": "miter"
                }
              },
              {
                "type": "path",
                "name": "traço",
                "visible": {
                  "$eq": ["state", "indeterminate"]
                },
                "width": 20,
                "height": 20,
                "viewBox": [20, 20],
                "d": "M4 10L16 10",
                "fill": "none",
                "stroke": {
                  "color": {
                    "$token": "on-primary"
                  },
                  "width": 2,
                  "align": "center",
                  "cap": "square",
                  "join": "miter"
                }
              }
            ],
            "anchors": {
              "centerX": true,
              "centerY": true
            }
          }
        ]
      },
      {
        "type": "text",
        "name": "rótulo",
        "text": {
          "$field": "label"
        },
        "font": {
          "size": {
            "$token": "body-large-size"
          },
          "weight": {
            "$token": "body-large-weight"
          },
          "lineHeight": {
            "$token": "body-large-line-height"
          },
          "letterSpacing": {
            "$token": "body-large-tracking"
          }
        },
        "color": {
          "$token": "on-surface"
        },
        "opacity": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": {
            "$token": "state-disabled-content"
          },
          "else": 1
        },
        "width": "fill",
        "visible": {
          "$has": "label"
        }
      }
    ]
  }
}
