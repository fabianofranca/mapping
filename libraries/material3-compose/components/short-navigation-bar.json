{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "short-navigation-bar",
  "name": "Short navigation bar",
  "description": "Barra de navegação curta de 64 em surface container, com um destino por linha de Itens; ícone acima do rótulo (indicador de 56 × 32) ou ao lado dele (pílula de 40); centralizada, os itens ficam agrupados no meio (margem de 10% de cada lado: o Compose usa 20% com 3 itens, 15% com 4, 10% com 5 e 5% com 6).",
  "size": {
    "width": 412,
    "height": 64
  },
  "sizing": {
    "width": "fill",
    "height": 64
  },
  "preview": {
    "items": [
      {
        "label": "Início",
        "icon": "Home",
        "selected": "true"
      },
      {
        "label": "Buscar",
        "icon": "Search",
        "selected": "false"
      },
      {
        "label": "Perfil",
        "icon": "Person",
        "selected": "false"
      }
    ],
    "arrangement": "EqualWeight",
    "iconPosition": "Top"
  },
  "template": {
    "type": "frame",
    "name": "short navigation bar",
    "fill": {
      "$token": "surface-container"
    },
    "layout": {
      "type": "row",
      "align": "center"
    },
    "children": [
      {
        "type": "frame",
        "name": "margem",
        "width": "10%",
        "height": 1,
        "visible": {
          "$eq": ["arrangement", "Centered"]
        }
      },
      {
        "type": "repeat",
        "name": "destinos",
        "field": "items",
        "direction": "row",
        "distribute": "fill",
        "width": "fill",
        "height": "fill",
        "template": {
          "type": "frame",
          "name": "destino",
          "width": "fill",
          "height": "fill",
          "layout": {
            "type": "column",
            "align": "center",
            "justify": "center"
          },
          "children": [
            {
              "type": "frame",
              "name": "ícone acima",
              "width": "hug",
              "height": "hug",
              "visible": {
                "$not": {
                  "$eq": ["iconPosition", "Start"]
                }
              },
              "layout": {
                "type": "column",
                "gap": 4,
                "align": "center"
              },
              "children": [
                {
                  "type": "frame",
                  "name": "indicador",
                  "width": 56,
                  "height": 32,
                  "cornerRadius": {
                    "$token": "corner-full"
                  },
                  "fill": {
                    "$if": {
                      "$field": "selected"
                    },
                    "then": {
                      "$token": "secondary-container"
                    },
                    "else": "none"
                  },
                  "layout": {
                    "type": "none"
                  },
                  "children": [
                    {
                      "type": "rect",
                      "name": "estado",
                      "anchors": {
                        "left": 0,
                        "right": 0,
                        "top": 0,
                        "bottom": 0
                      },
                      "cornerRadius": {
                        "$token": "corner-full"
                      },
                      "fill": {
                        "$token": "on-surface"
                      },
                      "opacity": {
                        "$switch": "interaction",
                        "cases": {
                          "hovered": {
                            "$token": "state-hover"
                          },
                          "focused": {
                            "$token": "state-focus"
                          },
                          "pressed": {
                            "$token": "state-pressed"
                          }
                        },
                        "default": 0
                      },
                      "visible": {
                        "$and": [
                          {
                            "$field": "selected"
                          },
                          {
                            "$not": {
                              "$eq": ["interaction", "none"]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "frame",
                      "name": "conteúdo",
                      "width": "fill",
                      "height": "fill",
                      "layout": {
                        "type": "row",
                        "align": "center",
                        "justify": "center"
                      },
                      "children": [
                        {
                          "type": "icon",
                          "name": {
                            "$switch": "icon",
                            "cases": {
                              "Home": "home",
                              "Search": "search",
                              "Person": "person",
                              "Menu": "menu",
                              "MoreVert": "more_vert",
