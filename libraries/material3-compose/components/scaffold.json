{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "scaffold",
  "name": "Scaffold",
  "description": "Estrutura de tela do Material 3: fundo da tela e um espaço para a barra de cima, o conteúdo, a barra de baixo e o botão flutuante.",
  "size": {
    "width": 360,
    "height": 800
  },
  "sizing": {
    "width": "fill",
    "height": "fill"
  },
  "preview": {
    "containerColor": "background",
    "floatingActionButtonPosition": "End",
    "width": "fill",
    "height": "fill"
  },
  "template": {
    "type": "frame",
    "name": "scaffold",
    "clip": false,
    "layout": {
      "type": "none"
    },
    "fill": {
      "$switch": "containerColor",
      "cases": {
        "primary": {
          "$token": "primary"
        },
        "onPrimary": {
          "$token": "on-primary"
        },
        "primaryContainer": {
          "$token": "primary-container"
        },
        "onPrimaryContainer": {
          "$token": "on-primary-container"
        },
        "secondary": {
          "$token": "secondary"
        },
        "onSecondary": {
          "$token": "on-secondary"
        },
        "secondaryContainer": {
          "$token": "secondary-container"
        },
        "onSecondaryContainer": {
          "$token": "on-secondary-container"
        },
        "tertiary": {
          "$token": "tertiary"
        },
        "onTertiary": {
          "$token": "on-tertiary"
        },
        "tertiaryContainer": {
          "$token": "tertiary-container"
        },
        "onTertiaryContainer": {
          "$token": "on-tertiary-container"
        },
        "error": {
          "$token": "error"
        },
        "onError": {
          "$token": "on-error"
        },
        "errorContainer": {
          "$token": "error-container"
        },
        "onErrorContainer": {
          "$token": "on-error-container"
        },
        "background": {
          "$token": "background"
        },
        "onBackground": {
          "$token": "on-background"
        },
        "surface": {
          "$token": "surface"
        },
        "onSurface": {
          "$token": "on-surface"
        },
        "surfaceVariant": {
          "$token": "surface-variant"
        },
        "onSurfaceVariant": {
          "$token": "on-surface-variant"
        },
        "surfaceTint": {
          "$token": "surface-tint"
        },
        "inverseSurface": {
          "$token": "inverse-surface"
        },
        "inverseOnSurface": {
          "$token": "inverse-on-surface"
        },
        "inversePrimary": {
          "$token": "inverse-primary"
        },
        "outline": {
          "$token": "outline"
        },
        "outlineVariant": {
          "$token": "outline-variant"
        },
        "scrim": {
          "$token": "scrim"
        },
        "surfaceBright": {
          "$token": "surface-bright"
        },
        "surfaceDim": {
          "$token": "surface-dim"
        },
        "surfaceContainerLowest": {
          "$token": "surface-container-lowest"
        },
        "surfaceContainerLow": {
          "$token": "surface-container-low"
        },
        "surfaceContainer": {
          "$token": "surface-container"
        },
        "surfaceContainerHigh": {
          "$token": "surface-container-high"
        },
        "surfaceContainerHighest": {
          "$token": "surface-container-highest"
        }
      },
      "default": {
        "$token": "background"
      }
    },
    "children": [
      {
        "type": "slot",
        "name": "content",
        "label": {
          "$concat": [
            "Scaffold · FAB ",
            {
              "$field": "floatingActionButtonPosition",
              "default": "End"
            },
            " · ",
            {
              "$field": "width",
              "default": "fill"
            },
            " × ",
            {
              "$field": "height",
              "default": "fill"
            }
          ]
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "layout": {
          "type": "none"
        },
        "provide": {
          "content-color": {
            "$switch": "containerColor",
            "cases": {
              "primary": {
                "$token": "on-primary"
              },
              "onPrimary": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "primaryContainer": {
                "$token": "on-primary-container"
              },
              "onPrimaryContainer": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "secondary": {
                "$token": "on-secondary"
              },
              "onSecondary": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "secondaryContainer": {
                "$token": "on-secondary-container"
              },
              "onSecondaryContainer": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "tertiary": {
                "$token": "on-tertiary"
              },
              "onTertiary": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "tertiaryContainer": {
                "$token": "on-tertiary-container"
              },
              "onTertiaryContainer": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "error": {
                "$token": "on-error"
              },
              "onError": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "errorContainer": {
                "$token": "on-error-container"
              },
              "onErrorContainer": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "background": {
                "$token": "on-background"
              },
              "onBackground": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "surface": {
                "$token": "on-surface"
              },
              "onSurface": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "surfaceVariant": {
                "$token": "on-surface-variant"
              },
              "onSurfaceVariant": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "surfaceTint": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "inverseSurface": {
                "$token": "inverse-on-surface"
              },
              "inverseOnSurface": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "inversePrimary": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "outline": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "outlineVariant": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "scrim": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "surfaceBright": {
                "$token": "on-surface"
              },
              "surfaceDim": {
                "$token": "on-surface"
              },
              "surfaceContainerLowest": {
                "$token": "on-surface"
              },
              "surfaceContainerLow": {
                "$token": "on-surface"
              },
              "surfaceContainer": {
                "$token": "on-surface"
              },
              "surfaceContainerHigh": {
                "$token": "on-surface"
              },
              "surfaceContainerHighest": {
                "$token": "on-surface"
              }
            },
            "default": {
              "$token": "on-background"
            }
          }
        }
      }
    ]
  }
}
