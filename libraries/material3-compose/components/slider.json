{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "slider",
  "name": "Slider",
  "description": "Slider de 44: trilha de 16 em secondary container, trecho ativo em primary e alça de 4 × 44 com vão de 6 (SliderTokens). Os valores são números de 0 a 1; com steps a alça vai ao passo mais próximo e as marcas são exatamente as de steps; quando não cabem (menos de 1 de espaço entre centros, ou mais de 1000 marcas), cada trecho vira uma faixa de 4. No intervalo há duas alças.",
  "size": { "width": 328, "height": 48 },
  "sizing": { "width": "fill", "height": 48 },
  "preview": {
    "type": "single",
    "value": 0.5,
    "valueStart": 0.2,
    "valueEnd": 0.8,
    "steps": null,
    "enabled": "true"
  },
  "template": {
    "type": "frame",
    "name": "slider",
    "let": {
      "n": { "$max": [{ "$floor": { "$field": "steps", "default": 0 } }, 0] },
      "parts": { "$add": [{ "$var": "n" }, 1] },
      "sp": { "$div": [{ "$sub": [{ "$size": "width" }, 20] }, { "$var": "parts" }] },
      "dense": {
        "$and": [
          { "$gte": [{ "$var": "n" }, 1] },
          {
            "$or": [
              { "$lt": [{ "$var": "sp" }, 1] },
              { "$gt": [{ "$add": [{ "$var": "n" }, 2] }, 1000] }
            ]
          }
        ]
      },
      "first": {
        "$round": {
          "$mul": [
            { "$clamp": [{ "$field": "valueStart", "default": 0.2 }, 0, 1] },
            { "$var": "parts" }
          ]
        }
      },
      "last": {
        "$round": {
          "$mul": [
            {
              "$clamp": [
                {
                  "$if": { "$eq": ["type", "range"] },
                  "then": { "$field": "valueEnd", "default": 0.8 },
                  "else": { "$field": "value", "default": 0.5 }
                },
                0,
                1
              ]
            },
            { "$var": "parts" }
          ]
        }
      }
    },
    "layout": { "type": "none" },
    "children": [
      {
        "type": "frame",
        "name": "faixa",
        "height": 44,
        "anchors": { "left": 2, "right": 2, "centerY": true },
        "layout": { "type": "row" },
        "children": [
          {
            "type": "frame",
            "name": "antes do início",
            "width": {
              "$if": { "$eq": ["type", "range"] },
              "then": {
                "$add": [
                  {
                    "$mul": [
                      {
                        "$div": [
                          {
                            "$round": {
                              "$mul": [
                                {
                                  "$clamp": [
                                    { "$field": "valueStart", "default": 0.2 },
                                    0,
                                    1
                                  ]
                                },
                                {
                                  "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                  "then": {
                                    "$add": [{ "$floor": { "$field": "steps" } }, 1]
                                  },
                                  "else": 1000000000
                                }
                              ]
                            }
                          },
                          {
                            "$if": { "$gte": [{ "$field": "steps" }, 1] },
                            "then": { "$add": [{ "$floor": { "$field": "steps" } }, 1] },
                            "else": 1000000000
                          }
                        ]
                      },
                      {
                        "$sub": [
                          { "$sub": [{ "$size": "width" }, 4] },
                          {
                            "$mul": [
                              16,
                              {
                                "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                "then": 1,
                                "else": 0
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "$mul": [
                      8,
                      {
                        "$if": { "$gte": [{ "$field": "steps" }, 1] },
                        "then": 1,
                        "else": 0
                      }
                    ]
                  }
                ]
              },
              "else": 0
            },
            "height": "fill",
            "visible": { "$eq": ["type", "range"] },
            "layout": { "type": "row", "align": "center", "padding": [0, 8, 0, 0] },
            "children": [
              {
                "type": "rect",
                "name": "trilho inativo",
                "height": 16,
                "cornerRadius": [
                  { "$token": "corner-track-outer" },
                  { "$token": "corner-track-inside" },
                  { "$token": "corner-track-inside" },
                  { "$token": "corner-track-outer" }
                ],
                "fill": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": {
                    "$token": "on-surface",
                    "alpha": { "$token": "state-disabled-container" },
                    "over": "surface"
                  },
                  "else": { "$token": "secondary-container" }
                },
                "width": "fill"
              }
            ]
          },
          {
            "type": "frame",
            "name": "trecho ativo",
            "width": "fill",
            "height": "fill",
            "layout": {
              "type": "row",
              "align": "center",
              "padding": {
                "$if": { "$eq": ["type", "range"] },
                "then": [0, 8],
                "else": [0, 8, 0, 0]
              }
            },
            "children": [
              {
                "type": "rect",
                "name": "trilho ativo",
                "height": 16,
                "cornerRadius": [
                  { "$token": "corner-track-outer" },
                  { "$token": "corner-track-inside" },
                  { "$token": "corner-track-inside" },
                  { "$token": "corner-track-outer" }
                ],
                "visible": { "$not": { "$eq": ["type", "range"] } },
                "fill": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": {
                    "$token": "on-surface",
                    "alpha": { "$token": "state-disabled-content" },
                    "over": "surface"
                  },
                  "else": { "$token": "primary" }
                },
                "width": "fill"
              },
              {
                "type": "rect",
                "name": "trilho ativo",
                "height": 16,
                "cornerRadius": { "$token": "corner-track-inside" },
                "visible": { "$eq": ["type", "range"] },
                "fill": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": {
                    "$token": "on-surface",
                    "alpha": { "$token": "state-disabled-content" },
                    "over": "surface"
                  },
                  "else": { "$token": "primary" }
                },
                "width": "fill"
              }
            ]
          },
          {
            "type": "frame",
            "name": "depois do fim",
            "width": {
              "$sub": [
                { "$sub": [{ "$size": "width" }, 4] },
                {
                  "$if": {
                    "$and": [
                      { "$gte": [{ "$field": "steps" }, 1] },
                      {
                        "$or": [
                          { "$eq": ["type", "range"] },
                          {
                            "$lt": [
                              {
                                "$abs": {
                                  "$sub": [
                                    {
                                      "$mul": [
                                        {
                                          "$round": {
                                            "$mul": [
                                              {
                                                "$clamp": [
                                                  {
                                                    "$if": { "$eq": ["type", "range"] },
                                                    "then": {
                                                      "$field": "valueEnd",
                                                      "default": 0.8
                                                    },
                                                    "else": {
                                                      "$field": "value",
                                                      "default": 0.5
                                                    }
                                                  },
                                                  0,
                                                  1
                                                ]
                                              },
                                              {
                                                "$add": [
                                                  { "$floor": { "$field": "steps" } },
                                                  1
                                                ]
                                              }
                                            ]
                                          }
                                        },
                                        2
                                      ]
                                    },
                                    { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                                  ]
                                }
                              },
                              { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "then": {
                    "$add": [
                      8,
                      {
                        "$mul": [
                          {
                            "$div": [
                              {
                                "$round": {
                                  "$mul": [
                                    {
                                      "$clamp": [
                                        {
                                          "$if": { "$eq": ["type", "range"] },
                                          "then": {
                                            "$field": "valueEnd",
                                            "default": 0.8
                                          },
                                          "else": { "$field": "value", "default": 0.5 }
                                        },
                                        0,
                                        1
                                      ]
                                    },
                                    {
                                      "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                      "then": {
                                        "$add": [{ "$floor": { "$field": "steps" } }, 1]
                                      },
                                      "else": 1000000000
                                    }
                                  ]
                                }
                              },
                              {
                                "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                "then": {
                                  "$add": [{ "$floor": { "$field": "steps" } }, 1]
                                },
                                "else": 1000000000
                              }
                            ]
                          },
                          { "$sub": [{ "$sub": [{ "$size": "width" }, 4] }, 16] }
                        ]
                      }
                    ]
                  },
                  "else": {
                    "$mul": [
                      {
                        "$div": [
                          {
                            "$round": {
                              "$mul": [
                                {
                                  "$clamp": [
                                    {
                                      "$if": { "$eq": ["type", "range"] },
                                      "then": { "$field": "valueEnd", "default": 0.8 },
                                      "else": { "$field": "value", "default": 0.5 }
                                    },
                                    0,
                                    1
                                  ]
                                },
                                {
                                  "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                  "then": {
                                    "$add": [{ "$floor": { "$field": "steps" } }, 1]
                                  },
                                  "else": 1000000000
                                }
                              ]
                            }
                          },
                          {
                            "$if": { "$gte": [{ "$field": "steps" }, 1] },
                            "then": { "$add": [{ "$floor": { "$field": "steps" } }, 1] },
                            "else": 1000000000
                          }
                        ]
                      },
                      { "$sub": [{ "$size": "width" }, 4] }
                    ]
                  }
                }
              ]
            },
            "height": "fill",
            "layout": { "type": "row", "align": "center", "padding": [0, 0, 0, 8] },
            "children": [
              {
                "type": "rect",
                "name": "trilho inativo",
                "height": 16,
                "cornerRadius": [
                  { "$token": "corner-track-inside" },
                  { "$token": "corner-track-outer" },
                  { "$token": "corner-track-outer" },
                  { "$token": "corner-track-inside" }
                ],
                "fill": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": {
                    "$token": "on-surface",
                    "alpha": { "$token": "state-disabled-container" },
                    "over": "surface"
                  },
                  "else": { "$token": "secondary-container" }
                },
                "width": "fill"
              }
            ]
          }
        ]
      },
      {
        "type": "rect",
        "name": "faixa de passos",
        "height": 4,
        "cornerRadius": 2,
        "fill": {
          "$if": { "$eq": ["enabled", "false"] },
          "then": {
            "$token": "on-surface",
            "alpha": { "$token": "state-disabled-content" },
            "over": "surface"
          },
          "else": { "$token": "primary" }
        },
        "width": {
          "$add": [
            {
              "$mul": [
                { "$sub": [{ "$sub": [{ "$var": "first" }, 1] }, 0] },
                { "$var": "sp" }
              ]
            },
            4
          ]
        },
        "anchors": {
          "centerY": true,
          "left": { "$add": [8, { "$mul": [0, { "$var": "sp" }] }] }
        },
        "visible": {
          "$and": [
            { "$var": "dense" },
            {
              "$and": [{ "$eq": ["type", "range"] }, { "$gte": [{ "$var": "first" }, 1] }]
            }
          ]
        }
      },
      {
        "type": "rect",
        "name": "faixa de passos",
        "height": 4,
        "cornerRadius": 2,
        "fill": {
          "$if": { "$eq": ["enabled", "false"] },
          "then": {
            "$token": "on-surface",
            "alpha": { "$token": "state-disabled-container" },
            "over": "surface"
          },
          "else": { "$token": "secondary-container" }
        },
        "width": {
          "$add": [
            {
              "$mul": [
                {
                  "$sub": [
                    { "$sub": [{ "$var": "last" }, 1] },
                    {
                      "$if": { "$eq": ["type", "range"] },
                      "then": { "$add": [{ "$var": "first" }, 1] },
                      "else": 0
                    }
                  ]
                },
                { "$var": "sp" }
              ]
            },
            4
          ]
        },
        "anchors": {
          "centerY": true,
          "left": {
            "$add": [
              8,
              {
                "$mul": [
                  {
                    "$if": { "$eq": ["type", "range"] },
                    "then": { "$add": [{ "$var": "first" }, 1] },
                    "else": 0
                  },
                  { "$var": "sp" }
                ]
              }
            ]
          }
        },
        "visible": {
          "$and": [
            { "$var": "dense" },
            {
              "$gte": [
                { "$sub": [{ "$var": "last" }, 1] },
                {
                  "$if": { "$eq": ["type", "range"] },
                  "then": { "$add": [{ "$var": "first" }, 1] },
                  "else": 0
                }
              ]
            }
          ]
        }
      },
      {
        "type": "rect",
        "name": "faixa de passos",
        "height": 4,
        "cornerRadius": 2,
        "fill": {
          "$if": { "$eq": ["enabled", "false"] },
          "then": {
            "$token": "on-surface",
            "alpha": { "$token": "state-disabled-content" },
            "over": "surface"
          },
          "else": { "$token": "primary" }
        },
        "width": {
          "$add": [
            {
              "$mul": [
                { "$sub": [{ "$var": "parts" }, { "$add": [{ "$var": "last" }, 1] }] },
                { "$var": "sp" }
              ]
            },
            4
          ]
        },
        "anchors": {
          "centerY": true,
          "left": {
            "$add": [
              8,
              { "$mul": [{ "$add": [{ "$var": "last" }, 1] }, { "$var": "sp" }] }
            ]
          }
        },
        "visible": {
          "$and": [
            { "$var": "dense" },
            { "$lt": [{ "$var": "last" }, { "$var": "parts" }] }
          ]
        }
      },
      {
        "type": "rect",
        "name": "alça",
        "height": 44,
        "width": 4,
        "anchors": {
          "centerY": true,
          "left": {
            "$if": { "$eq": ["type", "range"] },
            "then": {
              "$add": [
                {
                  "$mul": [
                    {
                      "$div": [
                        {
                          "$round": {
                            "$mul": [
                              {
                                "$clamp": [
                                  { "$field": "valueStart", "default": 0.2 },
                                  0,
                                  1
                                ]
                              },
                              {
                                "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                "then": {
                                  "$add": [{ "$floor": { "$field": "steps" } }, 1]
                                },
                                "else": 1000000000
                              }
                            ]
                          }
                        },
                        {
                          "$if": { "$gte": [{ "$field": "steps" }, 1] },
                          "then": { "$add": [{ "$floor": { "$field": "steps" } }, 1] },
                          "else": 1000000000
                        }
                      ]
                    },
                    {
                      "$sub": [
                        { "$sub": [{ "$size": "width" }, 4] },
                        {
                          "$mul": [
                            16,
                            {
                              "$if": { "$gte": [{ "$field": "steps" }, 1] },
                              "then": 1,
                              "else": 0
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "$mul": [
                    8,
                    {
                      "$if": { "$gte": [{ "$field": "steps" }, 1] },
                      "then": 1,
                      "else": 0
                    }
                  ]
                }
              ]
            },
            "else": 0
          }
        },
        "cornerRadius": { "$token": "corner-full" },
        "fill": {
          "$if": { "$eq": ["enabled", "false"] },
          "then": {
            "$token": "on-surface",
            "alpha": { "$token": "state-disabled-content" },
            "over": "surface"
          },
          "else": { "$token": "primary" }
        },
        "visible": { "$eq": ["type", "range"] }
      },
      {
        "type": "rect",
        "name": "alça",
        "height": 44,
        "width": {
          "$if": {
            "$and": [
              { "$not": { "$eq": ["enabled", "false"] } },
              {
                "$or": [
                  { "$eq": ["interaction", "focused"] },
                  { "$eq": ["interaction", "pressed"] }
                ]
              }
            ]
          },
          "then": 2,
          "else": 4
        },
        "anchors": {
          "centerY": true,
          "left": {
            "$add": [
              {
                "$if": {
                  "$and": [
                    { "$gte": [{ "$field": "steps" }, 1] },
                    {
                      "$or": [
                        { "$eq": ["type", "range"] },
                        {
                          "$lt": [
                            {
                              "$abs": {
                                "$sub": [
                                  {
                                    "$mul": [
                                      {
                                        "$round": {
                                          "$mul": [
                                            {
                                              "$clamp": [
                                                {
                                                  "$if": { "$eq": ["type", "range"] },
                                                  "then": {
                                                    "$field": "valueEnd",
                                                    "default": 0.8
                                                  },
                                                  "else": {
                                                    "$field": "value",
                                                    "default": 0.5
                                                  }
                                                },
                                                0,
                                                1
                                              ]
                                            },
                                            {
                                              "$add": [
                                                { "$floor": { "$field": "steps" } },
                                                1
                                              ]
                                            }
                                          ]
                                        }
                                      },
                                      2
                                    ]
                                  },
                                  { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                                ]
                              }
                            },
                            { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                          ]
                        }
                      ]
                    }
                  ]
                },
                "then": {
                  "$add": [
                    8,
                    {
                      "$mul": [
                        {
                          "$div": [
                            {
                              "$round": {
                                "$mul": [
                                  {
                                    "$clamp": [
                                      {
                                        "$if": { "$eq": ["type", "range"] },
                                        "then": { "$field": "valueEnd", "default": 0.8 },
                                        "else": { "$field": "value", "default": 0.5 }
                                      },
                                      0,
                                      1
                                    ]
                                  },
                                  {
                                    "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                    "then": {
                                      "$add": [{ "$floor": { "$field": "steps" } }, 1]
                                    },
                                    "else": 1000000000
                                  }
                                ]
                              }
                            },
                            {
                              "$if": { "$gte": [{ "$field": "steps" }, 1] },
                              "then": {
                                "$add": [{ "$floor": { "$field": "steps" } }, 1]
                              },
                              "else": 1000000000
                            }
                          ]
                        },
                        { "$sub": [{ "$sub": [{ "$size": "width" }, 4] }, 16] }
                      ]
                    }
                  ]
                },
                "else": {
                  "$mul": [
                    {
                      "$div": [
                        {
                          "$round": {
                            "$mul": [
                              {
                                "$clamp": [
                                  {
                                    "$if": { "$eq": ["type", "range"] },
                                    "then": { "$field": "valueEnd", "default": 0.8 },
                                    "else": { "$field": "value", "default": 0.5 }
                                  },
                                  0,
                                  1
                                ]
                              },
                              {
                                "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                "then": {
                                  "$add": [{ "$floor": { "$field": "steps" } }, 1]
                                },
                                "else": 1000000000
                              }
                            ]
                          }
                        },
                        {
                          "$if": { "$gte": [{ "$field": "steps" }, 1] },
                          "then": { "$add": [{ "$floor": { "$field": "steps" } }, 1] },
                          "else": 1000000000
                        }
                      ]
                    },
                    { "$sub": [{ "$size": "width" }, 4] }
                  ]
                }
              },
              {
                "$if": {
                  "$and": [
                    { "$not": { "$eq": ["enabled", "false"] } },
                    {
                      "$or": [
                        { "$eq": ["interaction", "focused"] },
                        { "$eq": ["interaction", "pressed"] }
                      ]
                    }
                  ]
                },
                "then": 1,
                "else": 0
              }
            ]
          }
        },
        "cornerRadius": { "$token": "corner-full" },
        "fill": {
          "$if": { "$eq": ["enabled", "false"] },
          "then": {
            "$token": "on-surface",
            "alpha": { "$token": "state-disabled-content" },
            "over": "surface"
          },
          "else": { "$token": "primary" }
        }
      },
      {
        "type": "repeat",
        "name": "marcas",
        "count": {
          "$if": { "$var": "dense" },
          "then": 0,
          "else": {
            "$add": [
              { "$max": [{ "$floor": { "$field": "steps", "default": 0 } }, 0] },
              2
            ]
          }
        },
        "direction": "row",
        "gap": {
          "$sub": [
            {
              "$div": [
                { "$sub": [{ "$size": "width" }, 20] },
                {
                  "$if": { "$gte": [{ "$field": "steps" }, 1] },
                  "then": { "$add": [{ "$floor": { "$field": "steps" } }, 1] },
                  "else": 1
                }
              ]
            },
            4
          ]
        },
        "template": {
          "type": "frame",
          "name": "posição",
          "width": 4,
          "height": 4,
          "layout": { "type": "none" },
          "children": [
            {
              "type": "ellipse",
              "name": "marca",
              "width": 4,
              "height": 4,
              "fill": {
                "$if": { "$eq": ["enabled", "false"] },
                "then": {
                  "$token": "on-surface",
                  "alpha": { "$token": "state-disabled-container" },
                  "over": "surface"
                },
                "else": { "$token": "secondary-container" }
              },
              "visible": {
                "$and": [
                  { "$gte": [{ "$field": "steps" }, 1] },
                  {
                    "$gt": [
                      { "$field": "$index" },
                      {
                        "$if": { "$eq": ["type", "range"] },
                        "then": {
                          "$if": { "$gte": [{ "$field": "steps" }, 1] },
                          "then": {
                            "$round": {
                              "$mul": [
                                {
                                  "$clamp": [
                                    { "$field": "valueStart", "default": 0.2 },
                                    0,
                                    1
                                  ]
                                },
                                { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                              ]
                            }
                          },
                          "else": {
                            "$clamp": [{ "$field": "valueStart", "default": 0.2 }, 0, 1]
                          }
                        },
                        "else": -1
                      }
                    ]
                  },
                  {
                    "$lt": [
                      { "$field": "$index" },
                      {
                        "$if": { "$gte": [{ "$field": "steps" }, 1] },
                        "then": {
                          "$round": {
                            "$mul": [
                              {
                                "$clamp": [
                                  {
                                    "$if": { "$eq": ["type", "range"] },
                                    "then": { "$field": "valueEnd", "default": 0.8 },
                                    "else": { "$field": "value", "default": 0.5 }
                                  },
                                  0,
                                  1
                                ]
                              },
                              { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                            ]
                          }
                        },
                        "else": {
                          "$clamp": [
                            {
                              "$if": { "$eq": ["type", "range"] },
                              "then": { "$field": "valueEnd", "default": 0.8 },
                              "else": { "$field": "value", "default": 0.5 }
                            },
                            0,
                            1
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "ellipse",
              "name": "marca",
              "width": 4,
              "height": 4,
              "fill": {
                "$if": { "$eq": ["enabled", "false"] },
                "then": {
