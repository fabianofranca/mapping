{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "bar",
  "name": "Bar",
  "description": "A bar with an actions slot whose default content draws the two icon fields.",
  "size": { "width": 360, "height": 56 },
  "preview": { "title": "Title", "actionIcon1": "search", "actionIcon2": "more" },
  "template": {
    "type": "frame",
    "layout": { "type": "row", "align": "center", "gap": 8, "padding": 8 },
    "fill": "#FEF7FF",
    "children": [
      {
        "type": "text",
        "text": { "$field": "title", "default": "Title" },
        "font": { "size": 20, "weight": 500 },
        "width": "fill"
      },
      {
        "type": "slot",
        "id": "actions",
        "name": "actions",
        "width": "hug",
        "height": 40,
        "layout": { "type": "row", "gap": 4, "align": "center" },
        "fallback": {
          "type": "frame",
          "layout": { "type": "row", "align": "center", "gap": 4 },
          "children": [
            {
              "type": "text",
              "text": { "$field": "actionIcon1" },
              "font": { "size": 12 },
              "visible": { "$has": "actionIcon1" },
              "width": "hug"
            },
            {
              "type": "text",
              "text": { "$field": "actionIcon2" },
              "font": { "size": 12 },
              "visible": { "$has": "actionIcon2" },
              "width": "hug"
            }
          ]
        }
      }
    ]
  }
}
