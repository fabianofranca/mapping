{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "top-app-bar",
  "name": "Top app bar",
  "description": "Barra do topo: small e center com 64 de altura; medium (112) e large (152) com o título grande embaixo.",
  "size": {
    "width": 412,
    "height": 152
  },
  "sizing": {
    "width": "fill",
    "height": {
      "$switch": "style",
      "cases": {
        "small": 64,
        "center": 64,
        "medium": 112,
        "large": 152
      },
      "default": 64
    }
  },
  "preview": {
    "title": "Início",
    "style": "small",
    "navigationIcon": "Menu",
    "actionIcon1": "Search",
    "actionIcon2": "MoreVert"
  },
  "template": {
    "type": "frame",
    "name": "top app bar",
    "fill": {
      "$token": "surface"
    },
    "layout": {
      "type": "none"
    },
