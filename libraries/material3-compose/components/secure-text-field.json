                      "default": {
                        "$field": "trailingIcon"
                      }
                    },
                    "width": 24,
                    "height": 24,
                    "color": {
                      "$if": {
                        "$eq": ["enabled", "false"]
                      },
                      "then": {
                        "$token": "on-surface"
                      },
                      "else": {
                        "$if": {
                          "$eq": ["isError", "true"]
                        },
                        "then": {
                          "$if": {
                            "$eq": ["interaction", "hovered"]
                          },
                          "then": {
                            "$token": "on-error-container"
                          },
                          "else": {
                            "$token": "error"
                          }
                        },
                        "else": {
                          "$token": "on-surface-variant"
                        }
                      }
                    },
                    "opacity": {
                      "$if": {
                        "$eq": ["enabled", "false"]
                      },
                      "then": {
                        "$token": "state-disabled-content"
                      },
                      "else": 1
                    },
