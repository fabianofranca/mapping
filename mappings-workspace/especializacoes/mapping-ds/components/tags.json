{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "tags",
  "name": "Tags",
  "description": "Etiqueta (Chip) alternável de 24 px, em pílula; ligada fica em color-selection com borda color-accent.",
  "size": {
    "width": 80,
    "height": 24
  },
  "minSize": {
    "width": 16,
    "height": 16
  },
  "sizing": {
    "width": "hug",
    "height": 24
  },
  "preview": {
    "texto": "Camada",
    "pressionado": "sim",
    "contagem": 3
  },
  "template": {
    "type": "frame",
    "name": "chip",
    "cornerRadius": 999,
    "fill": {
      "$if": {
        "$eq": [
          "pressionado",
          "sim"
        ]
      },
      "then": {
        "$token": "color-selection"
      },
      "else": {
        "$token": "color-surface"
      }
    },
    "stroke": {
      "color": {
        "$if": {
          "$eq": [
            "pressionado",
            "sim"
          ]
        },
        "then": {
          "$token": "color-accent"
        },
        "else": {
          "$token": "color-border-control"
        }
      },
      "width": 1
    },
    "layout": {
      "type": "row",
      "gap": 4,
      "padding": [
        0,
        8
      ],
      "align": "center",
      "justify": "center"
    },
    "children": [
      {
        "type": "text",
        "name": "texto",
        "text": {
          "$field": "texto",
          "default": "Etiqueta"
        },
        "color": {
          "$token": "color-text"
        },
        "font": {
          "size": 12,
          "weight": 400,
          "lineHeight": 16
        }
      },
      {
        "type": "text",
        "name": "contagem",
        "text": {
          "$field": "contagem"
        },
        "color": {
          "$token": "color-text"
        },
        "font": {
          "size": 12,
          "weight": 600,
          "lineHeight": 16
        },
        "visible": {
          "$has": "contagem"
        }
      }
    ]
  }
}
