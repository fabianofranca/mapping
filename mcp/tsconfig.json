{
  // MCP server (stage 3a): runs on Node, without the DOM. It also compiles `src/model/`,
  // which proves that it does not depend on browser types.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "jsx": "preserve",
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["./**/*.ts", "../src/model/**/*.ts", "../tests/mcp/**/*.ts"]
}
