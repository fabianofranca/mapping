{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "segmented-button",
  "name": "Segmented button",
  "description": "Linha de segmentos de 40 com contorno e forma full, um por linha de Opções; o selecionado leva secondary container e um check antes do rótulo.",
  "size": {
    "width": 328,
    "height": 40
  },
  "minSize": {
    "width": 58,
    "height": 40
  },
  "sizing": {
    "width": "fill",
    "height": 40
  },
  "preview": {
    "options": [
      {
        "label": "Dia",
        "icon": "",
        "selected": "false"
      },
      {
        "label": "Semana",
        "icon": "",
        "selected": "true"
      },
      {
        "label": "Mês",
        "icon": "",
        "selected": "false"
      }
    ],
    "selection": "single",
    "enabled": "true"
  },
  "template": {
    "type": "frame",
    "name": "segmented button",
    "cornerRadius": {
      "$token": "corner-full"
    },
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "repeat",
        "name": "segmentos",
        "field": "options",
        "direction": "row",
        "distribute": "fill",
        "anchors": {
          "left": -1,
          "top": 0
        },
        "width": "fill",
        "height": "fill",
        "template": {
          "type": "frame",
          "name": "segmento",
          "width": "fill",
          "height": "fill",
          "minWidth": 58,
          "fill": {
            "$if": {
              "$field": "selected"
            },
            "then": {
              "$token": "secondary-container"
            },
            "else": "none"
          },
          "layout": {
            "type": "none"
          },
          "children": [
            {
              "type": "rect",
              "name": "estado",
              "anchors": {
                "left": 0,
                "right": 0,
                "top": 0,
                "bottom": 0
              },
              "fill": {
                "$token": "on-secondary-container"
              },
              "opacity": {
                "$switch": "interaction",
                "cases": {
                  "hovered": {
                    "$token": "state-hover"
                  },
                  "focused": {
                    "$token": "state-focus"
                  },
                  "pressed": {
                    "$token": "state-pressed"
                  }
                },
                "default": 0
              },
              "visible": {
                "$and": [
                  {
                    "$field": "selected"
                  },
                  {
                    "$not": {
                      "$eq": ["enabled", "false"]
                    }
                  },
                  {
                    "$not": {
                      "$eq": ["interaction", "none"]
                    }
                  }
                ]
              }
            },
            {
              "type": "frame",
              "name": "conteúdo",
              "width": "fill",
              "height": "fill",
              "layout": {
                "type": "row",
                "gap": 8,
                "padding": [8, 12],
                "align": "center",
                "justify": "center"
              },
              "children": [
                {
                  "type": "icon",
                  "name": {
                    "$if": {
                      "$field": "selected"
                    },
                    "then": "check",
                    "else": {
                      "$switch": "icon",
                      "cases": {
                        "Home": "home",
                        "Search": "search",
                        "Person": "person",
                        "Menu": "menu",
                        "MoreVert": "more_vert",
                        "Add": "add",
                        "Check": "check",
                        "Close": "close",
                        "ArrowBack": "arrow_back",
                        "Favorite": "favorite",
                        "Edit": "edit",
                        "Delete": "delete",
                        "Share": "share",
                        "Notifications": "notifications",
                        "Settings": "settings",
                        "Info": "info",
                        "Star": "star",
                        "Email": "email",
                        "Phone": "phone",
                        "Place": "place",
                        "DateRange": "date_range",
                        "ShoppingCart": "shopping_cart",
                        "AccountCircle": "account_circle",
                        "KeyboardArrowRight": "keyboard_arrow_right",
                        "KeyboardArrowDown": "keyboard_arrow_down",
                        "Refresh": "refresh",
                        "Clear": "clear",
                        "Done": "done",
                        "Lock": "lock",
                        "List": "list",
                        "AccountBox": "account_box",
                        "AddCircle": "add_circle",
                        "ArrowDropDown": "arrow_drop_down",
                        "ArrowDropUp": "arrow_drop_up",
                        "ArrowForward": "arrow_forward",
                        "ArrowUpward": "arrow_upward",
                        "ArrowDownward": "arrow_downward",
                        "Build": "build",
                        "Call": "call",
                        "CheckCircle": "check_circle",
                        "Create": "create",
                        "Face": "face",
                        "FavoriteBorder": "favorite_border",
                        "ExitToApp": "exit_to_app",
                        "KeyboardArrowLeft": "keyboard_arrow_left",
                        "KeyboardArrowUp": "keyboard_arrow_up",
                        "LocationOn": "location_on",
                        "MailOutline": "mail_outline",
                        "PlayArrow": "play_arrow",
                        "Send": "send",
                        "ThumbUp": "thumb_up",
                        "Warning": "warning",
                        "Cancel": "cancel",
                        "ExpandMore": "expand_more",
                        "ExpandLess": "expand_less",
                        "ChevronLeft": "chevron_left",
                        "ChevronRight": "chevron_right",
                        "FirstPage": "first_page",
                        "LastPage": "last_page",
                        "MoreHoriz": "more_horiz",
                        "Apps": "apps",
                        "Dashboard": "dashboard",
                        "Folder": "folder",
                        "FolderOpen": "folder_open",
                        "InsertDriveFile": "insert_drive_file",
                        "Description": "description",
                        "Image": "image",
                        "Mic": "mic",
                        "Videocam": "videocam",
                        "Chat": "chat",
                        "Comment": "comment",
                        "Forum": "forum",
                        "NotificationsNone": "notifications_none",
                        "Visibility": "visibility",
                        "VisibilityOff": "visibility_off",
                        "Language": "language",
                        "Public": "public",
                        "Link": "link",
                        "Attachment": "attachment",
                        "ContentCopy": "content_copy",
                        "ContentPaste": "content_paste",
                        "ContentCut": "content_cut",
                        "Save": "save",
                        "Download": "download",
                        "Upload": "upload",
                        "CloudUpload": "cloud_upload",
                        "CloudDownload": "cloud_download",
                        "Cloud": "cloud",
                        "Sync": "sync",
                        "Schedule": "schedule",
                        "AccessTime": "access_time",
                        "CalendarToday": "calendar_today",
                        "Event": "event",
                        "Today": "today",
                        "Timer": "timer",
                        "Alarm": "alarm",
                        "History": "history",
                        "Bookmark": "bookmark",
                        "BookmarkBorder": "bookmark_border",
                        "Label": "label",
                        "Flag": "flag",
                        "Help": "help",
                        "HelpOutline": "help_outline",
                        "Error": "error",
                        "ErrorOutline": "error_outline",
                        "Report": "report",
                        "Block": "block",
                        "Tune": "tune",
                        "FilterList": "filter_list",
                        "Sort": "sort",
                        "Fullscreen": "fullscreen",
                        "Wifi": "wifi",
                        "Bluetooth": "bluetooth",
                        "LightMode": "light_mode",
                        "DarkMode": "dark_mode",
                        "Palette": "palette",
                        "ShoppingBag": "shopping_bag",
                        "Store": "store",
                        "Payment": "payment",
                        "CreditCard": "credit_card",
                        "AttachMoney": "attach_money",
                        "Receipt": "receipt",
                        "Map": "map",
                        "Navigation": "navigation",
                        "DirectionsCar": "directions_car",
                        "Flight": "flight",
                        "MenuOpen": "menu_open",
                        "Logout": "logout",
                        "Login": "login",
                        "People": "people",
                        "Group": "group",
                        "PersonAdd": "person_add",
                        "LockOpen": "lock_open",
                        "Security": "security",
                        "VerifiedUser": "verified_user",
                        "Key": "key",
                        "Pause": "pause",
                        "Stop": "stop",
                        "SkipNext": "skip_next",
                        "SkipPrevious": "skip_previous",
                        "VolumeUp": "volume_up",
                        "VolumeOff": "volume_off",
                        "ThumbDown": "thumb_down",
                        "Reply": "reply",
                        "Inbox": "inbox",
                        "Archive": "archive",
                        "Undo": "undo",
                        "Redo": "redo",
                        "ZoomIn": "zoom_in",
                        "ZoomOut": "zoom_out",
                        "Keyboard": "keyboard",
                        "CheckBox": "check_box",
                        "CheckBoxOutlineBlank": "check_box_outline_blank",
                        "RadioButtonChecked": "radio_button_checked",
                        "RadioButtonUnchecked": "radio_button_unchecked",
                        "ToggleOn": "toggle_on",
                        "ToggleOff": "toggle_off",
                        "StarBorder": "star_border",
                        "StarHalf": "star_half",
                        "Lightbulb": "lightbulb",
                        "Code": "code",
                        "Terminal": "terminal",
                        "Bolt": "bolt",
                        "EditCalendar": "edit_calendar"
                      },
                      "default": {
                        "$field": "icon"
                      }
                    }
                  },
                  "width": 18,
                  "height": 18,
                  "color": {
                    "$if": {
                      "$eq": ["enabled", "false"]
                    },
                    "then": {
                      "$token": "on-surface"
                    },
                    "else": {
                      "$if": {
                        "$field": "selected"
                      },
                      "then": {
                        "$token": "on-secondary-container"
                      },
                      "else": {
                        "$token": "on-surface"
                      }
                    }
                  },
                  "opacity": {
                    "$if": {
                      "$eq": ["enabled", "false"]
                    },
                    "then": {
                      "$token": "state-disabled-content"
                    },
                    "else": 1
                  },
                  "visible": {
                    "$or": [
                      {
                        "$field": "selected"
                      },
                      {
                        "$has": "icon"
                      }
                    ]
                  }
                },
                {
                  "type": "text",
                  "name": "rótulo",
                  "text": {
                    "$field": "label"
                  },
                  "font": {
                    "size": {
                      "$token": "label-large-size"
                    },
                    "weight": {
                      "$token": "label-large-weight"
                    },
                    "lineHeight": {
                      "$token": "label-large-line-height"
                    },
                    "letterSpacing": {
                      "$token": "label-large-tracking"
                    }
                  },
                  "color": {
                    "$if": {
                      "$eq": ["enabled", "false"]
                    },
                    "then": {
                      "$token": "on-surface"
                    },
                    "else": {
                      "$if": {
                        "$field": "selected"
                      },
                      "then": {
                        "$token": "on-secondary-container"
                      },
                      "else": {
                        "$token": "on-surface"
                      }
                    }
                  },
                  "opacity": {
                    "$if": {
                      "$eq": ["enabled", "false"]
                    },
                    "then": {
                      "$token": "state-disabled-content"
                    },
                    "else": 1
                  },
                  "visible": {
                    "$has": "label"
                  }
                }
              ]
            },
            {
              "type": "rect",
              "name": "divisor",
              "width": 1,
              "height": "fill",
              "anchors": {
                "left": 0,
                "top": 0
              },
              "fill": {
                "$token": "outline"
              },
              "opacity": {
                "$if": {
                  "$eq": ["enabled", "false"]
                },
                "then": {
                  "$token": "state-disabled-container"
                },
                "else": 1
              }
            }
          ]
        }
      },
      {
        "type": "frame",
        "name": "contorno",
        "width": "fill",
        "height": "fill",
        "cornerRadius": {
          "$token": "corner-full"
        },
        "fill": "none",
        "stroke": {
          "color": {
            "$token": "outline"
          },
          "width": 1,
          "align": "inside"
        },
        "opacity": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": {
            "$token": "state-disabled-container"
          },
          "else": 1
        }
      }
    ]
  }
}
