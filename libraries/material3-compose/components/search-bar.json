                    "StarBorder": "star_border",
                    "StarHalf": "star_half",
                    "Lightbulb": "lightbulb",
                    "Code": "code",
                    "Terminal": "terminal",
                    "Bolt": "bolt",
                    "EditCalendar": "edit_calendar"
                  },
                  "default": {
                    "$field": "leadingIcon"
                  }
                },
                "width": 24,
                "height": 24,
                "color": {
                  "$token": "on-surface"
                },
                "visible": {
                  "$has": "leadingIcon"
                }
              },
              {
                "type": "frame",
                "name": "consulta (recorte)",
                "width": "fill",
                "height": "hug",
                "clip": true,
                "layout": {
                  "type": "row"
                },
                "visible": {
                  "$has": "query"
                },
                "children": [
                  {
                    "type": "text",
                    "name": "consulta",
                    "text": {
                      "$field": "query"
                    },
                    "font": {
                      "size": {
                        "$token": "body-large-size"
                      },
                      "weight": {
                        "$token": "body-large-weight"
                      },
                      "lineHeight": {
                        "$token": "body-large-line-height"
                      },
                      "letterSpacing": {
                        "$token": "body-large-tracking"
                      },
                      "wrap": "none",
                      "maxLines": 1,
                      "verticalAlign": "cap-middle"
                    },
                    "color": {
                      "$token": "on-surface"
                    },
                    "width": "hug"
                  }
                ]
              },
              {
                "type": "text",
                "name": "dica",
                "text": {
                  "$field": "placeholder"
                },
                "font": {
                  "size": {
                    "$token": "body-large-size"
                  },
                  "weight": {
                    "$token": "body-large-weight"
                  },
                  "lineHeight": {
                    "$token": "body-large-line-height"
                  },
                  "letterSpacing": {
                    "$token": "body-large-tracking"
                  },
                  "verticalAlign": "cap-middle"
                },
                "color": {
                  "$token": "on-surface-variant"
                },
                "width": "fill",
                "visible": {
                  "$and": [
                    {
                      "$not": {
                        "$has": "query"
                      }
                    },
                    {
                      "$has": "placeholder"
                    }
                  ]
                }
              },
              {
                "type": "icon",
                "name": {
                  "$switch": "trailingIcon",
                  "cases": {
