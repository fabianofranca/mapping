{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "card",
  "name": "Card",
  "description": "Card do Material 3 (CardDefaults): forma medium (12), mídia opcional no topo, título, subtítulo e texto; filled (surface container highest), elevated (surface container low, elevação 1) ou outlined (surface com contorno outline variant de 1).",
  "size": {
    "width": 360,
    "height": 244
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "title": "Praia do Rosa",
    "subtitle": "Santa Catarina",
    "supportingText": "Fim de semana de sol.",
    "media": "https://example.com/praia.jpg",
    "style": "elevated"
  },
  "template": {
    "type": "frame",
    "name": "card",
    "cornerRadius": {
      "$token": "corner-medium"
    },
    "fill": {
      "$switch": "style",
      "cases": {
        "elevated": {
          "$token": "surface-container-low"
        },
        "outlined": {
          "$token": "surface"
        }
      },
      "default": {
        "$token": "surface-container-highest"
      }
    },
    "stroke": {
      "color": {
        "$if": {
          "$eq": ["style", "outlined"]
        },
        "then": {
          "$if": {
            "$eq": ["interaction", "focused"]
          },
          "then": {
            "$token": "on-surface"
          },
          "else": {
            "$token": "outline-variant"
          }
        },
        "else": "none"
      },
      "width": 1,
      "align": "inside"
    },
    "shadow": {
      "color": {
        "$if": {
          "$or": [
            {
              "$and": [
                {
                  "$eq": ["style", "elevated"]
                },
                {
                  "$not": {
                    "$or": [
                      {
                        "$eq": ["interaction", "hovered"]
                      },
                      {
                        "$eq": ["interaction", "dragged"]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "$and": [
                {
                  "$or": [
                    {
                      "$eq": ["style", "filled"]
                    },
                    {
                      "$eq": ["style", "outlined"]
                    }
                  ]
                },
                {
                  "$eq": ["interaction", "hovered"]
                }
              ]
            }
          ]
        },
        "then": {
          "$token": "elevation-shadow"
        },
        "else": "none"
      },
      "y": {
        "$token": "elevation-1-y"
      },
      "blur": {
        "$token": "elevation-1-blur"
      }
    },
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "rect",
        "name": "sombra nível 2",
        "fill": {
          "$switch": "style",
          "cases": {
            "elevated": {
              "$token": "surface-container-low"
            },
            "outlined": {
              "$token": "surface"
            }
          },
          "default": {
            "$token": "surface-container-highest"
          }
        },
        "cornerRadius": {
          "$token": "corner-medium"
        },
        "visible": {
          "$and": [
            {
              "$eq": ["style", "elevated"]
            },
            {
              "$eq": ["interaction", "hovered"]
            }
          ]
        },
        "shadow": {
          "color": {
            "$token": "elevation-shadow"
          },
          "y": {
            "$token": "elevation-2-y"
          },
          "blur": {
            "$token": "elevation-2-blur"
          }
        }
      },
      {
        "type": "rect",
        "name": "sombra nível 3",
        "fill": {
          "$switch": "style",
          "cases": {
            "elevated": {
              "$token": "surface-container-low"
            },
            "outlined": {
              "$token": "surface"
            }
          },
          "default": {
            "$token": "surface-container-highest"
          }
        },
        "cornerRadius": {
          "$token": "corner-medium"
        },
        "visible": {
          "$and": [
            {
              "$or": [
                {
                  "$eq": ["style", "filled"]
                },
                {
                  "$eq": ["style", "outlined"]
                }
              ]
            },
            {
              "$eq": ["interaction", "dragged"]
            }
          ]
        },
        "shadow": {
          "color": {
            "$token": "elevation-shadow"
          },
          "y": {
            "$token": "elevation-3-y"
          },
          "blur": {
            "$token": "elevation-3-blur"
          }
        },
        "stroke": {
          "color": {
            "$if": {
              "$eq": ["style", "outlined"]
            },
            "then": {
              "$token": "outline-variant"
            },
            "else": "none"
          },
          "width": 1,
          "align": "inside"
        }
      },
      {
        "type": "rect",
        "name": "sombra nível 4",
        "fill": {
          "$switch": "style",
          "cases": {
            "elevated": {
              "$token": "surface-container-low"
            },
            "outlined": {
              "$token": "surface"
            }
          },
          "default": {
            "$token": "surface-container-highest"
          }
        },
        "cornerRadius": {
          "$token": "corner-medium"
        },
        "visible": {
          "$and": [
            {
              "$eq": ["style", "elevated"]
            },
            {
              "$eq": ["interaction", "dragged"]
            }
          ]
        },
        "shadow": {
          "color": {
            "$token": "elevation-shadow"
          },
          "y": {
            "$token": "elevation-4-y"
          },
          "blur": {
            "$token": "elevation-4-blur"
          }
        }
      },
      {
        "type": "frame",
        "name": "corpo",
        "width": "fill",
        "height": "hug",
        "layout": {
          "type": "column",
          "gap": 0
        },
        "children": [
          {
            "type": "image",
            "name": "mídia",
            "src": {
              "$field": "media"
            },
            "fit": "cover",
            "width": "fill",
            "height": 140,
            "fill": {
              "$token": "surface-container-highest"
            },
            "visible": {
              "$has": "media"
            }
          },
          {
            "type": "frame",
            "name": "conteúdo",
            "width": "fill",
            "height": "hug",
            "layout": {
              "type": "column",
              "gap": 4,
              "padding": 16
            },
            "children": [
              {
                "type": "text",
                "name": "título",
                "text": {
                  "$field": "title",
                  "default": "Title"
                },
                "font": {
                  "size": {
                    "$token": "title-medium-size"
                  },
                  "weight": {
                    "$token": "title-medium-weight"
                  },
                  "lineHeight": {
                    "$token": "title-medium-line-height"
                  },
                  "letterSpacing": {
                    "$token": "title-medium-tracking"
                  }
                },
                "color": {
                  "$token": "on-surface"
                },
                "width": "fill"
              },
              {
                "type": "text",
                "name": "subtítulo",
                "text": {
                  "$field": "subtitle"
                },
                "font": {
                  "size": {
                    "$token": "body-medium-size"
                  },
                  "weight": {
                    "$token": "body-medium-weight"
                  },
                  "lineHeight": {
                    "$token": "body-medium-line-height"
                  },
                  "letterSpacing": {
                    "$token": "body-medium-tracking"
                  }
                },
                "color": {
                  "$token": "on-surface-variant"
                },
                "width": "fill",
                "visible": {
                  "$has": "subtitle"
                }
              },
              {
                "type": "text",
                "name": "apoio",
                "text": {
                  "$field": "supportingText"
                },
                "font": {
                  "size": {
                    "$token": "body-medium-size"
                  },
                  "weight": {
                    "$token": "body-medium-weight"
                  },
                  "lineHeight": {
                    "$token": "body-medium-line-height"
                  },
                  "letterSpacing": {
                    "$token": "body-medium-tracking"
                  }
                },
                "color": {
                  "$token": "on-surface-variant"
                },
                "width": "fill",
                "visible": {
                  "$has": "supportingText"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "rect",
        "name": "estado",
        "fill": {
          "$token": "on-surface"
        },
        "opacity": {
          "$switch": "interaction",
          "cases": {
            "hovered": {
              "$token": "state-hover"
            },
            "focused": {
              "$token": "state-focus"
            },
            "pressed": {
              "$token": "state-pressed"
            },
            "dragged": {
              "$token": "state-dragged"
            }
          },
          "default": 0
        },
        "cornerRadius": {
          "$token": "corner-medium"
        },
        "visible": {
          "$not": {
            "$eq": ["interaction", "none"]
          }
        }
      },
      {
        "type": "rect",
        "name": "anel de foco",
        "cornerRadius": {
          "$token": "corner-medium"
        },
        "fill": "none",
        "stroke": {
          "color": {
            "$token": "secondary"
          },
          "width": 3,
          "align": "outside",
          "offset": 2
        },
        "visible": {
          "$and": [
            {
              "$eq": ["interaction", "focused"]
            },
            {
              "$not": {
                "$eq": ["style", "outlined"]
              }
            }
          ]
        }
      }
    ]
  }
}
