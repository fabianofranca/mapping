        },
        "width": {
          "$ref": "#/$defs/valueSource"
        },
        "height": {
          "$ref": "#/$defs/valueSource"
        },
        "background": {
          "$ref": "#/$defs/valueSource"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/originRoot"
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "node", "screen"],
      "description": "Declaração de origem executável. A estrutura é espelhada aqui; as regras finas (caminhos, âncoras, [*] só em roots[].path, system único) são do validador (parseOrigins).",
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "props", "children"],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "props": {
              "type": "string",
              "minLength": 1
            },
            "children": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "screen": {
          "$ref": "#/$defs/originScreen"
        },
        "booleans": {
          "type": "object",
          "additionalProperties": false,
          "required": ["true", "false"],
          "properties": {
            "true": {
              "type": "string"
            },
            "false": {
              "type": "string"
            }
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "file"],
            "properties": {
