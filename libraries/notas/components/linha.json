{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "linha",
  "name": "Line",
  "description": "A straight line through the middle of the marking, along its whole width (horizontal, the default) or its whole height (vertical). Solid or dashed, any width. Decorative: it never contains other markings.",
  "size": {
    "width": 160,
    "height": 8
  },
  "sizing": {
    "width": "fill",
    "height": "fill"
  },
  "preview": {
    "cor": "#79747E",
    "orientacao": "horizontal"
  },
  "template": {
    "type": "frame",
    "name": "linha",
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "frame",
        "name": "horizontal",
        "layout": {
          "type": "none"
        },
        "visible": {
          "$not": {
            "$eq": ["orientacao", "vertical"]
          }
        },
        "height": {
          "$field": "espessura",
          "default": 1
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "centerY": true
        },
        "stroke": {
          "color": {
            "$if": {
              "$lte": [
                {
                  "$field": "espessura",
                  "default": 1
                },
                0
              ]
            },
            "then": "none",
            "else": {
              "$tokenNamed": {
                "$field": "cor"
              },
              "default": "#79747E"
            }
          },
          "width": {
            "$field": "espessura",
            "default": 1
          },
          "align": "inside",
          "dash": {
            "$switch": "estilo",
            "cases": {
              "tracejado": [6, 4]
            },
            "default": []
          },
          "sides": ["top"]
        },
        "children": []
      },
      {
        "type": "frame",
        "name": "vertical",
        "layout": {
          "type": "none"
        },
        "visible": {
          "$eq": ["orientacao", "vertical"]
        },
        "width": {
          "$field": "espessura",
          "default": 1
        },
        "anchors": {
          "top": 0,
          "bottom": 0,
          "centerX": true
        },
        "stroke": {
          "color": {
            "$if": {
              "$lte": [
                {
                  "$field": "espessura",
                  "default": 1
                },
                0
              ]
            },
            "then": "none",
            "else": {
              "$tokenNamed": {
                "$field": "cor"
              },
              "default": "#79747E"
            }
          },
          "width": {
            "$field": "espessura",
            "default": 1
          },
          "align": "inside",
          "dash": {
            "$switch": "estilo",
            "cases": {
              "tracejado": [6, 4]
            },
            "default": []
          },
          "sides": ["left"]
        },
        "children": []
      }
    ]
  }
}
