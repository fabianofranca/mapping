  "doc": {
    "selected": "whether this chip is selected or not",
    "onClick": "called when this chip is clicked",
    "label": "text label for this chip",
    "modifier": "the [Modifier] to be applied to this chip",
    "enabled": "controls the enabled state of this chip. When `false`, this component will not respond to user input, and it will appear visually disabled and disabled to accessibility services.",
    "leadingIcon": "optional icon at the start of the chip, preceding the [label] text. When [selected] is true, this icon may visually indicate that the chip is selected (for example, via a checkmark icon).",
    "trailingIcon": "optional icon at the end of the chip",
    "shape": "defines the shape of this chip's container, border (when [border] is not null), and shadow (when using [elevation])",
    "colors": "[SelectableChipColors] that will be used to resolve the colors used for this chip in different states. See [FilterChipDefaults.filterChipColors].",
    "colors.containerColor": "the container color of this chip when enabled",
    "colors.labelColor": "the label color of this chip when enabled",
    "colors.iconColor": "the color of this chip's start and end icons when enabled",
    "colors.disabledContainerColor": "the container color of this chip when not enabled",
    "colors.disabledLabelColor": "the label color of this chip when not enabled",
    "colors.disabledLeadingIconColor": "the color of this chip's start icon when not enabled",
    "colors.disabledTrailingIconColor": "the color of this chip's end icon when not enabled",
    "colors.selectedContainerColor": "the container color of this chip when selected",
    "colors.disabledSelectedContainerColor": "the container color of this chip when not enabled and selected",
    "colors.selectedLabelColor": "the label color of this chip when selected",
    "colors.selectedLeadingIconColor": "the color of this chip's start icon when selected",
    "colors.selectedTrailingIconColor": "the color of this chip's end icon when selected",
    "elevation": "[SelectableChipElevation] used to resolve the elevation for this chip in different states. This controls the size of the shadow below the chip. Additionally, when the container color is [ColorScheme.surface], this controls the amount of primary color applied as an overlay. See [FilterChipDefaults.filterChipElevation].",
    "elevation.elevation": "the elevation used when the [FilterChip] is has no other [Interaction]s",
    "elevation.pressedElevation": "the elevation used when the chip is pressed",
    "elevation.focusedElevation": "the elevation used when the chip is focused",
    "elevation.hoveredElevation": "the elevation used when the chip is hovered",
    "elevation.draggedElevation": "the elevation used when the chip is dragged",
    "elevation.disabledElevation": "the elevation used when the chip is not enabled",
    "border": "the border to draw around the container of this chip. Pass `null` for no border. See [FilterChipDefaults.filterChipBorder].",
    "border.enabled": "controls the enabled state of this chip. When `false`, this component will not respond to user input, and it will appear visually disabled and disabled to accessibility services.",
    "border.selected": "whether this chip is selected or not",
    "border.borderColor": "the border color of this chip when enabled and not selected",
    "border.selectedBorderColor": "the border color of this chip when enabled and selected",
    "border.disabledBorderColor": "the border color of this chip when not enabled and not selected",
    "border.disabledSelectedBorderColor": "the border color of this chip when not enabled but selected",
    "border.borderWidth": "the border stroke width of this chip when not selected",
    "border.selectedBorderWidth": "the border stroke width of this chip when selected",
    "interactionSource": "an optional hoisted [MutableInteractionSource] for observing and emitting [Interaction]s for this chip. You can use this to change the chip's appearance or preview the chip in different states. Note that if `null` is provided, interactions will still happen internally."
  }
