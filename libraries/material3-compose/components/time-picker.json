{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "time-picker",
  "name": "Time picker",
  "description": "Seletor de hora em um diálogo de 328: no modo picker, os campos de hora e minuto e o relógio de 256 com o seletor; no modo input, só os campos com os rótulos. Sem 24 horas, mostra o AM/PM.",
  "size": { "width": 328, "height": 528 },
  "sizing": { "width": 328, "height": "hug" },
  "preview": {
    "title": "Selecionar horário",
    "mode": "picker",
    "hour": 14,
    "minute": 30,
    "is24Hour": "true",
    "selection": "hour"
  },
  "template": {
    "type": "frame",
    "name": "time picker",
    "layout": { "type": "column", "padding": 24, "align": "center" },
    "cornerRadius": { "$token": "corner-extra-large" },
    "fill": { "$token": "surface-container-high" },
    "children": [
      {
        "type": "frame",
        "name": "cabeçalho",
        "layout": { "type": "column" },
        "width": "fill",
        "height": 36,
        "visible": { "$has": "title" },
        "children": [
          {
            "type": "text",
            "name": "título",
            "text": { "$field": "title" },
            "font": {
              "size": { "$token": "label-medium-size" },
              "weight": { "$token": "label-medium-weight" },
              "lineHeight": { "$token": "label-medium-line-height" },
              "letterSpacing": { "$token": "label-medium-tracking" }
            },
            "color": { "$token": "on-surface-variant" }
          }
        ]
      },
      {
        "type": "frame",
        "name": "hora e minuto",
        "layout": { "type": "row", "align": "start", "justify": "center" },
        "width": "fill",
        "height": { "$if": { "$eq": ["mode", "input"] }, "then": "hug", "else": 80 },
        "children": [
          {
            "type": "frame",
            "name": "campo da hora",
            "layout": {
              "type": "column",
              "gap": { "$if": { "$eq": ["mode", "input"] }, "then": 7, "else": 0 }
            },
            "width": 96,
            "height": "hug",
            "children": [
              {
                "type": "frame",
                "name": "hora",
                "layout": { "type": "none" },
                "width": 96,
                "height": { "$if": { "$eq": ["mode", "input"] }, "then": 72, "else": 80 },
                "cornerRadius": { "$token": "corner-small" },
                "fill": {
                  "$if": { "$not": { "$eq": ["selection", "minute"] } },
                  "then": { "$token": "primary-container" },
                  "else": { "$token": "surface-container-highest" }
                },
                "stroke": {
                  "color": {
                    "$if": {
                      "$and": [
                        { "$eq": ["mode", "input"] },
                        { "$not": { "$eq": ["selection", "minute"] } }
                      ]
                    },
                    "then": { "$token": "primary" },
                    "else": "none"
                  },
                  "width": 2,
                  "align": "inside"
                },
                "children": [
                  {
                    "type": "rect",
                    "name": "estado",
                    "cornerRadius": { "$token": "corner-small" },
                    "fill": { "$token": "on-primary-container" },
                    "opacity": {
                      "$switch": "interaction",
                      "cases": {
                        "hovered": { "$token": "state-hover" },
                        "focused": { "$token": "state-focus" },
                        "pressed": { "$token": "state-pressed" }
                      },
                      "default": 0
                    },
                    "anchors": { "left": 0, "right": 0, "top": 0, "bottom": 0 },
                    "visible": {
                      "$and": [
                        { "$not": { "$eq": ["interaction", "none"] } },
                        { "$not": { "$eq": ["selection", "minute"] } }
                      ]
                    }
                  },
                  {
                    "type": "text",
                    "name": "valor",
                    "text": {
                      "$if": { "$has": "hour" },
                      "then": {
                        "$if": {
                          "$lt": [
                            {
                              "$if": { "$eq": ["is24Hour", "false"] },
                              "then": {
                                "$add": [
                                  {
                                    "$mod": [{ "$add": [{ "$field": "hour" }, 11] }, 12]
                                  },
                                  1
                                ]
                              },
                              "else": { "$field": "hour" }
                            },
                            10
                          ]
                        },
                        "then": {
                          "$concat": [
                            "0",
                            {
                              "$if": { "$eq": ["is24Hour", "false"] },
                              "then": {
                                "$add": [
                                  {
                                    "$mod": [{ "$add": [{ "$field": "hour" }, 11] }, 12]
                                  },
                                  1
                                ]
                              },
                              "else": { "$field": "hour" }
                            }
                          ]
                        },
                        "else": {
                          "$if": { "$eq": ["is24Hour", "false"] },
                          "then": {
                            "$add": [
                              { "$mod": [{ "$add": [{ "$field": "hour" }, 11] }, 12] },
                              1
                            ]
                          },
                          "else": { "$field": "hour" }
                        }
                      },
                      "else": {
                        "$if": { "$eq": ["is24Hour", "false"] },
                        "then": "12",
                        "else": "00"
                      }
                    },
                    "font": {
                      "size": {
                        "$if": { "$eq": ["mode", "input"] },
                        "then": { "$token": "display-medium-size" },
                        "else": { "$token": "display-large-size" }
                      },
                      "weight": { "$token": "display-large-weight" },
                      "lineHeight": {
                        "$if": { "$eq": ["mode", "input"] },
                        "then": { "$token": "display-medium-line-height" },
                        "else": { "$token": "display-large-line-height" }
                      },
                      "letterSpacing": {
                        "$if": { "$eq": ["mode", "input"] },
                        "then": { "$token": "display-medium-tracking" },
                        "else": { "$token": "display-large-tracking" }
                      },
                      "verticalAlign": "cap-middle"
                    },
                    "color": {
                      "$if": { "$not": { "$eq": ["selection", "minute"] } },
                      "then": { "$token": "on-primary-container" },
                      "else": { "$token": "on-surface" }
                    },
                    "anchors": { "centerX": true, "top": 0, "bottom": 0 }
                  }
                ]
              },
              {
                "type": "text",
                "name": "rótulo da hora",
                "text": "Hora",
                "font": {
                  "size": { "$token": "body-small-size" },
                  "weight": { "$token": "body-small-weight" },
                  "lineHeight": { "$token": "body-small-line-height" },
                  "letterSpacing": { "$token": "body-small-tracking" }
                },
                "color": { "$token": "on-surface-variant" },
                "visible": { "$eq": ["mode", "input"] }
              }
            ]
          },
          {
            "type": "frame",
            "name": "dois pontos",
            "layout": { "type": "row", "align": "center", "justify": "center" },
            "width": 24,
            "height": { "$if": { "$eq": ["mode", "input"] }, "then": 72, "else": 80 },
            "children": [
              {
                "type": "text",
                "name": "separador",
                "text": ":",
                "font": {
                  "size": {
                    "$if": { "$eq": ["mode", "input"] },
                    "then": { "$token": "display-medium-size" },
                    "else": { "$token": "display-large-size" }
                  },
                  "weight": { "$token": "display-large-weight" },
                  "lineHeight": {
                    "$if": { "$eq": ["mode", "input"] },
                    "then": { "$token": "display-medium-line-height" },
                    "else": { "$token": "display-large-line-height" }
                  },
                  "letterSpacing": {
                    "$if": { "$eq": ["mode", "input"] },
                    "then": { "$token": "display-medium-tracking" },
                    "else": { "$token": "display-large-tracking" }
                  },
                  "align": "center",
                  "verticalAlign": "cap-middle"
                },
                "color": { "$token": "on-surface" },
                "width": "fill",
                "height": "fill"
              }
            ]
          },
          {
            "type": "frame",
            "name": "campo do minuto",
            "layout": {
              "type": "column",
              "gap": { "$if": { "$eq": ["mode", "input"] }, "then": 7, "else": 0 }
            },
            "width": 96,
            "height": "hug",
            "children": [
              {
                "type": "frame",
                "name": "minuto",
                "layout": { "type": "none" },
                "width": 96,
                "height": { "$if": { "$eq": ["mode", "input"] }, "then": 72, "else": 80 },
                "cornerRadius": { "$token": "corner-small" },
                "fill": {
                  "$if": { "$eq": ["selection", "minute"] },
                  "then": { "$token": "primary-container" },
                  "else": { "$token": "surface-container-highest" }
                },
                "stroke": {
                  "color": {
                    "$if": {
                      "$and": [
                        { "$eq": ["mode", "input"] },
                        { "$eq": ["selection", "minute"] }
                      ]
                    },
                    "then": { "$token": "primary" },
                    "else": "none"
                  },
                  "width": 2,
                  "align": "inside"
                },
                "children": [
                  {
                    "type": "rect",
                    "name": "estado",
                    "cornerRadius": { "$token": "corner-small" },
                    "fill": { "$token": "on-primary-container" },
                    "opacity": {
                      "$switch": "interaction",
                      "cases": {
                        "hovered": { "$token": "state-hover" },
                        "focused": { "$token": "state-focus" },
                        "pressed": { "$token": "state-pressed" }
                      },
                      "default": 0
                    },
                    "anchors": { "left": 0, "right": 0, "top": 0, "bottom": 0 },
                    "visible": {
                      "$and": [
                        { "$not": { "$eq": ["interaction", "none"] } },
                        { "$eq": ["selection", "minute"] }
                      ]
                    }
                  },
                  {
                    "type": "text",
                    "name": "valor",
                    "text": {
                      "$if": { "$has": "minute" },
                      "then": {
                        "$if": { "$lt": [{ "$field": "minute" }, 10] },
                        "then": { "$concat": ["0", { "$field": "minute" }] },
                        "else": { "$field": "minute" }
                      },
                      "else": "00"
                    },
                    "font": {
                      "size": {
                        "$if": { "$eq": ["mode", "input"] },
                        "then": { "$token": "display-medium-size" },
                        "else": { "$token": "display-large-size" }
                      },
                      "weight": { "$token": "display-large-weight" },
                      "lineHeight": {
                        "$if": { "$eq": ["mode", "input"] },
                        "then": { "$token": "display-medium-line-height" },
                        "else": { "$token": "display-large-line-height" }
                      },
                      "letterSpacing": {
                        "$if": { "$eq": ["mode", "input"] },
                        "then": { "$token": "display-medium-tracking" },
                        "else": { "$token": "display-large-tracking" }
                      },
                      "verticalAlign": "cap-middle"
                    },
                    "color": {
                      "$if": { "$eq": ["selection", "minute"] },
                      "then": { "$token": "on-primary-container" },
                      "else": { "$token": "on-surface" }
                    },
                    "anchors": { "centerX": true, "top": 0, "bottom": 0 }
                  }
                ]
              },
              {
                "type": "text",
                "name": "rótulo do minuto",
                "text": "Minuto",
                "font": {
                  "size": { "$token": "body-small-size" },
                  "weight": { "$token": "body-small-weight" },
                  "lineHeight": { "$token": "body-small-line-height" },
                  "letterSpacing": { "$token": "body-small-tracking" }
                },
                "color": { "$token": "on-surface-variant" },
                "visible": { "$eq": ["mode", "input"] }
              }
            ]
          },
          {
            "type": "rect",
            "name": "espaço",
            "width": 12,
            "height": 1,
            "fill": "none",
            "visible": { "$eq": ["is24Hour", "false"] }
          },
          {
            "type": "frame",
            "name": "AM e PM",
            "layout": { "type": "column" },
            "width": 52,
            "height": { "$if": { "$eq": ["mode", "input"] }, "then": 72, "else": 80 },
            "cornerRadius": { "$token": "corner-small" },
            "clip": true,
            "stroke": { "color": { "$token": "outline" }, "width": 1, "align": "inside" },
            "visible": { "$eq": ["is24Hour", "false"] },
            "children": [
              {
                "type": "frame",
                "name": "AM",
                "layout": { "type": "row", "align": "center", "justify": "center" },
                "width": "fill",
                "height": "fill",
                "fill": {
                  "$if": { "$not": { "$gte": [{ "$field": "hour" }, 12] } },
                  "then": { "$token": "tertiary-container" },
                  "else": "none"
                },
                "children": [
                  {
                    "type": "text",
                    "name": "texto",
                    "text": "AM",
                    "font": {
                      "size": { "$token": "title-medium-size" },
                      "weight": { "$token": "title-medium-weight" },
                      "lineHeight": { "$token": "title-medium-line-height" },
                      "letterSpacing": { "$token": "title-medium-tracking" },
                      "verticalAlign": "cap-middle"
                    },
                    "color": {
                      "$if": { "$not": { "$gte": [{ "$field": "hour" }, 12] } },
                      "then": { "$token": "on-tertiary-container" },
                      "else": { "$token": "on-surface-variant" }
                    },
                    "height": "fill"
                  }
                ]
              },
              {
                "type": "rect",
                "name": "divisor",
                "width": "fill",
                "height": 1,
                "fill": { "$token": "outline" }
              },
              {
                "type": "frame",
                "name": "PM",
                "layout": { "type": "row", "align": "center", "justify": "center" },
                "width": "fill",
                "height": "fill",
                "fill": {
                  "$if": { "$gte": [{ "$field": "hour" }, 12] },
                  "then": { "$token": "tertiary-container" },
                  "else": "none"
                },
                "children": [
                  {
                    "type": "text",
                    "name": "texto",
                    "text": "PM",
                    "font": {
                      "size": { "$token": "title-medium-size" },
                      "weight": { "$token": "title-medium-weight" },
                      "lineHeight": { "$token": "title-medium-line-height" },
                      "letterSpacing": { "$token": "title-medium-tracking" },
                      "verticalAlign": "cap-middle"
                    },
                    "color": {
                      "$if": { "$gte": [{ "$field": "hour" }, 12] },
                      "then": { "$token": "on-tertiary-container" },
                      "else": { "$token": "on-surface-variant" }
                    },
                    "height": "fill"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "rect",
        "name": "margem",
        "width": "fill",
        "height": 36,
        "fill": "none",
        "visible": { "$not": { "$eq": ["mode", "input"] } }
      },
      {
        "type": "frame",
        "name": "relógio",
        "layout": { "type": "none" },
        "width": 256,
        "height": 256,
        "cornerRadius": { "$token": "corner-full" },
        "fill": { "$token": "surface-container-highest" },
        "children": [
          {
            "type": "repeat",
            "name": "números",
