{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "button",
  "name": "Button",
  "description": "Botão com rótulo e ícone opcional: filled, tonal, elevated, outlined ou text; 40 de altura e forma full.",
  "size": {
    "width": 136,
    "height": 40
  },
  "minSize": {
    "width": 58,
    "height": 40
  },
  "sizing": {
    "width": "hug",
    "height": 40
  },
  "preview": {
    "label": "Salvar",
    "style": "filled",
    "enabled": "true",
    "icon": ""
  },
  "template": {
    "type": "frame",
    "name": "button",
    "clip": false,
    "layout": {
      "type": "none"
    },
    "minWidth": 58,
    "minHeight": 40,
    "children": [
      {
        "type": "rect",
        "name": "sombra elevada",
        "fill": {
          "$token": "surface-container-low"
        },
        "cornerRadius": {
          "$token": "corner-full"
        },
        "visible": {
          "$and": [
            {
              "$eq": ["style", "elevated"]
            },
            {
              "$eq": ["interaction", "hovered"]
            },
            {
              "$not": {
                "$eq": ["enabled", "false"]
              }
            }
          ]
        },
        "shadow": {
          "color": {
            "$token": "elevation-shadow"
          },
          "y": 2,
          "blur": 6
        }
      },
      {
        "type": "rect",
        "name": "container",
        "fill": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": {
            "$switch": "style",
            "cases": {
              "outlined": "none",
              "text": "none"
            },
            "default": {
              "$token": "on-surface"
            }
          },
          "else": {
            "$switch": "style",
            "cases": {
              "filled": {
                "$token": "primary"
              },
              "tonal": {
                "$token": "secondary-container"
              },
              "elevated": {
                "$token": "surface-container-low"
              }
            },
            "default": "none"
          }
        },
        "opacity": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": {
            "$switch": "style",
            "cases": {
              "tonal": {
                "$token": "state-disabled-container"
              }
            },
            "default": {
              "$token": "state-disabled-container-filled"
            }
          },
          "else": 1
        },
        "cornerRadius": {
          "$token": "corner-full"
        },
        "shadow": {
          "color": {
            "$if": {
              "$and": [
                {
                  "$not": {
                    "$eq": ["enabled", "false"]
                  }
                },
                {
                  "$or": [
                    {
                      "$and": [
                        {
                          "$eq": ["style", "elevated"]
                        },
                        {
                          "$not": {
                            "$eq": ["interaction", "hovered"]
                          }
                        }
                      ]
                    },
                    {
                      "$and": [
                        {
                          "$or": [
                            {
                              "$eq": ["style", "filled"]
                            },
                            {
                              "$eq": ["style", "tonal"]
                            }
                          ]
                        },
                        {
                          "$eq": ["interaction", "hovered"]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "then": {
              "$token": "elevation-shadow"
            },
            "else": "none"
          },
          "y": 1,
          "blur": 2
        }
      },
      {
        "type": "rect",
        "name": "contorno",
        "fill": "none",
        "cornerRadius": {
          "$token": "corner-full"
        },
        "visible": {
          "$eq": ["style", "outlined"]
        },
        "opacity": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": {
            "$token": "state-disabled-container-filled"
          },
          "else": 1
        },
        "stroke": {
          "color": {
            "$token": "outline-variant"
          },
          "width": 1
        }
      },
      {
        "type": "rect",
        "name": "estado",
        "fill": {
          "$switch": "style",
          "cases": {
            "filled": {
              "$token": "on-primary"
            },
            "tonal": {
              "$token": "on-secondary-container"
            },
            "outlined": {
              "$token": "on-surface-variant"
            }
          },
          "default": {
            "$token": "primary"
          }
        },
        "opacity": {
          "$switch": "interaction",
          "cases": {
            "hovered": {
              "$token": "state-hover"
            },
            "focused": {
              "$token": "state-focus"
            },
            "pressed": {
              "$token": "state-pressed"
            }
          },
          "default": 0
        },
        "cornerRadius": {
          "$token": "corner-full"
        },
        "visible": {
          "$and": [
            {
              "$not": {
                "$eq": ["enabled", "false"]
              }
            },
            {
              "$not": {
                "$eq": ["interaction", "none"]
              }
            }
          ]
        }
      },
      {
        "type": "frame",
        "name": "conteúdo",
        "clip": false,
        "anchors": {
          "centerX": true,
          "centerY": true
        },
        "width": "hug",
        "height": "hug",
        "layout": {
          "type": "row",
          "gap": 8,
          "padding": {
            "$if": {
              "$has": "icon"
            },
            "then": {
              "$if": {
                "$eq": ["style", "text"]
              },
              "then": [8, 16, 8, 12],
              "else": [8, 24, 8, 16]
            },
            "else": {
              "$if": {
                "$eq": ["style", "text"]
              },
              "then": [8, 12],
              "else": [8, 24]
            }
          },
          "align": "center",
          "justify": "center"
        },
        "children": [
          {
            "type": "icon",
            "name": {
              "$switch": "icon",
              "cases": {
                "Home": "home",
                "Search": "search",
                "Person": "person",
                "Menu": "menu",
                "MoreVert": "more_vert",
                "Add": "add",
                "Check": "check",
                "Close": "close",
                "ArrowBack": "arrow_back",
                "Favorite": "favorite",
                "Edit": "edit",
                "Delete": "delete",
                "Share": "share",
                "Notifications": "notifications",
                "Settings": "settings",
                "Info": "info",
                "Star": "star",
                "Email": "email",
                "Phone": "phone",
                "Place": "place",
                "DateRange": "date_range",
                "ShoppingCart": "shopping_cart",
                "AccountCircle": "account_circle",
                "KeyboardArrowRight": "keyboard_arrow_right",
                "KeyboardArrowDown": "keyboard_arrow_down",
                "Refresh": "refresh",
                "Clear": "clear",
                "Done": "done",
                "Lock": "lock",
                "List": "list",
                "AccountBox": "account_box",
                "AddCircle": "add_circle",
                "ArrowDropDown": "arrow_drop_down",
                "ArrowDropUp": "arrow_drop_up",
                "ArrowForward": "arrow_forward",
                "ArrowUpward": "arrow_upward",
                "ArrowDownward": "arrow_downward",
                "Build": "build",
                "Call": "call",
                "CheckCircle": "check_circle",
                "Create": "create",
                "Face": "face",
                "FavoriteBorder": "favorite_border",
                "ExitToApp": "exit_to_app",
                "KeyboardArrowLeft": "keyboard_arrow_left",
                "KeyboardArrowUp": "keyboard_arrow_up",
                "LocationOn": "location_on",
                "MailOutline": "mail_outline",
                "PlayArrow": "play_arrow",
                "Send": "send",
                "ThumbUp": "thumb_up",
                "Warning": "warning",
                "Cancel": "cancel",
                "ExpandMore": "expand_more",
                "ExpandLess": "expand_less",
                "ChevronLeft": "chevron_left",
                "ChevronRight": "chevron_right",
                "FirstPage": "first_page",
                "LastPage": "last_page",
                "MoreHoriz": "more_horiz",
                "Apps": "apps",
                "Dashboard": "dashboard",
                "Folder": "folder",
                "FolderOpen": "folder_open",
                "InsertDriveFile": "insert_drive_file",
                "Description": "description",
                "Image": "image",
                "Mic": "mic",
                "Videocam": "videocam",
                "Chat": "chat",
                "Comment": "comment",
                "Forum": "forum",
                "NotificationsNone": "notifications_none",
                "Visibility": "visibility",
                "VisibilityOff": "visibility_off",
                "Language": "language",
                "Public": "public",
                "Link": "link",
                "Attachment": "attachment",
                "ContentCopy": "content_copy",
                "ContentPaste": "content_paste",
                "ContentCut": "content_cut",
                "Save": "save",
                "Download": "download",
                "Upload": "upload",
                "CloudUpload": "cloud_upload",
                "CloudDownload": "cloud_download",
                "Cloud": "cloud",
                "Sync": "sync",
                "Schedule": "schedule",
                "AccessTime": "access_time",
                "CalendarToday": "calendar_today",
                "Event": "event",
                "Today": "today",
                "Timer": "timer",
                "Alarm": "alarm",
                "History": "history",
                "Bookmark": "bookmark",
                "BookmarkBorder": "bookmark_border",
                "Label": "label",
                "Flag": "flag",
                "Help": "help",
                "HelpOutline": "help_outline",
                "Error": "error",
                "ErrorOutline": "error_outline",
                "Report": "report",
                "Block": "block",
                "Tune": "tune",
                "FilterList": "filter_list",
                "Sort": "sort",
                "Fullscreen": "fullscreen",
                "Wifi": "wifi",
                "Bluetooth": "bluetooth",
                "LightMode": "light_mode",
                "DarkMode": "dark_mode",
                "Palette": "palette",
                "ShoppingBag": "shopping_bag",
                "Store": "store",
                "Payment": "payment",
                "CreditCard": "credit_card",
                "AttachMoney": "attach_money",
                "Receipt": "receipt",
                "Map": "map",
                "Navigation": "navigation",
                "DirectionsCar": "directions_car",
                "Flight": "flight",
                "MenuOpen": "menu_open",
                "Logout": "logout",
                "Login": "login",
                "People": "people",
                "Group": "group",
                "PersonAdd": "person_add",
                "LockOpen": "lock_open",
                "Security": "security",
                "VerifiedUser": "verified_user",
                "Key": "key",
                "Pause": "pause",
                "Stop": "stop",
                "SkipNext": "skip_next",
                "SkipPrevious": "skip_previous",
                "VolumeUp": "volume_up",
                "VolumeOff": "volume_off",
                "ThumbDown": "thumb_down",
                "Reply": "reply",
                "Inbox": "inbox",
                "Archive": "archive",
                "Undo": "undo",
                "Redo": "redo",
                "ZoomIn": "zoom_in",
                "ZoomOut": "zoom_out",
                "Keyboard": "keyboard",
                "CheckBox": "check_box",
                "CheckBoxOutlineBlank": "check_box_outline_blank",
                "RadioButtonChecked": "radio_button_checked",
                "RadioButtonUnchecked": "radio_button_unchecked",
                "ToggleOn": "toggle_on",
                "ToggleOff": "toggle_off",
                "StarBorder": "star_border",
                "StarHalf": "star_half",
                "Lightbulb": "lightbulb",
                "Code": "code",
                "Terminal": "terminal",
                "Bolt": "bolt",
                "EditCalendar": "edit_calendar"
              },
              "default": {
                "$field": "icon"
              }
            },
            "width": 18,
            "height": 18,
            "color": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$switch": "style",
                "cases": {
                  "tonal": {
                    "$token": "on-surface"
                  }
                },
                "default": {
                  "$token": "on-surface-variant"
                }
              },
              "else": {
                "$switch": "style",
                "cases": {
                  "filled": {
                    "$token": "on-primary"
                  },
                  "tonal": {
                    "$token": "on-secondary-container"
                  },
                  "outlined": {
                    "$token": "on-surface-variant"
                  },
                  "elevated": {
                    "$token": "primary"
                  },
                  "text": {
                    "$token": "primary"
                  }
                },
                "default": {
                  "$token": "on-primary"
                }
              }
            },
            "opacity": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$token": "state-disabled-content"
              },
              "else": 1
            },
            "visible": {
              "$has": "icon"
            }
          },
          {
            "type": "text",
            "name": "rótulo",
            "text": {
              "$field": "label",
              "default": "Label"
            },
            "font": {
              "size": {
                "$token": "label-large-size"
              },
              "weight": {
                "$token": "label-large-weight"
              },
              "lineHeight": {
                "$token": "label-large-line-height"
              },
              "letterSpacing": {
                "$token": "label-large-tracking"
              }
            },
            "color": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$switch": "style",
                "cases": {
                  "tonal": {
                    "$token": "on-surface"
                  }
                },
                "default": {
                  "$token": "on-surface-variant"
                }
              },
              "else": {
                "$switch": "style",
                "cases": {
                  "filled": {
                    "$token": "on-primary"
                  },
                  "tonal": {
                    "$token": "on-secondary-container"
                  },
                  "outlined": {
                    "$token": "on-surface-variant"
                  },
                  "elevated": {
                    "$token": "primary"
                  },
                  "text": {
                    "$token": "primary"
                  }
                },
                "default": {
                  "$token": "on-primary"
                }
              }
            },
            "opacity": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$token": "state-disabled-content"
              },
              "else": 1
            }
          }
        ]
      }
    ]
  }
}
