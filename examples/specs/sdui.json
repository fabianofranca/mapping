{
  "format": "mapping-spec",
  "formatVersion": 12,
  "id": "sdui",
  "name": "SDUI",
  "version": 4,
  "description": "Screen components and their events for Server-Driven UI.",
  "platforms": [
    {
      "id": "android",
      "name": "Android",
      "language": "kotlin",
      "repo": {
        "url": "https://github.com/org/app-android",
        "urlTemplate": "https://github.com/org/app-android/blob/v3/{path}",
        "ref": "v3"
      }
    },
    {
      "id": "ios",
      "name": "iOS",
      "language": "swift",
      "repo": {
        "url": "https://github.com/org/app-ios",
        "urlTemplate": "https://github.com/org/app-ios/blob/v3/{path}",
        "ref": "v3"
      }
    },
    {
      "id": "bff",
      "name": "BFF",
      "language": "kotlin",
      "repo": {
        "url": "https://github.com/org/bff",
        "urlTemplate": "https://github.com/org/bff/blob/v3/{path}",
        "ref": "v3"
      }
    }
  ],
  "docRepos": [
    {
      "id": "design-docs",
      "url": "https://gitlab.example.com/group/sdui-docs",
      "urlTemplate": "https://gitlab.example.com/group/sdui-docs/-/blob/main/{path}",
      "ref": "main"
    }
  ],
  "layers": [
    {
      "id": "components",
      "name": "Components",
      "color": "#1E88E5",
      "annotationTypes": [
        {
          "id": "button",
          "name": "Button",
          "doc": {
            "repo": "design-docs",
            "path": "components/button.md"
          },
          "allowedChildren": [
            {
              "layer": "events",
              "groups": ["interaction"]
            }
          ],
          "childRolesLabel": "Trigger",
          "childRoles": [
            {
              "id": "click",
              "name": "Click",
              "description": "The tap or click on the component."
            },
            {
              "id": "hold",
              "name": "Press",
              "description": "The long press that holds the component."
            }
          ],
          "fields": [
            {
              "key": "id",
              "type": "string",
              "required": true
            },
            {
              "key": "text",
              "type": "string",
              "required": true
            },
            {
              "key": "style",
              "type": "enum",
              "options": ["primary", "secondary", "text"],
              "default": "primary"
            },
            {
              "key": "enabled",
              "type": "enum",
              "options": ["yes", "no"],
              "default": "yes"
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.DSButton",
              "path": "app/src/main/java/com/app/ds/DSButton.kt",
              "params": {
                "text": "text",
                "style": "style",
                "enabled": "enabled"
              },
              "values": {
                "style": {
                  "primary": "ButtonStyle.Primary",
                  "secondary": "ButtonStyle.Secondary",
                  "text": "ButtonStyle.Text"
                },
                "enabled": {
                  "yes": "true",
                  "no": "false"
                }
              },
              "notes": "Use the testTag modifier with the value of the id field."
            },
            "ios": {
              "symbol": "DSButton",
              "path": "App/DesignSystem/DSButton.swift",
              "params": {
                "text": "title",
                "style": "style",
                "enabled": "isEnabled"
              },
              "values": {
                "style": {
                  "primary": ".primary",
                  "secondary": ".secondary",
                  "text": ".text"
                },
                "enabled": {
                  "yes": "true",
                  "no": "false"
                }
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.button",
              "path": "src/main/kotlin/com/app/bff/sdui/Components.kt",
              "params": {
                "id": "id",
                "text": "label",
                "style": "variant",
                "enabled": "enabled"
              },
              "notes": "The function returns the component node in the screen JSON."
            }
          }
        },
        {
          "id": "input",
          "name": "Input",
          "allowedChildren": [
            {
              "layer": "events",
              "groups": ["data"]
            }
          ],
          "childRolesLabel": "Trigger",
          "childRoles": [
            {
              "id": "change",
              "name": "Change",
              "description": "The typed value changed."
            }
          ],
          "fields": [
            {
              "key": "id",
              "type": "string",
              "required": true
            },
            {
              "key": "inputType",
              "type": "enum",
              "options": ["text", "email", "password", "number", "phone"],
              "default": "text",
              "required": true
            },
            {
              "key": "placeholder",
              "type": "string"
            },
            {
              "key": "required",
              "type": "enum",
              "options": ["yes", "no"],
              "default": "no"
            },
            {
              "key": "maxLength",
              "type": "number"
            },
            {
              "key": "data",
              "type": "ref",
              "accepts": {
                "tags": ["data-field"],
                "free": true
              },
              "description": "Data model attribute shown and edited by this field"
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.DSTextField",
              "path": "app/src/main/java/com/app/ds/DSTextField.kt",
              "params": {
                "inputType": "keyboardType",
                "placeholder": "placeholder",
                "required": "required",
                "maxLength": "maxLength"
              },
              "values": {
                "inputType": {
                  "text": "KeyboardType.Text",
                  "email": "KeyboardType.Email",
                  "password": "KeyboardType.Password",
                  "number": "KeyboardType.Number",
                  "phone": "KeyboardType.Phone"
                },
                "required": {
                  "yes": "true",
                  "no": "false"
                }
              },
              "notes": "The data field names the data model attribute linked to the typed value."
            },
            "ios": {
              "symbol": "DSTextField",
              "params": {
                "inputType": "keyboardType",
                "placeholder": "placeholder",
                "required": "isRequired",
                "maxLength": "maxLength"
              },
              "values": {
                "inputType": {
                  "text": ".default",
                  "email": ".emailAddress",
                  "password": ".default",
                  "number": ".numberPad",
                  "phone": ".phonePad"
                },
                "required": {
                  "yes": "true",
                  "no": "false"
                }
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.input",
              "path": "src/main/kotlin/com/app/bff/sdui/Components.kt",
              "params": {
                "id": "id",
                "inputType": "type",
                "placeholder": "placeholder",
                "required": "required",
                "maxLength": "maxLength"
              },
              "notes": "The function returns the component node in the screen JSON."
            }
          }
        },
        {
          "id": "text",
          "name": "Text",
          "fields": [
            {
              "key": "id",
              "type": "string",
              "required": true
            },
            {
              "key": "content",
              "type": "string",
              "required": true
            },
            {
              "key": "style",
              "type": "enum",
              "options": ["title", "body", "caption"],
              "default": "body"
            },
            {
              "key": "data",
              "type": "ref",
              "accepts": {
                "tags": ["data-field"],
                "free": true
              },
              "description": "Attribute shown by this text (optional)"
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.DSText",
              "params": {
                "content": "text",
                "style": "style"
              },
              "values": {
                "style": {
                  "title": "TextStyle.Title",
                  "body": "TextStyle.Body",
                  "caption": "TextStyle.Caption"
                }
              }
            },
            "ios": {
              "symbol": "DSText",
              "params": {
                "content": "text",
                "style": "style"
              },
              "values": {
                "style": {
                  "title": ".title",
                  "body": ".body",
                  "caption": ".caption"
                }
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.text",
              "path": "src/main/kotlin/com/app/bff/sdui/Components.kt",
              "params": {
                "id": "id",
                "content": "content",
                "style": "variant"
              },
              "notes": "The function returns the component node in the screen JSON."
            }
          }
        },
        {
          "id": "image",
          "name": "Image",
          "allowedChildren": [
            {
              "layer": "events",
              "groups": ["interaction"]
            }
          ],
          "childRolesLabel": "Trigger",
          "childRoles": [
            {
              "id": "click",
              "name": "Click",
              "description": "The tap or click on the component."
            }
          ],
          "fields": [
            {
              "key": "id",
              "type": "string",
              "required": true
            },
            {
              "key": "description",
              "label": "description (accessibility)",
              "type": "string",
              "required": true
            },
            {
              "key": "url",
              "type": "string"
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.DSImage",
              "params": {
                "description": "contentDescription",
                "url": "url"
              }
            },
            "ios": {
              "symbol": "DSImage",
              "params": {
                "description": "accessibilityLabel",
                "url": "url"
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.image",
              "path": "src/main/kotlin/com/app/bff/sdui/Components.kt",
              "params": {
                "id": "id",
                "description": "accessibilityLabel",
                "url": "url"
              },
              "notes": "The function returns the component node in the screen JSON."
            }
          }
        }
      ]
    },
    {
      "id": "events",
      "name": "Events",
      "color": "#FB8C00",
      "annotationTypes": [
        {
          "id": "action",
          "name": "Action",
          "groups": ["interaction"],
          "requiresOwner": true,
          "fields": [
            {
              "key": "action",
              "type": "enum",
              "options": ["navigate", "submit", "openUrl", "showDialog", "track"],
              "required": true
            },
            {
              "key": "target",
              "type": "string"
            },
            {
              "key": "parameters",
              "type": "table",
              "columns": [
                {
                  "key": "name",
                  "type": "string",
                  "required": true
                },
                {
                  "key": "value",
                  "type": "string"
                }
              ]
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.Action",
              "params": {
                "action": "action",
                "target": "target",
                "parameters": "params"
              },
              "notes": "Pass the event in the parameter of the role it fills in the owner component (Click in onClick, Press in onHold)."
            },
            "ios": {
              "symbol": "Action",
              "params": {
                "action": "action",
                "target": "target",
                "parameters": "params"
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.action",
              "path": "src/main/kotlin/com/app/bff/sdui/Events.kt",
              "params": {
                "action": "action",
                "target": "target",
                "parameters": "parameters"
              },
              "notes": "The function returns the component node in the screen JSON."
            }
          }
        },
        {
          "id": "feedback",
          "name": "Feedback",
          "groups": ["interaction"],
          "requiresOwner": true,
          "fields": [
            {
              "key": "action",
              "type": "enum",
              "options": ["showTooltip", "showMenu", "track"],
              "required": true
            },
            {
              "key": "durationMs",
              "label": "duration (ms)",
              "type": "number",
              "default": 500
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.Feedback",
              "params": {
                "action": "action",
                "durationMs": "durationMs"
              }
            },
            "ios": {
              "symbol": "Feedback",
              "params": {
                "action": "action",
                "durationMs": "duration"
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.feedback",
              "path": "src/main/kotlin/com/app/bff/sdui/Events.kt",
              "params": {
                "action": "action",
                "durationMs": "durationMs"
              },
              "notes": "The function returns the component node in the screen JSON."
            }
          }
        },
        {
          "id": "validation",
          "name": "Validation",
          "groups": ["data"],
          "requiresOwner": true,
          "fields": [
            {
              "key": "action",
              "type": "enum",
              "options": ["validate", "mask", "track"],
              "required": true
            },
            {
              "key": "rule",
              "type": "string",
              "description": "E.g. email, cpf, minLength:8"
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.Validation",
              "params": {
                "action": "action",
                "rule": "rule"
              }
            },
            "ios": {
              "symbol": "Validation",
              "params": {
                "action": "action",
                "rule": "rule"
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.validation",
              "path": "src/main/kotlin/com/app/bff/sdui/Events.kt",
              "params": {
                "action": "action",
                "rule": "rule"
              },
              "notes": "The function returns the component node in the screen JSON."
            }
          }
        }
      ],
      "groups": [
        {
          "id": "interaction",
          "name": "Interaction",
          "description": "What happens when the person taps, clicks or holds the component."
        },
        {
          "id": "data",
          "name": "Data",
          "description": "Validation and mask of the typed value."
        }
      ]
    },
    {
      "id": "screens",
      "name": "Screens",
      "color": "#00897B",
      "annotationTypes": [
        {
          "id": "screen",
          "name": "Screen",
          "labelField": "name",
          "fields": [
            {
              "key": "name",
              "type": "string",
              "required": true
            },
            {
              "key": "route",
              "type": "string"
            }
          ]
        }
      ]
    }
  ],
  "migrations": [
    {
      "from": 3,
      "to": 4,
      "steps": [
        {
          "op": "set-role",
          "type": "button",
          "childType": "onClick",
          "role": "click"
        },
        {
          "op": "set-role",
          "type": "button",
          "childType": "onHold",
          "role": "hold"
        },
        {
          "op": "set-role",
          "type": "image",
          "childType": "onClick",
          "role": "click"
        },
        {
          "op": "set-role",
          "type": "input",
          "childType": "onChange",
          "role": "change"
        },
        {
          "op": "rename-type",
          "from": "onClick",
          "to": "action"
        },
        {
          "op": "rename-type",
          "from": "onHold",
          "to": "feedback"
        },
        {
          "op": "rename-type",
          "from": "onChange",
          "to": "validation"
        },
        {
          "op": "rename-field",
          "type": "button",
          "from": "texto",
          "to": "text"
        },
        {
          "op": "rename-field",
          "type": "button",
          "from": "estilo",
          "to": "style"
        },
        {
          "op": "rename-field",
          "type": "button",
          "from": "habilitado",
          "to": "enabled"
        },
        {
          "op": "map-values",
          "type": "button",
          "field": "enabled",
          "values": {
            "sim": "yes",
            "não": "no"
          }
        },
        {
          "op": "rename-field",
          "type": "input",
          "from": "tipo",
          "to": "inputType"
        },
        {
          "op": "rename-field",
          "type": "input",
          "from": "obrigatorio",
          "to": "required"
        },
        {
          "op": "map-values",
          "type": "input",
          "field": "required",
          "values": {
            "sim": "yes",
            "não": "no"
          }
        },
        {
          "op": "rename-field",
          "type": "input",
          "from": "dado",
          "to": "data"
        },
        {
          "op": "rename-field",
          "type": "text",
          "from": "conteudo",
          "to": "content"
        },
        {
          "op": "rename-field",
          "type": "text",
          "from": "estilo",
          "to": "style"
        },
        {
          "op": "map-values",
          "type": "text",
          "field": "style",
          "values": {
            "titulo": "title",
            "corpo": "body",
            "legenda": "caption"
          }
        },
        {
          "op": "rename-field",
          "type": "text",
          "from": "dado",
          "to": "data"
        },
        {
          "op": "rename-field",
          "type": "image",
          "from": "descricao",
          "to": "description"
        },
        {
          "op": "rename-field",
          "type": "action",
          "from": "acao",
          "to": "action"
        },
        {
          "op": "rename-field",
          "type": "action",
          "from": "destino",
          "to": "target"
        },
        {
          "op": "rename-field",
          "type": "action",
          "from": "parametros",
          "to": "parameters"
        },
        {
          "op": "rename-field",
          "type": "action",
          "from": "parameters.nome",
          "to": "parameters.name"
        },
        {
          "op": "rename-field",
          "type": "action",
          "from": "parameters.valor",
          "to": "parameters.value"
        },
        {
          "op": "rename-field",
          "type": "feedback",
          "from": "acao",
          "to": "action"
        },
        {
          "op": "rename-field",
          "type": "feedback",
          "from": "duracaoMs",
          "to": "durationMs"
        },
        {
          "op": "rename-field",
          "type": "validation",
          "from": "acao",
          "to": "action"
        },
        {
          "op": "rename-field",
          "type": "validation",
          "from": "regra",
          "to": "rule"
        },
        {
          "op": "rename-field",
          "type": "screen",
          "from": "nome",
          "to": "name"
        },
        {
          "op": "rename-field",
          "type": "screen",
          "from": "rota",
          "to": "route"
        },
        {
          "op": "fill-field",
          "type": "button",
          "field": "text",
          "default": ""
        },
        {
          "op": "fill-field",
          "type": "input",
          "field": "inputType",
          "default": "text"
        },
        {
          "op": "fill-field",
          "type": "text",
          "field": "content",
          "default": ""
        },
        {
          "op": "fill-field",
          "type": "image",
          "field": "description",
          "default": ""
        },
        {
          "op": "fill-field",
          "type": "screen",
          "field": "name",
          "default": ""
        }
      ]
    }
  ]
}
