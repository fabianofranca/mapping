              "$token": "inverse-surface"
            },
            "inverseOnSurface": {
              "$token": "inverse-on-surface"
            },
            "inversePrimary": {
              "$token": "inverse-primary"
            },
            "outline": {
              "$token": "outline"
            },
            "outlineVariant": {
              "$token": "outline-variant"
