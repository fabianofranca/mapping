{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "spacer",
  "name": "Spacer",
  "description": "Espaço vazio entre irmãos: um retângulo tracejado discreto com as medidas.",
  "size": {
    "width": 96,
    "height": 24
  },
  "sizing": {
    "width": 96,
    "height": 24
  },
  "preview": {
    "width": "fixed",
    "height": "fixed",
    "weight": null
  },
  "template": {
    "type": "frame",
    "name": "spacer",
    "clip": true,
    "layout": {
      "type": "none"
    },
    "stroke": {
      "color": {
        "$token": "outline-variant"
      },
      "width": 1,
      "dash": [4, 3]
    },
    "cornerRadius": {
      "$token": "corner-extra-small"
    },
    "children": [
      {
        "type": "text",
        "name": "medidas",
        "width": "hug",
        "height": "hug",
        "anchors": {
          "centerX": true,
          "centerY": true
        },
        "maxWidth": { "$sub": [{ "$size": "width" }, 8] },
        "text": {
          "$concat": [
            {
              "$field": "width",
              "default": "fixed"
            },
            " × ",
            {
              "$field": "height",
              "default": "fixed"
            },
            {
              "$if": {
                "$has": "weight"
              },
              "then": {
                "$concat": [
                  " · weight ",
                  {
                    "$field": "weight"
                  }
                ]
              },
              "else": ""
            }
          ]
        },
        "color": {
          "$token": "outline"
        },
        "font": {
          "size": {
            "$token": "label-small-size"
          },
          "weight": {
            "$token": "label-small-weight"
          },
          "lineHeight": {
            "$token": "label-small-line-height"
          },
          "letterSpacing": {
            "$token": "label-small-tracking"
          },
          "wrap": "none",
          "ellipsis": true
        }
      }
    ]
  }
}
