{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "icon-button",
  "name": "IconButton",
  "description": "Botão de 28 px só com ícone de 16 px, ou com texto ao lado; ligado (pressionado) fica cheio de color-accent.",
  "size": {
    "width": 28,
    "height": 28
  },
  "minSize": {
    "width": 12,
    "height": 12
  },
  "sizing": {
    "width": "hug",
    "height": 28
  },
  "preview": {
    "icone": "plus",
    "rotulo": "Adicionar",
    "texto": "",
    "variant": "default",
    "pressionado": "não",
    "alerta": "não",
    "selo": ""
  },
  "template": {
    "type": "frame",
    "name": "icon-button",
    "layout": {
      "type": "none"
    },
    "cornerRadius": 4,
    "fill": {
      "$if": {
        "$field": "pressionado"
      },
      "then": {
        "$token": "color-accent"
      },
      "else": "rgba(0, 0, 0, 0)"
    },
    "children": [
      {
        "type": "frame",
        "name": "conteúdo",
        "layout": {
          "type": "row",
          "gap": 6,
          "padding": 0,
          "align": "center",
          "justify": "center"
        },
        "children": [
          {
            "type": "icon",
            "width": 16,
            "height": 16,
            "name": {
              "$switch": "icone",
              "cases": {
                "undo": "undo",
                "redo": "redo",
                "edit": "edit",
                "copy": "copy",
                "trash": "trash",
                "plus": "plus",
                "minus": "minus",
                "check": "check",
                "close": "close",
                "refresh": "refresh",
                "pan": "pan",
                "pointer": "pointer",
                "draw": "draw",
                "marking": "marking",
                "arrow": "arrow",
                "crop": "crop",
                "text": "text",
                "fit": "fit",
                "zoomIn": "zoom-in",
                "zoomOut": "zoom-out",
                "search": "search",
                "locate": "locate",
                "filter": "filter",
                "menu": "menu",
                "chevronUp": "chevron-up",
                "chevronDown": "chevron-down",
                "chevronLeft": "chevron-left",
                "chevronRight": "chevron-right",
                "arrowUp": "arrow-up",
                "arrowDown": "arrow-down",
                "arrowLeft": "arrow-left",
                "arrowRight": "arrow-right",
                "collapseAll": "collapse-all",
                "expandAll": "expand-all",
                "maximize": "maximize",
                "minimize": "minimize",
                "externalLink": "external-link",
                "home": "home",
                "panelLeft": "panel-left",
                "panelRight": "panel-right",
                "panelBottom": "panel-bottom",
                "minimap": "minimap",
                "tree": "tree",
                "perspective": "perspective",
                "layers": "layers",
                "list": "list",
                "table": "table",
                "checklist": "checklist",
                "diagnostics": "diagnostics",
                "specialization": "specialization",
                "library": "library",
                "container": "container",
                "containerMark": "container-mark",
                "arrange": "arrange",
                "more": "grip",
                "moreVertical": "grip",
                "grip": "grip",
                "addImage": "add-image",
                "image": "image",
                "folder": "folder",
                "file": "file",
                "save": "save",
                "export": "export",
                "upload": "upload",
                "tag": "tag",
                "link": "link",
                "share": "share",
                "eye": "eye",
                "eyeOff": "eye-off",
                "lock": "lock",
                "unlock": "unlock",
                "info": "info",
                "warning": "warning",
                "error": "error",
                "help": "help",
                "settings": "settings",
                "keyboard": "keyboard",
                "sun": "sun",
                "moon": "moon",
                "proposal": "proposal",
                "chat": "chat",
                "chatAdd": "chat-add",
                "moved": "moved",
                "changed": "changed",
                "replaced": "replaced",
                "compare": "compare",
                "note": "note",
                "blocked": "blocked",
                "globe": "globe"
              }
            },
            "color": {
              "$if": {
                "$field": "pressionado"
              },
              "then": {
                "$token": "color-accent-text"
              },
              "else": {
                "$switch": "variant",
                "cases": {
                  "danger": {
                    "$token": "color-danger"
                  },
                  "accept": {
                    "$token": "color-text-muted"
                  },
                  "reject": {
                    "$token": "color-text-muted"
                  }
                },
                "default": {
                  "$token": "color-text"
                }
              }
            }
          },
          {
            "type": "text",
            "name": "texto",
            "text": {
              "$field": "texto"
            },
            "color": {
              "$if": {
                "$field": "pressionado"
              },
              "then": {
                "$token": "color-accent-text"
              },
              "else": {
                "$token": "color-text"
              }
            },
            "font": {
              "size": 13,
              "weight": 400,
              "lineHeight": 20
            },
            "visible": {
              "$has": "texto"
            }
          }
        ]
      },
      {
        "type": "ellipse",
        "name": "alerta",
        "width": 6,
        "height": 6,
        "anchors": {
          "top": 4,
          "right": 4
        },
        "fill": {
          "$token": "color-danger"
        },
        "visible": {
          "$field": "alerta"
        }
      },
      {
        "type": "frame",
        "name": "selo",
        "width": "hug",
        "height": 16,
        "anchors": {
          "top": 0,
          "right": 0
        },
        "cornerRadius": 999,
        "fill": {
          "$token": "color-accent"
        },
        "visible": {
          "$has": "selo"
        },
        "layout": {
          "type": "row",
          "padding": [
            0,
            4
          ],
          "align": "center",
          "justify": "center"
        },
        "children": [
          {
            "type": "text",
            "name": "número",
            "text": {
              "$field": "selo"
            },
            "color": {
              "$token": "color-accent-text"
            },
            "font": {
              "size": 11,
              "weight": 600,
              "lineHeight": 16
            }
          }
        ]
      }
    ]
  }
}
