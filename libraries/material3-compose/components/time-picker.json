              "else": 12
            },
            "direction": "row",
            "width": 0,
            "height": 0,
            "anchors": { "left": 0, "top": 0 },
            "template": {
              "type": "frame",
              "name": "posição",
              "width": 0,
              "height": 0,
              "layout": { "type": "none" },
              "children": [
                {
                  "type": "text",
                  "name": "número",
                  "text": {
                    "$if": { "$eq": ["selection", "minute"] },
                    "then": { "$mul": [{ "$field": "$index" }, 5] },
                    "else": {
                      "$if": { "$gte": [{ "$field": "$index" }, 12] },
                      "then": { "$field": "$index" },
                      "else": {
                        "$if": { "$eq": ["is24Hour", "false"] },
                        "then": {
                          "$if": { "$lt": [{ "$field": "$index" }, 1] },
                          "then": 12,
                          "else": { "$field": "$index" }
                        },
                        "else": { "$field": "$index" }
                      }
                    }
                  },
                  "font": {
                    "size": { "$token": "body-large-size" },
                    "weight": { "$token": "body-large-weight" },
                    "lineHeight": { "$token": "body-large-line-height" },
                    "letterSpacing": { "$token": "body-large-tracking" },
                    "align": "center",
                    "verticalAlign": "cap-middle"
                  },
                  "color": { "$token": "on-surface" },
                  "width": 24,
                  "height": 24,
                  "anchors": {
                    "right": {
                      "$sub": [
                        {
                          "$mul": [
                            -1,
                            {
                              "$sub": [
                                {
                                  "$add": [
                                    128,
                                    {
                                      "$mul": [
                                        {
                                          "$if": { "$gte": [{ "$field": "$index" }, 12] },
                                          "then": 69,
                                          "else": 101
                                        },
                                        {
                                          "$sin": {
                                            "$mul": [
                                              { "$mod": [{ "$field": "$index" }, 12] },
                                              30
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                },
                                12
                              ]
                            }
                          ]
                        },
                        24
                      ]
                    },
                    "bottom": {
                      "$sub": [
                        {
                          "$mul": [
                            -1,
                            {
                              "$sub": [
                                128,
                                {
                                  "$add": [
                                    12,
                                    {
                                      "$mul": [
                                        {
                                          "$if": { "$gte": [{ "$field": "$index" }, 12] },
                                          "then": 69,
                                          "else": 101
                                        },
                                        {
                                          "$cos": {
                                            "$mul": [
                                              { "$mod": [{ "$field": "$index" }, 12] },
                                              30
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        24
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "type": "path",
            "name": "trilho",
            "width": 256,
            "height": 256,
            "viewBox": [256, 256],
            "d": {
              "$concat": [
                "M128 128L",
                {
                  "$add": [
                    128,
                    {
                      "$mul": [
                        {
                          "$if": {
                            "$and": [
                              { "$not": { "$eq": ["is24Hour", "false"] } },
                              { "$not": { "$eq": ["selection", "minute"] } },
                              { "$gte": [{ "$field": "hour" }, 12] }
                            ]
                          },
                          "then": 69,
                          "else": 101
                        },
                        {
                          "$sin": {
                            "$if": { "$eq": ["selection", "minute"] },
                            "then": { "$mul": [{ "$field": "minute", "default": 0 }, 6] },
                            "else": {
                              "$mul": [
                                { "$mod": [{ "$field": "hour", "default": 0 }, 12] },
                                30
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
