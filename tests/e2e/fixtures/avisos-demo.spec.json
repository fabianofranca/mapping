{
  "format": "mapping-spec",
  "formatVersion": 10,
  "id": "avisos-demo",
  "name": "Notices Demo",
  "version": 1,
  "platforms": [
    {
      "id": "demo",
      "name": "Demo",
      "language": "kotlin",
      "repo": { "url": "https://example.com/demo" }
    }
  ],
  "layers": [
    {
      "id": "ui",
      "name": "UI",
      "color": "#1E88E5",
      "annotationTypes": [
        {
          "id": "legacy",
          "name": "Legacy",
          "code": { "demo": { "symbol": "Legacy" } },
          "notices": [
            { "kind": "removed", "message": "Removed from the contract; use Card." }
          ],
          "fields": [{ "key": "heading", "type": "string" }]
        },
        {
          "id": "card",
          "name": "Card",
          "code": { "demo": { "symbol": "Card" } },
          "notices": [
            {
              "kind": "pending",
              "message": "The contract accepts avatar; the SDK does not yet.",
              "since": "2026-11-04",
              "ref": "contract/card.md"
            }
          ],
          "fields": [
            {
              "key": "style",
              "type": "string",
              "notices": [{ "kind": "deprecated", "message": "Use variant." }]
            },
            {
              "key": "variant",
              "type": "string",
              "notices": [
                { "kind": "diverges", "message": "The sources disagree on the default." }
              ]
            },
            {
              "key": "items",
              "type": "table",
              "columns": [
                {
                  "key": "label",
                  "type": "string",
                  "notices": [
                    { "kind": "pending", "message": "Column not in the SDK yet." }
                  ]
                },
                { "key": "value", "type": "string" }
              ]
            }
          ]
        },
        {
          "id": "simple",
          "name": "Simple",
          "code": { "demo": { "symbol": "Simple" } },
          "fields": [
            { "key": "text", "type": "string" },
            {
              "key": "draft",
              "type": "string",
              "notices": [{ "kind": "removed", "message": "Field outside the contract." }]
            }
          ]
        }
      ]
    }
  ]
}
