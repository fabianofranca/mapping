                            "then": { "$mul": [{ "$field": "minute", "default": 0 }, 6] },
                            "else": {
                              "$mul": [
                                { "$mod": [{ "$field": "hour", "default": 0 }, 12] },
                                30
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "fill": "none",
            "stroke": { "color": { "$token": "primary" }, "width": 2, "align": "center" },
            "anchors": { "left": 0, "top": 0 }
          },
          {
            "type": "frame",
            "name": "alça",
            "width": 48,
            "height": 48,
