{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "tabs",
  "name": "Tabs",
  "description": "Fileira de abas de 48 (72 com o ícone acima do texto): indicador de 3 em primary, do tamanho do rótulo nas primárias e da largura da aba nas secundárias; as roláveis têm recuo de 52 e abas de 90 no mínimo.",
  "size": {
    "width": 412,
    "height": 72
  },
  "sizing": {
    "width": "fill",
    "height": 48
  },
  "preview": {
    "items": [
      {
        "label": "Início",
        "icon": "Home",
        "selected": "true"
      },
      {
        "label": "Buscar",
        "icon": "Search",
        "selected": "false"
      },
      {
        "label": "Perfil",
        "icon": "Person",
        "selected": "false"
      }
    ],
    "style": "primary",
    "iconPosition": "top"
  },
  "template": {
    "type": "frame",
    "name": "tabs",
    "fill": {
      "$token": "surface"
    },
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "frame",
        "name": "divisória",
        "height": 1,
        "anchors": {
          "left": 0,
          "right": 0,
          "bottom": 0
        },
        "stroke": {
          "color": {
            "$token": "outline-variant"
          },
          "width": 1,
          "align": "inside",
          "sides": ["bottom"]
        }
      },
      {
        "type": "frame",
        "name": "abas fixas",
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "visible": {
          "$not": {
            "$or": [
              {
                "$eq": ["style", "primary-scrollable"]
              },
              {
                "$eq": ["style", "secondary-scrollable"]
              }
            ]
          }
        },
        "layout": {
          "type": "row"
        },
        "children": [
          {
            "type": "repeat",
            "name": "abas",
            "field": "items",
            "direction": "row",
            "distribute": "fill",
            "width": "fill",
            "height": "fill",
            "template": {
              "type": "frame",
              "name": "aba",
              "width": "fill",
              "height": "fill",
              "layout": {
                "type": "none"
              },
              "children": [
                {
                  "type": "rect",
                  "name": "estado",
                  "anchors": {
                    "left": 0,
                    "right": 0,
                    "top": 0,
                    "bottom": 0
                  },
                  "fill": {
                    "$if": {
                      "$or": [
                        {
                          "$eq": ["style", "secondary"]
                        },
                        {
                          "$eq": ["style", "secondary-scrollable"]
                        }
                      ]
                    },
                    "then": {
                      "$token": "on-surface"
                    },
                    "else": {
                      "$token": "primary"
                    }
                  },
                  "opacity": {
                    "$switch": "interaction",
                    "cases": {
                      "hovered": {
                        "$token": "state-hover"
                      },
                      "focused": {
                        "$token": "state-focus"
                      },
                      "pressed": {
                        "$token": "state-pressed"
                      }
                    },
                    "default": 0
                  },
                  "visible": {
                    "$and": [
                      {
                        "$field": "selected"
                      },
                      {
                        "$not": {
                          "$eq": ["interaction", "none"]
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "frame",
                  "name": "corpo",
                  "anchors": {
                    "left": 0,
                    "right": 0,
                    "top": 0,
                    "bottom": 0
                  },
                  "layout": {
                    "type": "row",
                    "padding": [0, 16],
                    "align": "stretch",
                    "justify": "center"
                  },
                  "children": [
                    {
                      "type": "frame",
                      "name": "conteúdo",
                      "width": "hug",
                      "minWidth": 24,
                      "height": "fill",
                      "layout": {
                        "type": "none"
                      },
                      "children": [
                        {
                          "type": "frame",
                          "name": "pilha",
                          "anchors": {
                            "left": 0,
                            "right": 0,
                            "top": 0,
                            "bottom": 0
                          },
                          "layout": {
                            "type": {
                              "$if": {
                                "$and": [
                                  {
                                    "$has": "icon"
                                  },
                                  {
                                    "$has": "label"
                                  },
                                  {
                                    "$not": {
                                      "$eq": ["iconPosition", "leading"]
                                    }
                                  }
                                ]
                              },
                              "then": "column",
                              "else": "row"
                            },
                            "gap": {
                              "$if": {
                                "$eq": ["iconPosition", "leading"]
                              },
                              "then": 8,
                              "else": 5
                            },
                            "padding": {
                              "$if": {
                                "$and": [
                                  {
                                    "$has": "icon"
                                  },
                                  {
                                    "$has": "label"
                                  },
                                  {
                                    "$not": {
                                      "$eq": ["iconPosition", "leading"]
                                    }
                                  }
                                ]
                              },
                              "then": [0, 0, 12, 0],
                              "else": 0
                            },
                            "align": "center",
                            "justify": {
                              "$if": {
                                "$and": [
                                  {
                                    "$has": "icon"
                                  },
                                  {
                                    "$has": "label"
                                  },
                                  {
                                    "$not": {
                                      "$eq": ["iconPosition", "leading"]
                                    }
                                  }
                                ]
                              },
                              "then": "end",
                              "else": "center"
                            }
