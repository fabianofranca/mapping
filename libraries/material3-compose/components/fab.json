{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "fab",
  "name": "FAB",
  "description": "Botão de ação flutuante, como o FloatingActionButton do Compose: small 40 (forma medium), regular 56 (forma large) e large 96 (forma extra large), com elevação 3 e o ícone na cor de conteúdo do containerColor.",
  "size": {
    "width": 56,
    "height": 56
  },
  "minSize": {
    "width": 40,
    "height": 40
  },
  "sizing": {
    "width": 56,
    "height": 56
  },
  "preview": {
    "icon": "Add",
    "contentDescription": "Adicionar",
    "size": "regular",
    "containerColor": "primaryContainer"
  },
  "template": {
    "type": "frame",
    "name": "fab",
    "clip": false,
    "layout": {
      "type": "none"
    },
    "cornerRadius": {
      "$switch": "size",
      "cases": {
        "small": {
          "$token": "corner-medium"
        },
        "large": {
          "$token": "corner-extra-large"
        }
      },
      "default": {
        "$token": "corner-large"
      }
    },
    "fill": {
      "$switch": "containerColor",
      "cases": {
        "primary": {
          "$token": "primary"
        },
        "onPrimary": {
          "$token": "on-primary"
        },
        "primaryContainer": {
          "$token": "primary-container"
        },
        "onPrimaryContainer": {
          "$token": "on-primary-container"
        },
        "secondary": {
          "$token": "secondary"
        },
        "onSecondary": {
          "$token": "on-secondary"
        },
        "secondaryContainer": {
          "$token": "secondary-container"
        },
        "onSecondaryContainer": {
          "$token": "on-secondary-container"
        },
        "tertiary": {
          "$token": "tertiary"
        },
        "onTertiary": {
          "$token": "on-tertiary"
        },
        "tertiaryContainer": {
          "$token": "tertiary-container"
        },
        "onTertiaryContainer": {
          "$token": "on-tertiary-container"
        },
        "error": {
          "$token": "error"
        },
        "onError": {
          "$token": "on-error"
        },
        "errorContainer": {
          "$token": "error-container"
        },
        "onErrorContainer": {
          "$token": "on-error-container"
        },
        "background": {
          "$token": "background"
        },
        "onBackground": {
          "$token": "on-background"
        },
        "surface": {
          "$token": "surface"
        },
        "onSurface": {
          "$token": "on-surface"
        },
        "surfaceVariant": {
          "$token": "surface-variant"
        },
        "onSurfaceVariant": {
          "$token": "on-surface-variant"
        },
        "surfaceTint": {
          "$token": "surface-tint"
        },
        "inverseSurface": {
          "$token": "inverse-surface"
        },
        "inverseOnSurface": {
          "$token": "inverse-on-surface"
        },
        "inversePrimary": {
          "$token": "inverse-primary"
        },
        "outline": {
          "$token": "outline"
        },
        "outlineVariant": {
          "$token": "outline-variant"
        },
        "scrim": {
          "$token": "scrim"
        },
        "surfaceBright": {
          "$token": "surface-bright"
        },
        "surfaceDim": {
          "$token": "surface-dim"
        },
        "surfaceContainerLowest": {
          "$token": "surface-container-lowest"
        },
        "surfaceContainerLow": {
          "$token": "surface-container-low"
        },
        "surfaceContainer": {
          "$token": "surface-container"
        },
        "surfaceContainerHigh": {
          "$token": "surface-container-high"
        },
        "surfaceContainerHighest": {
          "$token": "surface-container-highest"
        }
      },
      "default": {
        "$token": "primary-container"
      }
    },
    "shadow": {
      "color": {
        "$token": "elevation-shadow"
      },
      "y": 3,
      "blur": 12
    },
    "children": [
      {
        "type": "icon",
        "name": {
          "$switch": "icon",
          "cases": {
            "Home": "home",
            "Search": "search",
            "Person": "person",
            "Menu": "menu",
            "MoreVert": "more_vert",
            "Add": "add",
            "Check": "check",
            "Close": "close",
            "ArrowBack": "arrow_back",
            "Favorite": "favorite",
            "Edit": "edit",
            "Delete": "delete",
            "Share": "share",
            "Notifications": "notifications",
            "Settings": "settings",
            "Info": "info",
            "Star": "star",
            "Email": "email",
            "Phone": "phone",
            "Place": "place",
            "DateRange": "date_range",
            "ShoppingCart": "shopping_cart",
            "AccountCircle": "account_circle",
            "KeyboardArrowRight": "keyboard_arrow_right",
            "KeyboardArrowDown": "keyboard_arrow_down",
            "Refresh": "refresh",
            "Clear": "clear",
            "Done": "done",
            "Lock": "lock",
            "List": "list",
            "AccountBox": "account_box",
            "AddCircle": "add_circle",
            "ArrowDropDown": "arrow_drop_down",
            "ArrowDropUp": "arrow_drop_up",
            "ArrowForward": "arrow_forward",
            "ArrowUpward": "arrow_upward",
            "ArrowDownward": "arrow_downward",
            "Build": "build",
            "Call": "call",
            "CheckCircle": "check_circle",
            "Create": "create",
            "Face": "face",
            "FavoriteBorder": "favorite_border",
            "ExitToApp": "exit_to_app",
            "KeyboardArrowLeft": "keyboard_arrow_left",
            "KeyboardArrowUp": "keyboard_arrow_up",
            "LocationOn": "location_on",
            "MailOutline": "mail_outline",
            "PlayArrow": "play_arrow",
            "Send": "send",
            "ThumbUp": "thumb_up",
            "Warning": "warning",
            "Cancel": "cancel",
            "ExpandMore": "expand_more",
            "ExpandLess": "expand_less",
            "ChevronLeft": "chevron_left",
            "ChevronRight": "chevron_right",
            "FirstPage": "first_page",
            "LastPage": "last_page",
            "MoreHoriz": "more_horiz",
            "Apps": "apps",
            "Dashboard": "dashboard",
            "Folder": "folder",
            "FolderOpen": "folder_open",
            "InsertDriveFile": "insert_drive_file",
            "Description": "description",
            "Image": "image",
            "Mic": "mic",
            "Videocam": "videocam",
            "Chat": "chat",
            "Comment": "comment",
            "Forum": "forum",
            "NotificationsNone": "notifications_none",
            "Visibility": "visibility",
            "VisibilityOff": "visibility_off",
            "Language": "language",
            "Public": "public",
            "Link": "link",
            "Attachment": "attachment",
            "ContentCopy": "content_copy",
            "ContentPaste": "content_paste",
            "ContentCut": "content_cut",
            "Save": "save",
            "Download": "download",
            "Upload": "upload",
            "CloudUpload": "cloud_upload",
            "CloudDownload": "cloud_download",
            "Cloud": "cloud",
            "Sync": "sync",
            "Schedule": "schedule",
            "AccessTime": "access_time",
            "CalendarToday": "calendar_today",
            "Event": "event",
            "Today": "today",
            "Timer": "timer",
            "Alarm": "alarm",
            "History": "history",
            "Bookmark": "bookmark",
            "BookmarkBorder": "bookmark_border",
            "Label": "label",
            "Flag": "flag",
            "Help": "help",
            "HelpOutline": "help_outline",
            "Error": "error",
            "ErrorOutline": "error_outline",
            "Report": "report",
            "Block": "block",
            "Tune": "tune",
            "FilterList": "filter_list",
            "Sort": "sort",
            "Fullscreen": "fullscreen",
            "Wifi": "wifi",
            "Bluetooth": "bluetooth",
            "LightMode": "light_mode",
            "DarkMode": "dark_mode",
            "Palette": "palette",
            "ShoppingBag": "shopping_bag",
            "Store": "store",
            "Payment": "payment",
            "CreditCard": "credit_card",
            "AttachMoney": "attach_money",
            "Receipt": "receipt",
            "Map": "map",
            "Navigation": "navigation",
            "DirectionsCar": "directions_car",
            "Flight": "flight",
            "MenuOpen": "menu_open",
            "Logout": "logout",
            "Login": "login",
            "People": "people",
            "Group": "group",
            "PersonAdd": "person_add",
            "LockOpen": "lock_open",
            "Security": "security",
            "VerifiedUser": "verified_user",
            "Key": "key",
            "Pause": "pause",
            "Stop": "stop",
            "SkipNext": "skip_next",
            "SkipPrevious": "skip_previous",
            "VolumeUp": "volume_up",
            "VolumeOff": "volume_off",
            "ThumbDown": "thumb_down",
            "Reply": "reply",
            "Inbox": "inbox",
            "Archive": "archive",
            "Undo": "undo",
            "Redo": "redo",
            "ZoomIn": "zoom_in",
            "ZoomOut": "zoom_out",
            "Keyboard": "keyboard",
            "CheckBox": "check_box",
            "CheckBoxOutlineBlank": "check_box_outline_blank",
            "RadioButtonChecked": "radio_button_checked",
            "RadioButtonUnchecked": "radio_button_unchecked",
            "ToggleOn": "toggle_on",
            "ToggleOff": "toggle_off",
            "StarBorder": "star_border",
            "StarHalf": "star_half",
            "Lightbulb": "lightbulb",
            "Code": "code",
            "Terminal": "terminal",
            "Bolt": "bolt",
            "EditCalendar": "edit_calendar"
          },
          "default": {
            "$field": "icon"
          }
        },
        "width": {
          "$if": {
            "$eq": ["size", "large"]
          },
          "then": 36,
          "else": 24
        },
        "height": {
          "$if": {
            "$eq": ["size", "large"]
          },
          "then": 36,
          "else": 24
        },
        "color": {
          "$switch": "containerColor",
          "cases": {
            "primary": {
              "$token": "on-primary"
            },
            "secondary": {
              "$token": "on-secondary"
            },
            "tertiary": {
              "$token": "on-tertiary"
            },
            "background": {
              "$token": "on-background"
            },
            "error": {
              "$token": "on-error"
            },
            "primaryContainer": {
              "$token": "on-primary-container"
            },
            "secondaryContainer": {
              "$token": "on-secondary-container"
            },
            "tertiaryContainer": {
              "$token": "on-tertiary-container"
            },
            "errorContainer": {
              "$token": "on-error-container"
            },
            "inverseSurface": {
              "$token": "inverse-on-surface"
            },
            "surface": {
              "$token": "on-surface"
            },
            "surfaceVariant": {
              "$token": "on-surface-variant"
            }
          },
          "default": {
            "$token": "on-surface"
          }
        },
        "visible": {
          "$has": "icon"
        },
        "anchors": {
          "centerX": true,
          "centerY": true
        }
      }
    ]
  }
}
