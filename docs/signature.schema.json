{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fabianofranca/mapping/blob/main/docs/signature.schema.json",
  "title": "mapping-signature (formatVersion 1)",
  "description": "The signature sheet of a component: the parameters of a @Composable function, the init of a SwiftUI view, or the properties of a Figma component, in a neutral form. The text of SIGNATURE-FORMAT.md is the reference; the uniqueness of parameter names is checked by the app validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "source", "params"],
  "properties": {
    "format": {
      "const": "mapping-signature"
    },
    "formatVersion": {
      "const": 1
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "platform", "language", "symbol", "path", "extractor"],
          "properties": {
            "kind": {
              "const": "code"
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "File that defines the symbol, relative to the repository root."
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "Commit, tag, or branch that was read."
            },
            "extractor": {
              "$ref": "#/$defs/extractor"
            },
            "overload": {
              "type": "integer",
              "minimum": 0
            },
            "init": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "system", "id", "name", "extractor"],
          "properties": {
            "kind": {
              "const": "design"
            },
            "system": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "extractor": {
              "$ref": "#/$defs/extractor"
            }
          }
        }
      ]
    },
    "params": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/param"
      },
      "description": "In source order."
    },
    "doc": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Parameter name → documentation (KDoc @param, Swift ///, Figma description)."
    }
  },
  "$defs": {
    "extractor": {
      "type": "string",
      "pattern": "^(agent|mapping-signature/[a-z0-9-]+@[0-9]+)$",
      "description": "mapping-signature/<reader>@<version> or agent."
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "text",
            "boolean",
            "number",
            "integer",
            "dimension",
            "enum",
            "color",
            "opaque"
          ],
          "description": "dimension is in component units (1 dp, 1 pt, or 1 CSS px at 1x)."
        },
        "default": {
          "type": ["string", "number", "boolean"],
          "description": "Only when the default is a representable literal."
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Only on enum: the constants, as text in the source."
        }
      },
      "description": "options is required on enum and forbidden on the other kinds (checked by the app validator)."
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Swift external label; _ is positional."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Parameter id in the source (the #<id> suffix of the name in Figma)."
        },
        "role": {
          "enum": ["value", "slot", "callback", "modifier", "state", "other"]
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "The type text in the source, normalized only in whitespace."
        },
        "default": {
          "type": "string",
          "description": "The default text in the source."
        },
        "required": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "factory": {
          "$ref": "#/$defs/factory"
        }
      }
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call", "params"],
      "description": "The default's factory, one level only: its parameters have no factory.",
      "properties": {
        "call": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "type"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "description": "Swift external label; _ is positional."
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Parameter id in the source (the #<id> suffix of the name in Figma)."
              },
              "role": {
                "enum": ["value", "slot", "callback", "modifier", "state", "other"]
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "The type text in the source, normalized only in whitespace."
              },
              "default": {
                "type": "string",
                "description": "The default text in the source."
              },
              "required": {
                "type": "boolean"
              },
              "value": {
                "$ref": "#/$defs/value"
              }
            }
          }
        }
      }
    }
  }
}
