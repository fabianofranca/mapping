{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "snackbar",
  "name": "Snackbar",
  "description": "Aviso rápido e temporário em inverse surface: mensagem, ação opcional (texto em inverse primary) e botão de fechar. A altura vem das linhas da mensagem: uma linha mede 48, duas 68 e três 81 (o texto com a primeira linha de base a 30 do topo); com a ação em nova linha a ação desce para uma fileira de 48.",
  "size": {
    "width": 344,
    "height": 48
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "message": "Mensagem arquivada",
    "actionLabel": "Desfazer",
    "dismissAction": "false",
    "actionOnNewLine": "false"
  },
  "template": {
    "type": "frame",
    "name": "snackbar",
    "cornerRadius": {
      "$token": "corner-extra-small"
    },
    "fill": {
      "$token": "inverse-surface"
    },
    "maxWidth": 600,
    "shadow": [
      {
        "color": {
          "$token": "elevation-point-shadow"
        },
        "y": {
          "$token": "elevation-3-point-y"
        },
        "blur": {
          "$token": "elevation-3-point-blur"
        },
        "spread": {
          "$token": "elevation-3-point-spread"
        }
      },
      {
        "color": {
          "$token": "elevation-ambient-shadow"
        },
        "y": {
          "$token": "elevation-3-ambient-y"
        },
        "blur": {
          "$token": "elevation-3-ambient-blur"
        },
        "spread": {
          "$token": "elevation-3-ambient-spread"
        }
      }
    ],
    "layout": {
      "type": "column"
    },
    "children": [
      {
        "type": "frame",
        "name": "linha",
        "width": "fill",
        "height": "hug",
        "minHeight": {
          "$if": {
            "$gt": [
              {
                "$lines": "mensagem"
              },
              1
            ]
          },
          "then": 68,
          "else": 48
        },
        "visible": {
          "$not": {
            "$and": [
              {
                "$eq": ["actionOnNewLine", "true"]
              },
              {
                "$has": "actionLabel"
              }
            ]
          }
        },
        "layout": {
          "type": "row",
          "align": "center",
          "padding": {
            "$if": {
              "$eq": ["dismissAction", "true"]
            },
            "then": [0, 0, 0, 16],
            "else": [0, 8, 0, 16]
          }
        },
        "children": [
          {
            "type": "frame",
            "name": "mensagem",
            "width": "fill",
            "height": "hug",
            "layout": {
              "type": "column",
              "padding": {
                "$if": {
                  "$eq": ["dismissAction", "true"]
                },
                "then": [14, 0, 14, 0],
                "else": [14, 8, 14, 0]
              }
            },
            "children": [
              {
                "type": "text",
                "name": "mensagem",
                "text": {
                  "$field": "message",
                  "default": "Mensagem"
                },
                "width": "fill",
                "font": {
                  "size": {
                    "$token": "body-medium-size"
                  },
                  "weight": {
                    "$token": "body-medium-weight"
                  },
                  "lineHeight": {
                    "$token": "body-medium-line-height"
                  },
                  "letterSpacing": {
                    "$token": "body-medium-tracking"
                  }
                },
                "color": {
                  "$token": "inverse-on-surface"
                }
              }
            ],
            "visible": {
              "$not": {
                "$gt": [
                  {
                    "$lines": "mensagem"
                  },
                  1
                ]
              }
            }
          },
          {
            "type": "frame",
            "name": "mensagem em várias linhas",
            "width": "fill",
            "height": "fill",
            "layout": {
              "type": "column",
              "padding": {
                "$if": {
                  "$eq": ["dismissAction", "true"]
                },
                "then": [0, 0, 0, 0],
                "else": [0, 8, 0, 0]
              }
            },
            "children": [
              {
                "type": "text",
                "name": "mensagem em várias linhas",
                "text": {
                  "$field": "message",
                  "default": "Mensagem"
                },
                "width": "fill",
                "font": {
                  "size": {
                    "$token": "body-medium-size"
                  },
                  "weight": {
                    "$token": "body-medium-weight"
                  },
                  "lineHeight": {
                    "$token": "body-medium-line-height"
                  },
                  "letterSpacing": {
                    "$token": "body-medium-tracking"
                  }
                },
                "color": {
                  "$token": "inverse-on-surface"
                },
                "baselinePadding": {
                  "top": 30,
                  "bottom": 11
                }
              }
            ],
            "visible": {
              "$gt": [
                {
                  "$lines": "mensagem"
                },
                1
              ]
            }
          },
          {
            "type": "frame",
            "name": "ação",
            "width": "hug",
            "height": 48,
            "minWidth": 58,
            "layout": {
              "type": "row",
              "padding": [0, 12],
              "align": "center",
              "justify": "center"
            },
            "visible": {
              "$has": "actionLabel"
            },
            "children": [
              {
                "type": "text",
                "name": "rótulo da ação",
                "text": {
                  "$field": "actionLabel"
                },
                "font": {
                  "size": {
                    "$token": "label-large-size"
                  },
                  "weight": {
                    "$token": "label-large-weight"
                  },
                  "lineHeight": {
                    "$token": "label-large-line-height"
                  },
                  "letterSpacing": {
                    "$token": "label-large-tracking"
                  },
                  "verticalAlign": "cap-middle"
                },
                "color": {
                  "$token": "inverse-primary"
                },
                "height": "fill"
              }
            ]
          },
          {
            "type": "frame",
            "name": "fechar",
            "width": 48,
            "height": 48,
            "layout": {
              "type": "row",
              "align": "center",
              "justify": "center"
            },
            "visible": {
              "$eq": ["dismissAction", "true"]
            },
            "children": [
              {
                "type": "icon",
                "name": "close",
                "color": {
                  "$token": "inverse-on-surface"
                },
                "width": 24,
                "height": 24
              }
            ]
          }
        ]
      },
      {
        "type": "frame",
        "name": "duas linhas",
        "width": "fill",
        "height": "hug",
        "visible": {
          "$and": [
            {
              "$eq": ["actionOnNewLine", "true"]
            },
            {
              "$has": "actionLabel"
            }
          ]
        },
        "layout": {
          "type": "column",
          "padding": [0, 0, 2, 16]
        },
        "children": [
          {
            "type": "frame",
            "name": "mensagem com ação em nova linha",
            "width": "fill",
            "height": "hug",
            "layout": {
              "type": "column",
              "padding": [0, 8, 0, 0]
            },
            "children": [
              {
                "type": "text",
                "name": "mensagem com ação em nova linha",
                "text": {
                  "$field": "message",
                  "default": "Mensagem"
                },
                "width": "fill",
                "font": {
                  "size": {
                    "$token": "body-medium-size"
                  },
                  "weight": {
                    "$token": "body-medium-weight"
                  },
                  "lineHeight": {
                    "$token": "body-medium-line-height"
                  },
                  "letterSpacing": {
                    "$token": "body-medium-tracking"
                  }
                },
                "color": {
                  "$token": "inverse-on-surface"
                },
                "baselinePadding": {
                  "top": 30,
                  "bottom": 12
                }
              }
            ]
          },
          {
            "type": "frame",
            "name": "ações",
            "width": "fill",
            "height": "hug",
            "layout": {
              "type": "row",
              "align": "center",
              "justify": "end",
              "padding": {
                "$if": {
                  "$eq": ["dismissAction", "true"]
                },
                "then": [0, 0, 0, 0],
                "else": [0, 8, 0, 0]
              }
            },
            "children": [
              {
                "type": "frame",
                "name": "ação",
                "width": "hug",
                "height": 48,
                "minWidth": 58,
                "layout": {
                  "type": "row",
                  "padding": [0, 12],
                  "align": "center",
                  "justify": "center"
                },
                "visible": {
                  "$has": "actionLabel"
                },
                "children": [
                  {
                    "type": "text",
                    "name": "rótulo da ação",
                    "text": {
                      "$field": "actionLabel"
                    },
                    "font": {
                      "size": {
                        "$token": "label-large-size"
                      },
                      "weight": {
                        "$token": "label-large-weight"
                      },
                      "lineHeight": {
                        "$token": "label-large-line-height"
                      },
                      "letterSpacing": {
                        "$token": "label-large-tracking"
                      },
                      "verticalAlign": "cap-middle"
                    },
                    "color": {
                      "$token": "inverse-primary"
                    },
                    "height": "fill"
                  }
                ]
              },
              {
                "type": "frame",
                "name": "fechar",
                "width": 48,
                "height": 48,
                "layout": {
                  "type": "row",
                  "align": "center",
                  "justify": "center"
                },
                "visible": {
                  "$eq": ["dismissAction", "true"]
                },
                "children": [
                  {
                    "type": "icon",
                    "name": "close",
                    "color": {
                      "$token": "inverse-on-surface"
                    },
                    "width": 24,
                    "height": 24
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
