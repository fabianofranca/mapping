{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "badge",
  "name": "Badge",
  "description": "Indicador de notificação: pontinho de 6 (small) ou contador de 16 com o texto em onError (large), na cor error. Ancorado ao canto de um ícone pelo BadgedBox.",
  "size": {
    "width": 32,
    "height": 16
  },
  "minSize": {
    "width": 6,
    "height": 6
  },
  "sizing": {
    "width": "hug",
    "height": "hug"
  },
  "preview": {
    "count": "3",
    "style": "large"
  },
  "template": {
    "type": "frame",
    "name": "badge",
    "clip": false,
    "layout": {
      "type": "row",
      "align": "center",
      "justify": "center"
    },
    "children": [
      {
        "type": "frame",
        "name": "pontinho",
        "width": 6,
        "height": 6,
        "cornerRadius": {
          "$token": "corner-full"
        },
        "fill": {
          "$token": "error"
        },
        "visible": {
          "$not": {
            "$eq": ["style", "large"]
          }
        },
        "children": []
      },
      {
        "type": "frame",
        "name": "contador",
        "clip": false,
        "layout": {
          "type": "row",
          "padding": [0, 4],
          "align": "center",
          "justify": "center"
        },
        "width": "hug",
        "height": 16,
        "minWidth": 16,
        "cornerRadius": {
          "$token": "corner-full"
        },
        "fill": {
          "$token": "error"
        },
        "visible": {
          "$eq": ["style", "large"]
        },
        "children": [
          {
            "type": "text",
            "name": "número",
            "text": {
              "$field": "count"
            },
            "font": {
              "size": {
                "$token": "label-small-size"
              },
              "weight": {
                "$token": "label-small-weight"
              },
              "lineHeight": {
                "$token": "label-small-line-height"
              },
              "letterSpacing": {
                "$token": "label-small-tracking"
              }
            },
            "color": {
              "$token": "on-error"
            },
            "height": 16
          }
        ]
      }
    ]
  }
}
