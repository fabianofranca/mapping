{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "thread-message",
  "name": "ThreadMessage",
  "description": "Uma mensagem da conversa: avatar de 24 px, nome, selo de agente, hora relativa e o texto.",
  "size": {
    "width": 344,
    "height": 72
  },
  "minSize": {
    "width": 160,
    "height": 44
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "iniciais": "MA",
    "autor": "Marina Alves",
    "agente": "não",
    "quando": "há 5 min",
    "texto": "É outlined. O da tela de login é o principal da página, por isso filled."
  },
  "template": {
    "type": "frame",
    "name": "mensagem",
    "layout": {
      "type": "row",
      "gap": 8,
      "align": "start"
    },
    "children": [
      {
        "type": "frame",
        "name": "avatar",
        "width": 24,
        "height": 24,
        "cornerRadius": 12,
        "fill": "#eceff3",
        "layout": {
          "type": "row",
          "align": "center",
          "justify": "center"
        },
        "children": [
          {
            "type": "text",
            "name": "iniciais",
            "text": {
              "$field": "iniciais",
              "default": "?"
            },
            "color": "#1b1f24",
            "font": {
              "size": 11,
              "weight": 600,
              "lineHeight": 16
            }
          }
        ]
      },
      {
        "type": "frame",
        "name": "corpo",
        "width": "fill",
        "height": "hug",
        "layout": {
          "type": "column"
        },
        "children": [
          {
            "type": "frame",
            "name": "cabeçalho",
            "width": "fill",
            "height": "hug",
            "layout": {
              "type": "row",
              "gap": 8,
              "align": "center"
            },
            "children": [
              {
                "type": "text",
                "name": "autor",
                "text": {
                  "$field": "autor"
                },
                "color": "#1b1f24",
                "font": {
                  "size": 13,
                  "weight": 600,
                  "lineHeight": 20
                }
              },
              {
                "type": "frame",
                "name": "agente",
                "width": "hug",
                "height": 16,
                "cornerRadius": 999,
                "fill": "#eceff3",
                "visible": {
                  "$eq": [
                    "agente",
                    "sim"
                  ]
                },
                "layout": {
                  "type": "row",
                  "padding": [
                    0,
                    6
                  ],
                  "align": "center"
                },
                "children": [
                  {
                    "type": "text",
                    "name": "agente",
                    "text": "agente",
                    "color": "#5b6470",
                    "font": {
                      "size": 11,
                      "weight": 600,
                      "lineHeight": 16
                    }
                  }
                ]
              },
              {
                "type": "text",
                "name": "quando",
                "text": {
                  "$field": "quando"
                },
                "color": "#5b6470",
                "font": {
                  "size": 12,
                  "weight": 400,
                  "lineHeight": 16
                }
              }
            ]
          },
          {
            "type": "frame",
            "name": "cartão da proposta",
            "width": "fill",
            "height": "hug",
            "cornerRadius": 6,
            "visible": {
              "$has": "proposta"
            },
            "stroke": {
              "color": "#dfe3e8",
              "width": 1
            },
            "layout": {
              "type": "row",
              "gap": 8,
              "padding": [
                6,
                8
              ],
              "align": "center"
            },
            "children": [
              {
                "type": "path",
                "name": "proposta",
                "width": 16,
                "height": 16,
                "viewBox": [
                  16,
                  16
                ],
                "d": "M2.5 4a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0ZM2.5 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0ZM4 5.5v5M10.5 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0ZM12 10.5V6.5a2 2 0 0 0-2-2H8.5M10 2.5-1.8 2 1.8 2",
                "fill": "none",
                "stroke": {
                  "color": "#1b1f24",
                  "width": 1.25
                }
              },
              {
                "type": "frame",
                "name": "texto",
                "width": "fill",
                "height": "hug",
                "layout": {
                  "type": "column"
                },
                "children": [
                  {
                    "type": "text",
                    "name": "título",
                    "text": {
                      "$field": "proposta"
                    },
                    "color": "#1b1f24",
                    "font": {
                      "size": 12,
                      "weight": 600,
                      "lineHeight": 16
                    },
                    "width": "fill"
                  },
                  {
                    "type": "text",
                    "name": "estado",
                    "text": {
                      "$field": "propostaEstado"
                    },
                    "color": "#5b6470",
                    "font": {
                      "size": 12,
                      "weight": 400,
                      "lineHeight": 16
                    },
                    "width": "fill",
                    "visible": {
                      "$has": "propostaEstado"
                    }
                  }
                ]
              },
              {
                "type": "frame",
                "name": "ação",
                "width": "hug",
                "height": 24,
                "cornerRadius": 4,
                "visible": {
                  "$has": "propostaAcao"
                },
                "fill": {
                  "$if": {
                    "$eq": [
                      "propostaAcao",
                      "Revisar"
                    ]
                  },
                  "then": "#1a63cc",
                  "else": "#ffffff"
                },
                "stroke": {
                  "color": {
                    "$if": {
                      "$eq": [
                        "propostaAcao",
                        "Revisar"
                      ]
                    },
                    "then": "#1a63cc",
                    "else": "#7d8590"
                  },
                  "width": 1
                },
                "layout": {
                  "type": "row",
                  "padding": [
                    0,
                    8
                  ],
                  "align": "center",
                  "justify": "center"
                },
                "children": [
                  {
                    "type": "text",
                    "name": "ação",
                    "text": {
                      "$field": "propostaAcao"
                    },
                    "color": {
                      "$if": {
                        "$eq": [
                          "propostaAcao",
                          "Revisar"
                        ]
                      },
                      "then": "#ffffff",
                      "else": "#1b1f24"
                    },
                    "font": {
                      "size": 13,
                      "weight": 400,
                      "lineHeight": 20
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "text",
            "name": "texto",
            "text": {
              "$field": "texto"
            },
            "color": "#1b1f24",
            "font": {
              "size": 13,
              "weight": 400,
              "lineHeight": 20
            },
            "width": "fill"
          }
        ]
      }
    ]
  }
}
