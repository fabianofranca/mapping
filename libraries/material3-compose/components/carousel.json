{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "carousel",
  "name": "Carousel",
  "description": "Carrossel horizontal de itens com imagem e rótulo opcional, um item por linha de Itens: multi-browse (item grande, médio e pequeno que seguem a largura da marcação), uncontained (itens de largura fixa) e centered-hero (um item grande entre dois pequenos). Os tamanhos são os da estratégia do Compose no início da rolagem; a rolagem não existe.",
  "size": {
    "width": 360,
    "height": 205
  },
  "sizing": {
    "width": "fill",
    "height": 205
  },
  "preview": {
    "items": [
      {
        "image": "https://example.com/praia.jpg",
        "label": "Praia"
      },
      {
        "image": "https://example.com/serra.jpg",
        "label": "Serra"
      },
      {
        "image": "https://example.com/cidade.jpg",
        "label": "Cidade"
      }
    ],
    "style": "multi-browse",
    "preferredItemWidth": 186,
    "itemWidth": 186,
    "itemSpacing": 8,
    "width": "fill",
    "height": "fixed",
    "weight": null
  },
  "template": {
    "type": "frame",
    "name": "carousel",
    "let": {
      "smallWidth": {
        "$clamp": [
          {
            "$sub": [
              {
                "$var": "fitRemainder"
              },
              {
                "$add": [
                  {
                    "$field": "itemSpacing",
                    "default": 8
                  },
                  {
                    "$mul": [
                      0.5,
                      {
                        "$add": [
                          {
                            "$field": "preferredItemWidth",
                            "default": 186
                          },
                          {
                            "$clamp": [
                              {
                                "$div": [
                                  {
                                    "$field": "preferredItemWidth",
                                    "default": 186
                                  },
                                  3
                                ]
                              },
                              40,
                              56
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          40,
          56
        ]
      },
      "itemWidthFit": {
        "$sub": [
          {
            "$div": [
              {
                "$add": [
                  {
                    "$size": "width"
                  },
                  {
                    "$mul": [
                      0.5,
                      {
                        "$field": "itemSpacing",
                        "default": 8
                      }
                    ]
                  }
                ]
              },
              {
                "$add": [
                  {
                    "$var": "fitCountPadded"
                  },
                  0.5
                ]
              }
            ]
          },
          {
            "$field": "itemSpacing",
            "default": 8
          }
        ]
      },
      "remainderLarge": {
        "$gte": [
          {
            "$mod": [
              {
                "$add": [
                  {
                    "$size": "width"
                  },
                  {
                    "$mul": [
                      0.265,
                      {
                        "$field": "preferredItemWidth",
                        "default": 186
                      }
                    ]
                  },
                  -70
                ]
              },
              {
                "$add": [
                  {
                    "$field": "preferredItemWidth",
                    "default": 186
                  },
                  {
                    "$field": "itemSpacing",
                    "default": 8
                  }
                ]
              }
            ]
          },
          {
            "$add": [
              {
                "$mul": [
                  0.435,
                  {
                    "$field": "preferredItemWidth",
                    "default": 186
                  }
                ]
              },
              {
                "$mul": [
                  0.45,
                  {
                    "$field": "itemSpacing",
                    "default": 8
                  }
                ]
              },
              -13
            ]
          }
        ]
      },
      "remainderTwice": {
        "$mul": [
          2,
          {
            "$var": "fitRemainder"
          }
        ]
      },
      "fitInverse": {
        "$div": [
          0.05,
          {
            "$var": "fitCountPadded"
          }
        ]
      },
      "fitCountWide": {
        "$max": [
          1,
          {
            "$floor": {
              "$div": [
                {
                  "$add": [
                    {
                      "$size": "width"
                    },
                    {
                      "$mul": [
                        0.785,
                        {
                          "$field": "preferredItemWidth",
                          "default": 186
                        }
                      ]
                    },
                    {
                      "$mul": [
                        1.64,
                        {
                          "$field": "itemSpacing",
                          "default": 8
                        }
                      ]
                    },
                    -6.7
                  ]
                },
                {
                  "$add": [
                    {
                      "$field": "preferredItemWidth",
                      "default": 186
                    },
                    {
                      "$field": "itemSpacing",
                      "default": 8
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "fitRemainder": {
        "$add": [
          {
            "$mul": [
              -0.265,
              {
                "$field": "preferredItemWidth",
                "default": 186
              }
            ]
          },
          {
            "$mod": [
              {
                "$add": [
                  {
                    "$size": "width"
                  },
                  {
                    "$mul": [
                      0.265,
                      {
                        "$field": "preferredItemWidth",
                        "default": 186
                      }
                    ]
                  },
                  -70
                ]
              },
              {
                "$add": [
                  {
                    "$field": "preferredItemWidth",
                    "default": 186
                  },
                  {
                    "$field": "itemSpacing",
                    "default": 8
                  }
                ]
              }
            ]
          },
          70
        ]
      },
      "fitCountPadded": {
        "$max": [
          1,
          {
            "$floor": {
              "$div": [
                {
                  "$add": [
                    {
                      "$size": "width"
                    },
                    {
                      "$mul": [
                        0.2,
                        {
                          "$field": "preferredItemWidth",
                          "default": 186
                        }
                      ]
                    },
                    {
                      "$mul": [
                        0.3,
                        {
                          "$field": "itemSpacing",
                          "default": 8
                        }
                      ]
                    },
                    0.5
                  ]
                },
                {
                  "$add": [
                    {
                      "$field": "preferredItemWidth",
                      "default": 186
                    },
                    {
                      "$field": "itemSpacing",
                      "default": 8
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "rowsFromFitPlus2": {
        "$gte": [
          {
            "$rows": "items"
          },
          {
            "$var": "fitPlus2"
          }
        ]
      },
      "rowsFromFitPlus1": {
        "$gte": [
          {
            "$rows": "items"
          },
          {
            "$var": "fitPlus1"
          }
        ]
      },
      "slotsDouble": {
        "$mul": [
          2,
          {
            "$add": [
              {
                "$mul": [
                  2,
                  {
                    "$var": "fitCount"
                  }
                ]
              },
              1
            ]
          }
        ]
      },
      "indexBeforeFit": {
        "$lt": [
          {
            "$field": "$index"
          },
          {
            "$var": "fitCount"
          }
        ]
      },
      "fitPlus2": {
        "$add": [
          {
            "$var": "fitCount"
          },
          2
        ]
      },
      "fitPlus1": {
        "$add": [
          {
            "$var": "fitCount"
          },
          1
        ]
      },
      "fitCount": {
        "$max": [
          1,
          {
            "$floor": {
              "$div": [
                {
                  "$add": [
                    {
                      "$size": "width"
                    },
                    {
                      "$mul": [
                        0.265,
                        {
                          "$field": "preferredItemWidth",
                          "default": 186
                        }
                      ]
                    },
                    -70
                  ]
                },
                {
                  "$add": [
                    {
                      "$field": "preferredItemWidth",
                      "default": 186
                    },
                    {
                      "$field": "itemSpacing",
                      "default": 8
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "heroSmallCount": {
        "$if": {
          "$gte": [
            {
              "$rows": "items"
            },
            3
          ]
        },
        "then": 2,
        "else": 1
      },
      "heroFits": {
        "$gte": [
          {
            "$size": "width"
          },
          {
            "$add": [
              {
                "$mul": [
                  40,
                  {
                    "$var": "heroSmallCount"
                  }
                ]
              },
              50
            ]
          }
        ]
      },
      "heroStart": {
        "$if": {
          "$and": [
            {
              "$gte": [
                {
                  "$rows": "items"
                },
                3
              ]
            },
            {
              "$var": "heroFits"
            }
          ]
        },
        "then": {
          "$add": [
            40,
            {
              "$field": "itemSpacing",
              "default": 8
            }
          ]
        },
        "else": 0
      },
      "heroWidth": {
        "$if": {
          "$var": "heroFits"
        },
        "then": {
          "$sub": [
            {
              "$size": "width"
            },
            {
              "$mul": [
                {
                  "$var": "heroSmallCount"
                },
                {
                  "$add": [
                    {
                      "$field": "itemSpacing",
                      "default": 8
                    },
                    40
                  ]
                }
              ]
            }
          ]
        },
        "else": {
          "$size": "width"
        }
      },
      "heroRight": {
        "$sub": [
          {
            "$size": "width"
          },
          {
            "$add": [
              {
                "$var": "heroStart"
              },
              {
                "$mul": [
                  {
                    "$field": "$index"
                  },
                  {
                    "$add": [
                      {
                        "$var": "heroWidth"
                      },
                      {
                        "$field": "itemSpacing",
                        "default": 8
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "frame",
        "name": "faixa",
        "width": "fill",
        "anchors": {
          "left": 0,
          "top": 0,
          "bottom": 0
        },
        "layout": {
          "type": "row"
        },
        "children": [
          {
            "type": "frame",
            "name": "recuo",
            "width": {
              "$var": "heroStart"
            },
            "layout": {
              "type": "none"
            },
            "visible": {
              "$eq": ["style", "centered-hero"]
            }
          },
          {
            "type": "repeat",
            "name": "itens",
            "field": "items",
            "direction": "row",
            "gap": {
              "$field": "itemSpacing",
              "default": 8
            },
            "template": {
              "type": "frame",
              "name": "item",
              "width": {
                "$switch": "style",
                "cases": {
                  "uncontained": {
                    "$min": [
                      {
                        "$field": "itemWidth",
                        "default": 140
                      },
                      {
                        "$sub": [
                          {
                            "$size": "width"
                          },
                          {
                            "$mul": [
                              {
                                "$field": "$index"
                              },
                              {
                                "$add": [
                                  {
                                    "$field": "itemWidth",
                                    "default": 140
                                  },
                                  {
                                    "$field": "itemSpacing",
                                    "default": 8
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "centered-hero": {
                    "$min": [
                      {
                        "$var": "heroWidth"
                      },
                      {
                        "$var": "heroRight"
                      }
                    ]
                  }
                },
                "default": {
                  "$if": {
                    "$gte": [
                      {
                        "$field": "preferredItemWidth",
                        "default": 186
                      },
                      {
                        "$size": "width"
                      }
                    ]
                  },
                  "then": {
                    "$if": {
                      "$lt": [
                        {
                          "$field": "$index"
                        },
                        1
                      ]
                    },
                    "then": {
                      "$if": {
                        "$gte": [
                          {
                            "$rows": "items"
                          },
                          2
                        ]
                      },
                      "then": {
                        "$sub": [
                          {
                            "$size": "width"
                          },
                          {
                            "$add": [
                              {
                                "$field": "itemSpacing",
                                "default": 8
                              },
                              40
                            ]
                          }
                        ]
                      },
                      "else": {
                        "$size": "width"
                      }
                    },
                    "else": 40
                  },
                  "else": {
                    "$if": {
                      "$var": "remainderLarge"
                    },
                    "then": {
                      "$if": {
                        "$var": "rowsFromFitPlus2"
                      },
                      "then": {
                        "$if": {
                          "$var": "indexBeforeFit"
                        },
                        "then": "fill",
                        "else": {
                          "$if": {
                            "$lt": [
                              {
                                "$field": "$index"
                              },
                              {
                                "$var": "fitPlus1"
                              }
                            ]
                          },
                          "then": {
                            "$clamp": [
                              {
                                "$sub": [
                                  {
                                    "$var": "fitRemainder"
                                  },
                                  {
                                    "$add": [
                                      {
                                        "$field": "itemSpacing",
                                        "default": 8
                                      },
                                      {
                                        "$var": "smallWidth"
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "$mul": [
                                  0.9,
                                  {
                                    "$add": [
                                      {
                                        "$mul": [
                                          0.5,
                                          {
                                            "$add": [
                                              {
                                                "$field": "preferredItemWidth",
                                                "default": 186
                                              },
                                              40
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "$div": [
                                          {
                                            "$add": [
                                              {
                                                "$var": "remainderTwice"
                                              },
                                              {
                                                "$mul": [
                                                  -2,
                                                  {
                                                    "$field": "itemSpacing",
                                                    "default": 8
                                                  }
                                                ]
                                              },
                                              {
                                                "$mul": [
                                                  -1,
                                                  {
                                                    "$field": "preferredItemWidth",
                                                    "default": 186
                                                  }
                                                ]
                                              },
                                              -120
                                            ]
                                          },
                                          {
                                            "$var": "slotsDouble"
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "$mul": [
                                  1.1,
                                  {
                                    "$add": [
                                      {
                                        "$mul": [
                                          0.5,
                                          {
                                            "$add": [
                                              {
                                                "$field": "preferredItemWidth",
                                                "default": 186
                                              },
                                              56
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "$div": [
                                          {
                                            "$add": [
                                              {
                                                "$var": "remainderTwice"
                                              },
                                              {
                                                "$mul": [
                                                  -2,
                                                  {
                                                    "$field": "itemSpacing",
                                                    "default": 8
                                                  }
                                                ]
                                              },
                                              {
                                                "$mul": [
                                                  -1,
                                                  {
                                                    "$field": "preferredItemWidth",
                                                    "default": 186
                                                  }
                                                ]
                                              },
                                              -168
                                            ]
                                          },
                                          {
                                            "$var": "slotsDouble"
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          "else": {
                            "$var": "smallWidth"
                          }
                        }
                      },
                      "else": {
                        "$if": {
                          "$lt": [
                            {
                              "$field": "$index"
                            },
                            {
                              "$var": "fitCountPadded"
                            }
                          ]
                        },
                        "then": {
                          "$clamp": [
                            {
                              "$field": "preferredItemWidth",
                              "default": 186
                            },
                            {
                              "$mul": [
                                {
                                  "$var": "itemWidthFit"
                                },
                                {
                                  "$sub": [
                                    1,
                                    {
                                      "$var": "fitInverse"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "$mul": [
                                {
                                  "$var": "itemWidthFit"
                                },
                                {
                                  "$add": [
                                    {
                                      "$var": "fitInverse"
                                    },
                                    1
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        "else": "fill"
                      }
                    },
                    "else": {
                      "$if": {
                        "$var": "rowsFromFitPlus1"
                      },
                      "then": {
                        "$if": {
                          "$var": "indexBeforeFit"
                        },
                        "then": "fill",
                        "else": {
                          "$clamp": [
                            {
                              "$var": "fitRemainder"
                            },
                            40,
                            56
                          ]
                        }
                      },
                      "else": {
                        "$div": [
                          {
                            "$sub": [
                              {
                                "$size": "width"
                              },
                              {
                                "$mul": [
                                  {
                                    "$sub": [
                                      {
                                        "$var": "fitCountWide"
                                      },
                                      1
                                    ]
                                  },
                                  {
                                    "$field": "itemSpacing",
                                    "default": 8
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "$var": "fitCountWide"
                          }
                        ]
                      }
                    }
                  }
                }
              },
              "height": "fill",
              "visible": {
                "$and": [
                  {
                    "$or": [
                      {
                        "$eq": ["style", "uncontained"]
                      },
                      {
                        "$eq": ["style", "centered-hero"]
                      },
                      {
                        "$lt": [
                          {
                            "$field": "$index"
                          },
                          {
                            "$if": {
                              "$gte": [
                                {
                                  "$field": "preferredItemWidth",
                                  "default": 186
                                },
                                {
                                  "$size": "width"
                                }
                              ]
                            },
                            "then": 2,
                            "else": {
                              "$if": {
                                "$var": "remainderLarge"
                              },
                              "then": {
                                "$if": {
                                  "$var": "rowsFromFitPlus2"
                                },
                                "then": {
                                  "$var": "fitPlus2"
                                },
                                "else": {
                                  "$add": [
                                    {
                                      "$var": "fitCountPadded"
                                    },
                                    1
                                  ]
                                }
                              },
                              "else": {
                                "$if": {
                                  "$var": "rowsFromFitPlus1"
                                },
                                "then": {
                                  "$var": "fitPlus1"
                                },
                                "else": {
                                  "$var": "fitCountWide"
                                }
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "$and": [
                      {
                        "$or": [
                          {
                            "$not": {
                              "$eq": ["style", "uncontained"]
                            }
                          },
                          {
                            "$gte": [
                              {
                                "$sub": [
                                  {
                                    "$size": "width"
                                  },
                                  {
                                    "$mul": [
                                      {
                                        "$field": "$index"
                                      },
                                      {
                                        "$add": [
                                          {
                                            "$field": "itemWidth",
                                            "default": 140
                                          },
                                          {
                                            "$field": "itemSpacing",
                                            "default": 8
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              },
                              32
                            ]
                          }
                        ]
                      },
                      {
                        "$or": [
                          {
                            "$not": {
                              "$eq": ["style", "centered-hero"]
                            }
                          },
                          {
                            "$gte": [
                              {
                                "$var": "heroRight"
                              },
                              32
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "cornerRadius": {
                "$token": "corner-extra-large"
              },
              "clip": true,
              "layout": {
                "type": "none"
              },
              "children": [
                {
                  "type": "image",
                  "name": "imagem",
                  "src": {
                    "$field": "image"
                  },
                  "fit": "cover",
                  "width": "fill",
                  "height": "fill",
                  "fill": {
                    "$token": "surface-container-highest"
                  }
                },
                {
                  "type": "rect",
                  "name": "véu",
                  "height": 48,
                  "anchors": {
                    "left": 0,
                    "right": 0,
                    "bottom": 0
                  },
                  "fill": {
                    "type": "linear",
                    "angle": 90,
                    "stops": [
                      {
                        "offset": 0,
                        "color": {
                          "$token": "scrim",
                          "alpha": 0
                        }
                      },
                      {
                        "offset": 1,
                        "color": {
                          "$token": "scrim",
                          "alpha": 0.32
                        }
                      }
                    ]
                  },
                  "visible": {
                    "$has": "label"
                  }
                },
                {
                  "type": "text",
                  "name": "rótulo",
                  "text": {
                    "$field": "label"
                  },
                  "color": {
                    "$token": "secondary-fixed"
                  },
                  "anchors": {
                    "left": 16,
                    "right": 16,
                    "bottom": 14
                  },
                  "font": {
                    "size": {
                      "$token": "label-large-size"
                    },
                    "weight": {
                      "$token": "label-large-weight"
                    },
                    "lineHeight": {
                      "$token": "label-large-line-height"
                    },
                    "letterSpacing": {
                      "$token": "label-large-tracking"
                    },
                    "maxLines": 1,
                    "ellipsis": true,
                    "verticalAlign": "cap-middle"
                  },
                  "visible": {
                    "$has": "label"
                  }
                }
              ]
            },
            "width": {
              "$if": {
                "$or": [
                  {
                    "$eq": ["style", "uncontained"]
                  },
                  {
                    "$eq": ["style", "centered-hero"]
                  }
                ]
              },
              "then": "hug",
              "else": {
                "$size": "width"
              }
            }
          }
        ]
      }
    ]
  }
}
