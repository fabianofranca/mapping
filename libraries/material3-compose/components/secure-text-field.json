{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "secure-text-field",
  "name": "Secure text field",
  "description": "Campo de senha: filled (fundo e indicador) ou outlined (contorno com o rótulo na borda). O texto digitado aparece mascarado (••••••••); aceita ícones, texto de apoio e estado de erro.",
  "size": {
    "width": 280,
    "height": 84
  },
  "minSize": {
    "width": 280,
    "height": 56
  },
  "sizing": {
    "width": "fill",
    "height": 84
  },
  "preview": {
    "label": "Senha",
    "hasText": "true",
    "placeholder": "",
    "supportingText": "",
    "style": "filled",
    "enabled": "true",
    "isError": "false",
    "leadingIcon": "",
    "trailingIcon": ""
  },
  "template": {
    "type": "frame",
    "name": "secure text field",
    "clip": false,
    "layout": {
      "type": "column"
    },
    "children": [
      {
        "type": "frame",
        "name": "contêiner",
        "clip": true,
        "width": "fill",
        "height": "fill",
        "minHeight": {
          "$if": {
            "$eq": ["style", "outlined"]
          },
          "then": 64,
          "else": 56
        },
        "maxHeight": {
          "$if": {
            "$eq": ["style", "outlined"]
          },
          "then": 64,
          "else": 56
        },
        "layout": {
          "type": "none"
        },
        "children": [
          {
            "type": "rect",
            "name": "fundo",
            "anchors": {
              "left": 0,
              "right": 0,
              "top": 0,
              "bottom": 0
            },
            "cornerRadius": [
              {
                "$token": "corner-extra-small"
              },
              {
                "$token": "corner-extra-small"
              },
              0,
              0
            ],
            "fill": {
              "$token": "surface-container-highest"
            },
            "visible": {
              "$not": {
                "$eq": ["style", "outlined"]
              }
            }
          },
          {
            "type": "rect",
            "name": "indicador",
            "anchors": {
              "left": 0,
              "right": 0,
              "top": 0,
              "bottom": 0
            },
            "fill": "none",
            "stroke": {
              "color": {
                "$if": {
                  "$eq": ["enabled", "false"]
                },
                "then": {
                  "$token": "on-surface"
                },
                "else": {
                  "$if": {
                    "$eq": ["interaction", "focused"]
                  },
                  "then": {
                    "$if": {
                      "$eq": ["isError", "true"]
                    },
                    "then": {
                      "$token": "error"
                    },
                    "else": {
                      "$token": "primary"
                    }
                  },
                  "else": {
                    "$if": {
                      "$eq": ["interaction", "hovered"]
                    },
                    "then": {
                      "$if": {
                        "$eq": ["isError", "true"]
                      },
                      "then": {
                        "$token": "on-error-container"
                      },
                      "else": {
                        "$token": "on-surface"
                      }
                    },
                    "else": {
                      "$if": {
                        "$eq": ["isError", "true"]
                      },
                      "then": {
                        "$token": "error"
                      },
                      "else": {
                        "$token": "on-surface-variant"
                      }
                    }
                  }
                }
              },
              "width": {
                "$if": {
                  "$and": [
                    {
                      "$eq": ["interaction", "focused"]
                    },
                    {
                      "$not": {
                        "$eq": ["enabled", "false"]
                      }
                    }
                  ]
                },
                "then": 2,
                "else": 1
              },
              "align": "inside",
              "sides": ["bottom"]
            },
            "opacity": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$token": "state-disabled-content"
              },
              "else": 1
            },
            "visible": {
              "$not": {
                "$eq": ["style", "outlined"]
              }
            }
          },
          {
            "type": "rect",
            "name": "contorno",
            "anchors": {
              "left": 0,
              "right": 0,
              "top": 8,
              "bottom": 0
            },
            "cornerRadius": {
              "$token": "corner-extra-small"
            },
            "fill": "none",
            "stroke": {
              "color": {
                "$if": {
                  "$eq": ["enabled", "false"]
                },
                "then": {
                  "$token": "on-surface"
                },
                "else": {
                  "$if": {
                    "$eq": ["interaction", "focused"]
                  },
                  "then": {
                    "$if": {
                      "$eq": ["isError", "true"]
                    },
                    "then": {
                      "$token": "error"
                    },
                    "else": {
                      "$token": "primary"
                    }
                  },
                  "else": {
                    "$if": {
                      "$eq": ["interaction", "hovered"]
                    },
                    "then": {
                      "$if": {
                        "$eq": ["isError", "true"]
                      },
                      "then": {
                        "$token": "on-error-container"
                      },
                      "else": {
                        "$token": "on-surface"
                      }
                    },
                    "else": {
                      "$if": {
                        "$eq": ["isError", "true"]
                      },
                      "then": {
                        "$token": "error"
                      },
                      "else": {
                        "$token": "outline"
                      }
                    }
                  }
                }
              },
              "width": {
                "$if": {
                  "$and": [
                    {
                      "$eq": ["interaction", "focused"]
                    },
                    {
                      "$not": {
                        "$eq": ["enabled", "false"]
                      }
                    }
                  ]
                },
                "then": 2,
                "else": 1
              },
              "align": "inside",
              "gap": {
                "node": "rótulo minimizado",
                "padding": 4
              }
            },
            "opacity": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$token": "state-disabled-container"
              },
              "else": 1
            },
            "visible": {
              "$eq": ["style", "outlined"]
            }
          },
          {
            "type": "frame",
            "name": "conteúdo",
            "anchors": {
              "left": 0,
              "right": 0,
              "top": 0,
              "bottom": 0
            },
            "layout": {
              "type": "column",
              "padding": {
                "$if": {
                  "$eq": ["style", "outlined"]
                },
                "then": [8, 0, 0, 0],
                "else": 0
              }
            },
            "children": [
              {
                "type": "frame",
                "name": "linha",
                "width": "fill",
                "height": "fill",
                "layout": {
                  "type": "row",
                  "gap": 16,
                  "padding": {
                    "$if": {
                      "$has": "leadingIcon"
                    },
                    "then": {
                      "$if": {
                        "$has": "trailingIcon"
                      },
                      "then": [0, 12, 0, 12],
                      "else": [0, 16, 0, 12]
                    },
                    "else": {
                      "$if": {
                        "$has": "trailingIcon"
                      },
                      "then": [0, 12, 0, 16],
                      "else": [0, 16, 0, 16]
                    }
                  },
                  "align": "center"
                },
                "children": [
                  {
                    "type": "icon",
                    "name": {
                      "$switch": "leadingIcon",
                      "cases": {
                        "Home": "home",
                        "Search": "search",
                        "Person": "person",
                        "Menu": "menu",
                        "MoreVert": "more_vert",
                        "Add": "add",
                        "Check": "check",
                        "Close": "close",
                        "ArrowBack": "arrow_back",
                        "Favorite": "favorite",
                        "Edit": "edit",
                        "Delete": "delete",
                        "Share": "share",
                        "Notifications": "notifications",
                        "Settings": "settings",
                        "Info": "info",
                        "Star": "star",
                        "Email": "email",
