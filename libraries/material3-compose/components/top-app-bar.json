      {
        "type": "frame",
        "name": "título centralizado (caixa)",
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0
        },
        "height": 64,
        "visible": {
          "$eq": ["style", "center"]
        },
        "layout": {
          "type": "row",
          "padding": {
            "$if": {
              "$and": [
                {
                  "$has": "actionIcon1"
                },
                {
                  "$has": "actionIcon2"
                }
              ]
            },
            "then": [0, 104],
            "else": {
              "$if": {
                "$or": [
                  {
                    "$has": "actionIcon1"
                  },
                  {
                    "$has": "actionIcon2"
                  }
                ]
              },
              "then": [0, 56],
              "else": {
                "$if": {
                  "$has": "navigationIcon"
                },
                "then": [0, 56],
                "else": [0, 16]
              }
            }
          },
          "align": "center"
        },
        "children": [
          {
            "type": "text",
            "name": "título centralizado",
            "text": {
              "$field": "title",
              "default": "Title"
            },
            "font": {
              "size": {
                "$token": "title-large-size"
              },
              "weight": {
                "$token": "title-large-weight"
              },
              "lineHeight": {
                "$token": "title-large-line-height"
              },
              "letterSpacing": {
                "$token": "title-large-tracking"
              },
              "align": "center",
              "wrap": "none",
              "ellipsis": true,
              "maxLines": 1,
              "verticalAlign": "cap-middle"
            },
            "color": {
              "$token": "on-surface"
            },
            "width": "fill",
            "height": "fill"
          }
        ]
      },
