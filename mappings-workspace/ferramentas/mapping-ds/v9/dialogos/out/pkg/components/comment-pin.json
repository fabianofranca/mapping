{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "comment-pin",
  "name": "CommentPin",
  "description": "Pino de conversa: pílula de 20 px de tela com as iniciais e o número de mensagens, na cor do estado mais urgente; anel de selecionado, ponto de não lida e contorno tracejado de rascunho. Tamanho constante em qualquer zoom.",
  "size": {
    "width": 96,
    "height": 28
  },
  "minSize": {
    "width": 20,
    "height": 20
  },
  "sizing": {
    "width": 96,
    "height": 28
  },
  "screen": {
    "anchor": "center"
  },
  "preview": {
    "estado": "humano",
    "rotulo": "MA 3",
    "selecionado": "não",
    "naoLida": "não",
    "rascunho": "não"
  },
  "template": {
    "type": "frame",
    "name": "pino",
    "layout": {
      "type": "row",
      "align": "center",
      "justify": "center"
    },
    "children": [
      {
        "type": "frame",
        "name": "corpo",
        "width": "hug",
        "height": 20,
        "layout": {
          "type": "none"
        },
        "children": [
          {
            "type": "frame",
            "name": "pílula",
            "width": "hug",
            "height": 20,
            "minWidth": 20,
            "anchors": {
              "left": 0,
              "top": 0
            },
            "cornerRadius": 10,
            "fill": {
              "$switch": "estado",
              "cases": {
                "agente": {
                  "$token": "cv-pin-agent"
                },
                "resolvida": {
                  "$token": "cv-pin-resolved"
                }
              },
              "default": {
                "$token": "cv-pin-human"
              }
            },
            "stroke": {
              "color": {
                "$if": {
                  "$eq": [
                    "rascunho",
                    "sim"
                  ]
                },
                "then": "none",
                "else": {
                  "$if": {
                    "$eq": [
                      "selecionado",
                      "sim"
                    ]
                  },
                  "then": {
                    "$token": "cv-pin-selected"
                  },
                  "else": {
                    "$token": "cv-pin-halo"
                  }
                }
              },
              "width": {
                "$if": {
                  "$eq": [
                    "selecionado",
                    "sim"
                  ]
                },
                "then": 2,
                "else": 1
              },
              "align": "center"
            },
            "layout": {
              "type": "row",
              "padding": [
                0,
                8
              ],
              "align": "center",
              "justify": "center"
            },
            "children": [
              {
                "type": "text",
                "name": "rótulo",
                "text": {
                  "$field": "rotulo",
                  "default": "MA 1"
                },
                "color": {
                  "$token": "cv-pin-text"
                },
                "font": {
                  "size": 11,
                  "weight": 600,
                  "lineHeight": 16
                }
              }
            ]
          },
          {
            "type": "rect",
            "name": "rascunho",
            "anchors": {
              "left": 0,
              "right": 0,
              "top": 0,
              "bottom": 0
            },
            "cornerRadius": 10,
            "fill": "none",
            "stroke": {
              "color": {
                "$token": "cv-pin-selected"
              },
              "width": 2,
              "align": "center",
              "dash": [
                3,
                2
              ]
            },
            "visible": {
              "$eq": [
                "rascunho",
                "sim"
              ]
            }
          },
          {
            "type": "ellipse",
            "name": "não lida",
            "width": 8,
            "height": 8,
            "anchors": {
              "top": -4,
              "right": -4
            },
            "fill": {
              "$token": "cv-pin-unread"
            },
            "stroke": {
              "color": {
                "$token": "cv-pin-halo"
              },
              "width": 1,
              "align": "center"
            },
            "visible": {
              "$eq": [
                "naoLida",
                "sim"
              ]
            }
          }
        ]
      }
    ]
  }
}
