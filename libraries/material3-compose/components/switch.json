{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "switch",
  "name": "Switch",
  "description": "Switch: trilho 52 × 32, alça de 24 (ligado, ou com ícone) ou 16 (desligado) e rótulo opcional ao lado.",
  "size": {
    "width": 200,
    "height": 32
  },
  "minSize": {
    "width": 52,
    "height": 32
  },
  "sizing": {
    "width": "fill",
    "height": 32
  },
  "preview": {
    "label": "Notificações",
    "checked": "true",
    "enabled": "true",
    "thumbIcon": "false"
  },
  "template": {
    "type": "frame",
    "name": "switch",
    "layout": {
      "type": "row",
      "gap": 16,
      "align": "center"
    },
    "children": [
      {
        "type": "text",
        "name": "rótulo",
        "text": {
          "$field": "label"
        },
        "font": {
          "family": "Roboto",
          "size": 16,
          "weight": 400,
          "lineHeight": 24
        },
        "color": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": "rgba(29, 27, 32, 0.38)",
          "else": "#1D1B20"
        },
        "width": "fill",
        "visible": {
          "$has": "label"
        }
      },
      {
        "type": "frame",
        "name": "trilho",
        "width": 52,
        "height": 32,
        "cornerRadius": 16,
        "fill": {
          "$if": {
            "$field": "checked"
          },
          "then": {
            "$if": {
              "$eq": ["enabled", "false"]
            },
            "then": "rgba(29, 27, 32, 0.12)",
            "else": "#6750A4"
          },
          "else": {
            "$if": {
              "$eq": ["enabled", "false"]
            },
            "then": "rgba(0, 0, 0, 0)",
            "else": "#E6E0E9"
          }
        },
        "stroke": {
          "color": {
            "$if": {
              "$field": "checked"
            },
            "then": "rgba(0, 0, 0, 0)",
            "else": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": "rgba(29, 27, 32, 0.12)",
              "else": "#79747E"
            }
          },
          "width": 2,
          "align": "inside"
        },
        "layout": {
          "type": "none"
        },
        "children": [
          {
            "type": "ellipse",
            "name": "alça ligada",
            "visible": {
              "$field": "checked"
            },
            "width": 24,
            "height": 24,
            "anchors": {
              "right": 4,
              "centerY": true
            },
            "fill": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": "#FEF7FF",
              "else": "#FFFFFF"
            }
          },
          {
            "type": "ellipse",
            "name": "alça desligada",
            "visible": {
              "$and": [
                {
                  "$not": {
                    "$field": "checked"
                  }
                },
                {
                  "$not": {
                    "$eq": ["thumbIcon", "true"]
                  }
                }
              ]
            },
            "width": 16,
            "height": 16,
            "anchors": {
              "left": 8,
              "centerY": true
            },
            "fill": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": "rgba(29, 27, 32, 0.38)",
              "else": "#79747E"
            }
          },
          {
            "type": "ellipse",
            "name": "alça desligada com ícone",
            "visible": {
              "$and": [
                {
                  "$not": {
                    "$field": "checked"
                  }
                },
                {
                  "$eq": ["thumbIcon", "true"]
                }
              ]
            },
            "width": 24,
            "height": 24,
            "anchors": {
              "left": 4,
              "centerY": true
            },
            "fill": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": "rgba(29, 27, 32, 0.38)",
              "else": "#79747E"
            }
          },
          {
            "type": "path",
            "name": "check",
            "visible": {
              "$and": [
                {
                  "$field": "checked"
                },
                {
                  "$eq": ["thumbIcon", "true"]
                }
              ]
            },
            "width": 16,
            "height": 16,
            "viewBox": [24, 24],
            "d": "M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z",
            "anchors": {
              "right": 8,
              "centerY": true
            },
            "fill": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": "rgba(29, 27, 32, 0.38)",
              "else": "#21005D"
            }
          },
          {
            "type": "path",
            "name": "close",
            "visible": {
              "$and": [
                {
                  "$not": {
                    "$field": "checked"
                  }
                },
                {
                  "$eq": ["thumbIcon", "true"]
                }
              ]
            },
            "width": 16,
            "height": 16,
            "viewBox": [24, 24],
            "d": "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z",
            "anchors": {
              "left": 8,
              "centerY": true
            },
            "fill": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": "#FEF7FF",
              "else": "#E6E0E9"
            }
          }
        ]
      }
    ]
  }
}
