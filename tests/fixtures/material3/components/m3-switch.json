{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "m3-switch",
  "name": "Switch",
  "description": "Switch: trilho 52 × 32, alça 24 (ligado) ou 16 (desligado); rótulo opcional.",
  "size": {
    "width": 200,
    "height": 32
  },
  "minSize": {
    "width": 52,
    "height": 32
  },
  "sizing": {
    "width": "fill",
    "height": 32
  },
  "preview": {
    "label": "Label",
    "selected": "sim",
    "icon": "não"
  },
  "template": {
    "type": "frame",
    "name": "switch",
    "layout": {
      "type": "row",
      "gap": 16,
      "align": "center"
    },
    "children": [
      {
        "type": "text",
        "name": "rótulo",
        "text": {
          "$field": "label"
        },
        "font": {
          "family": "Roboto",
          "size": 16,
          "weight": 400,
          "lineHeight": 24
        },
        "color": "#1D1B20",
        "visible": {
          "$has": "label"
        },
        "width": "fill"
      },
      {
        "type": "frame",
        "name": "trilho",
        "width": 52,
        "height": 32,
        "layout": {
          "type": "none"
        },
        "cornerRadius": 16,
        "fill": {
          "$if": {
            "$field": "selected"
          },
          "then": "#6750A4",
          "else": "#E6E0E9"
        },
        "stroke": {
          "color": {
            "$if": {
              "$field": "selected"
            },
            "then": "rgba(0, 0, 0, 0)",
            "else": "#79747E"
          },
          "width": 2,
          "align": "inside"
        },
        "children": [
          {
            "type": "ellipse",
            "name": "alça ligada",
            "visible": {
              "$field": "selected"
            },
            "width": 24,
            "height": 24,
            "anchors": {
              "right": 4,
              "centerY": true
            },
            "fill": "#FFFFFF"
          },
          {
            "type": "ellipse",
            "name": "alça desligada",
            "visible": {
              "$not": {
                "$field": "selected"
              }
            },
            "width": 16,
            "height": 16,
            "anchors": {
              "left": 8,
              "centerY": true
            },
            "fill": "#79747E"
          },
          {
            "type": "frame",
            "name": "ícone",
            "visible": {
              "$and": [
                {
                  "$field": "selected"
                },
                {
                  "$field": "icon"
                }
              ]
            },
            "width": 24,
            "height": 24,
            "anchors": {
              "right": 4,
              "centerY": true
            },
            "layout": {
              "type": "row",
              "align": "center",
              "justify": "center"
            },
            "children": [
              {
                "type": "path",
                "name": "check",
                "width": 16,
                "height": 16,
                "viewBox": [24, 24],
                "d": "M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z",
                "fill": "#21005D"
              }
            ]
          }
        ]
      }
    ]
  }
}
