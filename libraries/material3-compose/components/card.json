{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "card",
  "name": "Card",
  "description": "Card do Material 3 (CardDefaults): forma medium (12), mídia opcional no topo, título, subtítulo e texto; filled (surface container highest), elevated (surface container low, elevação 1) ou outlined (surface com contorno outline variant de 1).",
  "size": {
    "width": 360,
    "height": 244
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "title": "Praia do Rosa",
    "subtitle": "Santa Catarina",
    "supportingText": "Fim de semana de sol.",
    "media": "https://example.com/praia.jpg",
    "style": "elevated"
  },
  "template": {
    "type": "frame",
    "name": "card",
    "cornerRadius": {
      "$token": "corner-medium"
    },
    "fill": {
      "$switch": "style",
      "cases": {
        "elevated": {
          "$token": "surface-container-low"
        },
        "outlined": {
          "$token": "surface"
        }
      },
      "default": {
        "$token": "surface-container-highest"
      }
    },
    "stroke": {
      "color": {
        "$if": {
          "$eq": ["style", "outlined"]
        },
        "then": {
          "$token": "outline-variant"
        },
        "else": "none"
      },
      "width": 1,
      "align": "inside"
    },
    "shadow": {
      "color": {
        "$if": {
          "$eq": ["style", "elevated"]
        },
        "then": {
          "$token": "elevation-shadow"
        },
        "else": "none"
      },
      "y": 1,
      "blur": 2
    },
    "layout": {
      "type": "column",
      "gap": 0
    },
    "children": [
      {
        "type": "image",
        "name": "mídia",
        "src": {
          "$field": "media"
        },
        "fit": "cover",
        "width": "fill",
        "height": 140,
        "fill": {
          "$token": "surface-container-highest"
        },
        "visible": {
          "$has": "media"
        }
      },
      {
        "type": "frame",
        "name": "conteúdo",
        "width": "fill",
        "height": "hug",
        "layout": {
          "type": "column",
          "gap": 4,
          "padding": 16
        },
        "children": [
          {
            "type": "text",
            "name": "título",
            "text": {
              "$field": "title",
              "default": "Title"
            },
            "font": {
              "size": {
                "$token": "title-medium-size"
              },
              "weight": {
                "$token": "title-medium-weight"
              },
              "lineHeight": {
                "$token": "title-medium-line-height"
              },
              "letterSpacing": {
                "$token": "title-medium-tracking"
              }
            },
            "color": {
              "$token": "on-surface"
            },
            "width": "fill"
          },
          {
            "type": "text",
            "name": "subtítulo",
            "text": {
              "$field": "subtitle"
            },
            "font": {
              "size": {
                "$token": "body-medium-size"
              },
              "weight": {
                "$token": "body-medium-weight"
              },
              "lineHeight": {
                "$token": "body-medium-line-height"
              },
              "letterSpacing": {
                "$token": "body-medium-tracking"
              }
            },
            "color": {
              "$token": "on-surface-variant"
            },
            "width": "fill",
            "visible": {
              "$has": "subtitle"
            }
          },
          {
            "type": "text",
            "name": "apoio",
            "text": {
              "$field": "supportingText"
            },
            "font": {
              "size": {
                "$token": "body-medium-size"
              },
              "weight": {
                "$token": "body-medium-weight"
              },
              "lineHeight": {
                "$token": "body-medium-line-height"
              },
              "letterSpacing": {
                "$token": "body-medium-tracking"
              }
            },
            "color": {
              "$token": "on-surface-variant"
            },
            "width": "fill",
            "visible": {
              "$has": "supportingText"
            }
          }
        ]
      }
    ]
  }
}
