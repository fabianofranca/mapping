                        "MenuOpen": "menu_open",
                        "Logout": "logout",
                        "Login": "login",
                        "People": "people",
                        "Group": "group",
                        "PersonAdd": "person_add",
                        "LockOpen": "lock_open",
                        "Security": "security",
                        "VerifiedUser": "verified_user",
                        "Key": "key",
                        "Pause": "pause",
                        "Stop": "stop",
                        "SkipNext": "skip_next",
                        "SkipPrevious": "skip_previous",
                        "VolumeUp": "volume_up",
                        "VolumeOff": "volume_off",
                        "ThumbDown": "thumb_down",
                        "Reply": "reply",
                        "Inbox": "inbox",
                        "Archive": "archive",
                        "Undo": "undo",
                        "Redo": "redo",
                        "ZoomIn": "zoom_in",
                        "ZoomOut": "zoom_out",
                        "Keyboard": "keyboard",
                        "CheckBox": "check_box",
                        "CheckBoxOutlineBlank": "check_box_outline_blank",
                        "RadioButtonChecked": "radio_button_checked",
                        "RadioButtonUnchecked": "radio_button_unchecked",
                        "ToggleOn": "toggle_on",
                        "ToggleOff": "toggle_off",
                        "StarBorder": "star_border",
                        "StarHalf": "star_half",
                        "Lightbulb": "lightbulb",
                        "Code": "code",
                        "Terminal": "terminal",
                        "Bolt": "bolt",
                        "EditCalendar": "edit_calendar"
                      },
                      "default": {
                        "$field": "leadingIcon"
                      }
                    },
                    "width": 24,
                    "height": 24,
                    "color": {
                      "$if": {
                        "$eq": ["enabled", "false"]
                      },
                      "then": {
                        "$token": "on-surface"
                      },
                      "else": {
                        "$token": "on-surface-variant"
                      }
                    },
                    "opacity": {
                      "$if": {
                        "$eq": ["enabled", "false"]
                      },
                      "then": {
                        "$token": "state-disabled-content"
                      },
                      "else": 1
                    },
                    "visible": {
                      "$has": "leadingIcon"
                    }
                  },
                  {
                    "type": "frame",
                    "name": "textos",
                    "width": "fill",
                    "height": "hug",
                    "layout": {
                      "type": "column"
                    },
                    "children": [
                      {
                        "type": "text",
                        "name": "rótulo",
                        "text": {
                          "$field": "label"
                        },
                        "font": {
                          "size": {
                            "$if": {
                              "$or": [
                                {
                                  "$eq": ["hasText", "true"]
                                },
                                {
                                  "$has": "placeholder"
                                }
                              ]
                            },
                            "then": {
                              "$token": "body-small-size"
                            },
                            "else": {
                              "$token": "body-large-size"
                            }
                          },
                          "weight": {
                            "$if": {
                              "$or": [
                                {
                                  "$eq": ["hasText", "true"]
                                },
                                {
                                  "$has": "placeholder"
                                }
                              ]
                            },
                            "then": {
                              "$token": "body-small-weight"
                            },
                            "else": {
                              "$token": "body-large-weight"
                            }
                          },
                          "lineHeight": {
                            "$if": {
                              "$or": [
                                {
                                  "$eq": ["hasText", "true"]
                                },
                                {
                                  "$has": "placeholder"
                                }
                              ]
                            },
                            "then": {
                              "$token": "body-small-line-height"
                            },
                            "else": {
                              "$token": "body-large-line-height"
                            }
                          },
                          "letterSpacing": {
                            "$if": {
                              "$or": [
                                {
                                  "$eq": ["hasText", "true"]
                                },
                                {
                                  "$has": "placeholder"
                                }
                              ]
                            },
                            "then": {
                              "$token": "body-small-tracking"
                            },
                            "else": {
                              "$token": "body-large-tracking"
                            }
                          },
                          "verticalAlign": "cap-middle"
                        },
                        "color": {
                          "$if": {
                            "$eq": ["enabled", "false"]
                          },
                          "then": {
                            "$token": "on-surface"
                          },
                          "else": {
                            "$if": {
                              "$eq": ["interaction", "focused"]
                            },
                            "then": {
                              "$if": {
                                "$eq": ["isError", "true"]
                              },
                              "then": {
                                "$token": "error"
                              },
                              "else": {
                                "$token": "primary"
                              }
                            },
                            "else": {
                              "$if": {
                                "$eq": ["interaction", "hovered"]
                              },
                              "then": {
                                "$if": {
                                  "$eq": ["isError", "true"]
                                },
                                "then": {
                                  "$token": "on-error-container"
                                },
                                "else": {
                                  "$if": {
                                    "$eq": ["style", "outlined"]
                                  },
                                  "then": {
                                    "$token": "on-surface"
                                  },
                                  "else": {
                                    "$token": "on-surface-variant"
                                  }
                                }
                              },
                              "else": {
                                "$if": {
                                  "$eq": ["isError", "true"]
                                },
                                "then": {
                                  "$token": "error"
                                },
                                "else": {
                                  "$token": "on-surface-variant"
                                }
                              }
                            }
                          }
                        },
                        "opacity": {
                          "$if": {
                            "$eq": ["enabled", "false"]
                          },
                          "then": {
                            "$token": "state-disabled-content"
                          },
                          "else": 1
                        },
                        "width": "fill",
                        "visible": {
                          "$or": [
                            {
                              "$not": {
                                "$eq": ["style", "outlined"]
                              }
                            },
                            {
                              "$not": {
                                "$or": [
                                  {
                                    "$eq": ["hasText", "true"]
                                  },
                                  {
                                    "$has": "placeholder"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      },
                      {
                        "type": "frame",
                        "name": "valor (recorte)",
                        "width": "fill",
                        "height": "hug",
                        "clip": true,
                        "layout": {
                          "type": "row"
                        },
                        "visible": {
                          "$eq": ["hasText", "true"]
                        },
                        "children": [
                          {
                            "type": "text",
                            "name": "valor",
                            "text": "••••••••",
                            "font": {
                              "size": {
                                "$token": "body-large-size"
                              },
                              "weight": {
                                "$token": "body-large-weight"
                              },
                              "lineHeight": {
                                "$token": "body-large-line-height"
                              },
                              "letterSpacing": {
                                "$token": "body-large-tracking"
                              },
                              "wrap": "none",
                              "maxLines": 1,
                              "verticalAlign": "cap-middle"
                            },
                            "color": {
                              "$token": "on-surface"
                            },
                            "opacity": {
                              "$if": {
                                "$eq": ["enabled", "false"]
                              },
                              "then": {
                                "$token": "state-disabled-content"
                              },
                              "else": 1
                            },
                            "width": "hug"
                          }
                        ]
                      },
                      {
                        "type": "text",
                        "name": "dica",
                        "text": {
                          "$field": "placeholder"
                        },
                        "font": {
                          "size": {
                            "$token": "body-large-size"
                          },
                          "weight": {
                            "$token": "body-large-weight"
                          },
                          "lineHeight": {
                            "$token": "body-large-line-height"
                          },
                          "letterSpacing": {
                            "$token": "body-large-tracking"
                          },
                          "verticalAlign": "cap-middle"
                        },
                        "color": {
                          "$if": {
                            "$eq": ["enabled", "false"]
                          },
                          "then": {
                            "$token": "on-surface"
                          },
                          "else": {
                            "$token": "on-surface-variant"
                          }
                        },
                        "opacity": {
                          "$if": {
                            "$eq": ["enabled", "false"]
                          },
                          "then": {
                            "$token": "state-disabled-content"
                          },
                          "else": 1
                        },
                        "width": "fill",
                        "visible": {
                          "$and": [
                            {
                              "$not": {
                                "$eq": ["hasText", "true"]
                              }
                            },
                            {
                              "$has": "placeholder"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "type": "icon",
                    "name": {
                      "$switch": "trailingIcon",
                      "cases": {
