{
  "format": "mapping-spec",
  "formatVersion": 22,
  "id": "measured",
  "name": "Measured layout",
  "version": 1,
  "description": "Example of a measured page as a file format: the tree of rectangles of a page (measured in a browser) becomes markings through the plugin of the `dom` format, which matches each node to the Button and Card types by their `sources`. Containment comes from the geometry.",
  "fileFormats": [
    {
      "id": "dom",
      "name": "Measured page",
      "extension": "json",
      "plugin": "plugins/dom.js",
      "contract": 1,
      "scope": "container",
      "description": "The measured tree of a page, bare or { tree, scale?, offset? }: each node becomes a marking of the type its id, class or type matches in the sources (the geometry decides who contains whom). A node with no type or with an empty rectangle is left out with a warning.",
      "examples": [
        {
          "name": "Page",
          "file": "examples/page.measured.json"
        }
      ]
    }
  ],
  "layers": [
    {
      "id": "ui",
      "name": "Interface",
      "color": "#2563EB",
      "annotationTypes": [
        {
          "id": "card",
          "name": "Card",
          "component": "components/card.json",
          "doc": "docs/card.md",
          "sources": [
            {
              "system": "dom",
              "name": "card"
            }
          ],
          "fields": []
        },
        {
          "id": "button",
          "name": "Button",
          "labelField": "label",
          "component": "components/button.json",
          "doc": "docs/button.md",
          "sources": [
            {
              "system": "dom",
              "name": "btn-primary"
            }
          ],
          "fields": [
            {
              "key": "label",
              "label": "Label",
              "type": "string",
              "sources": [
                {
                  "system": "dom",
                  "path": "label"
                }
              ]
            },
            {
              "key": "tone",
              "label": "Tone",
              "type": "enum",
              "options": ["neutral", "error"],
              "default": "neutral",
              "sources": [
                {
                  "system": "dom",
                  "path": "tone",
                  "values": {
                    "danger": "error"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
