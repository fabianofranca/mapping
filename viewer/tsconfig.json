{
  // Type declarations of the embeddable viewer: `npm run build:viewer` generates
  // dist-viewer/types/. tsc follows the imports from the two entries. `react.tsx` uses the
  // `@jsxImportSource react` pragma per file (the root tsconfig uses preact).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../dist-viewer/types",
    "rootDir": ".."
  },
  "include": ["index.ts", "react.tsx"]
}
