{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "m3-card",
  "name": "Card",
  "description": "Card elevated, filled ou outlined; forma medium (12); headline, subhead, texto de apoio e espaço para ações.",
  "size": {
    "width": 360,
    "height": 200
  },
  "minSize": {
    "width": 160,
    "height": 96
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "headline": "Headline",
    "subhead": "Subhead",
    "body": "Explain more about the topic shown in the headline and subhead through supporting text.",
    "variant": "elevated"
  },
  "template": {
    "type": "frame",
    "name": "card",
    "layout": {
      "type": "column",
      "gap": 8,
      "padding": 16
    },
    "cornerRadius": 12,
    "fill": {
      "$switch": "variant",
      "cases": {
        "filled": "#E6E0E9",
        "outlined": "#FEF7FF"
      },
      "default": "#F7F2FA"
    },
    "stroke": {
      "color": {
        "$if": {
          "$eq": ["variant", "outlined"]
        },
        "then": "#CAC4D0",
        "else": "rgba(0, 0, 0, 0)"
      },
      "width": 1,
      "align": "inside"
    },
    "shadow": {
      "color": {
        "$if": {
          "$eq": ["variant", "elevated"]
        },
        "then": "rgba(0, 0, 0, 0.3)",
        "else": "rgba(0, 0, 0, 0)"
      },
      "y": 1,
      "blur": 3
    },
    "children": [
      {
        "type": "text",
        "name": "headline",
        "text": {
          "$field": "headline",
          "default": "Headline"
        },
        "font": {
          "family": "Roboto",
          "size": 16,
          "weight": 500,
          "lineHeight": 24
        },
        "color": "#1D1B20",
        "width": "fill"
      },
      {
        "type": "text",
        "name": "subhead",
        "text": {
          "$field": "subhead"
        },
        "font": {
          "family": "Roboto",
          "size": 14,
          "weight": 400,
          "lineHeight": 20
        },
        "color": "#49454F",
        "visible": {
          "$has": "subhead"
        },
        "width": "fill"
      },
      {
        "type": "text",
        "name": "apoio",
        "text": {
          "$field": "body"
        },
        "font": {
          "family": "Roboto",
          "size": 14,
          "weight": 400,
          "lineHeight": 20
        },
        "color": "#49454F",
        "visible": {
          "$has": "body"
        },
        "width": "fill"
      },
      {
        "type": "slot",
        "name": "ações",
        "width": "fill",
        "height": "fill",
        "label": "ações",
        "layout": {
          "type": "row",
          "gap": 8,
          "justify": "end"
        }
      }
    ]
  }
}
