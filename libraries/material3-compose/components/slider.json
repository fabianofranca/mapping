{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "slider",
  "name": "Slider",
  "description": "Slider de 44: trilha de 16 em secondary container, trecho ativo em primary e alça de 4 × 44 com vão de 6 (SliderTokens). Os valores são números de 0 a 1; com steps a alça vai ao passo mais próximo e as marcas são exatamente as de steps, em qualquer quantidade. No intervalo há duas alças.",
  "size": { "width": 328, "height": 48 },
  "sizing": { "width": "fill", "height": 48 },
  "preview": {
    "type": "single",
    "value": 0.5,
    "valueStart": 0.2,
    "valueEnd": 0.8,
    "steps": null,
    "enabled": "true"
  },
  "template": {
    "type": "frame",
    "name": "slider",
    "layout": { "type": "none" },
    "children": [
      {
        "type": "frame",
        "name": "faixa",
        "height": 44,
        "anchors": { "left": 2, "right": 2, "centerY": true },
        "layout": { "type": "row" },
        "children": [
          {
            "type": "frame",
            "name": "antes do início",
            "width": {
              "$if": { "$eq": ["type", "range"] },
              "then": {
                "$add": [
                  {
                    "$mul": [
                      {
                        "$div": [
                          {
                            "$round": {
                              "$mul": [
                                {
                                  "$clamp": [
                                    { "$field": "valueStart", "default": 0.2 },
                                    0,
                                    1
                                  ]
                                },
                                {
                                  "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                  "then": {
                                    "$add": [{ "$floor": { "$field": "steps" } }, 1]
                                  },
                                  "else": 1000000000
                                }
                              ]
                            }
                          },
                          {
                            "$if": { "$gte": [{ "$field": "steps" }, 1] },
                            "then": { "$add": [{ "$floor": { "$field": "steps" } }, 1] },
                            "else": 1000000000
                          }
                        ]
                      },
                      {
                        "$sub": [
                          { "$sub": [{ "$size": "width" }, 4] },
                          {
                            "$mul": [
                              16,
                              {
                                "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                "then": 1,
                                "else": 0
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "$mul": [
                      8,
                      {
                        "$if": { "$gte": [{ "$field": "steps" }, 1] },
                        "then": 1,
                        "else": 0
                      }
                    ]
                  }
                ]
              },
              "else": 0
            },
            "height": "fill",
            "visible": { "$eq": ["type", "range"] },
            "layout": { "type": "none" },
            "children": [
              {
                "type": "rect",
                "name": "trilho inativo",
                "height": 16,
                "anchors": { "centerY": true, "left": 0, "right": 8 },
                "cornerRadius": [
                  { "$token": "corner-track-outer" },
                  { "$token": "corner-track-inside" },
                  { "$token": "corner-track-inside" },
                  { "$token": "corner-track-outer" }
                ],
                "fill": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "on-surface" },
                  "else": { "$token": "secondary-container" }
                },
                "opacity": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "state-disabled-container" },
                  "else": 1
                }
              },
              {
                "type": "rect",
                "name": "alça",
                "height": 44,
                "width": 4,
                "anchors": { "centerY": true, "right": -2 },
                "cornerRadius": { "$token": "corner-full" },
                "fill": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "on-surface" },
                  "else": { "$token": "primary" }
                },
                "opacity": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "state-disabled-content" },
                  "else": 1
                }
              }
            ]
          },
          {
            "type": "frame",
            "name": "trecho ativo",
            "width": "fill",
            "height": "fill",
            "layout": { "type": "none" },
            "children": [
              {
                "type": "rect",
                "name": "trilho ativo",
                "height": 16,
                "anchors": { "centerY": true, "left": 0, "right": 8 },
                "cornerRadius": [
                  { "$token": "corner-track-outer" },
                  { "$token": "corner-track-inside" },
                  { "$token": "corner-track-inside" },
                  { "$token": "corner-track-outer" }
                ],
                "visible": { "$not": { "$eq": ["type", "range"] } },
                "fill": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "on-surface" },
                  "else": { "$token": "primary" }
                },
                "opacity": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "state-disabled-content" },
                  "else": 1
                }
              },
              {
                "type": "rect",
                "name": "trilho ativo",
                "height": 16,
                "anchors": { "centerY": true, "left": 8, "right": 8 },
                "cornerRadius": { "$token": "corner-track-inside" },
                "visible": { "$eq": ["type", "range"] },
                "fill": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "on-surface" },
                  "else": { "$token": "primary" }
                },
                "opacity": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "state-disabled-content" },
                  "else": 1
                }
              }
            ]
          },
          {
            "type": "frame",
            "name": "depois do fim",
            "width": {
              "$sub": [
                { "$sub": [{ "$size": "width" }, 4] },
                {
                  "$if": {
                    "$and": [
                      { "$gte": [{ "$field": "steps" }, 1] },
                      {
                        "$or": [
                          { "$eq": ["type", "range"] },
                          {
                            "$lt": [
                              {
                                "$abs": {
                                  "$sub": [
                                    {
                                      "$mul": [
                                        {
                                          "$round": {
                                            "$mul": [
                                              {
                                                "$clamp": [
                                                  {
                                                    "$if": { "$eq": ["type", "range"] },
                                                    "then": {
                                                      "$field": "valueEnd",
                                                      "default": 0.8
                                                    },
                                                    "else": {
                                                      "$field": "value",
                                                      "default": 0.5
                                                    }
                                                  },
                                                  0,
                                                  1
                                                ]
                                              },
                                              {
                                                "$add": [
                                                  { "$floor": { "$field": "steps" } },
                                                  1
                                                ]
                                              }
                                            ]
                                          }
                                        },
                                        2
                                      ]
                                    },
                                    { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                                  ]
                                }
                              },
                              { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "then": {
                    "$add": [
                      8,
                      {
                        "$mul": [
                          {
                            "$div": [
                              {
                                "$round": {
                                  "$mul": [
                                    {
                                      "$clamp": [
                                        {
                                          "$if": { "$eq": ["type", "range"] },
                                          "then": {
                                            "$field": "valueEnd",
                                            "default": 0.8
                                          },
                                          "else": { "$field": "value", "default": 0.5 }
                                        },
                                        0,
                                        1
                                      ]
                                    },
                                    {
                                      "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                      "then": {
                                        "$add": [{ "$floor": { "$field": "steps" } }, 1]
                                      },
                                      "else": 1000000000
                                    }
                                  ]
                                }
                              },
                              {
                                "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                "then": {
                                  "$add": [{ "$floor": { "$field": "steps" } }, 1]
                                },
                                "else": 1000000000
                              }
                            ]
                          },
                          { "$sub": [{ "$sub": [{ "$size": "width" }, 4] }, 16] }
                        ]
                      }
                    ]
                  },
                  "else": {
                    "$mul": [
                      {
                        "$div": [
                          {
                            "$round": {
                              "$mul": [
                                {
                                  "$clamp": [
                                    {
                                      "$if": { "$eq": ["type", "range"] },
                                      "then": { "$field": "valueEnd", "default": 0.8 },
                                      "else": { "$field": "value", "default": 0.5 }
                                    },
                                    0,
                                    1
                                  ]
                                },
                                {
                                  "$if": { "$gte": [{ "$field": "steps" }, 1] },
                                  "then": {
                                    "$add": [{ "$floor": { "$field": "steps" } }, 1]
                                  },
                                  "else": 1000000000
                                }
                              ]
                            }
                          },
                          {
                            "$if": { "$gte": [{ "$field": "steps" }, 1] },
                            "then": { "$add": [{ "$floor": { "$field": "steps" } }, 1] },
                            "else": 1000000000
                          }
                        ]
                      },
                      { "$sub": [{ "$size": "width" }, 4] }
                    ]
                  }
                }
              ]
            },
            "height": "fill",
            "layout": { "type": "none" },
            "children": [
              {
                "type": "rect",
                "name": "trilho inativo",
                "height": 16,
                "anchors": { "centerY": true, "left": 8, "right": 0 },
                "cornerRadius": [
                  { "$token": "corner-track-inside" },
                  { "$token": "corner-track-outer" },
                  { "$token": "corner-track-outer" },
                  { "$token": "corner-track-inside" }
                ],
                "fill": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "on-surface" },
                  "else": { "$token": "secondary-container" }
                },
                "opacity": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "state-disabled-container" },
                  "else": 1
                }
              },
              {
                "type": "rect",
                "name": "alça",
                "height": 44,
                "width": {
                  "$if": {
                    "$and": [
                      { "$not": { "$eq": ["enabled", "false"] } },
                      {
                        "$or": [
                          { "$eq": ["interaction", "focused"] },
                          { "$eq": ["interaction", "pressed"] }
                        ]
                      }
                    ]
                  },
                  "then": 2,
                  "else": 4
                },
                "anchors": {
                  "centerY": true,
                  "left": {
                    "$if": {
                      "$and": [
                        { "$not": { "$eq": ["enabled", "false"] } },
                        {
                          "$or": [
                            { "$eq": ["interaction", "focused"] },
                            { "$eq": ["interaction", "pressed"] }
                          ]
                        }
                      ]
                    },
                    "then": -1,
                    "else": -2
                  }
                },
                "cornerRadius": { "$token": "corner-full" },
                "fill": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "on-surface" },
                  "else": { "$token": "primary" }
                },
                "opacity": {
                  "$if": { "$eq": ["enabled", "false"] },
                  "then": { "$token": "state-disabled-content" },
                  "else": 1
                }
              }
            ]
          }
        ]
      },
      {
        "type": "repeat",
        "name": "marcas",
        "count": {
          "$add": [{ "$max": [{ "$floor": { "$field": "steps", "default": 0 } }, 0] }, 2]
        },
        "direction": "row",
        "gap": {
          "$sub": [
            {
              "$div": [
                { "$sub": [{ "$size": "width" }, 20] },
                {
                  "$if": { "$gte": [{ "$field": "steps" }, 1] },
                  "then": { "$add": [{ "$floor": { "$field": "steps" } }, 1] },
                  "else": 1
                }
              ]
            },
            4
          ]
        },
        "template": {
          "type": "frame",
          "name": "posição",
          "width": 4,
          "height": 4,
          "layout": { "type": "none" },
          "children": [
            {
              "type": "ellipse",
              "name": "marca",
              "width": 4,
              "height": 4,
              "fill": {
                "$if": { "$eq": ["enabled", "false"] },
                "then": { "$token": "on-surface" },
                "else": { "$token": "secondary-container" }
              },
              "opacity": {
                "$if": { "$eq": ["enabled", "false"] },
                "then": { "$token": "state-disabled-container" },
                "else": 1
              },
              "visible": {
                "$and": [
                  { "$gte": [{ "$field": "steps" }, 1] },
                  {
                    "$gt": [
                      { "$field": "$index" },
                      {
                        "$if": { "$eq": ["type", "range"] },
                        "then": {
                          "$if": { "$gte": [{ "$field": "steps" }, 1] },
                          "then": {
                            "$round": {
                              "$mul": [
                                {
                                  "$clamp": [
                                    { "$field": "valueStart", "default": 0.2 },
                                    0,
                                    1
                                  ]
                                },
                                { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                              ]
                            }
                          },
                          "else": {
                            "$clamp": [{ "$field": "valueStart", "default": 0.2 }, 0, 1]
                          }
                        },
                        "else": -1
                      }
                    ]
                  },
                  {
                    "$lt": [
                      { "$field": "$index" },
                      {
                        "$if": { "$gte": [{ "$field": "steps" }, 1] },
                        "then": {
                          "$round": {
                            "$mul": [
                              {
                                "$clamp": [
                                  {
                                    "$if": { "$eq": ["type", "range"] },
                                    "then": { "$field": "valueEnd", "default": 0.8 },
                                    "else": { "$field": "value", "default": 0.5 }
                                  },
                                  0,
                                  1
                                ]
                              },
                              { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                            ]
                          }
                        },
                        "else": {
                          "$clamp": [
                            {
                              "$if": { "$eq": ["type", "range"] },
                              "then": { "$field": "valueEnd", "default": 0.8 },
                              "else": { "$field": "value", "default": 0.5 }
                            },
                            0,
                            1
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "ellipse",
              "name": "marca",
              "width": 4,
              "height": 4,
              "fill": {
                "$if": { "$eq": ["enabled", "false"] },
                "then": { "$token": "on-surface" },
                "else": { "$token": "primary" }
              },
              "opacity": {
                "$if": { "$eq": ["enabled", "false"] },
                "then": { "$token": "state-disabled-content" },
                "else": 1
              },
              "visible": {
                "$and": [
                  {
                    "$or": [
                      {
                        "$lt": [
                          { "$field": "$index" },
                          {
                            "$if": { "$eq": ["type", "range"] },
                            "then": {
                              "$if": { "$gte": [{ "$field": "steps" }, 1] },
                              "then": {
                                "$round": {
                                  "$mul": [
                                    {
                                      "$clamp": [
                                        { "$field": "valueStart", "default": 0.2 },
                                        0,
                                        1
                                      ]
                                    },
                                    { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                                  ]
                                }
                              },
                              "else": {
                                "$clamp": [
                                  { "$field": "valueStart", "default": 0.2 },
                                  0,
                                  1
                                ]
                              }
                            },
                            "else": -1
                          }
                        ]
                      },
                      {
                        "$gt": [
                          { "$field": "$index" },
                          {
                            "$if": { "$gte": [{ "$field": "steps" }, 1] },
                            "then": {
                              "$round": {
                                "$mul": [
                                  {
                                    "$clamp": [
                                      {
                                        "$if": { "$eq": ["type", "range"] },
                                        "then": { "$field": "valueEnd", "default": 0.8 },
                                        "else": { "$field": "value", "default": 0.5 }
                                      },
                                      0,
                                      1
                                    ]
                                  },
                                  { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                                ]
                              }
                            },
                            "else": {
                              "$clamp": [
                                {
                                  "$if": { "$eq": ["type", "range"] },
                                  "then": { "$field": "valueEnd", "default": 0.8 },
                                  "else": { "$field": "value", "default": 0.5 }
                                },
                                0,
                                1
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "$or": [
                      { "$gte": [{ "$field": "steps" }, 1] },
                      { "$eq": ["type", "range"] },
                      { "$gte": [{ "$field": "$index" }, 1] }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "anchors": { "left": 8, "centerY": true },
        "height": 4
      }
    ]
  }
}
