{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "divider",
  "name": "Divider",
  "description": "Linha de 1 dp em outline variant, horizontal ou vertical, centrada na caixa da marcação, com a espessura do campo e recuo opcional nas pontas.",
  "size": {
    "width": 360,
    "height": 16
  },
  "sizing": {
    "width": "fill",
    "height": 1
  },
  "preview": {
    "orientation": "horizontal",
    "thickness": 1,
    "inset": 0
  },
  "template": {
    "type": "frame",
    "name": "divider",
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "frame",
        "name": "linha com recuo",
        "layout": {
          "type": {
            "$if": {
              "$eq": ["orientation", "vertical"]
            },
            "then": "column",
            "else": "row"
          },
          "gap": {
            "$field": "inset",
            "default": 0
          },
          "align": "center"
        },
        "children": [
          {
            "type": "frame",
            "name": "ponta inicial",
            "width": 0,
            "height": 0,
            "children": []
          },
          {
            "type": "rect",
            "name": "linha",
            "fill": {
              "$token": "outline-variant"
            },
            "width": {
              "$if": {
                "$eq": ["orientation", "vertical"]
              },
              "then": {
                "$field": "thickness",
                "default": 1
              },
              "else": "fill"
            },
            "height": {
              "$if": {
                "$eq": ["orientation", "vertical"]
              },
              "then": "fill",
              "else": {
                "$field": "thickness",
                "default": 1
              }
            }
          },
          {
            "type": "frame",
            "name": "ponta final",
            "width": 0,
            "height": 0,
            "children": []
          }
        ]
      }
    ]
  }
}
