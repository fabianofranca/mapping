{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "m3-checkbox",
  "name": "Checkbox",
  "description": "Checkbox de 18 dp (forma 2) com rótulo body-large.",
  "size": {
    "width": 200,
    "height": 40
  },
  "minSize": {
    "width": 40,
    "height": 24
  },
  "sizing": {
    "width": "fill",
    "height": 40
  },
  "preview": {
    "label": "Label",
    "checked": "sim",
    "error": "não"
  },
  "template": {
    "type": "frame",
    "name": "checkbox",
    "layout": {
      "type": "row",
      "gap": 12,
      "align": "center"
    },
    "children": [
      {
        "type": "frame",
        "name": "caixa",
        "width": 18,
        "height": 18,
        "layout": {
          "type": "row",
          "align": "center",
          "justify": "center"
        },
        "cornerRadius": 2,
        "fill": {
          "$if": {
            "$field": "checked"
          },
          "then": {
            "$if": {
              "$field": "error"
            },
            "then": "#B3261E",
            "else": "#6750A4"
          },
          "else": "rgba(0, 0, 0, 0)"
        },
        "stroke": {
          "color": {
            "$if": {
              "$field": "checked"
            },
            "then": "rgba(0, 0, 0, 0)",
            "else": {
              "$if": {
                "$field": "error"
              },
              "then": "#B3261E",
              "else": "#49454F"
            }
          },
          "width": 2,
          "align": "inside"
        },
        "children": [
          {
            "type": "path",
            "name": "check",
            "visible": {
              "$field": "checked"
            },
            "width": 14,
            "height": 14,
            "viewBox": [24, 24],
            "d": "M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z",
            "fill": "#FFFFFF"
          }
        ]
      },
      {
        "type": "text",
        "name": "rótulo",
        "text": {
          "$field": "label"
        },
        "font": {
          "family": "Roboto",
          "size": 16,
          "weight": 400,
          "lineHeight": 24
        },
        "color": "#1D1B20",
        "visible": {
          "$has": "label"
        },
        "width": "fill"
      }
    ]
  }
}
