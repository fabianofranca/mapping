{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "surface",
  "name": "Surface",
  "description": "Superfície do Material 3: cor, forma e elevação tonal (a sobreposição do surface tint sobre a cor surface, como o `Surface` do Compose) atrás do conteúdo.",
  "size": {
    "width": 200,
    "height": 100
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "color": "surface",
    "shape": "medium",
    "tonalElevation": 3,
    "width": "wrap",
    "height": "wrap",
    "weight": null
  },
  "template": {
    "type": "frame",
    "name": "surface",
    "clip": false,
    "layout": {
      "type": "none"
    },
    "fill": {
      "$var": "fundo"
    },
    "cornerRadius": {
      "$var": "raio"
    },
    "children": [
      {
        "type": "rect",
        "name": "sombra nível 1",
        "fill": {
          "$var": "fundo"
        },
        "cornerRadius": {
          "$var": "raio"
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "visible": {
          "$and": [
            {
              "$gt": [
                {
                  "$field": "shadowElevation",
                  "default": 0
                },
                0
              ]
            },
            {
              "$lt": [
                {
                  "$field": "shadowElevation",
                  "default": 0
                },
                2
              ]
            }
          ]
        },
        "shadow": [
          {
            "color": {
              "$token": "elevation-point-shadow"
            },
            "y": {
              "$token": "elevation-1-point-y"
            },
            "blur": {
              "$token": "elevation-1-point-blur"
            },
            "spread": {
              "$token": "elevation-1-point-spread"
            }
          },
          {
            "color": {
              "$token": "elevation-ambient-shadow"
            },
            "y": {
              "$token": "elevation-1-ambient-y"
            },
            "blur": {
              "$token": "elevation-1-ambient-blur"
            },
            "spread": {
              "$token": "elevation-1-ambient-spread"
            }
          }
        ]
      },
      {
        "type": "rect",
        "name": "sombra nível 2",
        "fill": {
          "$var": "fundo"
        },
        "cornerRadius": {
          "$var": "raio"
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "visible": {
          "$and": [
            {
              "$gte": [
                {
                  "$field": "shadowElevation",
                  "default": 0
                },
                2
              ]
            },
            {
              "$lt": [
                {
                  "$field": "shadowElevation",
                  "default": 0
                },
                4
              ]
            }
          ]
        },
        "shadow": [
          {
            "color": {
              "$token": "elevation-point-shadow"
            },
            "y": {
              "$token": "elevation-2-point-y"
            },
            "blur": {
              "$token": "elevation-2-point-blur"
            },
            "spread": {
              "$token": "elevation-2-point-spread"
            }
          },
          {
            "color": {
              "$token": "elevation-ambient-shadow"
            },
            "y": {
              "$token": "elevation-2-ambient-y"
            },
            "blur": {
              "$token": "elevation-2-ambient-blur"
            },
            "spread": {
              "$token": "elevation-2-ambient-spread"
            }
          }
        ]
      },
      {
        "type": "rect",
        "name": "sombra nível 3",
        "fill": {
          "$var": "fundo"
        },
        "cornerRadius": {
          "$var": "raio"
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "visible": {
          "$and": [
            {
              "$gte": [
                {
                  "$field": "shadowElevation",
                  "default": 0
                },
                4
              ]
            },
            {
              "$lt": [
                {
                  "$field": "shadowElevation",
                  "default": 0
                },
                7
              ]
            }
          ]
        },
        "shadow": [
          {
            "color": {
              "$token": "elevation-point-shadow"
            },
            "y": {
              "$token": "elevation-3-point-y"
            },
            "blur": {
              "$token": "elevation-3-point-blur"
            },
            "spread": {
              "$token": "elevation-3-point-spread"
            }
          },
          {
            "color": {
              "$token": "elevation-ambient-shadow"
            },
            "y": {
              "$token": "elevation-3-ambient-y"
            },
            "blur": {
              "$token": "elevation-3-ambient-blur"
            },
            "spread": {
              "$token": "elevation-3-ambient-spread"
            }
          }
        ]
      },
      {
        "type": "rect",
        "name": "sombra nível 4",
        "fill": {
          "$var": "fundo"
        },
        "cornerRadius": {
          "$var": "raio"
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "visible": {
          "$and": [
            {
              "$gte": [
                {
                  "$field": "shadowElevation",
                  "default": 0
                },
                7
              ]
            },
            {
              "$lt": [
                {
                  "$field": "shadowElevation",
                  "default": 0
                },
                10
              ]
            }
          ]
        },
        "shadow": [
          {
            "color": {
              "$token": "elevation-point-shadow"
            },
            "y": {
              "$token": "elevation-4-point-y"
            },
            "blur": {
              "$token": "elevation-4-point-blur"
            },
            "spread": {
              "$token": "elevation-4-point-spread"
            }
          },
          {
            "color": {
              "$token": "elevation-ambient-shadow"
            },
            "y": {
              "$token": "elevation-4-ambient-y"
            },
            "blur": {
              "$token": "elevation-4-ambient-blur"
            },
            "spread": {
              "$token": "elevation-4-ambient-spread"
            }
          }
        ]
      },
      {
        "type": "rect",
        "name": "sombra nível 5",
        "fill": {
          "$var": "fundo"
        },
        "cornerRadius": {
          "$var": "raio"
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "visible": {
          "$and": [
            {
              "$gte": [
                {
                  "$field": "shadowElevation",
                  "default": 0
                },
                10
              ]
            }
          ]
        },
        "shadow": [
          {
            "color": {
              "$token": "elevation-point-shadow"
            },
            "y": {
              "$token": "elevation-5-point-y"
            },
            "blur": {
              "$token": "elevation-5-point-blur"
            },
            "spread": {
              "$token": "elevation-5-point-spread"
            }
          },
          {
            "color": {
              "$token": "elevation-ambient-shadow"
            },
            "y": {
              "$token": "elevation-5-ambient-y"
            },
            "blur": {
              "$token": "elevation-5-ambient-blur"
            },
            "spread": {
              "$token": "elevation-5-ambient-spread"
            }
          }
        ]
      },
      {
        "type": "rect",
        "name": "elevação tonal",
        "fill": {
          "$token": "surface-tint"
        },
        "opacity": {
          "$if": {
            "$has": "tonalElevation"
          },
          "then": {
            "$switch": "tonalElevation",
            "cases": {
              "1": 0.051,
              "2": 0.069,
              "3": 0.082,
              "4": 0.092,
              "5": 0.101,
              "6": 0.108,
              "7": 0.114,
              "8": 0.119,
              "9": 0.124,
              "10": 0.128,
              "11": 0.132,
              "12": 0.135
            },
            "default": 0.14
          },
          "else": 0
        },
        "cornerRadius": {
          "$var": "raio"
        },
        "visible": {
          "$or": [
            {
              "$not": {
                "$has": "color"
              }
            },
            {
              "$eq": ["color", "surface"]
            }
          ]
        }
      },
      {
        "type": "slot",
        "name": "content",
        "label": {
          "$concat": [
            "Surface · ",
            {
              "$field": "width",
              "default": "wrap"
            },
            " × ",
            {
              "$field": "height",
              "default": "wrap"
            },
            {
              "$if": {
                "$has": "weight"
              },
              "then": {
                "$concat": [
                  " · weight ",
                  {
                    "$field": "weight"
                  }
                ]
              },
              "else": ""
            }
          ]
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "layout": {
          "type": "none"
        },
        "provide": {
          "content-color": {
            "$switch": "color",
            "cases": {
              "primary": {
                "$token": "on-primary"
              },
              "onPrimary": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "primaryContainer": {
                "$token": "on-primary-container"
              },
              "onPrimaryContainer": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "secondary": {
                "$token": "on-secondary"
              },
              "onSecondary": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "secondaryContainer": {
                "$token": "on-secondary-container"
              },
              "onSecondaryContainer": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "tertiary": {
                "$token": "on-tertiary"
              },
              "onTertiary": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "tertiaryContainer": {
                "$token": "on-tertiary-container"
              },
              "onTertiaryContainer": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "error": {
                "$token": "on-error"
              },
              "onError": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "errorContainer": {
                "$token": "on-error-container"
              },
              "onErrorContainer": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "background": {
                "$token": "on-background"
              },
              "onBackground": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "surface": {
                "$token": "on-surface"
              },
              "onSurface": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "surfaceVariant": {
                "$token": "on-surface-variant"
              },
              "onSurfaceVariant": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "surfaceTint": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "inverseSurface": {
                "$token": "inverse-on-surface"
              },
              "inverseOnSurface": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "inversePrimary": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "outline": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "outlineVariant": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "scrim": {
                "$provided": "content-color",
                "default": {
                  "$token": "on-surface"
                }
              },
              "surfaceBright": {
                "$token": "on-surface"
              },
              "surfaceDim": {
                "$token": "on-surface"
              },
              "surfaceContainerLowest": {
                "$token": "on-surface"
              },
              "surfaceContainerLow": {
                "$token": "on-surface"
              },
              "surfaceContainer": {
                "$token": "on-surface"
              },
              "surfaceContainerHigh": {
                "$token": "on-surface"
              },
              "surfaceContainerHighest": {
                "$token": "on-surface"
              }
            },
            "default": {
              "$token": "on-surface"
            }
          }
        }
      }
    ],
    "stroke": {
      "color": {
        "$if": {
          "$gt": [
            {
              "$field": "borderWidth",
              "default": 0
            },
            0
          ]
        },
        "then": {
          "$switch": "borderColor",
          "cases": {
            "primary": {
              "$token": "primary"
            },
            "onPrimary": {
              "$token": "on-primary"
            },
            "primaryContainer": {
              "$token": "primary-container"
            },
            "onPrimaryContainer": {
              "$token": "on-primary-container"
            },
            "secondary": {
              "$token": "secondary"
            },
            "onSecondary": {
              "$token": "on-secondary"
            },
            "secondaryContainer": {
              "$token": "secondary-container"
            },
            "onSecondaryContainer": {
              "$token": "on-secondary-container"
            },
            "tertiary": {
              "$token": "tertiary"
            },
            "onTertiary": {
              "$token": "on-tertiary"
            },
            "tertiaryContainer": {
              "$token": "tertiary-container"
            },
            "onTertiaryContainer": {
              "$token": "on-tertiary-container"
            },
            "error": {
              "$token": "error"
            },
            "onError": {
              "$token": "on-error"
            },
            "errorContainer": {
              "$token": "error-container"
            },
            "onErrorContainer": {
              "$token": "on-error-container"
            },
            "background": {
              "$token": "background"
            },
            "onBackground": {
              "$token": "on-background"
            },
            "surface": {
              "$token": "surface"
            },
            "onSurface": {
              "$token": "on-surface"
            },
            "surfaceVariant": {
              "$token": "surface-variant"
            },
            "onSurfaceVariant": {
              "$token": "on-surface-variant"
            },
            "surfaceTint": {
              "$token": "surface-tint"
            },
            "inverseSurface": {
              "$token": "inverse-surface"
            },
            "inverseOnSurface": {
              "$token": "inverse-on-surface"
            },
            "inversePrimary": {
              "$token": "inverse-primary"
            },
            "outline": {
              "$token": "outline"
            },
            "outlineVariant": {
              "$token": "outline-variant"
            },
            "scrim": {
              "$token": "scrim"
            },
            "surfaceBright": {
              "$token": "surface-bright"
            },
            "surfaceDim": {
              "$token": "surface-dim"
            },
            "surfaceContainerLowest": {
              "$token": "surface-container-lowest"
            },
            "surfaceContainerLow": {
              "$token": "surface-container-low"
            },
            "surfaceContainer": {
              "$token": "surface-container"
            },
            "surfaceContainerHigh": {
              "$token": "surface-container-high"
            },
            "surfaceContainerHighest": {
              "$token": "surface-container-highest"
            }
          },
          "default": {
            "$token": "outline"
          }
        },
        "else": "none"
      },
      "width": {
        "$field": "borderWidth",
        "default": 0
      },
      "align": "inside"
    },
    "let": {
      "fundo": {
        "$switch": "color",
        "cases": {
          "primary": {
            "$token": "primary"
          },
          "onPrimary": {
            "$token": "on-primary"
          },
          "primaryContainer": {
            "$token": "primary-container"
          },
          "onPrimaryContainer": {
            "$token": "on-primary-container"
          },
          "secondary": {
            "$token": "secondary"
          },
          "onSecondary": {
            "$token": "on-secondary"
          },
          "secondaryContainer": {
            "$token": "secondary-container"
          },
          "onSecondaryContainer": {
            "$token": "on-secondary-container"
          },
          "tertiary": {
            "$token": "tertiary"
          },
          "onTertiary": {
            "$token": "on-tertiary"
          },
          "tertiaryContainer": {
            "$token": "tertiary-container"
          },
          "onTertiaryContainer": {
            "$token": "on-tertiary-container"
          },
          "error": {
            "$token": "error"
          },
          "onError": {
            "$token": "on-error"
          },
          "errorContainer": {
            "$token": "error-container"
          },
          "onErrorContainer": {
            "$token": "on-error-container"
          },
          "background": {
            "$token": "background"
          },
          "onBackground": {
            "$token": "on-background"
          },
          "surface": {
            "$token": "surface"
          },
          "onSurface": {
            "$token": "on-surface"
          },
          "surfaceVariant": {
            "$token": "surface-variant"
          },
          "onSurfaceVariant": {
            "$token": "on-surface-variant"
          },
          "surfaceTint": {
            "$token": "surface-tint"
          },
          "inverseSurface": {
            "$token": "inverse-surface"
          },
          "inverseOnSurface": {
            "$token": "inverse-on-surface"
          },
          "inversePrimary": {
            "$token": "inverse-primary"
          },
          "outline": {
            "$token": "outline"
          },
          "outlineVariant": {
            "$token": "outline-variant"
          },
          "scrim": {
            "$token": "scrim"
          },
          "surfaceBright": {
            "$token": "surface-bright"
          },
          "surfaceDim": {
            "$token": "surface-dim"
          },
          "surfaceContainerLowest": {
            "$token": "surface-container-lowest"
          },
          "surfaceContainerLow": {
            "$token": "surface-container-low"
          },
          "surfaceContainer": {
            "$token": "surface-container"
          },
          "surfaceContainerHigh": {
            "$token": "surface-container-high"
          },
          "surfaceContainerHighest": {
            "$token": "surface-container-highest"
          }
        },
        "default": {
          "$token": "surface"
        }
      },
      "raio": {
        "$switch": "shape",
        "cases": {
          "extraSmall": {
            "$token": "corner-extra-small"
          },
          "small": {
            "$token": "corner-small"
          },
          "medium": {
            "$token": "corner-medium"
          },
          "large": {
            "$token": "corner-large"
          },
          "extraLarge": {
            "$token": "corner-extra-large"
          }
        },
        "default": {
          "$token": "corner-none"
        }
      }
    }
  }
}
