{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "change-kind",
  "name": "ChangeKind",
  "description": "Selo neutro do tipo de mudança: a forma diz o tipo, nunca a cor. Caixa de 20 px (18 px no tamanho sm) com borda de controle e o glifo: + criada, − removida, ⇄ movida, ∿ alterada, duas molduras para imagem trocada.",
  "size": {
    "width": 18,
    "height": 18
  },
  "minSize": {
    "width": 12,
    "height": 12
  },
  "sizing": {
    "width": 18,
    "height": 18
  },
  "preview": {
    "tipo": "alterada"
  },
  "template": {
    "type": "frame",
    "name": "tipo",
    "layout": {
      "type": "none"
    },
    "cornerRadius": 4,
    "stroke": {
      "color": {
        "$token": "color-border-control"
      },
      "width": 1
    },
    "children": [
      {
        "type": "icon",
        "name": {
          "$switch": "tipo",
          "cases": {
            "criada": "plus",
            "removida": "minus",
            "movida": "moved",
            "alterada": "changed",
            "trocada": "replaced"
          },
          "default": "changed"
        },
        "color": {
          "$token": "color-text"
        },
        "strokeWidth": 1.5,
        "width": 12,
        "height": 12,
        "anchors": {
          "centerX": true,
          "centerY": true
        }
      }
    ]
  }
}
