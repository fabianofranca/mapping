                "else": { "$token": "primary" }
              },
              "visible": {
                "$and": [
                  {
                    "$or": [
                      {
                        "$lt": [
                          { "$field": "$index" },
                          {
                            "$if": { "$eq": ["type", "range"] },
                            "then": {
                              "$if": { "$gte": [{ "$field": "steps" }, 1] },
                              "then": {
                                "$round": {
                                  "$mul": [
                                    {
                                      "$clamp": [
                                        { "$field": "valueStart", "default": 0.2 },
                                        0,
                                        1
                                      ]
                                    },
                                    { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                                  ]
                                }
                              },
                              "else": {
                                "$clamp": [
                                  { "$field": "valueStart", "default": 0.2 },
                                  0,
                                  1
                                ]
                              }
                            },
                            "else": -1
                          }
                        ]
                      },
                      {
                        "$gt": [
                          { "$field": "$index" },
                          {
                            "$if": { "$gte": [{ "$field": "steps" }, 1] },
                            "then": {
                              "$round": {
                                "$mul": [
                                  {
                                    "$clamp": [
                                      {
                                        "$if": { "$eq": ["type", "range"] },
                                        "then": { "$field": "valueEnd", "default": 0.8 },
                                        "else": { "$field": "value", "default": 0.5 }
                                      },
                                      0,
                                      1
                                    ]
                                  },
                                  { "$add": [{ "$floor": { "$field": "steps" } }, 1] }
                                ]
                              }
                            },
                            "else": {
                              "$clamp": [
                                {
                                  "$if": { "$eq": ["type", "range"] },
                                  "then": { "$field": "valueEnd", "default": 0.8 },
                                  "else": { "$field": "value", "default": 0.5 }
                                },
                                0,
                                1
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "$or": [
                      { "$gte": [{ "$field": "steps" }, 1] },
                      { "$eq": ["type", "range"] },
                      { "$gte": [{ "$field": "$index" }, 1] }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "anchors": { "left": 8, "centerY": true },
        "height": 4
      }
    ]
  }
