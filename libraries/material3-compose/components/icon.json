{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "icon",
  "name": "Icon",
  "description": "Ícone de 24 dp do conjunto Material Icons (Filled) da biblioteca, na cor de tint; nome fora do conjunto desenha o reservado e avisa.",
  "size": {
    "width": 24,
    "height": 24
  },
  "sizing": {
    "width": 24,
    "height": 24
  },
  "preview": {
    "imageVector": "Home",
    "contentDescription": null,
    "tint": null
  },
  "template": {
    "type": "frame",
    "name": "icon",
    "clip": false,
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "icon",
        "name": {
          "$switch": "imageVector",
          "cases": {
            "Home": "home",
            "Search": "search",
            "Person": "person",
