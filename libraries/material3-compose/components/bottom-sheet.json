{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "bottom-sheet",
  "name": "Bottom sheet",
  "description": "Folha de baixo em surface container low, cantos superiores de 28, alça de 32 × 4 numa área de 48, título e um ListItem de 56 por linha; modal sem sombra (o scrim é do composable), standard com a sombra do nível 1 e altura mínima de sheetPeekHeight.",
  "size": {
    "width": 412,
    "height": 320
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "title": "Compartilhar",
    "style": "modal",
    "dragHandle": "true",
    "sheetPeekHeight": 56,
    "items": [
      {
        "label": "Favoritos",
        "icon": "Favorite"
      },
      {
        "label": "Editar",
        "icon": "Edit"
      },
      {
        "label": "Configurações",
        "icon": "Settings"
      }
    ]
  },
  "template": {
    "type": "frame",
    "name": "bottom sheet",
    "cornerRadius": [
      { "$token": "corner-extra-large" },
      { "$token": "corner-extra-large" },
      0,
      0
    ],
    "fill": {
      "$token": "surface-container-low"
    },
    "maxWidth": 640,
    "minHeight": {
      "$if": {
        "$eq": ["style", "standard"]
      },
      "then": {
        "$field": "sheetPeekHeight"
      }
    },
    "shadow": {
      "color": {
        "$if": {
          "$eq": ["style", "standard"]
        },
        "then": {
          "$token": "elevation-shadow"
        },
        "else": "none"
      },
      "y": {
        "$token": "elevation-1-y"
      },
      "blur": {
        "$token": "elevation-1-blur"
      }
    },
    "layout": {
      "type": "column",
      "gap": 0,
      "padding": [0, 0, 16, 0]
    },
    "children": [
      {
        "type": "frame",
        "name": "área da alça",
        "width": "fill",
        "height": 48,
        "visible": {
          "$not": {
            "$eq": ["dragHandle", "false"]
          }
        },
        "layout": {
          "type": "row",
          "align": "center",
          "justify": "center"
        },
        "children": [
          {
            "type": "rect",
            "name": "alça",
            "width": 32,
            "height": 4,
            "cornerRadius": {
              "$token": "corner-extra-large"
            },
            "fill": {
              "$token": "on-surface-variant"
            }
          }
        ]
      },
      {
        "type": "frame",
        "name": "cabeçalho",
        "width": "fill",
        "height": "hug",
        "visible": {
          "$has": "title"
        },
        "layout": {
          "type": "column",
          "padding": [8, 16, 16, 16]
        },
        "children": [
          {
            "type": "text",
            "name": "título",
            "text": {
              "$field": "title"
            },
            "width": "fill",
            "font": {
              "size": {
                "$token": "title-large-size"
              },
              "weight": {
                "$token": "title-large-weight"
              },
              "lineHeight": {
                "$token": "title-large-line-height"
              },
              "letterSpacing": {
                "$token": "title-large-tracking"
              }
            },
            "color": {
              "$token": "on-surface"
            }
          }
        ]
      },
      {
        "type": "repeat",
        "name": "itens",
        "field": "items",
        "direction": "column",
        "width": "fill",
        "height": "hug",
        "template": {
          "type": "frame",
          "name": "item",
          "width": "fill",
          "height": "hug",
          "minHeight": 56,
          "fill": {
            "$token": "surface"
          },
          "layout": {
            "type": "row",
            "gap": 16,
            "padding": [8, 16],
            "align": "center"
          },
          "children": [
            {
              "type": "icon",
              "name": {
                "$switch": "icon",
                "cases": {
                  "Home": "home",
                  "Search": "search",
                  "Person": "person",
                  "Menu": "menu",
                  "MoreVert": "more_vert",
                  "Add": "add",
                  "Check": "check",
                  "Close": "close",
                  "ArrowBack": "arrow_back",
                  "Favorite": "favorite",
                  "Edit": "edit",
                  "Delete": "delete",
                  "Share": "share",
                  "Notifications": "notifications",
                  "Settings": "settings",
                  "Info": "info",
                  "Star": "star",
                  "Email": "email",
                  "Phone": "phone",
                  "Place": "place",
                  "DateRange": "date_range",
                  "ShoppingCart": "shopping_cart",
                  "AccountCircle": "account_circle",
                  "KeyboardArrowRight": "keyboard_arrow_right",
                  "KeyboardArrowDown": "keyboard_arrow_down",
                  "Refresh": "refresh",
                  "Clear": "clear",
                  "Done": "done",
                  "Lock": "lock",
                  "List": "list",
                  "AccountBox": "account_box",
                  "AddCircle": "add_circle",
                  "ArrowDropDown": "arrow_drop_down",
                  "ArrowDropUp": "arrow_drop_up",
                  "ArrowForward": "arrow_forward",
                  "ArrowUpward": "arrow_upward",
                  "ArrowDownward": "arrow_downward",
                  "Build": "build",
                  "Call": "call",
                  "CheckCircle": "check_circle",
                  "Create": "create",
                  "Face": "face",
                  "FavoriteBorder": "favorite_border",
                  "ExitToApp": "exit_to_app",
                  "KeyboardArrowLeft": "keyboard_arrow_left",
                  "KeyboardArrowUp": "keyboard_arrow_up",
                  "LocationOn": "location_on",
                  "MailOutline": "mail_outline",
                  "PlayArrow": "play_arrow",
                  "Send": "send",
                  "ThumbUp": "thumb_up",
                  "Warning": "warning",
                  "Cancel": "cancel",
                  "ExpandMore": "expand_more",
                  "ExpandLess": "expand_less",
                  "ChevronLeft": "chevron_left",
                  "ChevronRight": "chevron_right",
                  "FirstPage": "first_page",
                  "LastPage": "last_page",
                  "MoreHoriz": "more_horiz",
                  "Apps": "apps",
                  "Dashboard": "dashboard",
                  "Folder": "folder",
                  "FolderOpen": "folder_open",
                  "InsertDriveFile": "insert_drive_file",
                  "Description": "description",
                  "Image": "image",
                  "Mic": "mic",
                  "Videocam": "videocam",
                  "Chat": "chat",
                  "Comment": "comment",
                  "Forum": "forum",
                  "NotificationsNone": "notifications_none",
                  "Visibility": "visibility",
                  "VisibilityOff": "visibility_off",
                  "Language": "language",
                  "Public": "public",
                  "Link": "link",
                  "Attachment": "attachment",
                  "ContentCopy": "content_copy",
                  "ContentPaste": "content_paste",
                  "ContentCut": "content_cut",
                  "Save": "save",
                  "Download": "download",
                  "Upload": "upload",
                  "CloudUpload": "cloud_upload",
                  "CloudDownload": "cloud_download",
                  "Cloud": "cloud",
                  "Sync": "sync",
                  "Schedule": "schedule",
                  "AccessTime": "access_time",
                  "CalendarToday": "calendar_today",
                  "Event": "event",
                  "Today": "today",
                  "Timer": "timer",
                  "Alarm": "alarm",
                  "History": "history",
                  "Bookmark": "bookmark",
                  "BookmarkBorder": "bookmark_border",
                  "Label": "label",
                  "Flag": "flag",
                  "Help": "help",
                  "HelpOutline": "help_outline",
                  "Error": "error",
                  "ErrorOutline": "error_outline",
                  "Report": "report",
                  "Block": "block",
                  "Tune": "tune",
                  "FilterList": "filter_list",
                  "Sort": "sort",
                  "Fullscreen": "fullscreen",
                  "Wifi": "wifi",
                  "Bluetooth": "bluetooth",
                  "LightMode": "light_mode",
                  "DarkMode": "dark_mode",
                  "Palette": "palette",
                  "ShoppingBag": "shopping_bag",
                  "Store": "store",
                  "Payment": "payment",
                  "CreditCard": "credit_card",
                  "AttachMoney": "attach_money",
                  "Receipt": "receipt",
                  "Map": "map",
                  "Navigation": "navigation",
                  "DirectionsCar": "directions_car",
                  "Flight": "flight",
                  "MenuOpen": "menu_open",
                  "Logout": "logout",
                  "Login": "login",
                  "People": "people",
                  "Group": "group",
                  "PersonAdd": "person_add",
                  "LockOpen": "lock_open",
                  "Security": "security",
                  "VerifiedUser": "verified_user",
                  "Key": "key",
                  "Pause": "pause",
                  "Stop": "stop",
                  "SkipNext": "skip_next",
                  "SkipPrevious": "skip_previous",
                  "VolumeUp": "volume_up",
                  "VolumeOff": "volume_off",
                  "ThumbDown": "thumb_down",
                  "Reply": "reply",
                  "Inbox": "inbox",
                  "Archive": "archive",
                  "Undo": "undo",
                  "Redo": "redo",
                  "ZoomIn": "zoom_in",
                  "ZoomOut": "zoom_out",
                  "Keyboard": "keyboard",
                  "CheckBox": "check_box",
                  "CheckBoxOutlineBlank": "check_box_outline_blank",
                  "RadioButtonChecked": "radio_button_checked",
                  "RadioButtonUnchecked": "radio_button_unchecked",
                  "ToggleOn": "toggle_on",
                  "ToggleOff": "toggle_off",
                  "StarBorder": "star_border",
                  "StarHalf": "star_half",
                  "Lightbulb": "lightbulb",
                  "Code": "code",
                  "Terminal": "terminal",
                  "Bolt": "bolt",
                  "EditCalendar": "edit_calendar"
                },
                "default": {
                  "$field": "icon"
                }
              },
              "color": {
                "$token": "on-surface-variant"
              },
              "width": 24,
              "height": 24,
              "visible": {
                "$has": "icon"
              }
            },
            {
              "type": "text",
              "name": "rótulo",
              "text": {
                "$field": "label"
              },
              "width": "fill",
              "font": {
                "size": {
                  "$token": "body-large-size"
                },
                "weight": {
                  "$token": "body-large-weight"
                },
                "lineHeight": {
                  "$token": "body-large-line-height"
                },
                "letterSpacing": {
                  "$token": "body-large-tracking"
                },
                "maxLines": 1,
                "ellipsis": true
              },
              "color": {
                "$token": "on-surface"
              }
            }
          ]
        }
      }
    ]
  }
}
