{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapping.local/spec.schema.json",
  "title": "Mapping — especialização (formatVersion 1, 2, 3, 4, 5, 6 e 7)",
  "description": "Valida a estrutura. Regras entre elementos (ids únicos, allowedChildren em outra camada, requiresOwner, labelField, rowLabel, default compatível, rowLabel/tags, plataformas declaradas em platforms, chaves de params e values, platforms/code a partir do formatVersion 2, sources só no formatVersion 3, values de sources só em campos enum e com destinos nas options) e, na formatVersion 4, as chaves novas só com formatVersion 4, sources com slot/ignore/path só em sistema declarado em origins (com path obrigatório lá e name obrigatório fora), exemplos com um só modo e valores compatíveis com os campos do tipo, system dos exemplos declarado em origins, par family+weight+style único em fonts, faixa de peso com o primeiro valor menor, regras de origins (o detalhe está em origins, validado pelo parseOrigins) e as conferências das migrations (to maior que from e até version, from único, a chave de campo de um passo é campo ou tabela.coluna, o lado novo existe e o lado antigo não existe mais, destinos de map-values nas options, default de fill-field compatível) só são verificadas pelo validador da app; na formatVersion 5, platforms[].repo (a formatVersion 5 é a 4 mais repo; em versão anterior é erro) também só é verificado pelo validador da app; na formatVersion 6, containers (a 6 é a 5 mais containers; em versão anterior é erro, e o id repetido é verificado pelo validador da app); na formatVersion 7, floating e appliesTo no tipo e ref como tipo de coluna de table (a 7 é a 6 mais floating, appliesTo e a coluna ref; em versão anterior é erro, verificado pelo validador da app; appliesTo não vazio, sem repetição, e um tipo só de seta não tem component nem floating); veja SPEC-FORMAT.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "id", "name", "version", "layers"],
  "properties": {
    "format": {
      "enum": ["mapping-spec", "mapeador-spec"]
    },
    "formatVersion": {
      "enum": [1, 2, 3, 4, 5, 6, 7]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "containers": {
      "description": "formatVersion 6: presets de tamanho do diálogo Novo container, agrupados pelo nome da especialização. Em versão anterior é erro; id único.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/container"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/font"
      }
    },
    "origins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/origin"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/migration"
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_]*$"
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color", "annotationTypes"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "annotationTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotationType"
          }
        }
      }
    },
    "annotationType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "fields"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "labelField": {
          "type": ["string", "null"]
        },
        "requiresOwner": {
          "type": "boolean"
        },
        "allowedChildren": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "code": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/platformId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/codeEntry"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeSource"
          }
        },
        "component": {
          "$ref": "#/$defs/jsonFile"
        },
        "doc": {
          "$ref": "#/$defs/markdownFile"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "floating": {
          "type": "boolean",
          "description": "formatVersion 7: a instância do tipo é uma marcação flutuante (vive no canvas, fora do pertencimento, desenhada acima de tudo). Em versão anterior é erro."
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["marking", "arrow"]
          },
          "description": "formatVersion 7: a que a anotação se aplica, marking (uma marcação), arrow (uma seta) ou os dois; padrão [\"marking\"]. Um tipo só de seta não tem component nem floating. Em versão anterior é erro."
        }
      }
    },
    "field": {
      "oneOf": [
        {
          "$ref": "#/$defs/simpleField"
        },
        {
          "$ref": "#/$defs/tableField"
        },
        {
          "$ref": "#/$defs/refField"
        }
      ]
    },
    "simpleField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type"],
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tag"
              }
            },
            "type": {
              "enum": ["string", "number", "date"]
            },
            "default": {
              "type": ["string", "number"]
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fieldSource"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type", "options"],
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tag"
              }
            },
            "type": {
              "const": "enum"
            },
            "default": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fieldSource"
              }
            }
          }
        }
      ]
    },
    "column": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type"],
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "type": {
              "enum": ["string", "number", "date"]
            },
            "default": {
              "type": ["string", "number"]
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fieldSource"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "type", "options"],
          "properties": {
            "key": {
              "$ref": "#/$defs/key"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "type": {
              "const": "enum"
            },
            "default": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fieldSource"
              }
            }
          }
        },
        {
          "$ref": "#/$defs/refField",
          "description": "formatVersion 7: coluna de referência; a célula guarda uma referência (dado, não seta)."
        }
      ]
    },
    "tableField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "columns"],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "const": "table"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "rowLabel": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldSource"
          }
        }
      }
    },
    "refField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "accepts"],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "const": "ref"
        },
        "accepts": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["tags"],
              "properties": {
                "tags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/tag"
                  },
                  "minItems": 1
                },
                "free": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["free"],
              "properties": {
                "tags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/tag"
                  }
                },
                "free": {
                  "const": true
                }
              }
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldSource"
          }
        }
      }
    },
    "platformId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/platformId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "$ref": "#/$defs/platformRepo"
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "width", "height"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "background": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "platformRepo": {
      "type": "object",
      "description": "formatVersion 5: repositório da biblioteca nessa plataforma, onde estão os arquivos citados nos path do code. Em versão anterior é erro.",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^[hH][tT][tT][pP][sS]?://\\S+$",
          "description": "Endereço do repositório (http:// ou https://, sem espaços)."
        },
        "urlTemplate": {
          "type": "string",
          "pattern": "^[hH][tT][tT][pP][sS]?://\\S*\\{path\\}\\S*$",
          "description": "Modelo do endereço de um arquivo: http(s):// sem espaços, com {path} e {line} opcional. Sem ele, os arquivos não viram link."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Revisão (tag, branch ou commit) a que o code corresponde; informativa."
        }
      }
    },
    "codeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol"],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(^|/)\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\u0000-\\u001f\\u007f\\\\]+$",
          "description": "Arquivo que define o symbol, relativo à raiz do repositório da plataforma (sem linha)."
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "typeSource": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "id"],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "slot": {
              "type": "string",
              "minLength": 1,
              "description": "formatVersion 4, só em sistema declarado em origins."
            },
            "ignore": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "formatVersion 4, só em sistema declarado em origins."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "name"],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "slot": {
              "type": "string",
              "minLength": 1,
              "description": "formatVersion 4, só em sistema declarado em origins."
            },
            "ignore": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "formatVersion 4, só em sistema declarado em origins."
            }
          }
        }
      ]
    },
    "fieldSource": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "name"],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "formatVersion 4: caminho do valor nas props do nó externo (a.b[0].c), só em sistema declarado em origins; obrigatório lá, e name passa a ser opcional."
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "path"],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "formatVersion 4: caminho do valor nas props do nó externo (a.b[0].c), só em sistema declarado em origins; obrigatório lá, e name passa a ser opcional."
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "jsonFile": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(^|/)\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\u0000-\\u001f\\u007f\\\\]*[^/\\\\]\\.json$",
      "description": "Caminho de um arquivo .json do pacote, relativo ao arquivo da especialização (com /, sem . nem .., sem unidade de disco)."
    },
    "markdownFile": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(^|/)\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\u0000-\\u001f\\u007f\\\\]*[^/\\\\]\\.md$",
      "description": "Caminho de um arquivo .md do pacote, relativo ao arquivo da especialização."
    },
    "fontFile": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(^|/)\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\u0000-\\u001f\\u007f\\\\]*[^/\\\\]\\.(ttf|otf|woff|woff2)$",
      "description": "Caminho de um arquivo de fonte (.ttf, .otf, .woff ou .woff2) do pacote, relativo ao arquivo da especialização."
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "file"],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "$ref": "#/$defs/fontFile"
        },
        "weight": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 1000
            },
            {
              "type": "string",
              "pattern": "^(100|[1-9][0-9]{2}|1000) (100|[1-9][0-9]{2}|1000)$",
              "description": "Faixa \"100 900\": dois inteiros de 100 a 1000 separados por um espaço, o primeiro menor (a ordem só o validador confere)."
            }
          ]
        },
        "style": {
          "enum": ["normal", "italic"]
        }
      }
    },
    "example": {
      "oneOf": [
        {
          "$ref": "#/$defs/valuesExample"
        },
        {
          "$ref": "#/$defs/fileExample"
        }
      ],
      "description": "Exatamente um dos dois modos: valores do tipo (values) ou o JSON de um sistema externo (system + file)."
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "steps"],
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "integer",
          "minimum": 2
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/migrationStep"
          }
        }
      }
    },
    "migrationStep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "from", "to"],
          "properties": {
            "op": {
              "const": "rename-type"
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "type", "mode"],
          "properties": {
            "op": {
              "const": "remove-type"
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "enum": ["convert", "delete"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "type", "from", "to"],
          "properties": {
            "op": {
              "const": "rename-field"
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "type", "field"],
          "properties": {
            "op": {
              "const": "remove-field"
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "type", "field", "values"],
          "properties": {
            "op": {
              "const": "map-values"
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "type", "field", "default"],
          "properties": {
            "op": {
              "const": "fill-field"
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "default": {
              "type": ["string", "number"]
            }
          }
        }
      ]
    },
    "valueSource": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "default": {
              "type": ["string", "number"]
            }
          }
        }
      ]
    },
    "originRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Caminho da raiz no documento; [*] faz de cada elemento da lista uma raiz."
        },
        "anchor": {
          "$ref": "#/$defs/valueSource"
        },
        "margin": {
          "$ref": "#/$defs/valueSource"
        },
        "scrim": {
          "type": "string",
          "minLength": 1
        }
