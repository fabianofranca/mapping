{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "progress-indicator",
  "name": "Progress indicator",
  "description": "Indicador de progresso circular (40, traço de 4) ou linear (barra de 4 com parada), com o indicador em primary e o trilho em secondary-container, de ponta redonda e com gap de 4. Sem valor de progresso é indeterminado e o desenho mostra um quadro congelado da animação (um arco ou uma barra parcial).",
  "size": { "width": 240, "height": 48 },
  "sizing": { "width": "fill", "height": 48 },
  "preview": { "shape": "circular", "progress": 0.6 },
  "template": {
    "type": "frame",
    "name": "progress indicator",
    "layout": { "type": "row", "align": "center", "justify": "center" },
    "children": [
      {
        "type": "frame",
        "name": "circular",
        "width": 40,
        "height": 40,
        "layout": { "type": "none" },
        "visible": { "$not": { "$eq": ["shape", "linear"] } },
        "children": [
          {
            "type": "ellipse",
            "name": "trilho completo",
            "width": 40,
            "height": 40,
            "fill": "none",
            "stroke": {
              "color": { "$token": "secondary-container" },
              "width": 4,
              "align": "inside"
            },
            "visible": { "$lte": [{ "$field": "progress" }, 0] }
          },
          {
            "type": "path",
            "name": "trilho arco",
            "visible": {
              "$and": [
                { "$gt": [{ "$field": "progress" }, 0] },
                { "$lt": [{ "$field": "progress" }, 1] }
              ]
            },
            "width": 40,
            "height": 40,
            "viewBox": [40, 40],
            "d": {
              "$concat": [
                "M20 2A18 18 0 ",
                {
                  "$if": { "$lt": [{ "$field": "progress" }, 0.37267605] },
                  "then": "1",
                  "else": "0"
                },
                " ",
                {
                  "$if": { "$lte": [{ "$field": "progress" }, 0.87267605] },
                  "then": "1",
                  "else": "0"
                },
                " ",
                {
                  "$sub": [
                    20,
                    {
                      "$mul": [
                        18,
                        {
                          "$sin": {
                            "$min": [
                              { "$mul": [{ "$field": "progress" }, 1080] },
                              {
                                "$add": [
                                  { "$mul": [{ "$field": "progress" }, 360] },
                                  45.8366236
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                " ",
                {
                  "$sub": [
                    20,
                    {
                      "$mul": [
                        18,
                        {
                          "$cos": {
                            "$min": [
                              { "$mul": [{ "$field": "progress" }, 1080] },
                              {
                                "$add": [
                                  { "$mul": [{ "$field": "progress" }, 360] },
                                  45.8366236
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "fill": "none",
            "stroke": {
              "color": { "$token": "secondary-container" },
              "width": 4,
              "align": "center",
              "cap": "round",
              "join": "round"
            },
            "rotation": {
              "$min": [
                { "$mul": [{ "$field": "progress" }, 720] },
                { "$add": [{ "$mul": [{ "$field": "progress" }, 360] }, 22.9183118] }
              ]
            }
          },
          {
            "type": "path",
            "name": "indicador",
            "visible": {
              "$and": [
                { "$gt": [{ "$field": "progress" }, 0] },
                { "$lt": [{ "$field": "progress" }, 1] }
              ]
            },
            "width": 40,
            "height": 40,
            "viewBox": [40, 40],
            "d": {
              "$concat": [
                "M20 2A18 18 0 ",
                {
                  "$if": { "$gt": [{ "$field": "progress" }, 0.5] },
                  "then": "1",
                  "else": "0"
                },
                " 1 ",
                {
                  "$add": [
                    20,
                    {
                      "$mul": [
                        18,
                        { "$sin": { "$mul": [{ "$field": "progress" }, 360] } }
                      ]
                    }
                  ]
                },
                " ",
                {
                  "$sub": [
                    20,
                    {
                      "$mul": [
                        18,
                        { "$cos": { "$mul": [{ "$field": "progress" }, 360] } }
                      ]
                    }
                  ]
                }
              ]
            },
            "fill": "none",
            "stroke": {
              "color": { "$token": "primary" },
              "width": 4,
              "align": "center",
              "cap": "round",
              "join": "round"
            }
          },
          {
            "type": "ellipse",
            "name": "anel completo",
            "width": 40,
            "height": 40,
            "fill": "none",
            "stroke": { "color": { "$token": "primary" }, "width": 4, "align": "inside" },
            "visible": { "$gte": [{ "$field": "progress" }, 1] }
          },
          {
            "type": "path",
            "name": "indicador indeterminado",
            "visible": { "$not": { "$has": "progress" } },
            "width": 40,
            "height": 40,
            "viewBox": [40, 40],
            "d": "M20 2A18 18 0 0 1 21.69 37.92",
            "fill": "none",
            "stroke": {
              "color": { "$token": "primary" },
              "width": 4,
              "align": "center",
              "cap": "round",
              "join": "round"
            }
          }
        ]
      },
      {
        "type": "frame",
        "name": "linear",
        "width": "fill",
        "height": 4,
        "layout": { "type": "row", "align": "center" },
        "visible": { "$eq": ["shape", "linear"] },
        "children": [
          {
            "type": "frame",
            "name": "trilho antes",
            "width": "30%",
            "height": 4,
            "layout": { "type": "none" },
            "visible": { "$not": { "$has": "progress" } },
            "children": [
              {
                "type": "rect",
                "name": "faixa antes",
                "fill": { "$token": "secondary-container" },
                "cornerRadius": { "$token": "corner-full" },
                "anchors": { "left": 0, "right": 6 }
              }
            ]
          },
          {
            "type": "frame",
            "name": "indicador",
            "width": {
              "$if": { "$has": "progress" },
              "then": {
                "$concat": [
                  { "$mul": [{ "$clamp": [{ "$field": "progress" }, 0, 1] }, 100] },
                  "%"
                ]
              },
              "else": "40%"
            },
            "height": 4,
            "layout": { "type": "none" },
            "children": [
              {
                "type": "rect",
                "name": "barra",
                "visible": { "$gt": [{ "$field": "progress" }, 0] },
                "fill": { "$token": "primary" },
                "cornerRadius": { "$token": "corner-full" },
                "anchors": { "left": 0, "right": -2 }
              },
              {
                "type": "rect",
                "name": "barra indeterminada",
                "visible": { "$not": { "$has": "progress" } },
                "fill": { "$token": "primary" },
                "cornerRadius": { "$token": "corner-full" },
                "anchors": { "left": -2, "right": -2 }
              }
            ]
          },
          {
            "type": "frame",
            "name": "trilho",
            "width": "fill",
            "height": 4,
            "layout": { "type": "none" },
            "visible": { "$not": { "$gte": [{ "$field": "progress" }, 1] } },
            "children": [
              {
                "type": "rect",
                "name": "faixa",
                "visible": { "$not": { "$lte": [{ "$field": "progress" }, 0] } },
                "fill": { "$token": "secondary-container" },
                "cornerRadius": { "$token": "corner-full" },
                "anchors": { "left": 6 }
              },
              {
                "type": "rect",
                "name": "faixa total",
                "visible": { "$lte": [{ "$field": "progress" }, 0] },
                "fill": { "$token": "secondary-container" },
                "cornerRadius": { "$token": "corner-full" }
              },
              {
                "type": "ellipse",
                "name": "parada",
                "width": 4,
                "height": 4,
                "fill": { "$token": "primary" },
                "anchors": { "right": 0, "centerY": true }
              }
            ]
          }
        ]
      }
    ]
  }
}
