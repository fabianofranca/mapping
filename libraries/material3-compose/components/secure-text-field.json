          {
            "type": "frame",
            "name": "borda superior",
            "clip": false,
            "anchors": {
              "left": 0,
              "right": 0,
              "top": 0
            },
            "height": {
              "$token": "body-small-line-height"
            },
            "layout": {
              "type": "row",
              "align": "end"
            },
            "visible": {
              "$and": [
                {
                  "$eq": ["style", "outlined"]
                },
                {
                  "$or": [
                    {
                      "$eq": ["hasText", "true"]
                    },
                    {
                      "$has": "placeholder"
                    }
                  ]
                }
              ]
            },
            "children": [
              {
                "type": "rect",
                "name": "recuo",
                "width": 12,
                "height": 8,
                "fill": "none"
              },
              {
                "type": "frame",
                "name": "rótulo na borda",
                "width": "hug",
                "height": "hug",
                "layout": {
                  "type": "row",
                  "padding": [0, 4]
                },
                "children": [
                  {
                    "type": "text",
                    "name": "rótulo minimizado",
                    "text": {
                      "$field": "label"
                    },
                    "font": {
                      "size": {
                        "$token": "body-small-size"
                      },
                      "weight": {
                        "$token": "body-small-weight"
                      },
                      "lineHeight": {
                        "$token": "body-small-line-height"
                      },
                      "letterSpacing": {
                        "$token": "body-small-tracking"
                      },
                      "verticalAlign": "cap-middle"
                    },
                    "color": {
                      "$if": {
                        "$eq": ["enabled", "false"]
                      },
                      "then": {
                        "$token": "on-surface"
                      },
                      "else": {
                        "$if": {
                          "$eq": ["interaction", "focused"]
                        },
                        "then": {
                          "$if": {
                            "$eq": ["isError", "true"]
                          },
                          "then": {
                            "$token": "error"
                          },
                          "else": {
                            "$token": "primary"
                          }
                        },
                        "else": {
                          "$if": {
                            "$eq": ["interaction", "hovered"]
                          },
                          "then": {
                            "$if": {
                              "$eq": ["isError", "true"]
                            },
                            "then": {
                              "$token": "on-error-container"
                            },
                            "else": {
                              "$if": {
                                "$eq": ["style", "outlined"]
                              },
                              "then": {
                                "$token": "on-surface"
                              },
                              "else": {
                                "$token": "on-surface-variant"
                              }
                            }
                          },
                          "else": {
                            "$if": {
                              "$eq": ["isError", "true"]
                            },
                            "then": {
                              "$token": "error"
                            },
                            "else": {
                              "$token": "on-surface-variant"
                            }
                          }
                        }
                      }
                    },
                    "opacity": {
                      "$if": {
                        "$eq": ["enabled", "false"]
                      },
                      "then": {
                        "$token": "state-disabled-content"
                      },
                      "else": 1
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "frame",
        "name": "apoio (linha)",
        "width": "fill",
        "height": "hug",
        "visible": {
          "$has": "supportingText"
        },
        "layout": {
          "type": "row",
          "padding": [4, 16, 0, 16]
        },
        "children": [
          {
            "type": "text",
            "name": "apoio",
            "text": {
              "$field": "supportingText"
            },
            "font": {
              "size": {
                "$token": "body-small-size"
              },
              "weight": {
                "$token": "body-small-weight"
              },
              "lineHeight": {
                "$token": "body-small-line-height"
              },
              "letterSpacing": {
                "$token": "body-small-tracking"
              }
            },
            "color": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$token": "on-surface"
              },
              "else": {
                "$if": {
                  "$eq": ["isError", "true"]
                },
                "then": {
                  "$token": "error"
                },
                "else": {
                  "$token": "on-surface-variant"
                }
              }
            },
            "opacity": {
              "$if": {
                "$eq": ["enabled", "false"]
              },
              "then": {
                "$token": "state-disabled-content"
              },
              "else": 1
            },
            "width": "fill"
          }
        ]
      }
    ]
  }
