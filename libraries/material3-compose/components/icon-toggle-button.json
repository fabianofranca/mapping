{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "icon-toggle-button",
  "name": "Icon toggle button",
  "description": "Botão de ícone que liga e desliga, 40 de container e forma full: ligado ganha a cor de seleção do estilo (primary, secondary ou inverse surface).",
  "size": {
    "width": 40,
    "height": 40
  },
  "minSize": {
    "width": 40,
    "height": 40
  },
  "sizing": {
    "width": 40,
    "height": 40
  },
  "preview": {
    "icon": "Favorite",
    "contentDescription": "Favoritar",
    "style": "filled",
    "checked": "true",
    "enabled": "true"
  },
  "template": {
    "type": "frame",
    "name": "icon toggle button",
    "clip": false,
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "rect",
        "name": "container",
        "fill": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": {
            "$switch": "style",
            "cases": {
              "filled": {
                "$token": "on-surface"
              },
              "tonal": {
                "$token": "on-surface"
              }
            },
            "default": "none"
          },
          "else": {
            "$switch": "style",
            "cases": {
              "filled": {
                "$if": {
                  "$eq": ["checked", "true"]
                },
                "then": {
                  "$token": "primary"
                },
                "else": {
                  "$token": "surface-container"
                }
              },
              "tonal": {
                "$if": {
                  "$eq": ["checked", "true"]
                },
                "then": {
                  "$token": "secondary"
                },
                "else": {
                  "$token": "secondary-container"
                }
              },
              "outlined": {
                "$if": {
                  "$eq": ["checked", "true"]
                },
                "then": {
                  "$token": "inverse-surface"
                },
                "else": "none"
              }
            },
            "default": "none"
          }
        },
        "opacity": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": 0.1,
          "else": 1
        },
        "cornerRadius": {
          "$token": "corner-full"
        }
      },
      {
        "type": "rect",
        "name": "contorno",
        "fill": "none",
        "cornerRadius": {
          "$token": "corner-full"
        },
        "visible": {
          "$and": [
            {
              "$eq": ["style", "outlined"]
            },
            {
              "$not": {
                "$eq": ["checked", "true"]
              }
            }
          ]
        },
        "opacity": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": {
            "$token": "state-disabled-content"
          },
          "else": 1
        },
        "stroke": {
          "color": {
            "$token": "on-surface"
          },
          "width": 1
        }
      },
      {
        "type": "icon",
        "name": {
          "$switch": "icon",
          "cases": {
            "Home": "home",
            "Search": "search",
            "Person": "person",
            "Menu": "menu",
            "MoreVert": "more_vert",
            "Add": "add",
            "Check": "check",
            "Close": "close",
            "ArrowBack": "arrow_back",
            "Favorite": "favorite",
            "Edit": "edit",
            "Delete": "delete",
            "Share": "share",
            "Notifications": "notifications",
            "Settings": "settings",
            "Info": "info",
            "Star": "star",
            "Email": "email",
            "Phone": "phone",
            "Place": "place",
            "DateRange": "date_range",
            "ShoppingCart": "shopping_cart",
            "AccountCircle": "account_circle",
            "KeyboardArrowRight": "keyboard_arrow_right",
            "KeyboardArrowDown": "keyboard_arrow_down",
            "Refresh": "refresh",
            "Clear": "clear",
            "Done": "done",
            "Lock": "lock",
            "List": "list",
            "AccountBox": "account_box",
            "AddCircle": "add_circle",
            "ArrowDropDown": "arrow_drop_down",
            "ArrowDropUp": "arrow_drop_up",
            "ArrowForward": "arrow_forward",
            "ArrowUpward": "arrow_upward",
            "ArrowDownward": "arrow_downward",
            "Build": "build",
            "Call": "call",
            "CheckCircle": "check_circle",
            "Create": "create",
            "Face": "face",
            "FavoriteBorder": "favorite_border",
            "ExitToApp": "exit_to_app",
            "KeyboardArrowLeft": "keyboard_arrow_left",
            "KeyboardArrowUp": "keyboard_arrow_up",
            "LocationOn": "location_on",
            "MailOutline": "mail_outline",
            "PlayArrow": "play_arrow",
            "Send": "send",
            "ThumbUp": "thumb_up",
            "Warning": "warning",
            "Cancel": "cancel",
            "ExpandMore": "expand_more",
            "ExpandLess": "expand_less",
            "ChevronLeft": "chevron_left",
            "ChevronRight": "chevron_right",
            "FirstPage": "first_page",
            "LastPage": "last_page",
            "MoreHoriz": "more_horiz",
            "Apps": "apps",
            "Dashboard": "dashboard",
            "Folder": "folder",
            "FolderOpen": "folder_open",
            "InsertDriveFile": "insert_drive_file",
            "Description": "description",
            "Image": "image",
            "Mic": "mic",
            "Videocam": "videocam",
            "Chat": "chat",
            "Comment": "comment",
            "Forum": "forum",
            "NotificationsNone": "notifications_none",
            "Visibility": "visibility",
            "VisibilityOff": "visibility_off",
            "Language": "language",
            "Public": "public",
            "Link": "link",
            "Attachment": "attachment",
            "ContentCopy": "content_copy",
            "ContentPaste": "content_paste",
            "ContentCut": "content_cut",
            "Save": "save",
            "Download": "download",
            "Upload": "upload",
            "CloudUpload": "cloud_upload",
            "CloudDownload": "cloud_download",
            "Cloud": "cloud",
            "Sync": "sync",
            "Schedule": "schedule",
            "AccessTime": "access_time",
            "CalendarToday": "calendar_today",
            "Event": "event",
            "Today": "today",
            "Timer": "timer",
            "Alarm": "alarm",
            "History": "history",
            "Bookmark": "bookmark",
            "BookmarkBorder": "bookmark_border",
            "Label": "label",
            "Flag": "flag",
            "Help": "help",
            "HelpOutline": "help_outline",
            "Error": "error",
            "ErrorOutline": "error_outline",
            "Report": "report",
            "Block": "block",
            "Tune": "tune",
            "FilterList": "filter_list",
            "Sort": "sort",
            "Fullscreen": "fullscreen",
            "Wifi": "wifi",
            "Bluetooth": "bluetooth",
            "LightMode": "light_mode",
            "DarkMode": "dark_mode",
            "Palette": "palette",
            "ShoppingBag": "shopping_bag",
            "Store": "store",
            "Payment": "payment",
            "CreditCard": "credit_card",
            "AttachMoney": "attach_money",
            "Receipt": "receipt",
            "Map": "map",
            "Navigation": "navigation",
            "DirectionsCar": "directions_car",
            "Flight": "flight",
            "MenuOpen": "menu_open",
            "Logout": "logout",
            "Login": "login",
            "People": "people",
            "Group": "group",
            "PersonAdd": "person_add",
            "LockOpen": "lock_open",
            "Security": "security",
            "VerifiedUser": "verified_user",
            "Key": "key",
            "Pause": "pause",
            "Stop": "stop",
            "SkipNext": "skip_next",
            "SkipPrevious": "skip_previous",
            "VolumeUp": "volume_up",
            "VolumeOff": "volume_off",
            "ThumbDown": "thumb_down",
            "Reply": "reply",
            "Inbox": "inbox",
            "Archive": "archive",
            "Undo": "undo",
            "Redo": "redo",
            "ZoomIn": "zoom_in",
            "ZoomOut": "zoom_out",
            "Keyboard": "keyboard",
            "CheckBox": "check_box",
            "CheckBoxOutlineBlank": "check_box_outline_blank",
            "RadioButtonChecked": "radio_button_checked",
            "RadioButtonUnchecked": "radio_button_unchecked",
            "ToggleOn": "toggle_on",
            "ToggleOff": "toggle_off",
            "StarBorder": "star_border",
            "StarHalf": "star_half",
            "Lightbulb": "lightbulb",
            "Code": "code",
            "Terminal": "terminal",
            "Bolt": "bolt",
            "EditCalendar": "edit_calendar"
          },
          "default": {
            "$field": "icon"
          }
        },
        "width": 24,
        "height": 24,
        "color": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": {
            "$token": "on-surface"
          },
          "else": {
            "$switch": "style",
            "cases": {
              "standard": {
                "$if": {
                  "$eq": ["checked", "true"]
                },
                "then": {
                  "$token": "primary"
                },
                "else": {
                  "$token": "on-surface"
                }
              },
              "filled": {
                "$if": {
                  "$eq": ["checked", "true"]
                },
                "then": {
                  "$token": "on-primary"
                },
                "else": {
                  "$token": "on-surface-variant"
                }
              },
              "tonal": {
                "$if": {
                  "$eq": ["checked", "true"]
                },
                "then": {
                  "$token": "on-secondary"
                },
                "else": {
                  "$token": "on-secondary-container"
                }
              },
              "outlined": {
                "$if": {
                  "$eq": ["checked", "true"]
                },
                "then": {
                  "$token": "inverse-on-surface"
                },
                "else": {
                  "$token": "on-surface"
                }
              }
            },
            "default": {
              "$token": "on-surface"
            }
          }
        },
        "opacity": {
          "$if": {
            "$eq": ["enabled", "false"]
          },
          "then": {
            "$token": "state-disabled-content"
          },
          "else": 1
        },
        "anchors": {
          "centerX": true,
          "centerY": true
        }
      }
    ]
  }
}
