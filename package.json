{
  "name": "mapping",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:viewer": "vite --config vite.viewer.config.ts",
    "build": "npm run build:guia && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:durations": "node scripts/test-durations.mjs",
    "test:perf": "vitest run tests/model/performance.test.ts tests/canvas/renderPerformance.test.ts tests/store/reviewPerf.test.ts tests/mcp/batchPerf.test.ts --reporter=verbose",
    "test:scale": "vitest run --config vitest.scale.config.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "perf:canvas": "node scripts/perf/canvas.mjs",
    "lint": "eslint . && prettier --check .",
    "lint:ci": "eslint . --cache --cache-location .cache/eslint/ && prettier --check . --cache --cache-location .cache/prettier",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p mcp/tsconfig.json && tsc --noEmit -p signature/tsconfig.json",
    "build:mcp": "node mcp/build.mjs && node signature/build.mjs",
    "build:signature": "node signature/build.mjs",
    "build:example": "node scripts/exampleProject.mjs",
    "build:proposal-components": "node scripts/proposalComponents.mjs",
    "build:suggestions-kotlin": "node scripts/suggestionsKotlin.mjs",
    "build:material3-zip": "node scripts/material3ComposeZip.mjs",
    "build:guia": "node scripts/buildGuia.mjs",
    "build:viewer": "node viewer/build.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "konva": "^10.9.1",
    "preact": "^10.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "opentype.js": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@testing-library/dom": "^10.4.2"
  }
}
