              "default": {
                "$field": "trailingIcon"
              }
            },
            "width": 24,
            "height": 24,
            "color": {
              "$token": "on-surface-variant"
            },
            "visible": {
              "$has": "trailingIcon"
            }
          }
        ]
      },
      {
        "type": "rect",
        "name": "estado",
        "fill": {
          "$token": "on-surface"
        },
        "opacity": {
          "$switch": "interaction",
          "cases": {
            "hovered": {
              "$token": "state-hover"
            },
            "focused": {
              "$token": "state-focus"
            },
            "pressed": {
              "$token": "state-pressed"
            },
            "dragged": {
              "$token": "state-dragged"
            }
          },
          "default": 0
        },
        "visible": {
          "$not": {
            "$eq": ["interaction", "none"]
          }
        }
      },
      {
        "type": "rect",
        "name": "anel de foco",
        "fill": "none",
        "stroke": {
          "color": {
            "$token": "secondary"
          },
          "width": 3,
          "align": "outside",
          "offset": 2
        },
        "visible": {
          "$eq": ["interaction", "focused"]
        }
      }
    ],
    "layout": {
      "type": "none"
    },
    "shadow": [
      {
        "color": {
          "$if": {
            "$eq": ["interaction", "dragged"]
          },
          "then": {
            "$token": "elevation-point-shadow"
          },
          "else": "none"
        },
        "y": {
          "$token": "elevation-4-point-y"
        },
        "blur": {
          "$token": "elevation-4-point-blur"
        },
        "spread": {
          "$token": "elevation-4-point-spread"
        }
      },
      {
        "color": {
          "$if": {
            "$eq": ["interaction", "dragged"]
          },
          "then": {
            "$token": "elevation-ambient-shadow"
          },
          "else": "none"
        },
        "y": {
          "$token": "elevation-4-ambient-y"
        },
        "blur": {
          "$token": "elevation-4-ambient-blur"
        },
        "spread": {
          "$token": "elevation-4-ambient-spread"
        }
      }
    ]
