                "StarHalf": "star_half",
                "Lightbulb": "lightbulb",
                "Code": "code",
                "Terminal": "terminal",
                "Bolt": "bolt",
                "EditCalendar": "edit_calendar"
              },
              "default": {
                "$field": "leadingIcon"
              }
            },
            "width": 24,
            "height": 24,
            "color": {
              "$token": "on-surface-variant"
            },
            "visible": {
              "$and": [
                {
                  "$has": "leadingIcon"
                },
                {
                  "$not": {
                    "$has": "leadingImage"
                  }
                }
              ]
            }
          },
          {
            "type": "frame",
            "name": "textos",
            "width": "fill",
            "height": "hug",
            "layout": {
              "type": "column"
            },
            "children": [
              {
                "type": "text",
                "name": "sobretítulo",
                "text": {
                  "$field": "overlineContent"
                },
                "font": {
                  "size": {
                    "$token": "label-small-size"
                  },
                  "weight": {
                    "$token": "label-small-weight"
                  },
                  "lineHeight": {
                    "$token": "label-small-line-height"
                  },
                  "letterSpacing": {
                    "$token": "label-small-tracking"
                  },
                  "maxLines": 1,
                  "ellipsis": true
                },
                "color": {
                  "$token": "on-surface-variant"
                },
                "width": "fill",
                "visible": {
                  "$has": "overlineContent"
                }
              },
              {
                "type": "text",
                "name": "título",
                "text": {
                  "$field": "headlineContent",
                  "default": "Headline"
                },
                "font": {
                  "size": {
                    "$token": "body-large-size"
                  },
                  "weight": {
                    "$token": "body-large-weight"
                  },
                  "lineHeight": {
                    "$token": "body-large-line-height"
                  },
                  "letterSpacing": {
                    "$token": "body-large-tracking"
                  },
                  "maxLines": 1,
                  "ellipsis": true,
                  "verticalAlign": "cap-middle"
                },
                "color": {
                  "$token": "on-surface"
                },
                "width": "fill"
              },
              {
                "type": "text",
                "name": "apoio",
                "text": {
                  "$field": "supportingContent"
                },
                "font": {
                  "size": {
                    "$token": "body-medium-size"
                  },
                  "weight": {
                    "$token": "body-medium-weight"
                  },
                  "lineHeight": {
                    "$token": "body-medium-line-height"
                  },
                  "letterSpacing": {
                    "$token": "body-medium-tracking"
                  },
                  "maxLines": {
                    "$if": {
                      "$has": "overlineContent"
                    },
                    "then": 1,
                    "else": 2
                  },
                  "ellipsis": true
                },
                "color": {
                  "$token": "on-surface-variant"
                },
                "width": "fill",
                "visible": {
                  "$has": "supportingContent"
                }
              }
            ]
          },
          {
            "type": "text",
            "name": "conteúdo final",
            "text": {
              "$field": "trailingContent"
            },
            "font": {
              "size": {
                "$token": "label-small-size"
              },
              "weight": {
                "$token": "label-small-weight"
              },
              "lineHeight": {
                "$token": "label-small-line-height"
              },
              "letterSpacing": {
                "$token": "label-small-tracking"
              },
              "verticalAlign": "cap-middle"
            },
            "color": {
              "$token": "on-surface-variant"
            },
            "visible": {
              "$has": "trailingContent"
            }
          },
          {
            "type": "icon",
            "name": {
              "$switch": "trailingIcon",
              "cases": {
                "Home": "home",
                "Search": "search",
                "Person": "person",
