{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapping.local/component.schema.json",
  "title": "Mapping — componente (mapping-component, formatVersion 1)",
  "description": "Valida só a estrutura do arquivo de componente. A fonte da verdade é o código (src/model/components/parseComponent.ts), que também confere o que o schema não vê: campos citados pelas expressões que existem no tipo da especialização, minSize não maior que size, raiz do template obrigatoriamente do tipo frame, o slot único e a prova de desenho. Veja COMPONENT-FORMAT.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "id", "name", "size", "template"],
  "properties": {
    "format": {
      "const": "mapping-component"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "size": {
      "$ref": "#/$defs/dimensions"
    },
    "minSize": {
      "$ref": "#/$defs/dimensions"
    },
    "sizing": {
      "$ref": "#/$defs/sizing"
    },
    "preview": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "null"]
      }
    },
    "template": {
      "$ref": "#/$defs/node_frame"
    }
  },
  "$defs": {
    "fieldKey": {
      "type": "string",
      "minLength": 1
    },
    "lit_number": {
      "type": "number"
    },
    "lit_nonNegative": {
      "type": "number",
      "minimum": 0
    },
    "lit_unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lit_weight": {
      "type": "number",
      "minimum": 100,
      "maximum": 900
    },
    "lit_string": {
      "type": "string"
    },
    "lit_textOrNumber": {
      "type": ["string", "number"]
    },
    "lit_color": {
      "type": "string",
      "minLength": 1
    },
    "lit_boolean": {
      "type": "boolean"
    },
    "lit_fill": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/gradient"
        }
      ]
    },
    "lit_cornerRadius": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      ]
    },
    "lit_padding": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      ]
    },
    "lit_layoutAlign": {
      "enum": ["start", "center", "end", "stretch"]
    },
    "lit_justify": {
      "enum": ["start", "center", "end", "space-between"]
    },
    "lit_fontAlign": {
      "enum": ["left", "center", "right"]
    },
    "lit_verticalAlign": {
      "enum": ["top", "middle", "bottom"]
    },
    "lit_decoration": {
      "enum": ["none", "underline", "line-through"]
    },
    "expr_number": {
      "description": "Literal ou expressão ($field, $if, $switch, $concat).",
      "anyOf": [
        {
          "$ref": "#/$defs/lit_number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$field"],
          "properties": {
            "$field": {
              "$ref": "#/$defs/fieldKey"
            },
            "default": {
              "$ref": "#/$defs/lit_number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$if", "then"],
          "properties": {
            "$if": {
              "$ref": "#/$defs/condition"
            },
            "then": {
              "$ref": "#/$defs/expr_number"
            },
            "else": {
              "$ref": "#/$defs/expr_number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$switch", "cases"],
          "properties": {
            "$switch": {
              "$ref": "#/$defs/fieldKey"
            },
            "cases": {
