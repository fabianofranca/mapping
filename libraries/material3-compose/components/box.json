{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "box",
  "name": "Box",
  "description": "Container livre do Compose: as filhas ficam onde o retângulo delas diz; o padding recua o conteúdo.",
  "size": {
    "width": 200,
    "height": 120
  },
  "minSize": {
    "width": 24,
    "height": 24
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "contentAlignment": "TopStart",
    "background": "none",
    "padding": 0,
    "width": "wrap",
    "height": "wrap",
    "weight": null
  },
  "template": {
    "type": "frame",
    "name": "box",
    "clip": false,
    "layout": {
      "type": "column",
      "padding": {
        "$field": "padding",
        "default": 0
      }
    },
    "fill": {
      "$switch": "background",
      "cases": {
        "primary": "#6750A4",
        "onPrimary": "#FFFFFF",
        "primaryContainer": "#EADDFF",
        "onPrimaryContainer": "#21005D",
        "secondary": "#625B71",
        "onSecondary": "#FFFFFF",
        "secondaryContainer": "#E8DEF8",
        "onSecondaryContainer": "#1D192B",
        "tertiary": "#7D5260",
        "onTertiary": "#FFFFFF",
        "tertiaryContainer": "#FFD8E4",
        "onTertiaryContainer": "#31111D",
        "error": "#B3261E",
        "onError": "#FFFFFF",
        "errorContainer": "#F9DEDC",
        "onErrorContainer": "#410E0B",
        "background": "#FEF7FF",
        "onBackground": "#1D1B20",
        "surface": "#FEF7FF",
        "onSurface": "#1D1B20",
        "surfaceVariant": "#E7E0EC",
        "onSurfaceVariant": "#49454F",
        "surfaceTint": "#6750A4",
        "inverseSurface": "#322F35",
        "inverseOnSurface": "#F5EFF7",
        "inversePrimary": "#D0BCFF",
        "outline": "#79747E",
        "outlineVariant": "#CAC4D0",
        "scrim": "#000000",
        "surfaceBright": "#FEF7FF",
        "surfaceDim": "#DED8E1",
        "surfaceContainerLowest": "#FFFFFF",
        "surfaceContainerLow": "#F7F2FA",
        "surfaceContainer": "#F3EDF7",
        "surfaceContainerHigh": "#ECE6F0",
        "surfaceContainerHighest": "#E6E0E9"
      },
      "default": "rgba(0, 0, 0, 0)"
    },
    "children": [
      {
        "type": "slot",
        "name": "content",
        "width": "fill",
        "height": "fill",
        "label": {
          "$concat": [
            "Box · ",
            {
              "$field": "contentAlignment",
              "default": "TopStart"
            },
            " · ",
            {
              "$field": "width",
              "default": "wrap"
            },
            " × ",
            {
              "$field": "height",
              "default": "wrap"
            },
            {
              "$if": {
                "$has": "weight"
              },
              "then": {
                "$concat": [
                  " · weight ",
                  {
                    "$field": "weight"
                  }
                ]
              },
              "else": ""
            }
          ]
        },
        "layout": {
          "type": "none"
        }
      }
    ]
  }
}
