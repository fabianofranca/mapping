                                "default": {
                                  "$field": "icon"
                                }
                              },
                              "width": 24,
                              "height": 24,
                              "color": {
                                "$if": {
                                  "$field": "selected"
                                },
                                "then": {
                                  "$if": {
                                    "$or": [
                                      {
                                        "$eq": ["style", "secondary"]
                                      },
                                      {
                                        "$eq": ["style", "secondary-scrollable"]
                                      }
                                    ]
                                  },
                                  "then": {
                                    "$token": "on-surface"
                                  },
                                  "else": {
                                    "$token": "primary"
                                  }
                                },
                                "else": {
                                  "$token": "on-surface-variant"
                                }
                              },
                              "visible": {
                                "$has": "icon"
                              }
                            },
                            {
                              "type": "text",
                              "name": "rótulo",
                              "text": {
                                "$field": "label"
                              },
                              "font": {
                                "size": {
                                  "$token": "title-small-size"
                                },
                                "weight": {
                                  "$token": "title-small-weight"
                                },
                                "lineHeight": {
                                  "$token": "title-small-line-height"
                                },
                                "letterSpacing": {
                                  "$token": "title-small-tracking"
                                },
                                "verticalAlign": "cap-middle"
                              },
                              "color": {
                                "$if": {
                                  "$field": "selected"
                                },
                                "then": {
                                  "$if": {
                                    "$or": [
                                      {
                                        "$eq": ["style", "secondary"]
                                      },
                                      {
                                        "$eq": ["style", "secondary-scrollable"]
                                      }
                                    ]
                                  },
                                  "then": {
                                    "$token": "on-surface"
                                  },
                                  "else": {
                                    "$token": "primary"
                                  }
                                },
                                "else": {
                                  "$token": "on-surface-variant"
                                }
                              },
                              "visible": {
                                "$has": "label"
                              },
                              "height": {
                                "$if": {
                                  "$and": [
                                    {
                                      "$has": "icon"
                                    },
                                    {
                                      "$has": "label"
                                    },
                                    {
                                      "$not": {
                                        "$eq": ["iconPosition", "leading"]
                                      }
                                    }
                                  ]
                                },
                                "then": "hug",
                                "else": "fill"
                              }
                            }
                          ]
                        },
                        {
                          "type": "rect",
                          "name": "indicador primário",
                          "height": 3,
                          "anchors": {
                            "left": 0,
                            "right": 0,
                            "bottom": 0
                          },
                          "cornerRadius": 3,
                          "fill": {
                            "$token": "primary"
                          },
                          "visible": {
                            "$and": [
                              {
                                "$field": "selected"
                              },
                              {
                                "$not": {
                                  "$or": [
                                    {
                                      "$eq": ["style", "secondary"]
                                    },
                                    {
                                      "$eq": ["style", "secondary-scrollable"]
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "name": "indicador secundário",
                  "height": 3,
                  "anchors": {
                    "left": 0,
                    "right": 0,
                    "bottom": 0
                  },
                  "stroke": {
                    "color": {
                      "$token": "primary"
                    },
                    "width": 3,
                    "align": "inside",
                    "sides": ["bottom"]
                  },
                  "visible": {
                    "$and": [
                      {
                        "$field": "selected"
                      },
                      {
                        "$or": [
                          {
                            "$eq": ["style", "secondary"]
                          },
                          {
                            "$eq": ["style", "secondary-scrollable"]
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
