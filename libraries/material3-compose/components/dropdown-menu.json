{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "dropdown-menu",
  "name": "Dropdown menu",
  "description": "Menu em surface container com raio 4 e itens de 48; no estilo exposed, vem precedido do campo de texto (56, com rótulo, valor e seta) a que está preso.",
  "size": {
    "width": 200,
    "height": 160
  },
  "sizing": {
    "width": {
      "$if": {
        "$eq": ["style", "exposed"]
      },
      "then": "fill",
      "else": "hug"
    },
    "height": "hug"
  },
  "preview": {
    "style": "menu",
    "expanded": "true",
    "label": "",
    "value": "",
    "items": [
      {
        "text": "Editar",
        "leadingIcon": "Edit",
        "trailingIcon": "",
        "enabled": "true",
        "selected": "false"
      },
      {
        "text": "Compartilhar",
        "leadingIcon": "Share",
        "trailingIcon": "",
        "enabled": "true",
        "selected": "false"
      },
      {
        "text": "Excluir",
        "leadingIcon": "Delete",
        "trailingIcon": "",
        "enabled": "true",
        "selected": "false"
      }
    ]
  },
  "template": {
    "type": "frame",
    "name": "dropdown menu",
    "clip": false,
    "layout": {
      "type": "column"
    },
    "children": [
      {
        "type": "frame",
        "name": "campo",
        "width": "fill",
        "height": 56,
        "clip": true,
        "visible": {
          "$eq": ["style", "exposed"]
        },
        "layout": {
          "type": "none"
        },
        "children": [
          {
            "type": "rect",
            "name": "fundo",
            "anchors": {
              "left": 0,
              "right": 0,
              "top": 0,
              "bottom": 0
            },
            "cornerRadius": [
              {
                "$token": "corner-extra-small"
              },
              {
                "$token": "corner-extra-small"
              },
              0,
              0
            ],
            "fill": {
              "$token": "surface-container-highest"
            }
          },
          {
            "type": "rect",
            "name": "indicador",
            "anchors": {
              "left": 0,
              "right": 0,
              "top": 0,
              "bottom": 0
            },
            "fill": "none",
            "stroke": {
              "color": {
                "$if": {
                  "$eq": ["interaction", "focused"]
                },
                "then": {
                  "$token": "primary"
                },
                "else": {
                  "$if": {
                    "$eq": ["interaction", "hovered"]
                  },
                  "then": {
                    "$token": "on-surface"
                  },
                  "else": {
                    "$token": "on-surface-variant"
                  }
                }
              },
              "width": {
                "$if": {
                  "$eq": ["interaction", "focused"]
                },
                "then": 2,
                "else": 1
              },
              "align": "inside",
              "sides": ["bottom"]
            }
          },
          {
            "type": "frame",
            "name": "linha",
            "anchors": {
              "left": 0,
              "right": 0,
              "top": 0,
              "bottom": 0
            },
            "layout": {
              "type": "row",
              "gap": 16,
              "padding": [0, 12, 0, 16],
              "align": "center"
            },
            "children": [
              {
                "type": "frame",
                "name": "textos",
                "width": "fill",
                "height": "hug",
                "layout": {
                  "type": "column"
                },
                "children": [
                  {
                    "type": "text",
                    "name": "rótulo",
                    "text": {
                      "$field": "label"
                    },
                    "width": "fill",
                    "font": {
                      "size": {
                        "$if": {
                          "$has": "value"
                        },
                        "then": {
                          "$token": "body-small-size"
                        },
                        "else": {
                          "$token": "body-large-size"
                        }
                      },
                      "weight": {
                        "$if": {
                          "$has": "value"
                        },
                        "then": {
                          "$token": "body-small-weight"
                        },
                        "else": {
                          "$token": "body-large-weight"
                        }
                      },
                      "lineHeight": {
                        "$if": {
                          "$has": "value"
                        },
                        "then": {
                          "$token": "body-small-line-height"
                        },
                        "else": {
                          "$token": "body-large-line-height"
                        }
                      },
                      "letterSpacing": {
                        "$if": {
                          "$has": "value"
                        },
                        "then": {
                          "$token": "body-small-tracking"
                        },
                        "else": {
                          "$token": "body-large-tracking"
                        }
                      },
                      "verticalAlign": "cap-middle"
                    },
                    "color": {
                      "$if": {
                        "$eq": ["interaction", "focused"]
                      },
                      "then": {
                        "$token": "primary"
                      },
                      "else": {
                        "$token": "on-surface-variant"
                      }
                    },
                    "visible": {
                      "$has": "label"
                    }
                  },
                  {
                    "type": "frame",
                    "name": "valor (recorte)",
                    "width": "fill",
                    "height": "hug",
                    "clip": true,
                    "layout": {
                      "type": "row"
                    },
                    "visible": {
                      "$has": "value"
                    },
                    "children": [
                      {
                        "type": "text",
                        "name": "valor",
                        "text": {
                          "$field": "value"
                        },
                        "width": "hug",
                        "font": {
                          "size": {
                            "$token": "body-large-size"
                          },
                          "weight": {
                            "$token": "body-large-weight"
                          },
                          "lineHeight": {
                            "$token": "body-large-line-height"
                          },
                          "letterSpacing": {
                            "$token": "body-large-tracking"
                          },
                          "wrap": "none",
                          "maxLines": 1,
                          "verticalAlign": "cap-middle"
                        },
                        "color": {
                          "$token": "on-surface"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "icon",
                "name": {
                  "$if": {
                    "$eq": ["expanded", "false"]
                  },
                  "then": "arrow_drop_down",
                  "else": "arrow_drop_up"
                },
                "width": 24,
                "height": 24,
                "color": {
                  "$token": "on-surface-variant"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "frame",
        "name": "menu",
        "width": "fill",
        "height": "hug",
        "minWidth": {
          "$if": {
            "$not": {
              "$eq": ["style", "exposed"]
            }
          },
          "then": 112
        },
        "maxWidth": {
          "$if": {
            "$not": {
              "$eq": ["style", "exposed"]
            }
          },
          "then": 280
        },
        "fill": {
          "$token": "surface-container"
        },
        "cornerRadius": {
          "$token": "corner-extra-small"
        },
        "shadow": [
          {
            "color": {
              "$token": "elevation-point-shadow"
            },
            "y": {
              "$token": "elevation-2-point-y"
            },
            "blur": {
              "$token": "elevation-2-point-blur"
            },
            "spread": {
              "$token": "elevation-2-point-spread"
            }
          },
          {
            "color": {
              "$token": "elevation-ambient-shadow"
            },
            "y": {
              "$token": "elevation-2-ambient-y"
            },
            "blur": {
              "$token": "elevation-2-ambient-blur"
            },
            "spread": {
              "$token": "elevation-2-ambient-spread"
            }
          }
        ],
        "visible": {
          "$not": {
            "$eq": ["expanded", "false"]
          }
        },
        "layout": {
          "type": "column",
          "padding": [8, 0]
        },
        "children": [
          {
            "type": "repeat",
            "name": "itens",
            "field": "items",
            "direction": "column",
            "width": "fill",
            "height": "hug",
            "template": {
              "type": "frame",
              "name": "item",
              "width": "fill",
              "height": "hug",
              "layout": {
                "type": "none"
              },
              "fill": {
                "$if": {
                  "$and": [
                    {
                      "$eq": ["selected", "true"]
                    },
                    {
                      "$not": {
                        "$eq": ["enabled", "false"]
                      }
                    }
                  ]
                },
                "then": {
                  "$token": "secondary-container"
                },
                "else": "none"
              },
              "children": [
                {
                  "type": "frame",
                  "name": "conteúdo",
                  "width": "fill",
                  "height": "hug",
                  "minHeight": 48,
                  "layout": {
                    "type": "none"
                  },
                  "children": [
                    {
                      "type": "icon",
                      "name": {
                        "$switch": "leadingIcon",
                        "cases": {
                          "Home": "home",
                          "Search": "search",
                          "Person": "person",
                          "Menu": "menu",
                          "MoreVert": "more_vert",
                          "Add": "add",
                          "Check": "check",
                          "Close": "close",
                          "ArrowBack": "arrow_back",
                          "Favorite": "favorite",
                          "Edit": "edit",
                          "Delete": "delete",
                          "Share": "share",
                          "Notifications": "notifications",
