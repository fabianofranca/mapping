{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "progress-indicator",
  "name": "Progress indicator",
  "description": "Indicador de progresso circular (40, traço de 4) ou linear (barra de 4 com parada), com o indicador em primary e o trilho em secondary-container (ou no papel de trackColor), de ponta redonda (ou Butt/Square, pelo strokeCap) e com gap de 4. Sem valor de progresso é indeterminado e o desenho mostra um quadro congelado da animação (um arco ou uma barra parcial).",
  "size": { "width": 240, "height": 48 },
  "sizing": { "width": "fill", "height": 48 },
  "preview": { "shape": "circular", "progress": 0.6 },
  "template": {
    "type": "frame",
    "name": "progress indicator",
    "layout": { "type": "row", "align": "center", "justify": "center" },
    "children": [
      {
        "type": "frame",
        "name": "circular",
        "width": 40,
        "height": 40,
        "layout": { "type": "none" },
        "visible": { "$not": { "$eq": ["shape", "linear"] } },
        "children": [
          {
            "type": "ellipse",
            "name": "trilho completo",
            "width": 40,
            "height": 40,
            "fill": "none",
            "stroke": {
              "color": {
                "$switch": "trackColor",
                "cases": {
                  "primary": { "$token": "primary" },
                  "onPrimary": { "$token": "on-primary" },
                  "primaryContainer": { "$token": "primary-container" },
                  "onPrimaryContainer": { "$token": "on-primary-container" },
                  "secondary": { "$token": "secondary" },
                  "onSecondary": { "$token": "on-secondary" },
                  "secondaryContainer": { "$token": "secondary-container" },
                  "onSecondaryContainer": { "$token": "on-secondary-container" },
                  "tertiary": { "$token": "tertiary" },
                  "onTertiary": { "$token": "on-tertiary" },
                  "tertiaryContainer": { "$token": "tertiary-container" },
                  "onTertiaryContainer": { "$token": "on-tertiary-container" },
                  "error": { "$token": "error" },
                  "onError": { "$token": "on-error" },
                  "errorContainer": { "$token": "error-container" },
                  "onErrorContainer": { "$token": "on-error-container" },
                  "background": { "$token": "background" },
                  "onBackground": { "$token": "on-background" },
                  "surface": { "$token": "surface" },
                  "onSurface": { "$token": "on-surface" },
                  "surfaceVariant": { "$token": "surface-variant" },
                  "onSurfaceVariant": { "$token": "on-surface-variant" },
                  "surfaceTint": { "$token": "surface-tint" },
                  "inverseSurface": { "$token": "inverse-surface" },
                  "inverseOnSurface": { "$token": "inverse-on-surface" },
                  "inversePrimary": { "$token": "inverse-primary" },
                  "outline": { "$token": "outline" },
                  "outlineVariant": { "$token": "outline-variant" },
                  "scrim": { "$token": "scrim" },
                  "surfaceBright": { "$token": "surface-bright" },
                  "surfaceDim": { "$token": "surface-dim" },
                  "surfaceContainerLowest": { "$token": "surface-container-lowest" },
                  "surfaceContainerLow": { "$token": "surface-container-low" },
                  "surfaceContainer": { "$token": "surface-container" },
                  "surfaceContainerHigh": { "$token": "surface-container-high" },
                  "surfaceContainerHighest": { "$token": "surface-container-highest" }
                },
                "default": { "$token": "secondary-container" }
              },
              "width": 4,
              "align": "inside"
            },
            "visible": {
              "$or": [
                { "$lte": [{ "$field": "progress" }, 0] },
                { "$and": [{ "$not": { "$has": "progress" } }, { "$has": "trackColor" }] }
              ]
            }
          },
          {
            "type": "path",
            "name": "trilho arco",
            "visible": {
              "$and": [
                { "$gt": [{ "$field": "progress" }, 0] },
                { "$lt": [{ "$field": "progress" }, 1] }
              ]
            },
            "width": 40,
            "height": 40,
            "viewBox": [40, 40],
            "d": {
              "$concat": [
                "M20 2A18 18 0 ",
                {
                  "$if": { "$lt": [{ "$field": "progress" }, 0.37267605] },
                  "then": "1",
                  "else": "0"
                },
                " ",
                {
                  "$if": { "$lte": [{ "$field": "progress" }, 0.87267605] },
                  "then": "1",
                  "else": "0"
                },
                " ",
                {
                  "$sub": [
                    20,
                    {
                      "$mul": [
                        18,
                        {
                          "$sin": {
                            "$min": [
                              { "$mul": [{ "$field": "progress" }, 1080] },
                              {
                                "$add": [
                                  { "$mul": [{ "$field": "progress" }, 360] },
                                  45.8366236
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                " ",
                {
                  "$sub": [
                    20,
                    {
                      "$mul": [
                        18,
                        {
                          "$cos": {
                            "$min": [
                              { "$mul": [{ "$field": "progress" }, 1080] },
                              {
                                "$add": [
                                  { "$mul": [{ "$field": "progress" }, 360] },
                                  45.8366236
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "fill": "none",
            "stroke": {
              "color": {
                "$switch": "trackColor",
                "cases": {
                  "primary": { "$token": "primary" },
                  "onPrimary": { "$token": "on-primary" },
                  "primaryContainer": { "$token": "primary-container" },
                  "onPrimaryContainer": { "$token": "on-primary-container" },
                  "secondary": { "$token": "secondary" },
                  "onSecondary": { "$token": "on-secondary" },
                  "secondaryContainer": { "$token": "secondary-container" },
                  "onSecondaryContainer": { "$token": "on-secondary-container" },
                  "tertiary": { "$token": "tertiary" },
                  "onTertiary": { "$token": "on-tertiary" },
                  "tertiaryContainer": { "$token": "tertiary-container" },
                  "onTertiaryContainer": { "$token": "on-tertiary-container" },
                  "error": { "$token": "error" },
                  "onError": { "$token": "on-error" },
                  "errorContainer": { "$token": "error-container" },
                  "onErrorContainer": { "$token": "on-error-container" },
                  "background": { "$token": "background" },
                  "onBackground": { "$token": "on-background" },
                  "surface": { "$token": "surface" },
                  "onSurface": { "$token": "on-surface" },
                  "surfaceVariant": { "$token": "surface-variant" },
                  "onSurfaceVariant": { "$token": "on-surface-variant" },
                  "surfaceTint": { "$token": "surface-tint" },
                  "inverseSurface": { "$token": "inverse-surface" },
                  "inverseOnSurface": { "$token": "inverse-on-surface" },
                  "inversePrimary": { "$token": "inverse-primary" },
                  "outline": { "$token": "outline" },
                  "outlineVariant": { "$token": "outline-variant" },
                  "scrim": { "$token": "scrim" },
                  "surfaceBright": { "$token": "surface-bright" },
                  "surfaceDim": { "$token": "surface-dim" },
                  "surfaceContainerLowest": { "$token": "surface-container-lowest" },
                  "surfaceContainerLow": { "$token": "surface-container-low" },
                  "surfaceContainer": { "$token": "surface-container" },
                  "surfaceContainerHigh": { "$token": "surface-container-high" },
                  "surfaceContainerHighest": { "$token": "surface-container-highest" }
                },
                "default": { "$token": "secondary-container" }
              },
              "width": 4,
              "align": "center",
              "cap": {
                "$switch": "strokeCap",
                "cases": { "Butt": "butt", "Square": "square" },
                "default": "round"
              },
              "join": "round"
            },
            "rotation": {
              "$min": [
                { "$mul": [{ "$field": "progress" }, 720] },
                { "$add": [{ "$mul": [{ "$field": "progress" }, 360] }, 22.9183118] }
              ]
            }
          },
          {
            "type": "path",
            "name": "indicador",
            "visible": {
              "$and": [
                { "$gt": [{ "$field": "progress" }, 0] },
                { "$lt": [{ "$field": "progress" }, 1] }
              ]
            },
            "width": 40,
            "height": 40,
            "viewBox": [40, 40],
            "d": {
              "$concat": [
                "M20 2A18 18 0 ",
                {
                  "$if": { "$gt": [{ "$field": "progress" }, 0.5] },
                  "then": "1",
                  "else": "0"
                },
                " 1 ",
                {
                  "$add": [
                    20,
                    {
                      "$mul": [
                        18,
                        { "$sin": { "$mul": [{ "$field": "progress" }, 360] } }
                      ]
                    }
                  ]
                },
                " ",
                {
                  "$sub": [
                    20,
                    {
                      "$mul": [
                        18,
                        { "$cos": { "$mul": [{ "$field": "progress" }, 360] } }
                      ]
                    }
                  ]
                }
              ]
            },
            "fill": "none",
            "stroke": {
              "color": { "$token": "primary" },
              "width": 4,
              "align": "center",
              "cap": {
                "$switch": "strokeCap",
                "cases": { "Butt": "butt", "Square": "square" },
                "default": "round"
              },
              "join": "round"
            }
          },
          {
            "type": "ellipse",
            "name": "anel completo",
            "width": 40,
            "height": 40,
            "fill": "none",
            "stroke": { "color": { "$token": "primary" }, "width": 4, "align": "inside" },
            "visible": { "$gte": [{ "$field": "progress" }, 1] }
          },
          {
            "type": "path",
            "name": "indicador indeterminado",
            "visible": { "$not": { "$has": "progress" } },
            "width": 40,
            "height": 40,
            "viewBox": [40, 40],
            "d": "M20 2A18 18 0 0 1 21.69 37.92",
            "fill": "none",
            "stroke": {
              "color": { "$token": "primary" },
              "width": 4,
              "align": "center",
              "cap": {
                "$switch": "strokeCap",
                "cases": { "Butt": "butt", "Square": "square" },
                "default": "round"
              },
              "join": "round"
            }
          }
        ]
      },
      {
        "type": "frame",
        "name": "linear",
        "width": "fill",
        "height": 4,
        "layout": { "type": "row", "align": "center" },
        "visible": { "$eq": ["shape", "linear"] },
        "children": [
          {
            "type": "frame",
            "name": "trilho antes",
            "width": "30%",
            "height": 4,
            "layout": { "type": "none" },
            "visible": { "$not": { "$has": "progress" } },
            "children": [
              {
                "type": "rect",
                "name": "faixa antes",
                "fill": {
                  "$switch": "trackColor",
                  "cases": {
                    "primary": { "$token": "primary" },
                    "onPrimary": { "$token": "on-primary" },
                    "primaryContainer": { "$token": "primary-container" },
                    "onPrimaryContainer": { "$token": "on-primary-container" },
                    "secondary": { "$token": "secondary" },
                    "onSecondary": { "$token": "on-secondary" },
                    "secondaryContainer": { "$token": "secondary-container" },
                    "onSecondaryContainer": { "$token": "on-secondary-container" },
                    "tertiary": { "$token": "tertiary" },
                    "onTertiary": { "$token": "on-tertiary" },
                    "tertiaryContainer": { "$token": "tertiary-container" },
                    "onTertiaryContainer": { "$token": "on-tertiary-container" },
                    "error": { "$token": "error" },
                    "onError": { "$token": "on-error" },
                    "errorContainer": { "$token": "error-container" },
                    "onErrorContainer": { "$token": "on-error-container" },
                    "background": { "$token": "background" },
                    "onBackground": { "$token": "on-background" },
                    "surface": { "$token": "surface" },
                    "onSurface": { "$token": "on-surface" },
                    "surfaceVariant": { "$token": "surface-variant" },
                    "onSurfaceVariant": { "$token": "on-surface-variant" },
                    "surfaceTint": { "$token": "surface-tint" },
                    "inverseSurface": { "$token": "inverse-surface" },
                    "inverseOnSurface": { "$token": "inverse-on-surface" },
                    "inversePrimary": { "$token": "inverse-primary" },
                    "outline": { "$token": "outline" },
                    "outlineVariant": { "$token": "outline-variant" },
                    "scrim": { "$token": "scrim" },
                    "surfaceBright": { "$token": "surface-bright" },
                    "surfaceDim": { "$token": "surface-dim" },
                    "surfaceContainerLowest": { "$token": "surface-container-lowest" },
                    "surfaceContainerLow": { "$token": "surface-container-low" },
                    "surfaceContainer": { "$token": "surface-container" },
                    "surfaceContainerHigh": { "$token": "surface-container-high" },
                    "surfaceContainerHighest": { "$token": "surface-container-highest" }
                  },
                  "default": { "$token": "secondary-container" }
                },
                "cornerRadius": {
                  "$switch": "strokeCap",
                  "cases": { "Butt": 0, "Square": 0 },
                  "default": { "$token": "corner-full" }
                },
                "anchors": {
                  "left": 0,
                  "right": {
                    "$if": { "$eq": ["strokeCap", "Butt"] },
                    "then": 4,
                    "else": 6
                  }
                }
              }
            ]
          },
          {
            "type": "frame",
            "name": "indicador",
            "width": {
              "$if": { "$has": "progress" },
              "then": {
                "$concat": [
                  { "$mul": [{ "$clamp": [{ "$field": "progress" }, 0, 1] }, 100] },
                  "%"
                ]
              },
              "else": "40%"
            },
            "height": 4,
            "layout": { "type": "none" },
            "children": [
              {
                "type": "rect",
                "name": "barra",
                "visible": { "$gt": [{ "$field": "progress" }, 0] },
                "fill": { "$token": "primary" },
                "cornerRadius": {
                  "$switch": "strokeCap",
                  "cases": { "Butt": 0, "Square": 0 },
                  "default": { "$token": "corner-full" }
                },
                "anchors": {
                  "left": 0,
                  "right": {
                    "$if": { "$eq": ["strokeCap", "Butt"] },
                    "then": 0,
                    "else": -2
                  }
                }
              },
              {
                "type": "rect",
                "name": "barra indeterminada",
                "visible": { "$not": { "$has": "progress" } },
                "fill": { "$token": "primary" },
                "cornerRadius": {
                  "$switch": "strokeCap",
                  "cases": { "Butt": 0, "Square": 0 },
                  "default": { "$token": "corner-full" }
                },
                "anchors": {
                  "left": {
                    "$if": { "$eq": ["strokeCap", "Butt"] },
                    "then": 0,
                    "else": -2
                  },
                  "right": {
                    "$if": { "$eq": ["strokeCap", "Butt"] },
                    "then": 0,
                    "else": -2
                  }
                }
              }
            ]
          },
          {
            "type": "frame",
            "name": "trilho",
            "width": "fill",
            "height": 4,
            "layout": { "type": "none" },
            "visible": { "$not": { "$gte": [{ "$field": "progress" }, 1] } },
            "children": [
              {
                "type": "rect",
                "name": "faixa",
                "visible": {
                  "$and": [
                    { "$not": { "$lte": [{ "$field": "progress" }, 0] } },
                    {
                      "$gt": [
                        {
                          "$if": { "$has": "progress" },
                          "then": {
                            "$mul": [
                              { "$size": "width" },
                              {
                                "$sub": [
                                  1,
                                  { "$clamp": [{ "$field": "progress" }, 0, 1] }
                                ]
                              }
                            ]
                          },
                          "else": { "$mul": [{ "$size": "width" }, 0.3] }
                        },
                        { "$if": { "$eq": ["strokeCap", "Butt"] }, "then": 4, "else": 6 }
                      ]
                    }
                  ]
                },
                "fill": {
                  "$switch": "trackColor",
                  "cases": {
                    "primary": { "$token": "primary" },
                    "onPrimary": { "$token": "on-primary" },
                    "primaryContainer": { "$token": "primary-container" },
                    "onPrimaryContainer": { "$token": "on-primary-container" },
                    "secondary": { "$token": "secondary" },
                    "onSecondary": { "$token": "on-secondary" },
                    "secondaryContainer": { "$token": "secondary-container" },
                    "onSecondaryContainer": { "$token": "on-secondary-container" },
                    "tertiary": { "$token": "tertiary" },
                    "onTertiary": { "$token": "on-tertiary" },
                    "tertiaryContainer": { "$token": "tertiary-container" },
                    "onTertiaryContainer": { "$token": "on-tertiary-container" },
                    "error": { "$token": "error" },
                    "onError": { "$token": "on-error" },
                    "errorContainer": { "$token": "error-container" },
                    "onErrorContainer": { "$token": "on-error-container" },
                    "background": { "$token": "background" },
                    "onBackground": { "$token": "on-background" },
                    "surface": { "$token": "surface" },
                    "onSurface": { "$token": "on-surface" },
                    "surfaceVariant": { "$token": "surface-variant" },
                    "onSurfaceVariant": { "$token": "on-surface-variant" },
                    "surfaceTint": { "$token": "surface-tint" },
                    "inverseSurface": { "$token": "inverse-surface" },
                    "inverseOnSurface": { "$token": "inverse-on-surface" },
                    "inversePrimary": { "$token": "inverse-primary" },
                    "outline": { "$token": "outline" },
                    "outlineVariant": { "$token": "outline-variant" },
                    "scrim": { "$token": "scrim" },
                    "surfaceBright": { "$token": "surface-bright" },
                    "surfaceDim": { "$token": "surface-dim" },
                    "surfaceContainerLowest": { "$token": "surface-container-lowest" },
                    "surfaceContainerLow": { "$token": "surface-container-low" },
                    "surfaceContainer": { "$token": "surface-container" },
                    "surfaceContainerHigh": { "$token": "surface-container-high" },
                    "surfaceContainerHighest": { "$token": "surface-container-highest" }
                  },
                  "default": { "$token": "secondary-container" }
                },
                "cornerRadius": {
                  "$switch": "strokeCap",
                  "cases": { "Butt": 0, "Square": 0 },
                  "default": { "$token": "corner-full" }
                },
                "anchors": {
                  "left": {
                    "$if": { "$eq": ["strokeCap", "Butt"] },
                    "then": 4,
                    "else": 6
                  }
                }
              },
              {
                "type": "rect",
                "name": "faixa total",
                "visible": { "$lte": [{ "$field": "progress" }, 0] },
                "fill": {
                  "$switch": "trackColor",
                  "cases": {
                    "primary": { "$token": "primary" },
                    "onPrimary": { "$token": "on-primary" },
                    "primaryContainer": { "$token": "primary-container" },
                    "onPrimaryContainer": { "$token": "on-primary-container" },
                    "secondary": { "$token": "secondary" },
                    "onSecondary": { "$token": "on-secondary" },
                    "secondaryContainer": { "$token": "secondary-container" },
                    "onSecondaryContainer": { "$token": "on-secondary-container" },
                    "tertiary": { "$token": "tertiary" },
                    "onTertiary": { "$token": "on-tertiary" },
                    "tertiaryContainer": { "$token": "tertiary-container" },
                    "onTertiaryContainer": { "$token": "on-tertiary-container" },
                    "error": { "$token": "error" },
                    "onError": { "$token": "on-error" },
                    "errorContainer": { "$token": "error-container" },
                    "onErrorContainer": { "$token": "on-error-container" },
                    "background": { "$token": "background" },
                    "onBackground": { "$token": "on-background" },
                    "surface": { "$token": "surface" },
                    "onSurface": { "$token": "on-surface" },
                    "surfaceVariant": { "$token": "surface-variant" },
                    "onSurfaceVariant": { "$token": "on-surface-variant" },
                    "surfaceTint": { "$token": "surface-tint" },
                    "inverseSurface": { "$token": "inverse-surface" },
                    "inverseOnSurface": { "$token": "inverse-on-surface" },
                    "inversePrimary": { "$token": "inverse-primary" },
                    "outline": { "$token": "outline" },
                    "outlineVariant": { "$token": "outline-variant" },
                    "scrim": { "$token": "scrim" },
                    "surfaceBright": { "$token": "surface-bright" },
                    "surfaceDim": { "$token": "surface-dim" },
                    "surfaceContainerLowest": { "$token": "surface-container-lowest" },
                    "surfaceContainerLow": { "$token": "surface-container-low" },
                    "surfaceContainer": { "$token": "surface-container" },
                    "surfaceContainerHigh": { "$token": "surface-container-high" },
                    "surfaceContainerHighest": { "$token": "surface-container-highest" }
                  },
                  "default": { "$token": "secondary-container" }
                },
                "cornerRadius": {
                  "$switch": "strokeCap",
                  "cases": { "Butt": 0, "Square": 0 },
                  "default": { "$token": "corner-full" }
                }
              },
              {
                "type": "ellipse",
                "name": "parada",
                "width": 4,
                "height": 4,
                "fill": { "$token": "primary" },
                "anchors": { "right": 0, "centerY": true },
                "visible": {
                  "$gte": [
                    {
                      "$if": { "$has": "progress" },
                      "then": {
                        "$mul": [
                          { "$size": "width" },
                          { "$sub": [1, { "$clamp": [{ "$field": "progress" }, 0, 1] }] }
                        ]
                      },
                      "else": { "$mul": [{ "$size": "width" }, 0.3] }
                    },
                    4
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
