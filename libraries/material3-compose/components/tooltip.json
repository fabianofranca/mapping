{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "tooltip",
  "name": "Tooltip",
  "description": "Tooltip plain (pílula em inverse surface, só texto) ou rich (cartão em surface container com título, texto e ação opcionais), como aparece ao lado do elemento âncora.",
  "size": {
    "width": 240,
    "height": 24
  },
  "minSize": {
    "width": 40,
    "height": 24
  },
  "sizing": {
    "width": "hug",
    "height": "hug"
  },
  "preview": {
    "style": "plain",
    "text": "Adicionar aos favoritos",
    "title": "",
    "action": ""
  },
  "template": {
    "type": "frame",
    "name": "tooltip",
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "frame",
        "name": "plain",
        "anchors": {
          "left": 0,
          "top": 0
        },
        "width": "hug",
        "height": "hug",
        "minWidth": 40,
        "maxWidth": 200,
        "minHeight": 24,
        "cornerRadius": {
          "$token": "corner-extra-small"
        },
        "fill": {
          "$token": "inverse-surface"
        },
        "visible": {
          "$not": {
            "$eq": ["style", "rich"]
          }
        },
        "layout": {
          "type": "row",
          "align": "center",
          "padding": [4, 8]
        },
        "children": [
          {
            "type": "text",
            "name": "texto",
            "text": {
              "$field": "text",
              "default": "Tooltip"
            },
            "maxWidth": 184,
            "font": {
              "size": {
                "$token": "body-small-size"
              },
              "weight": {
                "$token": "body-small-weight"
              },
              "lineHeight": {
                "$token": "body-small-line-height"
              },
              "letterSpacing": {
                "$token": "body-small-tracking"
              },
              "verticalAlign": "cap-middle"
            },
            "color": {
              "$token": "inverse-on-surface"
            }
          }
        ]
      },
      {
        "type": "frame",
        "name": "rich",
        "anchors": {
          "left": 0,
          "top": 0
        },
        "width": "fill",
        "height": "hug",
        "minWidth": 40,
        "maxWidth": 320,
        "minHeight": 24,
        "cornerRadius": {
          "$token": "corner-medium"
        },
        "fill": {
          "$token": "surface-container"
        },
        "shadow": [
          {
            "color": {
              "$token": "elevation-point-shadow"
            },
            "y": {
              "$token": "elevation-2-point-y"
            },
            "blur": {
              "$token": "elevation-2-point-blur"
            },
            "spread": {
              "$token": "elevation-2-point-spread"
            }
          },
          {
            "color": {
              "$token": "elevation-ambient-shadow"
            },
            "y": {
              "$token": "elevation-2-ambient-y"
            },
            "blur": {
              "$token": "elevation-2-ambient-blur"
            },
            "spread": {
              "$token": "elevation-2-ambient-spread"
            }
          }
        ],
        "visible": {
          "$eq": ["style", "rich"]
        },
        "layout": {
          "type": "column",
          "padding": {
            "$if": {
              "$or": [
                {
                  "$has": "title"
                },
                {
                  "$has": "action"
                }
              ]
            },
            "then": [0, 16],
            "else": [4, 16]
          }
        },
        "children": [
          {
            "type": "text",
            "name": "título",
            "text": {
              "$field": "title"
            },
            "font": {
              "size": {
                "$token": "title-small-size"
              },
              "weight": {
                "$token": "title-small-weight"
              },
              "lineHeight": {
                "$token": "title-small-line-height"
              },
              "letterSpacing": {
                "$token": "title-small-tracking"
              }
            },
            "color": {
              "$token": "on-surface-variant"
            },
            "width": "fill",
            "visible": {
              "$has": "title"
            },
            "baselinePadding": {
              "top": 28,
              "bottom": 6
            }
          },
          {
            "type": "frame",
            "name": "corpo",
            "width": "fill",
            "height": "hug",
            "layout": {
              "type": "column"
            },
            "children": [
              {
                "type": "text",
                "name": "texto",
                "text": {
                  "$field": "text",
                  "default": "Tooltip"
                },
                "font": {
                  "size": {
                    "$token": "body-medium-size"
                  },
                  "weight": {
                    "$token": "body-medium-weight"
                  },
                  "lineHeight": {
                    "$token": "body-medium-line-height"
                  },
                  "letterSpacing": {
                    "$token": "body-medium-tracking"
                  }
                },
                "color": {
                  "$token": "on-surface-variant"
                },
                "width": "fill",
                "baselinePadding": {
                  "top": {
                    "$if": {
                      "$has": "title"
                    },
                    "then": 23,
                    "else": {
                      "$if": {
                        "$has": "action"
                      },
                      "then": 24,
                      "else": 0
                    }
                  },
                  "bottom": {
                    "$if": {
                      "$or": [
                        {
                          "$has": "title"
                        },
                        {
                          "$has": "action"
                        }
                      ]
                    },
                    "then": 21,
                    "else": 0
                  }
                }
              }
            ]
          },
          {
            "type": "frame",
            "name": "ação",
            "width": "hug",
            "height": "hug",
            "layout": {
              "type": "column",
              "padding": [0, 0, 8, 0]
            },
            "visible": {
              "$has": "action"
            },
            "children": [
              {
                "type": "frame",
                "name": "botão da ação",
                "width": "hug",
                "height": 40,
                "layout": {
                  "type": "row",
                  "align": "center",
                  "padding": [0, 12]
                },
                "children": [
                  {
                    "type": "text",
                    "name": "rótulo da ação",
                    "text": {
                      "$field": "action"
                    },
                    "font": {
                      "size": {
                        "$token": "label-large-size"
                      },
                      "weight": {
                        "$token": "label-large-weight"
                      },
                      "lineHeight": {
                        "$token": "label-large-line-height"
                      },
                      "letterSpacing": {
                        "$token": "label-large-tracking"
                      },
                      "verticalAlign": "cap-middle"
                    },
                    "color": {
                      "$token": "primary"
                    },
                    "height": "fill"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
