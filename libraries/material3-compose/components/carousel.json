{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "carousel",
  "name": "Carousel",
  "description": "Carrossel horizontal de itens com imagem e rótulo opcional, um item por linha de Itens: multi-browse (item grande e vizinhos que espiam), uncontained (itens de largura fixa) e centered-hero (um item grande centrado). Itens de largura uniforme; no Compose o tamanho varia com a rolagem.",
  "size": {
    "width": 360,
    "height": 205
  },
  "sizing": {
    "width": "fill",
    "height": 205
  },
  "preview": {
    "items": [
      {
        "image": "https://example.com/praia.jpg",
        "label": "Praia"
      },
      {
        "image": "https://example.com/serra.jpg",
        "label": "Serra"
      },
      {
        "image": "https://example.com/cidade.jpg",
        "label": "Cidade"
      }
    ],
    "style": "multi-browse",
    "preferredItemWidth": 186,
    "itemWidth": 186,
    "itemSpacing": 8,
    "width": "fill",
    "height": "fixed",
    "weight": null
  },
  "template": {
    "type": "frame",
    "name": "carousel",
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "frame",
        "name": "faixa",
        "width": 4000,
        "anchors": {
          "left": 0,
          "top": 0,
          "bottom": 0
        },
        "layout": {
          "type": "row",
          "padding": {
            "$if": {
              "$eq": ["style", "centered-hero"]
            },
            "then": [0, 0, 0, 64],
            "else": 0
          }
        },
        "children": [
          {
            "type": "repeat",
            "name": "itens",
            "field": "items",
            "direction": "row",
            "gap": {
              "$field": "itemSpacing",
              "default": 8
            },
            "template": {
              "type": "frame",
              "name": "item",
              "width": {
                "$switch": "style",
                "cases": {
                  "uncontained": {
                    "$field": "itemWidth",
                    "default": 140
                  },
                  "centered-hero": 232
                },
                "default": {
                  "$field": "preferredItemWidth",
                  "default": 186
                }
              },
              "height": "fill",
              "cornerRadius": {
                "$token": "corner-extra-large"
              },
              "clip": true,
              "layout": {
                "type": "none"
              },
              "children": [
                {
                  "type": "image",
                  "name": "imagem",
                  "src": {
                    "$field": "image"
                  },
                  "fit": "cover",
                  "width": "fill",
                  "height": "fill",
                  "fill": {
                    "$token": "surface-container-highest"
                  }
                },
                {
                  "type": "rect",
                  "name": "véu",
                  "height": 48,
                  "anchors": {
                    "left": 0,
                    "right": 0,
                    "bottom": 0
                  },
                  "fill": {
                    "type": "linear",
                    "angle": 90,
                    "stops": [
                      {
                        "offset": 0,
                        "color": {
                          "$token": "scrim",
                          "alpha": 0
                        }
                      },
                      {
                        "offset": 1,
                        "color": {
                          "$token": "scrim",
                          "alpha": 0.32
                        }
                      }
                    ]
                  },
                  "visible": {
                    "$has": "label"
                  }
                },
                {
                  "type": "text",
                  "name": "rótulo",
                  "text": {
                    "$field": "label"
                  },
                  "color": {
                    "$token": "secondary-fixed"
                  },
                  "anchors": {
                    "left": 16,
                    "right": 16,
                    "bottom": 14
                  },
                  "font": {
                    "size": {
                      "$token": "label-large-size"
                    },
                    "weight": {
                      "$token": "label-large-weight"
                    },
                    "lineHeight": {
                      "$token": "label-large-line-height"
                    },
                    "letterSpacing": {
                      "$token": "label-large-tracking"
                    },
                    "maxLines": 1,
                    "ellipsis": true,
                    "verticalAlign": "cap-middle"
                  },
                  "visible": {
                    "$has": "label"
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
