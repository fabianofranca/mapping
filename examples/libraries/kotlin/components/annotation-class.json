{
  "format": "mapping-component",
  "formatVersion": 2,
  "id": "annotation-class",
  "name": "Annotation class",
  "description": "Cartão de diagrama de classes de Annotation class: cabeçalho colorido com estereótipo, nome e supertipos, e seções de propriedades.",
  "size": {
    "width": 300,
    "height": 220
  },
  "minSize": {
    "width": 180,
    "height": 190
  },
  "sizing": {
    "width": "fill",
    "height": "fill"
  },
  "preview": {
    "name": "Audited",
    "package": "com.app.audit",
    "visibility": "public",
    "targets": "CLASS, FUNCTION",
    "retention": "RUNTIME",
    "kdoc": "Marca ações auditáveis.",
    "properties": [
      {
        "name": "action",
        "type": "String",
        "defaultValue": "\"\""
      },
      {
        "name": "level",
        "type": "Int",
        "defaultValue": "1"
      }
    ]
  },
  "template": {
    "type": "frame",
    "name": "annotation-class",
    "layout": {
      "type": "column"
    },
    "fill": "#FFFFFF",
    "stroke": {
      "color": "#7F52FF",
      "width": 1
    },
    "cornerRadius": 6,
    "children": [
      {
        "type": "frame",
        "name": "cabeçalho",
        "layout": {
          "type": "column",
          "gap": 2,
          "padding": 8
        },
        "fill": "#7F52FF",
        "width": "fill",
        "height": "hug",
        "children": [
          {
            "type": "text",
            "name": "anotações",
            "text": {
              "$field": "annotations"
            },
            "font": {
              "size": 11,
              "weight": 400,
              "lineHeight": 14,
              "italic": true
            },
            "color": "#FFFFFF",
            "opacity": 0.85,
            "visible": {
              "$has": "annotations"
            },
            "width": "fill"
          },
          {
            "type": "text",
            "name": "estereótipo",
            "text": {
              "$concat": [
                {
                  "$switch": "visibility",
                  "cases": {
                    "internal": "internal ",
                    "protected": "protected ",
                    "private": "private "
                  },
                  "default": ""
                },
                "«annotation class»"
              ]
            },
            "font": {
              "size": 12,
              "weight": 400,
              "lineHeight": 16
            },
            "color": "#FFFFFF",
            "opacity": 0.85,
            "width": "fill"
          },
          {
            "type": "text",
            "name": "nome",
            "text": {
              "$field": "name"
            },
            "font": {
              "size": 14,
              "weight": 700,
              "lineHeight": 20
            },
            "color": "#FFFFFF",
            "width": "fill"
          },
          {
            "type": "text",
            "name": "pacote",
            "text": {
              "$field": "package"
            },
            "font": {
              "size": 11,
              "weight": 400,
              "lineHeight": 14
            },
            "color": "#FFFFFF",
            "opacity": 0.85,
            "visible": {
              "$has": "package"
            },
            "width": "fill"
          },
          {
            "type": "text",
            "name": "alvos",
            "text": {
              "$concat": [
                {
                  "$if": {
                    "$has": "targets"
                  },
                  "then": {
                    "$concat": [
                      "@Target: ",
                      {
                        "$field": "targets"
                      },
                      " · "
                    ]
                  },
                  "else": ""
                },
                "@Retention: ",
                {
                  "$field": "retention"
                }
              ]
            },
            "font": {
              "size": 11,
              "weight": 400,
              "lineHeight": 14
            },
            "color": "#FFFFFF",
            "opacity": 0.85,
            "width": "fill"
          }
        ]
      },
      {
        "type": "rect",
        "name": "divisória propriedades",
        "height": 1,
        "width": "fill",
        "fill": "#7F52FF40",
        "visible": {
          "$has": "properties"
        }
      },
      {
        "type": "frame",
        "name": "propriedades",
        "layout": {
          "type": "column",
          "padding": 8
        },
        "width": "fill",
        "height": "hug",
        "visible": {
          "$has": "properties"
        },
        "children": [
          {
            "type": "repeat",
            "name": "properties",
            "field": "properties",
            "direction": "column",
            "gap": 2,
            "template": {
              "type": "frame",
              "name": "linha",
              "layout": {
                "type": "row"
              },
              "width": "fill",
              "children": [
                {
                  "type": "text",
                  "name": "linha",
                  "text": {
                    "$concat": [
                      "val ",
                      {
                        "$field": "name"
                      },
                      ": ",
                      {
                        "$field": "type"
                      }
                    ]
                  },
                  "font": {
                    "size": 12,
                    "weight": 400,
                    "lineHeight": 16
                  },
                  "color": "#1F1F1F",
                  "width": "fill"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "rect",
        "name": "divisória descrição",
        "height": 1,
        "width": "fill",
        "fill": "#7F52FF40",
        "visible": {
          "$has": "kdoc"
        }
      },
      {
        "type": "frame",
        "name": "descrição",
        "layout": {
          "type": "column",
          "padding": 8
        },
        "width": "fill",
        "height": "hug",
        "visible": {
          "$has": "kdoc"
        },
        "children": [
          {
            "type": "text",
            "name": "kdoc",
            "text": {
              "$field": "kdoc"
            },
            "font": {
              "size": 11,
              "weight": 400,
              "lineHeight": 14
            },
            "color": "#555555",
            "width": "fill"
          }
        ]
      }
    ]
  }
}
