{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "tooltip",
  "name": "Tooltip",
  "description": "Dica escura (color-tooltip) com o texto e, se houver, o atalho entre bordas.",
  "size": {
    "width": 120,
    "height": 24
  },
  "minSize": {
    "width": 40,
    "height": 24
  },
  "sizing": {
    "width": "hug",
    "height": "hug"
  },
  "preview": {
    "rotulo": "Marcar",
    "atalho": "M",
    "posicao": "bottom"
  },
  "template": {
    "type": "frame",
    "name": "tooltip",
    "cornerRadius": 4,
    "fill": "#1b1f24",
    "shadow": {
      "color": "rgba(16, 24, 40, 0.18)",
      "x": 0,
      "y": 8,
      "blur": 24
    },
    "layout": {
      "type": "row",
      "gap": 8,
      "padding": [
        4,
        8
      ],
      "align": "center"
    },
    "children": [
      {
        "type": "text",
        "name": "rótulo",
        "text": {
          "$field": "rotulo",
          "default": "Dica"
        },
        "color": "#ffffff",
        "font": {
          "size": 12,
          "weight": 400,
          "lineHeight": 16
        }
      },
      {
        "type": "frame",
        "name": "atalho",
        "width": "hug",
        "height": "hug",
        "cornerRadius": 2,
        "opacity": 0.75,
        "visible": {
          "$has": "atalho"
        },
        "stroke": {
          "color": "#ffffff",
          "width": 1
        },
        "layout": {
          "type": "row",
          "padding": [
            0,
            4
          ],
          "align": "center"
        },
        "children": [
          {
            "type": "text",
            "name": "tecla",
            "text": {
              "$field": "atalho"
            },
            "color": "#ffffff",
            "font": {
              "size": 11,
              "weight": 400,
              "lineHeight": 16
            }
          }
        ]
      }
    ]
  }
}
