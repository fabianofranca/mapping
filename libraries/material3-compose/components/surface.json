{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "surface",
  "name": "Surface",
  "description": "Superfície do Material 3: cor, forma e elevação tonal (a sobreposição da cor primária) atrás do conteúdo.",
  "size": {
    "width": 200,
    "height": 100
  },
  "minSize": {
    "width": 24,
    "height": 24
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "color": "surface",
    "shape": "medium",
    "tonalElevation": 3,
    "width": "wrap",
    "height": "wrap",
    "weight": null
  },
  "template": {
    "type": "frame",
    "name": "surface",
    "clip": false,
    "layout": {
      "type": "none"
    },
    "fill": {
      "$switch": "color",
      "cases": {
        "primary": "#6750A4",
        "onPrimary": "#FFFFFF",
        "primaryContainer": "#EADDFF",
        "onPrimaryContainer": "#21005D",
        "secondary": "#625B71",
        "onSecondary": "#FFFFFF",
        "secondaryContainer": "#E8DEF8",
        "onSecondaryContainer": "#1D192B",
        "tertiary": "#7D5260",
        "onTertiary": "#FFFFFF",
        "tertiaryContainer": "#FFD8E4",
        "onTertiaryContainer": "#31111D",
        "error": "#B3261E",
        "onError": "#FFFFFF",
        "errorContainer": "#F9DEDC",
        "onErrorContainer": "#410E0B",
        "background": "#FEF7FF",
        "onBackground": "#1D1B20",
        "surface": "#FEF7FF",
        "onSurface": "#1D1B20",
        "surfaceVariant": "#E7E0EC",
        "onSurfaceVariant": "#49454F",
        "surfaceTint": "#6750A4",
        "inverseSurface": "#322F35",
        "inverseOnSurface": "#F5EFF7",
        "inversePrimary": "#D0BCFF",
        "outline": "#79747E",
        "outlineVariant": "#CAC4D0",
        "scrim": "#000000",
        "surfaceBright": "#FEF7FF",
        "surfaceDim": "#DED8E1",
        "surfaceContainerLowest": "#FFFFFF",
        "surfaceContainerLow": "#F7F2FA",
        "surfaceContainer": "#F3EDF7",
        "surfaceContainerHigh": "#ECE6F0",
        "surfaceContainerHighest": "#E6E0E9"
      },
      "default": "#FEF7FF"
    },
    "cornerRadius": {
      "$switch": "shape",
      "cases": {
        "extraSmall": 4,
        "small": 8,
        "medium": 12,
        "large": 16,
        "extraLarge": 28
      },
      "default": 0
    },
    "children": [
      {
        "type": "rect",
        "name": "elevação tonal",
        "fill": "#6750A4",
        "opacity": {
          "$if": {
            "$has": "tonalElevation"
          },
          "then": {
            "$switch": "tonalElevation",
            "cases": {
              "1": 0.05,
              "2": 0.07,
              "3": 0.08,
              "4": 0.09,
              "5": 0.1,
              "6": 0.11,
              "7": 0.115,
              "8": 0.12,
              "9": 0.125,
              "10": 0.13,
              "11": 0.135,
              "12": 0.135
            },
            "default": 0.14
          },
          "else": 0
        },
        "cornerRadius": {
          "$switch": "shape",
          "cases": {
            "extraSmall": 4,
            "small": 8,
            "medium": 12,
            "large": 16,
            "extraLarge": 28
          },
          "default": 0
        }
      },
      {
        "type": "slot",
        "name": "content",
        "label": {
          "$concat": [
            "Surface · ",
            {
              "$field": "width",
              "default": "wrap"
            },
            " × ",
            {
              "$field": "height",
              "default": "wrap"
            },
            {
              "$if": {
                "$has": "weight"
              },
              "then": {
                "$concat": [
                  " · weight ",
                  {
                    "$field": "weight"
                  }
                ]
              },
              "else": ""
            }
          ]
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "layout": {
          "type": "none"
        }
      }
    ]
  }
}
