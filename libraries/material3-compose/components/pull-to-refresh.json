{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "pull-to-refresh",
  "name": "Pull to refresh",
  "description": "Área que atualiza o conteúdo ao ser puxada para baixo: o indicador circular de 40 fica no topo (spinner enquanto atualiza, seta enquanto é puxado) e as marcações filhas são o conteúdo.",
  "size": {
    "width": 360,
    "height": 400
  },
  "sizing": {
    "width": "fill",
    "height": "fill"
  },
  "preview": {
    "isRefreshing": "true",
    "contentAlignment": "TopStart",
    "width": "fill",
    "height": "fill",
    "weight": null
  },
  "template": {
    "type": "frame",
    "name": "pull to refresh",
    "fill": {
      "$token": "surface"
    },
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "slot",
        "name": "content",
        "width": "fill",
        "height": "fill",
        "layout": {
          "type": "none"
        },
        "label": {
          "$concat": [
            "PullToRefreshBox · ",
            {
              "$field": "contentAlignment",
              "default": "TopStart"
            },
            " · ",
            {
              "$field": "width",
              "default": "wrap"
            },
            " × ",
            {
              "$field": "height",
              "default": "wrap"
            },
            {
              "$if": {
                "$has": "weight"
              },
              "then": {
                "$concat": [
                  " · weight ",
                  {
                    "$field": "weight"
                  }
                ]
              },
              "else": ""
            }
          ]
        }
      },
      {
        "type": "frame",
        "name": "indicador atualizando",
        "width": 40,
        "height": 40,
        "cornerRadius": {
          "$token": "corner-full"
        },
        "fill": {
          "$token": "surface-container-high"
        },
        "shadow": {
          "color": {
            "$token": "elevation-shadow"
          },
          "y": {
            "$token": "elevation-2-y"
          },
          "blur": {
            "$token": "elevation-2-blur"
          }
        },
        "anchors": {
          "centerX": true,
          "top": 40
        },
        "visible": {
          "$field": "isRefreshing"
        },
        "layout": {
          "type": "none"
        },
        "children": [
          {
            "type": "path",
            "name": "anel",
            "width": 24,
            "height": 24,
            "viewBox": [24, 24],
            "anchors": {
              "centerX": true,
              "centerY": true
            },
            "d": "M12 5.25A6.75 6.75 0 0 1 12.64 18.72",
            "fill": "none",
            "stroke": {
              "color": {
                "$token": "on-surface-variant"
              },
              "width": 2.5,
              "align": "center",
              "cap": "round",
              "join": "round"
            }
          }
        ]
      },
      {
        "type": "frame",
        "name": "indicador puxando",
        "width": 40,
        "height": 40,
        "cornerRadius": {
          "$token": "corner-full"
        },
        "fill": {
          "$token": "surface-container-high"
        },
        "shadow": {
          "color": {
            "$token": "elevation-shadow"
          },
          "y": {
            "$token": "elevation-2-y"
          },
          "blur": {
            "$token": "elevation-2-blur"
          }
        },
        "anchors": {
          "centerX": true,
          "top": 40
        },
        "visible": {
          "$not": {
            "$field": "isRefreshing"
          }
        },
        "layout": {
          "type": "none"
        },
        "children": [
          {
            "type": "path",
            "name": "anel",
            "width": 24,
            "height": 24,
            "viewBox": [24, 24],
            "anchors": {
              "centerX": true,
              "centerY": true
            },
            "d": "M18.01 15.06A6.75 6.75 0 1 1 16.77 7.23",
            "fill": "none",
            "stroke": {
              "color": {
                "$token": "on-surface-variant"
              },
              "width": 2.5,
              "align": "center",
              "cap": "butt",
              "join": "miter"
            }
          },
          {
            "type": "path",
            "name": "seta",
            "width": 24,
            "height": 24,
            "viewBox": [24, 24],
            "anchors": {
              "centerX": true,
              "centerY": true
            },
            "d": "M11.34 9.02L18.4 8.71L18.09 1.65",
            "fill": "none",
            "stroke": {
              "color": {
                "$token": "on-surface-variant"
              },
              "width": 2.5,
              "align": "center",
              "cap": "butt",
              "join": "miter"
            }
          }
        ]
      }
    ]
  }
}
