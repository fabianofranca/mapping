                          "RadioButtonUnchecked": "radio_button_unchecked",
                          "ToggleOn": "toggle_on",
                          "ToggleOff": "toggle_off",
                          "StarBorder": "star_border",
                          "StarHalf": "star_half",
                          "Lightbulb": "lightbulb",
                          "Code": "code",
                          "Terminal": "terminal",
                          "Bolt": "bolt",
                          "EditCalendar": "edit_calendar"
                        },
                        "default": {
                          "$field": "trailingIcon"
                        }
                      },
                      "width": 24,
                      "height": 24,
                      "color": {
                        "$if": {
                          "$eq": ["enabled", "false"]
                        },
                        "then": {
                          "$token": "on-surface"
                        },
                        "else": {
                          "$if": {
                            "$eq": ["selected", "true"]
                          },
                          "then": {
                            "$token": "on-secondary-container"
                          },
                          "else": {
                            "$token": "on-surface-variant"
                          }
                        }
                      },
                      "opacity": {
                        "$if": {
                          "$eq": ["enabled", "false"]
                        },
                        "then": {
                          "$token": "state-disabled-content"
                        },
                        "else": 1
                      },
                      "visible": {
                        "$has": "trailingIcon"
                      },
                      "anchors": {
                        "right": {
                          "$if": {
                            "$eq": ["style", "exposed"]
                          },
                          "then": 16,
                          "else": 12
                        },
                        "centerY": true
                      }
                    }
                  ]
                },
                {
                  "type": "rect",
                  "name": "estado",
                  "fill": {
                    "$token": "on-secondary-container"
                  },
                  "opacity": {
                    "$switch": "interaction",
                    "cases": {
                      "hovered": {
                        "$token": "state-hover"
                      },
                      "focused": {
                        "$token": "state-focus"
                      }
                    },
                    "default": 0
                  },
                  "visible": {
                    "$and": [
                      {
                        "$eq": ["selected", "true"]
                      },
                      {
                        "$not": {
                          "$eq": ["enabled", "false"]
                        }
                      },
                      {
                        "$not": {
                          "$eq": ["interaction", "none"]
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "rect",
                  "name": "anel de foco",
                  "fill": "none",
                  "stroke": {
                    "color": {
                      "$token": "secondary"
                    },
                    "width": 3,
                    "align": "outside",
                    "offset": 2
                  },
                  "visible": {
                    "$and": [
                      {
                        "$eq": ["selected", "true"]
                      },
                      {
                        "$not": {
                          "$eq": ["enabled", "false"]
                        }
                      },
                      {
                        "$eq": ["interaction", "focused"]
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    ],
    "minWidth": {
      "$if": {
        "$not": {
          "$eq": ["style", "exposed"]
        }
      },
      "then": 112
    },
    "maxWidth": {
      "$if": {
        "$not": {
          "$eq": ["style", "exposed"]
        }
      },
      "then": 280
    }
  }
}
