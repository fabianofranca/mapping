{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "navigation-rail",
  "name": "Navigation rail",
  "description": "Barra de navegação lateral com um destino por linha de Itens. A rail estreita tem 80 de largura (indicador de 56 × 32 sob o ícone) em surface; a wide recolhida tem 96, com 44 de topo, e a expandida 220 ou mais, com o ícone ao lado do rótulo (pílula de 56 a 20 da borda); a modal expandida usa surface container e cantos de 16 (sem scrim nem sombra, que são do composable). A folha se desenha à esquerda da marcação com a largura do estilo; o resto do retângulo fica vazio.",
  "size": {
    "width": 220,
    "height": 400
  },
  "sizing": {
    "width": "hug",
    "height": 400
  },
  "preview": {
    "items": [
      {
        "label": "Início",
        "icon": "Home",
        "selected": "true"
      },
      {
        "label": "Buscar",
        "icon": "Search",
        "selected": "false"
      },
      {
        "label": "Perfil",
        "icon": "Person",
        "selected": "false"
      }
    ],
    "style": "rail",
    "initialValue": "Expanded",
    "alwaysShowLabel": "true"
  },
  "template": {
    "type": "frame",
    "name": "navigation rail",
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "frame",
        "name": "folha da rail",
        "width": "hug",
        "height": "fill",
        "minWidth": {
          "$if": {
            "$eq": ["style", "rail"]
          },
          "then": 80,
          "else": {
            "$if": {
              "$eq": ["initialValue", "Collapsed"]
            },
            "then": 96,
            "else": 220
          }
        },
        "maxWidth": {
          "$if": {
            "$and": [
              {
                "$not": {
                  "$eq": ["style", "rail"]
                }
              },
              {
                "$not": {
                  "$eq": ["initialValue", "Collapsed"]
                }
              }
            ]
          },
          "then": 360,
          "else": {
            "$if": {
              "$not": {
                "$eq": ["style", "rail"]
              }
            },
            "then": 96
          }
        },
        "fill": {
          "$if": {
            "$and": [
              {
                "$eq": ["style", "modal-wide"]
              },
              {
                "$not": {
                  "$eq": ["initialValue", "Collapsed"]
                }
              }
            ]
          },
          "then": {
            "$token": "surface-container"
          },
          "else": {
            "$token": "surface"
          }
        },
        "cornerRadius": {
          "$if": {
            "$and": [
              {
                "$eq": ["style", "modal-wide"]
              },
              {
                "$not": {
                  "$eq": ["initialValue", "Collapsed"]
                }
              }
            ]
          },
          "then": {
            "$token": "corner-large"
          },
          "else": 0
        },
        "layout": {
          "type": "column",
          "padding": {
            "$if": {
              "$eq": ["style", "rail"]
            },
            "then": [4, 0],
            "else": [44, 0, 0, 0]
          }
        },
        "children": [
          {
            "type": "repeat",
            "name": "destinos",
            "field": "items",
            "direction": "column",
            "gap": {
              "$if": {
                "$and": [
                  {
                    "$not": {
                      "$eq": ["style", "rail"]
                    }
                  },
                  {
                    "$not": {
                      "$eq": ["initialValue", "Collapsed"]
                    }
                  }
                ]
              },
              "then": 0,
              "else": 4
            },
            "width": "fill",
            "template": {
              "type": "frame",
              "name": "destino",
              "width": "fill",
              "layout": {
                "type": "column",
                "padding": {
                  "$if": {
                    "$or": [
                      {
                        "$eq": ["style", "rail"]
                      },
                      {
                        "$eq": ["initialValue", "Collapsed"]
                      }
                    ]
                  },
                  "then": 0,
                  "else": [0, 20]
                }
              },
              "children": [
                {
                  "type": "frame",
                  "name": "ícone acima",
                  "width": "fill",
                  "height": {
                    "$if": {
                      "$eq": ["style", "rail"]
                    },
                    "then": 56,
                    "else": 64
                  },
                  "visible": {
                    "$or": [
                      {
                        "$eq": ["style", "rail"]
                      },
                      {
                        "$eq": ["initialValue", "Collapsed"]
                      }
                    ]
                  },
                  "layout": {
                    "type": "column",
                    "gap": 4,
                    "align": "center",
                    "justify": {
                      "$if": {
                        "$and": [
                          {
                            "$has": "label"
                          },
                          {
                            "$or": [
                              {
                                "$not": {
                                  "$eq": ["style", "rail"]
                                }
                              },
                              {
                                "$not": {
                                  "$eq": ["alwaysShowLabel", "false"]
                                }
                              },
                              {
                                "$field": "selected"
                              }
                            ]
                          }
                        ]
                      },
                      "then": "start",
                      "else": "center"
                    }
                  },
                  "children": [
                    {
                      "type": "frame",
                      "name": "pílula",
                      "width": "hug",
                      "height": "hug",
                      "layout": {
                        "type": "none"
                      },
                      "children": [
                        {
                          "type": "frame",
                          "name": "indicador",
                          "width": 56,
                          "height": 32,
                          "cornerRadius": {
                            "$token": "corner-full"
                          },
                          "fill": {
                            "$if": {
                              "$field": "selected"
                            },
                            "then": {
                              "$token": "secondary-container"
                            },
                            "else": "none"
                          },
                          "layout": {
                            "type": "row",
                            "align": "center",
                            "justify": "center"
                          },
                          "children": [
                            {
                              "type": "icon",
                              "name": {
                                "$switch": "icon",
                                "cases": {
                                  "Home": "home",
                                  "Search": "search",
                                  "Person": "person",
                                  "Menu": "menu",
                                  "MoreVert": "more_vert",
