{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "text",
  "name": "Text",
  "description": "Texto do Material 3 com um dos 15 papéis de tipografia, cor e alinhamento (tokens do tema, claro e escuro, na Roboto); vazio, mostra as medidas.",
  "size": {
    "width": 240,
    "height": 32
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "text": "Título da seção",
    "style": "bodyLarge",
    "color": null,
    "textAlign": "Start",
    "maxLines": null,
    "width": "wrap",
    "height": "wrap",
    "weight": null
  },
  "template": {
    "type": "frame",
    "name": "text",
    "clip": true,
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "text",
        "name": "texto",
        "visible": {
          "$has": "text"
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0
        },
        "width": "fill",
        "height": "hug",
        "text": {
          "$field": "text"
        },
        "color": {
          "$switch": "color",
          "cases": {
            "primary": {
              "$token": "primary"
            },
            "onPrimary": {
              "$token": "on-primary"
            },
            "primaryContainer": {
              "$token": "primary-container"
            },
            "onPrimaryContainer": {
              "$token": "on-primary-container"
            },
            "secondary": {
              "$token": "secondary"
            },
            "onSecondary": {
              "$token": "on-secondary"
            },
            "secondaryContainer": {
              "$token": "secondary-container"
            },
            "onSecondaryContainer": {
              "$token": "on-secondary-container"
            },
            "tertiary": {
              "$token": "tertiary"
            },
            "onTertiary": {
              "$token": "on-tertiary"
            },
            "tertiaryContainer": {
              "$token": "tertiary-container"
            },
            "onTertiaryContainer": {
              "$token": "on-tertiary-container"
            },
            "error": {
              "$token": "error"
            },
            "onError": {
              "$token": "on-error"
            },
            "errorContainer": {
              "$token": "error-container"
            },
            "onErrorContainer": {
              "$token": "on-error-container"
            },
            "background": {
              "$token": "background"
            },
            "onBackground": {
              "$token": "on-background"
            },
            "surface": {
              "$token": "surface"
            },
            "onSurface": {
              "$token": "on-surface"
            },
            "surfaceVariant": {
              "$token": "surface-variant"
            },
            "onSurfaceVariant": {
              "$token": "on-surface-variant"
            },
            "surfaceTint": {
              "$token": "surface-tint"
            },
            "inverseSurface": {
              "$token": "inverse-surface"
            },
            "inverseOnSurface": {
              "$token": "inverse-on-surface"
            },
            "inversePrimary": {
              "$token": "inverse-primary"
            },
            "outline": {
              "$token": "outline"
            },
            "outlineVariant": {
              "$token": "outline-variant"
            },
            "scrim": {
              "$token": "scrim"
            },
            "surfaceBright": {
              "$token": "surface-bright"
            },
            "surfaceDim": {
              "$token": "surface-dim"
            },
            "surfaceContainerLowest": {
              "$token": "surface-container-lowest"
            },
            "surfaceContainerLow": {
              "$token": "surface-container-low"
            },
            "surfaceContainer": {
              "$token": "surface-container"
            },
            "surfaceContainerHigh": {
              "$token": "surface-container-high"
            },
            "surfaceContainerHighest": {
              "$token": "surface-container-highest"
            }
          },
          "default": {
            "$token": "on-surface"
          }
        },
        "font": {
          "size": {
            "$switch": "style",
            "cases": {
              "displayLarge": {
                "$token": "display-large-size"
              },
              "displayMedium": {
                "$token": "display-medium-size"
              },
              "displaySmall": {
                "$token": "display-small-size"
              },
              "headlineLarge": {
                "$token": "headline-large-size"
              },
              "headlineMedium": {
                "$token": "headline-medium-size"
              },
              "headlineSmall": {
                "$token": "headline-small-size"
              },
              "titleLarge": {
                "$token": "title-large-size"
              },
              "titleMedium": {
                "$token": "title-medium-size"
              },
              "titleSmall": {
                "$token": "title-small-size"
              },
              "bodyLarge": {
                "$token": "body-large-size"
              },
              "bodyMedium": {
                "$token": "body-medium-size"
              },
              "bodySmall": {
                "$token": "body-small-size"
              },
              "labelLarge": {
                "$token": "label-large-size"
              },
              "labelMedium": {
                "$token": "label-medium-size"
              },
              "labelSmall": {
                "$token": "label-small-size"
              }
            },
            "default": {
              "$token": "body-large-size"
            }
          },
          "weight": {
            "$switch": "style",
            "cases": {
              "displayLarge": {
                "$token": "display-large-weight"
              },
              "displayMedium": {
                "$token": "display-medium-weight"
              },
              "displaySmall": {
                "$token": "display-small-weight"
              },
              "headlineLarge": {
                "$token": "headline-large-weight"
              },
              "headlineMedium": {
                "$token": "headline-medium-weight"
              },
              "headlineSmall": {
                "$token": "headline-small-weight"
              },
              "titleLarge": {
                "$token": "title-large-weight"
              },
              "titleMedium": {
                "$token": "title-medium-weight"
              },
              "titleSmall": {
                "$token": "title-small-weight"
              },
              "bodyLarge": {
                "$token": "body-large-weight"
              },
              "bodyMedium": {
                "$token": "body-medium-weight"
              },
              "bodySmall": {
                "$token": "body-small-weight"
              },
              "labelLarge": {
                "$token": "label-large-weight"
              },
              "labelMedium": {
                "$token": "label-medium-weight"
              },
              "labelSmall": {
                "$token": "label-small-weight"
              }
            },
            "default": {
              "$token": "body-large-weight"
            }
          },
          "lineHeight": {
            "$switch": "style",
            "cases": {
              "displayLarge": {
                "$token": "display-large-line-height"
              },
              "displayMedium": {
                "$token": "display-medium-line-height"
              },
              "displaySmall": {
                "$token": "display-small-line-height"
              },
              "headlineLarge": {
                "$token": "headline-large-line-height"
              },
              "headlineMedium": {
                "$token": "headline-medium-line-height"
              },
              "headlineSmall": {
                "$token": "headline-small-line-height"
              },
              "titleLarge": {
                "$token": "title-large-line-height"
              },
              "titleMedium": {
                "$token": "title-medium-line-height"
              },
              "titleSmall": {
                "$token": "title-small-line-height"
              },
              "bodyLarge": {
                "$token": "body-large-line-height"
              },
              "bodyMedium": {
                "$token": "body-medium-line-height"
              },
              "bodySmall": {
                "$token": "body-small-line-height"
              },
              "labelLarge": {
                "$token": "label-large-line-height"
              },
              "labelMedium": {
                "$token": "label-medium-line-height"
              },
              "labelSmall": {
                "$token": "label-small-line-height"
              }
            },
            "default": {
              "$token": "body-large-line-height"
            }
          },
          "letterSpacing": {
            "$switch": "style",
            "cases": {
              "displayLarge": {
                "$token": "display-large-tracking"
              },
              "displayMedium": {
                "$token": "display-medium-tracking"
              },
              "displaySmall": {
                "$token": "display-small-tracking"
              },
              "headlineLarge": {
                "$token": "headline-large-tracking"
              },
              "headlineMedium": {
                "$token": "headline-medium-tracking"
              },
              "headlineSmall": {
                "$token": "headline-small-tracking"
              },
              "titleLarge": {
                "$token": "title-large-tracking"
              },
              "titleMedium": {
                "$token": "title-medium-tracking"
              },
              "titleSmall": {
                "$token": "title-small-tracking"
              },
              "bodyLarge": {
                "$token": "body-large-tracking"
              },
              "bodyMedium": {
                "$token": "body-medium-tracking"
              },
              "bodySmall": {
                "$token": "body-small-tracking"
              },
              "labelLarge": {
                "$token": "label-large-tracking"
              },
              "labelMedium": {
                "$token": "label-medium-tracking"
              },
              "labelSmall": {
                "$token": "label-small-tracking"
              }
            },
            "default": {
              "$token": "body-large-tracking"
            }
          },
          "align": {
            "$switch": "textAlign",
            "cases": {
              "Start": "left",
              "Center": "center",
              "End": "right",
              "Justify": "left"
            },
            "default": "left"
          },
          "maxLines": {
            "$field": "maxLines"
          }
        }
      },
      {
        "type": "text",
        "name": "texto vazio",
        "visible": {
          "$not": {
            "$has": "text"
          }
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0
        },
        "width": "fill",
        "height": "hug",
        "text": {
          "$concat": [
            "Text · ",
            {
              "$field": "width",
              "default": "wrap"
            },
            " × ",
            {
              "$field": "height",
              "default": "wrap"
            },
            {
              "$if": {
                "$has": "weight"
              },
              "then": {
                "$concat": [
                  " · weight ",
                  {
                    "$field": "weight"
                  }
                ]
              },
              "else": ""
            },
            {
              "$if": {
                "$has": "maxLines"
              },
              "then": {
                "$concat": [
                  " · max ",
                  {
                    "$field": "maxLines"
                  },
                  " linhas"
                ]
              },
              "else": ""
            }
          ]
        },
        "color": {
          "$token": "outline"
        },
        "font": {
          "size": 12,
          "weight": 400,
          "lineHeight": 16,
          "italic": true
        }
      }
    ]
  }
}
