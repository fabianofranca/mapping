    "width": 136,
    "height": 40
  },
  "minSize": {
    "width": 58,
    "height": 40
  },
  "sizing": {
    "width": "hug",
    "height": "hug"
  },
  "preview": {
    "label": "Salvar",
    "style": "filled",
    "enabled": "true",
    "icon": ""
