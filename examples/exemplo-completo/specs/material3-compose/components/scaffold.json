{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "scaffold",
  "name": "Scaffold",
  "description": "Estrutura de tela do Material 3: fundo da tela e um espaço para a barra de cima, o conteúdo, a barra de baixo e o botão flutuante.",
  "size": {
    "width": 360,
    "height": 800
  },
  "sizing": {
    "width": "fill",
    "height": "fill"
  },
  "preview": {
    "containerColor": "background",
    "floatingActionButtonPosition": "End",
    "width": "fill",
    "height": "fill"
  },
  "template": {
    "type": "frame",
    "name": "scaffold",
    "clip": false,
    "layout": {
      "type": "none"
    },
    "fill": {
      "$switch": "containerColor",
      "cases": {
        "primary": "#6750A4",
        "onPrimary": "#FFFFFF",
        "primaryContainer": "#EADDFF",
        "onPrimaryContainer": "#21005D",
        "secondary": "#625B71",
        "onSecondary": "#FFFFFF",
        "secondaryContainer": "#E8DEF8",
        "onSecondaryContainer": "#1D192B",
        "tertiary": "#7D5260",
        "onTertiary": "#FFFFFF",
        "tertiaryContainer": "#FFD8E4",
        "onTertiaryContainer": "#31111D",
        "error": "#B3261E",
        "onError": "#FFFFFF",
        "errorContainer": "#F9DEDC",
        "onErrorContainer": "#410E0B",
        "background": "#FEF7FF",
        "onBackground": "#1D1B20",
        "surface": "#FEF7FF",
        "onSurface": "#1D1B20",
        "surfaceVariant": "#E7E0EC",
        "onSurfaceVariant": "#49454F",
        "surfaceTint": "#6750A4",
        "inverseSurface": "#322F35",
        "inverseOnSurface": "#F5EFF7",
        "inversePrimary": "#D0BCFF",
        "outline": "#79747E",
        "outlineVariant": "#CAC4D0",
        "scrim": "#000000",
        "surfaceBright": "#FEF7FF",
        "surfaceDim": "#DED8E1",
        "surfaceContainerLowest": "#FFFFFF",
        "surfaceContainerLow": "#F7F2FA",
        "surfaceContainer": "#F3EDF7",
        "surfaceContainerHigh": "#ECE6F0",
        "surfaceContainerHighest": "#E6E0E9"
      },
      "default": "#FEF7FF"
    },
    "children": [
      {
        "type": "slot",
        "name": "content",
        "label": {
          "$concat": [
            "Scaffold · FAB ",
            {
              "$field": "floatingActionButtonPosition",
              "default": "End"
            },
            " · ",
            {
              "$field": "width",
              "default": "fill"
            },
            " × ",
            {
              "$field": "height",
              "default": "fill"
            }
          ]
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "layout": {
          "type": "none"
        }
      }
    ]
  }
}
