{
  "format": "mapping-spec",
  "formatVersion": 6,
  "id": "material3",
  "name": "Material Design 3 (baseline)",
  "version": 1,
  "description": "Material 3 components, baseline light theme, written in the component format of the lab.",
  "containers": [
    {
      "id": "phone",
      "name": "Celular",
      "width": 360,
      "height": 800
    },
    {
      "id": "phone-large",
      "name": "Celular grande",
      "width": 412,
      "height": 915
    },
    {
      "id": "tablet",
      "name": "Tablet",
      "width": 800,
      "height": 1280
    },
    {
      "id": "desktop",
      "name": "Desktop",
      "width": 1440,
      "height": 900
    }
  ],
  "fonts": [
    {
      "family": "Roboto",
      "file": "fonts/Roboto-Regular.ttf",
      "weight": 400
    },
    {
      "family": "Roboto",
      "file": "fonts/Roboto-Medium.ttf",
      "weight": 500
    }
  ],
  "origins": [
    {
      "system": "sdui",
      "name": "Backend SDUI",
      "node": {
        "type": "type",
        "props": "props",
        "children": "children"
      },
      "screen": {
        "id": {
          "path": "screen.id"
        },
        "name": {
          "path": "screen.title",
          "default": "Tela"
        },
        "width": {
          "path": "screen.device.width"
        },
        "height": {
          "path": "screen.device.height"
        },
        "background": {
          "path": "screen.background",
          "values": {
            "surface": "#FEF7FF"
          },
          "default": "#FFFFFF"
        },
        "roots": [
          {
            "path": "content"
          },
          {
            "path": "bottomBar",
            "anchor": "bottom"
          },
          {
            "path": "floating[*]",
            "anchor": {
              "path": "anchor"
            },
            "margin": {
              "path": "margin"
            }
          },
          {
            "path": "modal",
            "anchor": "bottom",
            "scrim": "m3-scrim"
          }
        ]
      },
      "booleans": {
        "true": "sim",
        "false": "não"
      },
      "examples": [
        {
          "name": "Settings",
          "file": "examples/settings.sdui.json"
        }
      ]
    }
  ],
  "layers": [
    {
      "id": "componentes",
      "name": "Componentes",
      "color": "#6750A4",
      "annotationTypes": [
