                            "$token": "state-focus"
                          },
                          "pressed": {
                            "$token": "state-pressed"
                          }
                        },
                        "default": 0
                      },
                      "visible": {
                        "$and": [
                          {
                            "$field": "selected"
                          },
                          {
                            "$not": {
                              "$eq": ["interaction", "none"]
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
