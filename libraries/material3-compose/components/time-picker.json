                                                {
                                                  "$mul": [
                                                    {
                                                      "$if": {
                                                        "$gte": [
                                                          { "$field": "$index" },
                                                          12
                                                        ]
                                                      },
                                                      "then": 69,
                                                      "else": 101
                                                    },
                                                    {
                                                      "$sin": {
                                                        "$mul": [
                                                          {
                                                            "$mod": [
                                                              { "$field": "$index" },
                                                              12
                                                            ]
                                                          },
                                                          30
                                                        ]
                                                      }
                                                    }
                                                  ]
                                                }
                                              ]
