      {
        "type": "frame",
        "name": "barra",
        "width": "fill",
        "height": 64,
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0
        },
        "layout": {
          "type": "row",
          "padding": [0, 4],
          "align": "center"
        },
