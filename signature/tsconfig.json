{
  // Signature extractor (stage #1079, S3): runs on Node, no DOM. It also compiles
  // `src/model/` (the record and `parseSignature`), which proves it does not depend on a browser.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "jsx": "preserve",
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["./**/*.ts", "../src/model/**/*.ts", "../tests/signature/**/*.ts"]
}
