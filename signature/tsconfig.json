{
  // Extrator de assinaturas (etapa #1079, S3): roda no Node, sem DOM. Compila também o
  // `src/model/` (a ficha e o `parseSignature`), o que prova que ele não depende de navegador.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "jsx": "preserve",
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["./**/*.ts", "../src/model/**/*.ts", "../tests/signature/**/*.ts"]
}
