{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "lazy-vertical-grid",
  "name": "LazyVerticalGrid",
  "description": "Grade vertical que compõe só as células visíveis: as filhas ficam onde o retângulo delas diz; o contentPadding recua o conteúdo.",
  "size": {
    "width": 360,
    "height": 400
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "columns": 2,
    "minColumnWidth": null,
    "verticalSpacing": 8,
    "horizontalSpacing": 8,
    "contentPadding": 16,
    "width": "wrap",
    "height": "wrap",
    "weight": null
  },
  "template": {
    "type": "frame",
    "name": "lazy-vertical-grid",
    "clip": false,
    "layout": {
      "type": "none"
    },
    "children": [
      {
        "type": "slot",
        "name": "content",
        "label": {
          "$concat": [
            "LazyVerticalGrid",
            " · ",
            {
              "$field": "width",
              "default": "wrap"
            },
            " × ",
            {
              "$field": "height",
              "default": "wrap"
            },
            {
              "$if": {
                "$has": "weight"
              },
              "then": {
                "$concat": [
                  " · weight ",
                  {
                    "$field": "weight"
                  }
                ]
              },
              "else": ""
            }
          ]
        },
        "layout": {
          "type": "grid",
          "columns": {
            "$if": {
              "$not": {
                "$has": "minColumnWidth"
              }
            },
            "then": {
              "$field": "columns",
              "default": 2
            }
          },
          "minColumnWidth": {
            "$field": "minColumnWidth"
          },
          "gap": {
            "$field": "horizontalSpacing",
            "default": 0
          },
          "lineGap": {
            "$field": "verticalSpacing",
            "default": 0
          },
          "padding": {
            "$field": "contentPadding",
            "default": 0
          }
        },
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        },
        "clip": true
      }
    ]
  }
}
