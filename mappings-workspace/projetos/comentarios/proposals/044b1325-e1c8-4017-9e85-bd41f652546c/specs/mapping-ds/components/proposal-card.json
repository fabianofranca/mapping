{
  "format": "mapping-component",
  "formatVersion": 1,
  "id": "proposal-card",
  "name": "ProposalCard",
  "description": "Cartão da proposta numa mensagem: ícone, título em negrito, quantas mudanças faltam revisar e o botão Revisar.",
  "size": {
    "width": 344,
    "height": 52
  },
  "minSize": {
    "width": 200,
    "height": 44
  },
  "sizing": {
    "width": "fill",
    "height": "hug"
  },
  "preview": {
    "titulo": "Variantes dos botões",
    "estado": "3 mudanças para revisar",
    "acao": "Revisar"
  },
  "template": {
    "type": "frame",
    "name": "cartão",
    "cornerRadius": 6,
    "stroke": {
      "color": "#dfe3e8",
      "width": 1
    },
    "layout": {
      "type": "row",
      "gap": 8,
      "padding": [
        6,
        8
      ],
      "align": "center"
    },
    "children": [
      {
        "type": "path",
        "name": "proposta",
        "width": 16,
        "height": 16,
        "viewBox": [
          16,
          16
        ],
        "d": "M2.5 4a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0ZM2.5 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0ZM4 5.5v5M10.5 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0ZM12 10.5V6.5a2 2 0 0 0-2-2H8.5M10 2.5-1.8 2 1.8 2",
        "fill": "none",
        "stroke": {
          "color": "#1b1f24",
          "width": 1.25
        }
      },
      {
        "type": "frame",
        "name": "texto",
        "width": "fill",
        "height": "hug",
        "layout": {
          "type": "column"
        },
        "children": [
          {
            "type": "text",
            "name": "título",
            "text": {
              "$field": "titulo",
              "default": "Proposta"
            },
            "color": "#1b1f24",
            "font": {
              "size": 12,
              "weight": 600,
              "lineHeight": 16
            },
            "width": "fill"
          },
          {
            "type": "text",
            "name": "estado",
            "text": {
              "$field": "estado"
            },
            "color": "#5b6470",
            "font": {
              "size": 12,
              "weight": 400,
              "lineHeight": 16
            },
            "width": "fill",
            "visible": {
              "$has": "estado"
            }
          }
        ]
      },
      {
        "type": "frame",
        "name": "ação",
        "width": "hug",
        "height": 24,
        "cornerRadius": 4,
        "visible": {
          "$has": "acao"
        },
        "fill": {
          "$if": {
            "$eq": [
              "acao",
              "Revisar"
            ]
          },
          "then": "#1a63cc",
          "else": "#ffffff"
        },
        "stroke": {
          "color": {
            "$if": {
              "$eq": [
                "acao",
                "Revisar"
              ]
            },
            "then": "#1a63cc",
            "else": "#7d8590"
          },
          "width": 1
        },
        "layout": {
          "type": "row",
          "padding": [
            0,
            8
          ],
          "align": "center",
          "justify": "center"
        },
        "children": [
          {
            "type": "text",
            "name": "ação",
            "text": {
              "$field": "acao"
            },
            "color": {
              "$if": {
                "$eq": [
                  "acao",
                  "Revisar"
                ]
              },
              "then": "#ffffff",
              "else": "#1b1f24"
            },
            "font": {
              "size": 13,
              "weight": 400,
              "lineHeight": 20
            }
          }
        ]
      }
    ]
  }
}
