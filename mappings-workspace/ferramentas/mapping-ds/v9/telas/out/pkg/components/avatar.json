{
  "format": "mapping-component",
  "formatVersion": 4,
  "id": "avatar",
  "name": "Iniciais",
  "description": "As iniciais de quem escreveu, num círculo em color-selection-muted (24 px na conversa, 16 px na tabela).",
  "size": {
    "width": 24,
    "height": 24
  },
  "minSize": {
    "width": 8,
    "height": 8
  },
  "sizing": {
    "width": 24,
    "height": 24
  },
  "preview": {
    "iniciais": "MA",
    "estilo": "conversa"
  },
  "template": {
    "type": "frame",
    "name": "iniciais",
    "layout": {
      "type": "none"
    },
    "cornerRadius": 999,
    "fill": {
      "$token": "color-selection-muted"
    },
    "children": [
      {
        "type": "text",
        "name": "iniciais",
        "text": {
          "$field": "iniciais",
          "default": "?"
        },
        "color": {
          "$switch": "estilo",
          "cases": {
            "tabela": {
              "$token": "color-text-muted"
            }
          },
          "default": {
            "$token": "color-text"
          }
        },
        "font": {
          "size": 11,
          "weight": 600,
          "lineHeight": 16,
          "align": "center",
          "verticalAlign": "middle"
        },
        "width": "fill",
        "height": "fill"
      }
    ]
  }
}
