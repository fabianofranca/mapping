{
 "compose": {
  "boolean": {
   "type": "enum",
   "options": [
    "true",
    "false"
   ]
  },
  "Color": {
   "like": "surface.color"
  },
  "Shape": {
   "like": "surface.shape"
  },
  "Dp": {
   "type": "number",
   "format": "{value}.dp"
  },
  "TextUnit": {
   "type": "number",
   "format": "{value}.sp"
  },
  "PaddingValues": {
   "expand": {
    "call": "PaddingValues",
    "params": {
     "horizontal": "Dp",
     "vertical": "Dp"
    }
   }
  },
  "BorderStroke": {
   "expand": {
    "call": "BorderStroke",
    "params": {
     "width": "Dp",
     "color": "Color"
    }
   }
  },
  "@Composable () -> Unit": {
   "type": "string",
   "format": "{ Text(\"{value}\") }"
  },
  "(@Composable () -> Unit)?": {
   "type": "string",
   "format": "{ Text(\"{value}\") }"
  },
  "BorderStroke?": {
   "expand": {
    "call": "BorderStroke",
    "params": {
     "width": "Dp",
     "color": "Color"
    }
   }
  },
  "@Composable (() -> Unit)?": {
   "type": "string",
   "format": "{ Text(\"{value}\") }"
  }
 }
}