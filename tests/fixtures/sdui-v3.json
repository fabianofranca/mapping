{
  "format": "mapping-spec",
  "formatVersion": 5,
  "id": "sdui",
  "name": "SDUI",
  "version": 3,
  "description": "Componentes de tela e seus eventos para Server-Driven UI.",
  "platforms": [
    {
      "id": "android",
      "name": "Android",
      "language": "kotlin",
      "repo": {
        "url": "https://github.com/org/app-android",
        "urlTemplate": "https://github.com/org/app-android/blob/v3/{path}",
        "ref": "v3"
      }
    },
    {
      "id": "ios",
      "name": "iOS",
      "language": "swift",
      "repo": {
        "url": "https://github.com/org/app-ios",
        "urlTemplate": "https://github.com/org/app-ios/blob/v3/{path}",
        "ref": "v3"
      }
    },
    {
      "id": "bff",
      "name": "BFF",
      "language": "kotlin",
      "repo": {
        "url": "https://github.com/org/bff",
        "urlTemplate": "https://github.com/org/bff/blob/v3/{path}",
        "ref": "v3"
      }
    }
  ],
  "layers": [
    {
      "id": "componentes",
      "name": "Componentes",
      "color": "#1E88E5",
      "annotationTypes": [
        {
          "id": "button",
          "name": "Button",
          "allowedChildren": ["onClick", "onHold"],
          "fields": [
            {
              "key": "id",
              "type": "string",
              "required": true
            },
            {
              "key": "texto",
              "type": "string",
              "required": true
            },
            {
              "key": "estilo",
              "type": "enum",
              "options": ["primary", "secondary", "text"],
              "default": "primary"
            },
            {
              "key": "habilitado",
              "type": "enum",
              "options": ["sim", "não"],
              "default": "sim"
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.DSButton",
              "path": "app/src/main/java/com/app/ds/DSButton.kt",
              "params": {
                "texto": "text",
                "estilo": "style",
                "habilitado": "enabled"
              },
              "values": {
                "estilo": {
                  "primary": "ButtonStyle.Primary",
                  "secondary": "ButtonStyle.Secondary",
                  "text": "ButtonStyle.Text"
                },
                "habilitado": {
                  "sim": "true",
                  "não": "false"
                }
              },
              "notes": "Use o modifier de testTag com o valor do campo id."
            },
            "ios": {
              "symbol": "DSButton",
              "path": "App/DesignSystem/DSButton.swift",
              "params": {
                "texto": "title",
                "estilo": "style",
                "habilitado": "isEnabled"
              },
              "values": {
                "estilo": {
                  "primary": ".primary",
                  "secondary": ".secondary",
                  "text": ".text"
                },
                "habilitado": {
                  "sim": "true",
                  "não": "false"
                }
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.button",
              "path": "src/main/kotlin/com/app/bff/sdui/Components.kt",
              "params": {
                "id": "id",
                "texto": "label",
                "estilo": "variant",
                "habilitado": "enabled"
              },
              "notes": "A função devolve o nó do componente no JSON da tela."
            }
          }
        },
        {
          "id": "input",
          "name": "Input",
          "allowedChildren": ["onChange"],
          "fields": [
            {
              "key": "id",
              "type": "string",
              "required": true
            },
            {
              "key": "tipo",
              "type": "enum",
              "options": ["text", "email", "password", "number", "phone"],
              "default": "text",
              "required": true
            },
            {
              "key": "placeholder",
              "type": "string"
            },
            {
              "key": "obrigatorio",
              "label": "obrigatório",
              "type": "enum",
              "options": ["sim", "não"],
              "default": "não"
            },
            {
              "key": "maxLength",
              "type": "number"
            },
            {
              "key": "dado",
              "type": "ref",
              "accepts": {
                "tags": ["data-field"],
                "free": true
              },
              "description": "Atributo do modelo de dados exibido e editado por este campo"
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.DSTextField",
              "path": "app/src/main/java/com/app/ds/DSTextField.kt",
              "params": {
                "tipo": "keyboardType",
                "placeholder": "placeholder",
                "obrigatorio": "required",
                "maxLength": "maxLength"
              },
              "values": {
                "tipo": {
                  "text": "KeyboardType.Text",
                  "email": "KeyboardType.Email",
                  "password": "KeyboardType.Password",
                  "number": "KeyboardType.Number",
                  "phone": "KeyboardType.Phone"
                },
                "obrigatorio": {
                  "sim": "true",
                  "não": "false"
                }
              },
              "notes": "O campo dado indica o atributo do modelo de dados ligado ao valor digitado."
            },
            "ios": {
              "symbol": "DSTextField",
              "params": {
                "tipo": "keyboardType",
                "placeholder": "placeholder",
                "obrigatorio": "isRequired",
                "maxLength": "maxLength"
              },
              "values": {
                "tipo": {
                  "text": ".default",
                  "email": ".emailAddress",
                  "password": ".default",
                  "number": ".numberPad",
                  "phone": ".phonePad"
                },
                "obrigatorio": {
                  "sim": "true",
                  "não": "false"
                }
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.input",
              "path": "src/main/kotlin/com/app/bff/sdui/Components.kt",
              "params": {
                "id": "id",
                "tipo": "type",
                "placeholder": "placeholder",
                "obrigatorio": "required",
                "maxLength": "maxLength"
              },
              "notes": "A função devolve o nó do componente no JSON da tela."
            }
          }
        },
        {
          "id": "text",
          "name": "Text",
          "fields": [
            {
              "key": "id",
              "type": "string",
              "required": true
            },
            {
              "key": "conteudo",
              "label": "conteúdo",
              "type": "string",
              "required": true
            },
            {
              "key": "estilo",
              "type": "enum",
              "options": ["titulo", "corpo", "legenda"],
              "default": "corpo"
            },
            {
              "key": "dado",
              "type": "ref",
              "accepts": {
                "tags": ["data-field"],
                "free": true
              },
              "description": "Atributo exibido por este texto (opcional)"
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.DSText",
              "params": {
                "conteudo": "text",
                "estilo": "style"
              },
              "values": {
                "estilo": {
                  "titulo": "TextStyle.Title",
                  "corpo": "TextStyle.Body",
                  "legenda": "TextStyle.Caption"
                }
              }
            },
            "ios": {
              "symbol": "DSText",
              "params": {
                "conteudo": "text",
                "estilo": "style"
              },
              "values": {
                "estilo": {
                  "titulo": ".title",
                  "corpo": ".body",
                  "legenda": ".caption"
                }
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.text",
              "path": "src/main/kotlin/com/app/bff/sdui/Components.kt",
              "params": {
                "id": "id",
                "conteudo": "content",
                "estilo": "variant"
              },
              "notes": "A função devolve o nó do componente no JSON da tela."
            }
          }
        },
        {
          "id": "image",
          "name": "Image",
          "allowedChildren": ["onClick"],
          "fields": [
            {
              "key": "id",
              "type": "string",
              "required": true
            },
            {
              "key": "descricao",
              "label": "descrição (acessibilidade)",
              "type": "string",
              "required": true
            },
            {
              "key": "url",
              "type": "string"
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.DSImage",
              "params": {
                "descricao": "contentDescription",
                "url": "url"
              }
            },
            "ios": {
              "symbol": "DSImage",
              "params": {
                "descricao": "accessibilityLabel",
                "url": "url"
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.image",
              "path": "src/main/kotlin/com/app/bff/sdui/Components.kt",
              "params": {
                "id": "id",
                "descricao": "accessibilityLabel",
                "url": "url"
              },
              "notes": "A função devolve o nó do componente no JSON da tela."
            }
          }
        }
      ]
    },
    {
      "id": "eventos",
      "name": "Eventos",
      "color": "#FB8C00",
      "annotationTypes": [
        {
          "id": "onClick",
          "name": "onClick",
          "requiresOwner": true,
          "fields": [
            {
              "key": "acao",
              "label": "ação",
              "type": "enum",
              "options": ["navigate", "submit", "openUrl", "showDialog", "track"],
              "required": true
            },
            {
              "key": "destino",
              "type": "string"
            },
            {
              "key": "parametros",
              "label": "parâmetros",
              "type": "table",
              "columns": [
                {
                  "key": "nome",
                  "type": "string",
                  "required": true
                },
                {
                  "key": "valor",
                  "type": "string"
                }
              ]
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.OnClick",
              "params": {
                "acao": "action",
                "destino": "target",
                "parametros": "params"
              },
              "notes": "Associe o evento ao componente dono por meio do parâmetro onClick."
            },
            "ios": {
              "symbol": "OnClick",
              "params": {
                "acao": "action",
                "destino": "target",
                "parametros": "params"
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.onClick",
              "path": "src/main/kotlin/com/app/bff/sdui/Events.kt",
              "params": {
                "acao": "action",
                "destino": "target",
                "parametros": "parameters"
              },
              "notes": "A função devolve o nó do componente no JSON da tela."
            }
          }
        },
        {
          "id": "onHold",
          "name": "onHold",
          "requiresOwner": true,
          "fields": [
            {
              "key": "acao",
              "label": "ação",
              "type": "enum",
              "options": ["showTooltip", "showMenu", "track"],
              "required": true
            },
            {
              "key": "duracaoMs",
              "label": "duração (ms)",
              "type": "number",
              "default": 500
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.OnHold",
              "params": {
                "acao": "action",
                "duracaoMs": "durationMs"
              }
            },
            "ios": {
              "symbol": "OnHold",
              "params": {
                "acao": "action",
                "duracaoMs": "duration"
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.onHold",
              "path": "src/main/kotlin/com/app/bff/sdui/Events.kt",
              "params": {
                "acao": "action",
                "duracaoMs": "durationMs"
              },
              "notes": "A função devolve o nó do componente no JSON da tela."
            }
          }
        },
        {
          "id": "onChange",
          "name": "onChange",
          "requiresOwner": true,
          "fields": [
            {
              "key": "acao",
              "label": "ação",
              "type": "enum",
              "options": ["validate", "mask", "track"],
              "required": true
            },
            {
              "key": "regra",
              "type": "string",
              "description": "Ex: email, cpf, minLength:8"
            }
          ],
          "code": {
            "android": {
              "symbol": "com.app.ds.OnChange",
              "params": {
                "acao": "action",
                "regra": "rule"
              }
            },
            "ios": {
              "symbol": "OnChange",
              "params": {
                "acao": "action",
                "regra": "rule"
              }
            },
            "bff": {
              "symbol": "com.app.bff.sdui.onChange",
              "path": "src/main/kotlin/com/app/bff/sdui/Events.kt",
              "params": {
                "acao": "action",
                "regra": "rule"
              },
              "notes": "A função devolve o nó do componente no JSON da tela."
            }
          }
        }
      ]
    },
    {
      "id": "telas",
      "name": "Telas",
      "color": "#00897B",
      "annotationTypes": [
        {
          "id": "screen",
          "name": "Screen",
          "labelField": "nome",
          "fields": [
            {
              "key": "nome",
              "type": "string",
              "required": true
            },
            {
              "key": "rota",
              "type": "string"
            }
          ]
        }
      ]
    }
  ]
}
